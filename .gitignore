# Python bytecode (lib/ helpers and tests run in place)
__pycache__/
*.py[co]

# Editor and scratch files (also removed by 'make clean')
*~
*.tmp
*.bak
*.swp

# Local agent and tool state: session exports, CLI device ids and per-user
# permission lists. Personal, and can hold credentials; never commit.
.qwen/
.local/
extract/
