install_usage() {
    cat <<EOF
${C_BOLD}kimo install${C_RESET} – Install and manage external CLIs (including GitHub CLI: gh)

GitHub CLI uses official checksum-verified Linux/macOS releases in ~/.local/bin.
Updates/--force refuse system, package-manager and symlink installations; use their package manager.
GitHub CLI is not Copilot and is not routed to Ollama.

${C_YELLOW}Usage:${C_RESET}
  ${0##*/} install [cli|all|list] [options]

${C_YELLOW}Arguments:${C_RESET}
  ${C_CYAN}<cli>${C_RESET}        Name of CLI to install (kimi, claude, grok, codex, qwen, cursor, opencode, cyberstrike, agy, openclaw, hermes, gh)
  ${C_CYAN}all${C_RESET}          Install or update all supported CLIs in batch
  ${C_CYAN}list${C_RESET}         Display status and version table of all supported CLIs (default without args)

${C_YELLOW}Options:${C_RESET}
  ${C_CYAN}-u, --update${C_RESET}  Update the CLI to the latest upstream release
  ${C_CYAN}-f, --force${C_RESET}   Force reinstallation even if already present
  ${C_CYAN}-l, --list${C_RESET}    List CLI installation inventory and status
  ${C_CYAN}-h, --help${C_RESET}    Show this help message

${C_YELLOW}Examples:${C_RESET}
  ${0##*/} install            # Display inventory and status of all CLIs
  ${0##*/} install kimi       # Install Kimi Code CLI
  ${0##*/} install claude     # Install Claude Code CLI
  ${0##*/} install all        # Install all supported CLIs
  ${0##*/} install kimi -u    # Update Kimi Code CLI to latest release
