# bl prints {"error": {...}} (often on stderr) and can still exit 0.
KIMI_FT_AUTH_ERR_RE='not logged in|session is not|expired|auth login|unauthorized|unauthenticated|forbidden|invalid token'
KIMI_FT_BL_TIMEOUT="${KIMO_KIMI_FT_BL_TIMEOUT:-180}"

_freetier_login_recipe() {
    cat >&2 <<EOF
${C_YELLOW}kimo freetier: the Model Studio console session is dead - quota data needs a
live console login (an API key alone cannot see free quotas).${C_RESET}

Run:
  bl auth login --console --console-site ${KIMI_FT_CONSOLE_SITE}

On a headless host, capture the callback URL instead:
  BROWSER=/bin/false NO_COLOR=1 bl auth login --console --console-site ${KIMI_FT_CONSOLE_SITE} 2>&1 | tee /tmp/bl-login.log
  # grab the 127.0.0.1:PORT URL it prints, then from a machine with a browser:
  ssh -N -L PORT:127.0.0.1:PORT <this-host>
  # open http://127.0.0.1:PORT/... in that browser (15-minute window)

Then re-run.
EOF
}

# _freetier_bl_usage_free -> rows JSON on stdout; returns 3 on auth error.
_freetier_bl_usage_free() {
    if ! command -v bl >/dev/null 2>&1; then
        echo "${C_RED}Error: the 'bl' (Bailian CLI) is required to fetch free-tier quotas.${C_RESET}" >&2
        echo "${C_RED}  Install with: bl skill init   (or pass --from-json to skip the live fetch)${C_RESET}" >&2
        return 1
    fi
    local out err rc payload
    out=$(mktemp) || return 1
    err=$(mktemp) || { rm -f "${out}"; return 1; }
    set +e
    NO_COLOR=1 timeout "${KIMI_FT_BL_TIMEOUT}" bl usage free --all --output json \
        --console-site "${KIMI_FT_CONSOLE_SITE}" >"${out}" 2>"${err}"
    rc=$?
    set -e
    payload=$(cat "${out}")
    if ! printf '%s' "${payload}" | jq -e 'type == "array"' >/dev/null 2>&1; then
        local blob code msg
        blob=$(cat "${out}" "${err}")
        code=$(printf '%s' "${blob}" | jq -r '.error.code // empty' 2>/dev/null | head -1)
        msg=$(printf '%s' "${blob}" | jq -r '.error.message // empty' 2>/dev/null | head -1)
        if [[ "${code}" == "3" ]] || printf '%s %s' "${code}" "${msg}" | grep -Eiq "${KIMI_FT_AUTH_ERR_RE}"; then
            rm -f "${out}" "${err}"
            _freetier_login_recipe
            return 3
        fi
        rm -f "${out}" "${err}"
        if [[ "${rc}" -eq 124 ]]; then
            echo "${C_RED}Error: 'bl usage free' timed out after ${KIMI_FT_BL_TIMEOUT}s.${C_RESET}" >&2
            return 1
        fi
        echo "${C_RED}Error: unexpected 'bl usage free' payload (rc=${rc}): $(printf '%s' "${blob}" | head -c 300)${C_RESET}" >&2
        return 1
    fi
    cat "${out}"
    rm -f "${out}" "${err}"
}

# Same workspace key the qwen sync resolved: settings.env in ~/.qwen first
# (qwen loads it, so it is the key qwen probes proved valid), then shell env,
# then the Bailian CLI profile.
_freetier_resolve_key() {
    if [[ -n "${KIMI_FT_API_KEY}" ]]; then
        printf '%s' "${KIMI_FT_API_KEY}"
        return 0
    fi
    local k=""
    if [[ -f "${KIMI_FT_QWEN_SETTINGS}" ]]; then
        k=$(jq -r '.env.MODELSTUDIO_API_KEY // .env.DASHSCOPE_API_KEY // empty' "${KIMI_FT_QWEN_SETTINGS}" 2>/dev/null)
    fi
    if [[ -z "${k}" && -n "${DASHSCOPE_API_KEY:-}" ]]; then k="${DASHSCOPE_API_KEY}"; fi
    if [[ -z "${k}" && -f "${KIMI_FT_BAILIAN_CONFIG}" ]]; then
        k=$(jq -r '. as $c | .[$c.active_config // "default"].api_key // empty' "${KIMI_FT_BAILIAN_CONFIG}" 2>/dev/null)
    fi
    if [[ -z "${k}" ]]; then
        echo "${C_RED}Error: no API key found (pass --api-key, set DASHSCOPE_API_KEY, or fix ${KIMI_FT_QWEN_SETTINGS}).${C_RESET}" >&2
        return 1
    fi
    printf '%s' "${k}"
}

_freetier_load_rows() {
    if [[ -n "${KIMI_FT_FROM_JSON}" ]]; then
        if [[ ! -f "${KIMI_FT_FROM_JSON}" ]]; then
            echo "${C_RED}Error: --from-json file not found: ${KIMI_FT_FROM_JSON}${C_RESET}" >&2
            return 1
        fi
        # jq -e prints the (normalized) rows array to stdout, which the caller
        # captures - mirroring the standalone script's load_rows().
        if ! jq -e 'if type=="array" then . elif (.rows? // .data?) then (.rows // .data) else error("no rows array") end' "${KIMI_FT_FROM_JSON}" 2>/dev/null; then
            echo "${C_RED}Error: bad --from-json payload in ${KIMI_FT_FROM_JSON}${C_RESET}" >&2
            return 1
        fi
        return 0
    fi
    _freetier_bl_usage_free
}

_freetier_filter_rows() {
    jq --argjson min_rem "${KIMI_FT_MIN_REMAINING}" --argjson min_days "${KIMI_FT_MIN_DAYS_LEFT}" \
       --argjson qwen_only "${KIMI_FT_QWEN_ONLY}" --arg sort "${KIMI_FT_SORT}" --argjson limit "${KIMI_FT_LIMIT}" \
       --arg token_types "${KIMI_FT_TOKEN_TYPES}" --arg realtime_re "${KIMI_FT_REALTIME_RE}" \
       --arg nonchat_re "${KIMI_FT_NONCHAT_RE}" --arg include_re "${KIMI_FT_INCLUDE_RE}" --arg exclude_re "${KIMI_FT_EXCLUDE_RE}" \
       --arg qwen_re "${KIMI_FT_QWEN_RE}" '
    def to_num: if type=="number" then . elif type=="string" then (tonumber // 0) else 0 end;
    def lc: tostring | ascii_downcase;
    def exp_ok($min_days):
      ((.expires // "") | lc | gsub("^\\s+|\\s+$";"")) as $e
      | if (["expired","invalid","exhausted","used up","used"] | index($e)) != null then false
        elif (["","-","none","null","unlimited","never","no expiry","valid","permanent","n/a"] | index($e)) != null then true
        else
          (try ($e | strptime("%Y-%m-%d") | mktime) catch
           (try ($e | strptime("%Y/%m/%d") | mktime) catch
            (try ($e | strptime("%d.%m.%Y") | mktime) catch
             (try ($e | strptime("%Y-%m") | mktime) catch
              (try ($e | strptime("%Y") | mktime) catch null))))) as $t
          | if $t == null then true
            else (($t - now) / 86400) >= $min_days end
        end;
    ($token_types | ascii_downcase | split("|")) as $tok
    | [ .[]
        | select(((.model // "") | tostring) != "")
        | select(($qwen_only == 0) or (.model | test($qwen_re; "i")))
        | select((.remaining | to_num) >= $min_rem and (.remaining | to_num) > 0)
        | select(exp_ok($min_days))
        | select(((.type // "") | lc) as $t | ($t == "") or ($tok | index($t) != null))
        | select(.model | test($realtime_re; "i") | not)
        | select(.model | test($nonchat_re; "i") | not)
        | select(($include_re == "") or (.model | test($include_re; "i")))
        | select(($exclude_re == "") or (.model | test($exclude_re; "i") | not))
      ]
    | (if $sort == "name" then sort_by(.model | lc)
       elif $sort == "expires" then sort_by(.expires // "9999")
       else sort_by(.remaining | to_num) | reverse end)
    | if $limit > 0 then .[:$limit] else . end
  '
}

# Network-level failures (000) are flaky under parallel load - retry those;
# HTTP answers (200/401/403/...) are deterministic and final.
_freetier_probe_one() {
    local model="$1" base="$2" tout="$3" outdir="$4" key body code attempt detail=""
    key=$(cat "${outdir}/.key")
    body=$(mktemp) || return 1
    for attempt in 1 2 3; do
        code=$(curl -sS -m "${tout}" -o "${body}" -w '%{http_code}' \
            -X POST "${base}/chat/completions" \
            -H 'Content-Type: application/json' -H "Authorization: Bearer ${key}" \
            -d "{\"model\":\"${model}\",\"messages\":[{\"role\":\"user\",\"content\":\"ping\"}],\"max_tokens\":1}" \
            2>/dev/null) || code="000"
        [[ "${code}" != "000" ]] && break
        sleep "${attempt}"
    done
    if [[ "${code}" != "200" ]]; then
        detail=$(jq -r '.error | (.code // "") + " " + (.message // "")' "${body}" 2>/dev/null | head -c 160)
        [[ -n "${detail}" ]] || detail=$(head -c 120 "${body}" 2>/dev/null | tr '\n' ' ')
    fi
    # 200 = answers; 429 = throttled but has quota -> ok
    if [[ "${code}" == "200" || "${code}" == "429" ]]; then
        printf '%s\tok\tHTTP %s\n' "${model}" "${code}" > "${outdir}/${model}.probe"
    else
        printf '%s\tfail\tHTTP %s %s\n' "${model}" "${code}" "${detail}" > "${outdir}/${model}.probe"
    fi
    rm -f "${body}"
}
export -f _freetier_probe_one

# args: models file (one per line) -> "model\tok|fail\tdetail" lines
_freetier_run_verify() {
    local models_file="$1" outdir
    outdir=$(mktemp -d) || return 1
    if ! _freetier_resolve_key > "${outdir}/.key"; then
        rm -rf "${outdir}"
        return 1
    fi
    xargs -P "${KIMI_FT_VERIFY_JOBS}" -I{} bash -c '_freetier_probe_one "$1" "$2" "$3" "$4"' _ {} \
        "${KIMI_FT_BASE_URL}" "${KIMI_FT_VERIFY_TIMEOUT}" "${outdir}" < "${models_file}" >/dev/null 2>&1 || true
    while IFS= read -r m; do
        if [[ -f "${outdir}/${m}.probe" ]]; then
            cat "${outdir}/${m}.probe"
        else
            printf '%s\tfail\tprobe missing\n' "${m}"
        fi
    done < "${models_file}"
    rm -rf "${outdir}"
}

# rows JSON on stdin; $1 = resolved key
_freetier_emit_block() {
    jq -r --arg provider "${KIMI_FT_PROVIDER}" --arg prefix "${KIMI_FT_ALIAS_PREFIX}" --arg base "${KIMI_FT_BASE_URL}" \
       --arg key "$1" --argjson ctx "${KIMI_FT_CONTEXT_WINDOW}" --argjson maxout "${KIMI_FT_MAX_OUTPUT}" '
    "# >>> kimi-freetier-sync managed block (regenerated; do not hand-edit) >>>",
    "[providers." + $provider + "]",
    "type = \"openai\"",
    "base_url = \"" + $base + "\"",
    "api_key = \"" + $key + "\"",
    "",
    ( .[] |
      "[models.\"" + $prefix + .model + "\"]",
      "provider = \"" + $provider + "\"",
      "model = \"" + .model + "\"",
      "max_context_size = " + ($ctx | tostring),
      "max_output_size = " + ($maxout | tostring),
      "capabilities = [ " +
        ([ "\"tool_use\"" ]
         + (if (.type // "") == "Vision" then ["\"image_in\""]
            elif (.type // "") == "Multimodal" then ["\"image_in\"", "\"video_in\""]
            else [] end)
        | join(", ")) + " ]",
      "display_name = \"" + .model + " (free tier)\"",
      ""
    ),
    "# <<< kimi-freetier-sync managed block <<<"
  '
}

# args: rows JSON (selected) on stdin
_freetier_write_config() {
    local rows key n default_alias="" candidate
    rows=$(cat)
    if ! key=$(_freetier_resolve_key); then return 1; fi
    n=$(printf '%s' "${rows}" | jq length)
    case "${KIMI_FT_SET_DEFAULT}" in
        ""|none) default_alias="" ;;
        first) default_alias="${KIMI_FT_ALIAS_PREFIX}$(printf '%s' "${rows}" | jq -r '.[0].model // ""')" ;;
        *) default_alias="${KIMI_FT_SET_DEFAULT}" ;;
    esac

    if [[ "${KIMI_FT_DRY_RUN}" -eq 1 ]]; then
        echo "${C_DIM}[dry-run] would replace the ${KIMI_FT_PROVIDER} group with ${n} entries in ${KIMI_FT_CONFIG}${C_RESET}" >&2
        [[ -n "${default_alias}" ]] && echo "${C_DIM}[dry-run] default_model -> ${default_alias}${C_RESET}" >&2
        printf '%s\n' "${rows}" | jq -r '.[].model'
        return 0
    fi

    candidate=$(mktemp) || return 1
    if [[ -f "${KIMI_FT_CONFIG}" ]]; then
        # Strip every managed section: [providers.alibaba] + subtables (but NOT
        # [providers.alibaba-token-plan]) and all [models."alibaba/..."] blocks.
        awk -v provider="${KIMI_FT_PROVIDER}" -v prefix="${KIMI_FT_ALIAS_PREFIX}" '
          /^\[/ {
            if ($0 ~ "^\\[providers\\." provider "(\\.|])" ||
                $0 ~ "^\\[models\\.\"" prefix) skip=1; else skip=0;
          }
          !skip { print }
        ' "${KIMI_FT_CONFIG}" > "${candidate}"
    else
        mkdir -p "$(dirname "${KIMI_FT_CONFIG}")"
        printf '# %s/config.toml\n' "${KIMI_CONFIG%/*}" > "${candidate}"
    fi

    printf '\n' >> "${candidate}"
    printf '%s' "${rows}" | _freetier_emit_block "${key}" >> "${candidate}"

    if [[ -n "${default_alias}" ]]; then
        if grep -q '^default_model\s*=' "${candidate}"; then
            sed -i 's|^default_model\s*=.*|default_model = "'"${default_alias}"'"|' "${candidate}"
        else
            sed -i '1i default_model = "'"${default_alias}"'"' "${candidate}"
        fi
    fi

    # Validate: kimi's own parser+schema when available, else a TOML parse check.
    if command -v kimi >/dev/null 2>&1; then
        if ! kimi doctor config "${candidate}" >/dev/null 2>&1; then
            kimi doctor config "${candidate}" >&2 || true
            rm -f "${candidate}"
            echo "${C_RED}Error: kimi doctor rejected the candidate; ${KIMI_FT_CONFIG} untouched.${C_RESET}" >&2
            return 1
        fi
    elif command -v python3 >/dev/null 2>&1; then
        if ! python3 -c 'import sys,tomllib; tomllib.load(open(sys.argv[1],"rb"))' "${candidate}"; then
            rm -f "${candidate}"
            echo "${C_RED}Error: TOML parse failed; ${KIMI_FT_CONFIG} untouched.${C_RESET}" >&2
            return 1
        fi
    else
        echo "${C_YELLOW}[!] warning: no kimi/python3 validator found; writing unvalidated${C_RESET}" >&2
    fi

    if [[ -f "${KIMI_FT_CONFIG}" ]]; then
        local backup
        backup="${KIMI_FT_CONFIG}.before-freetier-$(date -u +%Y%m%dT%H%M%S%z)"
        cp -p "${KIMI_FT_CONFIG}" "${backup}"
        chmod 600 "${backup}"
        echo "${C_DIM}backup: ${backup}${C_RESET}" >&2
    fi
    chmod 600 "${candidate}"
    mv "${candidate}" "${KIMI_FT_CONFIG}"
    echo "${C_GREEN}[+] wrote ${KIMI_FT_CONFIG}: ${n} free-tier models under [${KIMI_FT_PROVIDER}]${default_alias:+ default_model=${default_alias}}${C_RESET}" >&2
}

_freetier_usage() {
    cat <<EOF
${C_BOLD}kimo freetier${C_RESET} - sync Kimi Code config.toml with Model Studio (international) free-tier quotas

${C_YELLOW}Source:${C_RESET} ${KIMI_FT_CONSOLE_URL}
  Fetched through the Bailian CLI:  bl usage free --all --output json
  Login when expired:               bl auth login --console --console-site ${KIMI_FT_CONSOLE_SITE}

${C_YELLOW}Writes${C_RESET} (surgical edit, timestamped backup first, everything else preserved):
  [providers.alibaba] + one [models."alibaba/<id>"] per quota-verified model
  (managed block marked with "kimi-freetier-sync"). default_model is untouched
  unless --set-default is given. max_output_size caps max_tokens at 65536.

${C_YELLOW}Options:${C_RESET}
  --check-auth            Is the console session live? (exit 0 live / 3 dead)
  --dry-run               Plan and print selected models; write nothing
  --from-json FILE        Skip live fetch; read rows JSON from FILE
  --save-json FILE        Also dump fetched rows JSON to FILE
  --list-only             Print selected model ids and exit
  --output-json           With --list-only, emit JSON rows instead of ids
  --verify                Probe each selected model with a 1-token chat first
  --verify-prune          Also drop models that fail the probe (implies --verify)
  --verify-timeout N      Per-probe timeout in seconds (default 30)
  --jobs N                Parallel probe workers (default 6)
  --qwen-only             Restrict to qwen/qwq/qvq model ids
  --include RE            Keep only models matching RE
  --exclude RE            Drop models matching RE
  --min-remaining N       Require N remaining quota (default 1)
  --min-days-left N       Require N days before expiry (default 0)
  --sort name|expires|remaining    Selection order (default remaining)
  --limit N               Cap selection to N models
  --set-default first|none|ALIAS   Optionally rewrite default_model
  --context-window N      max_context_size written per model (default 131072)
  --max-output N          max_output_size written per model (default 65536)
  --base-url URL          DashScope compatible-mode base URL
  --api-key KEY           API key (else ~/.qwen/settings.json, DASHSCOPE_API_KEY, bl profile)
  --config FILE           Target config.toml (default: ${KIMI_FT_CONFIG})
  --verbose               Verbose per-model progress on stderr
  -h, --help              Show this help

${C_YELLOW}Examples:${C_RESET}
  ${0##*/} freetier --check-auth
  ${0##*/} freetier --dry-run
  ${0##*/} freetier --verify --verify-prune
  ${0##*/} freetier --set-default first
  ${0##*/} freetier --from-json ~/quota.json --list-only --output-json
EOF
    return 0
}

cmd_freetier() {
    KIMI_FT_CONFIG="${KIMI_CONFIG}"
    KIMI_FT_BASE_URL="${DASHSCOPE_BASE_URL:-${KIMI_FT_BASE_URL_DEFAULT}}"
    KIMI_FT_BASE_URL="${KIMI_FT_BASE_URL%/}"
    KIMI_FT_API_KEY=""
    KIMI_FT_FROM_JSON=""
    KIMI_FT_SAVE_JSON=""
    KIMI_FT_MIN_REMAINING=1
    KIMI_FT_MIN_DAYS_LEFT=0
    KIMI_FT_QWEN_ONLY=0
    KIMI_FT_INCLUDE_RE=""
    KIMI_FT_EXCLUDE_RE=""
    KIMI_FT_SORT="remaining"
    KIMI_FT_LIMIT=0
    KIMI_FT_VERIFY=0
    KIMI_FT_VERIFY_PRUNE=0
    KIMI_FT_VERIFY_TIMEOUT=30
    KIMI_FT_VERIFY_JOBS=6
    KIMI_FT_SET_DEFAULT=""
    KIMI_FT_CONTEXT_WINDOW="${KIMO_KIMI_FT_CONTEXT:-131072}"
    KIMI_FT_MAX_OUTPUT="${KIMO_KIMI_FT_MAX_OUTPUT:-65536}"
    KIMI_FT_DRY_RUN=0
    KIMI_FT_LIST_ONLY=0
    KIMI_FT_OUTPUT_JSON=0
    KIMI_FT_VERBOSE=0
    KIMI_FT_CHECK_AUTH=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --config) KIMI_FT_CONFIG="$2"; shift 2 ;;
            --base-url) KIMI_FT_BASE_URL="$2"; shift 2 ;;
            --api-key) KIMI_FT_API_KEY="$2"; shift 2 ;;
            --from-json) KIMI_FT_FROM_JSON="$2"; shift 2 ;;
            --save-json) KIMI_FT_SAVE_JSON="$2"; shift 2 ;;
            --min-remaining) KIMI_FT_MIN_REMAINING="$2"; shift 2 ;;
            --min-days-left) KIMI_FT_MIN_DAYS_LEFT="$2"; shift 2 ;;
            --qwen-only) KIMI_FT_QWEN_ONLY=1; shift ;;
            --include) KIMI_FT_INCLUDE_RE="$2"; shift 2 ;;
            --exclude) KIMI_FT_EXCLUDE_RE="$2"; shift 2 ;;
            --sort) KIMI_FT_SORT="$2"; shift 2 ;;
            --limit) KIMI_FT_LIMIT="$2"; shift 2 ;;
            --verify) KIMI_FT_VERIFY=1; shift ;;
            --verify-prune) KIMI_FT_VERIFY=1; KIMI_FT_VERIFY_PRUNE=1; shift ;;
            --verify-timeout) KIMI_FT_VERIFY_TIMEOUT="$2"; shift 2 ;;
            --jobs) KIMI_FT_VERIFY_JOBS="$2"; shift 2 ;;
            --set-default) KIMI_FT_SET_DEFAULT="$2"; shift 2 ;;
            --context-window) KIMI_FT_CONTEXT_WINDOW="$2"; shift 2 ;;
            --max-output) KIMI_FT_MAX_OUTPUT="$2"; shift 2 ;;
            --dry-run) KIMI_FT_DRY_RUN=1; shift ;;
            --list-only) KIMI_FT_LIST_ONLY=1; shift ;;
            --output-json) KIMI_FT_OUTPUT_JSON=1; shift ;;
            --verbose) KIMI_FT_VERBOSE=1; shift ;;
            --check-auth) KIMI_FT_CHECK_AUTH=1; shift ;;
            -h|--help) _freetier_usage; return 0 ;;
            *) echo "${C_RED}Error: unknown flag: $1 (try --help)${C_RESET}" >&2; return 1 ;;
        esac
    done

    if ! command -v jq >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1 || ! command -v awk >/dev/null 2>&1; then
        echo "${C_RED}Error: kimo freetier requires jq, curl and awk.${C_RESET}" >&2
        return 1
    fi

    KIMI_FT_BASE_URL="${KIMI_FT_BASE_URL%/}"

    if [[ "${KIMI_FT_CHECK_AUTH}" -eq 1 ]]; then
        echo "${C_DIM}probing console session with a real quota call...${C_RESET}" >&2
        # stdout is the (huge) rows dump; stderr stays visible so an expired
        # session prints the login recipe. if/else captures the real status
        # ($? inside else is the condition's status), so we can distinguish
        # "dead session" (3) from "unexpected payload" (1).
        local ft_auth_rc=0
        if _freetier_bl_usage_free >/dev/null; then
            ft_auth_rc=0
        else
            ft_auth_rc=$?
        fi
        if [[ "${ft_auth_rc}" -eq 0 ]]; then
            echo "${C_GREEN}console session: LIVE${C_RESET}" >&2
            return 0
        fi
        if [[ "${ft_auth_rc}" -eq 3 ]]; then
            echo "${C_YELLOW}[!] console session: expired (login required, see recipe above)${C_RESET}" >&2
            return 3
        fi
        echo "${C_YELLOW}[!] console session: unknown state (rc=${ft_auth_rc})${C_RESET}" >&2
        return "${ft_auth_rc}"
    fi

    local rows selected n models_file results ok_ids
    if ! rows=$(_freetier_load_rows); then return 1; fi
    if [[ -n "${KIMI_FT_SAVE_JSON}" ]]; then
        printf '%s\n' "${rows}" | jq '.' > "${KIMI_FT_SAVE_JSON}"
        echo "${C_DIM}saved rows -> ${KIMI_FT_SAVE_JSON}${C_RESET}" >&2
    fi

    selected=$(printf '%s' "${rows}" | _freetier_filter_rows)
    n=$(printf '%s' "${selected}" | jq length)
    if [[ "${n}" -lt 1 ]]; then
        echo "${C_RED}Error: no models with quota left after filtering (see ${KIMI_FT_CONSOLE_URL})${C_RESET}" >&2
        return 1
    fi
    echo "${C_DIM}selected ${n} models with quota left${C_RESET}" >&2

    if [[ "${KIMI_FT_VERBOSE}" -eq 1 ]]; then
        printf '%s' "${selected}" | jq -r '.[] | "  \(.model)\tremaining=\(.remaining)\texpires=\(.expires // "-")"' >&2
    fi

    if [[ "${KIMI_FT_VERIFY}" -eq 1 ]]; then
        models_file=$(mktemp) || return 1
        printf '%s' "${selected}" | jq -r '.[].model' > "${models_file}"
        echo "${C_DIM}probing ${n} models at ${KIMI_FT_BASE_URL} ...${C_RESET}" >&2
        results=$(_freetier_run_verify "${models_file}")
        ok_ids=$(printf '%s\n' "${results}" | awk -F'\t' '$2=="ok"{print $1}')
        printf '%s\n' "${results}" | awk -F'\t' '{printf "  %-36s %-4s %s\n", $1, $2, $3}' >&2
        if [[ "${KIMI_FT_VERIFY_PRUNE}" -eq 1 ]]; then
            selected=$(printf '%s' "${selected}" | jq --arg ok "${ok_ids}" '
              ($ok | split("\n") | map(select(. != ""))) as $ids
              | [ .[] | select(.model as $m | $ids | index($m) != null) ]')
            n=$(printf '%s' "${selected}" | jq length)
            if [[ "${n}" -lt 1 ]]; then
                rm -f "${models_file}"
                echo "${C_RED}Error: every probed model failed; nothing written.${C_RESET}" >&2
                return 1
            fi
            echo "${C_DIM}after verify-prune: ${n} models${C_RESET}" >&2
        fi
        rm -f "${models_file}"
    fi

    if [[ "${KIMI_FT_LIST_ONLY}" -eq 1 ]]; then
        if [[ "${KIMI_FT_OUTPUT_JSON}" -eq 1 || "${OPT_JSON}" == "true" ]]; then
            printf '%s\n' "${selected}" | jq '.'
        else
            printf '%s' "${selected}" | jq -r '.[].model'
        fi
        return 0
    fi

    printf '%s' "${selected}" | _freetier_write_config
}

# -----------------------------------------------------------------------------
# Command: gemini  (Google Gemini API token models -> Kimi Code)
# List every model the Gemini API key can see (GET /v1beta/models, paginated)
# and rewrite the managed [providers.gemini] / [models."gemini/..."] block of
# the Kimi Code config.toml. Kimi drives them natively through its
# 'google-genai' provider type, using each model's real token limits
# (inputTokenLimit -> max_context_size, outputTokenLimit -> max_output_size)
# and the API's thinking flag. Every other provider/model is preserved and
# default_model is untouched unless --set-default is given.
# -----------------------------------------------------------------------------
KIMI_GM_BASE_URL_DEFAULT="https://generativelanguage.googleapis.com"
KIMI_GM_MARKER="kimo-gemini-sync managed block"
KIMI_GM_DOTENV="${HOME:-/root}/.gemini/.env"
# Families /models lists with generateContent that Kimi cannot drive as a
# coding agent (media generation, speech, live/bidi, embeddings, agents).
KIMI_GM_NONCHAT_RE='embed|aqa|imagen|veo|lyria|tts|image|banana|native-audio|live|transcribe|robotics|computer-use|deep-research|learnlm'
KIMI_GM_PREVIEW_RE='preview|exp(erimental)?([-_]|$)'

# _gemini_curl_key KEY CURL_ARGS... - run curl with the key sent as the
# x-goog-api-key header via a stdin config, so it never shows up in argv/ps.
_gemini_curl_key() {
    local key="$1"
    shift
    printf 'header = "x-goog-api-key: %s"\n' "${key}" | curl -K - "$@"
}
export -f _gemini_curl_key

# Key order: --api-key, --api-key-env VAR, GEMINI_API_KEY, GOOGLE_API_KEY,
# GOOGLE_GENERATIVE_AI_API_KEY, then ~/.gemini/.env (gemini-cli's file). The
# literal "ollama" is skipped: that is the placeholder kimo's agy launch exports.
_gemini_resolve_key() {
    if [[ -n "${KIMI_GM_API_KEY}" ]]; then
        printf '%s' "${KIMI_GM_API_KEY}"
        return 0
    fi
    local k="" var
    if [[ -n "${KIMI_GM_API_KEY_ENV}" ]]; then
        k="${!KIMI_GM_API_KEY_ENV:-}"
        if [[ -z "${k}" ]]; then
            echo "${C_RED}Error: --api-key-env ${KIMI_GM_API_KEY_ENV} is not set in this shell.${C_RESET}" >&2
            return 1
        fi
        printf '%s' "${k}"
        return 0
    fi
    for var in GEMINI_API_KEY GOOGLE_API_KEY GOOGLE_GENERATIVE_AI_API_KEY; do
        if [[ -n "${!var:-}" && "${!var}" != "ollama" ]]; then
            k="${!var}"
            break
        fi
    done
    if [[ -z "${k}" && -f "${KIMI_GM_DOTENV}" ]]; then
        k=$(sed -n -E "s/^[[:space:]]*(export[[:space:]]+)?(GEMINI_API_KEY|GOOGLE_API_KEY)[[:space:]]*=[[:space:]]*[\"']?([^\"'[:space:]]+).*/\\3/p" \
            "${KIMI_GM_DOTENV}" 2>/dev/null | head -1) || k=""
    fi
    if [[ -z "${k}" ]]; then
        echo "${C_RED}Error: no Gemini API key found (pass --api-key, set GEMINI_API_KEY/GOOGLE_API_KEY, or add it to ${KIMI_GM_DOTENV}).${C_RESET}" >&2
        echo "${C_RED}  Create one at https://aistudio.google.com/apikey${C_RESET}" >&2
        return 1
    fi
    printf '%s' "${k}"
}

# _gemini_fetch_models KEY -> raw .models[] array (all pages) on stdout
_gemini_fetch_models() {
    local key="$1" token="" all="[]" body code msg pages=0
    local -a page_arg
    body=$(mktemp) || return 1
    while :; do
        page_arg=()
        if [[ -n "${token}" ]]; then page_arg=(--data-urlencode "pageToken=${token}"); fi
        code=$(_gemini_curl_key "${key}" -sS -G -m "${KIMI_GM_TIMEOUT}" -o "${body}" -w '%{http_code}' \
            "${KIMI_GM_BASE_URL}/v1beta/models" --data-urlencode "pageSize=1000" "${page_arg[@]}" \
            2>/dev/null) || code="000"
        if [[ "${code}" != "200" ]]; then
            msg=$(jq -r '.error | "\(.status // "") \(.message // "")"' "${body}" 2>/dev/null | head -c 300) || msg=""
            [[ -n "${msg// /}" ]] || msg=$(head -c 200 "${body}" 2>/dev/null | tr '\n' ' ')
            rm -f "${body}"
            echo "${C_RED}Error: GET ${KIMI_GM_BASE_URL}/v1beta/models -> HTTP ${code} ${msg}${C_RESET}" >&2
            return 1
        fi
        all=$(jq -c --argjson acc "${all}" '$acc + (.models // [])' "${body}") || { rm -f "${body}"; return 1; }
        token=$(jq -r '.nextPageToken // empty' "${body}")
        pages=$((pages + 1))
        if [[ -z "${token}" || "${pages}" -ge 50 ]]; then break; fi
    done
    rm -f "${body}"
    printf '%s\n' "${all}"
}

# Raw API models (array, or {models:[...]}) -> normalized rows on stdout.
_gemini_normalize_rows() {
    jq -e '
      (if type == "array" then . elif (.models? | type) == "array" then .models
       else error("no models array") end)
      | [ .[] | select(type == "object") | {
            model: ((.name // .model // "") | tostring | sub("^models/"; "")),
            display_name: (.displayName // .display_name // ""),
            input_tokens: ((.inputTokenLimit // .input_tokens // 0) | tonumber? // 0),
            output_tokens: ((.outputTokenLimit // .output_tokens // 0) | tonumber? // 0),
            methods: (.supportedGenerationMethods // .methods // []),
            thinking: ((.thinking // false) == true)
          } | select(.model != "") ]
    '
}

_gemini_load_rows() {
    local key="$1" raw
    if [[ -n "${KIMI_GM_FROM_JSON}" ]]; then
        if [[ ! -f "${KIMI_GM_FROM_JSON}" ]]; then
            echo "${C_RED}Error: --from-json file not found: ${KIMI_GM_FROM_JSON}${C_RESET}" >&2
            return 1
        fi
        raw=$(cat "${KIMI_GM_FROM_JSON}")
    else
        raw=$(_gemini_fetch_models "${key}") || return 1
    fi
    if [[ -n "${KIMI_GM_SAVE_JSON}" ]]; then
        printf '%s\n' "${raw}" | jq '.' > "${KIMI_GM_SAVE_JSON}"
        echo "${C_DIM}saved raw models -> ${KIMI_GM_SAVE_JSON}${C_RESET}" >&2
    fi
    if ! printf '%s' "${raw}" | _gemini_normalize_rows 2>/dev/null; then
        echo "${C_RED}Error: unexpected Gemini models payload${KIMI_GM_FROM_JSON:+ in ${KIMI_GM_FROM_JSON}}${C_RESET}" >&2
        return 1
    fi
}

_gemini_filter_rows() {
    jq --argjson all "${KIMI_GM_ALL}" --argjson stable "${KIMI_GM_STABLE_ONLY}" \
       --argjson min_ctx "${KIMI_GM_MIN_CONTEXT}" --argjson limit "${KIMI_GM_LIMIT}" --arg sort "${KIMI_GM_SORT}" \
       --arg nonchat_re "${KIMI_GM_NONCHAT_RE}" --arg preview_re "${KIMI_GM_PREVIEW_RE}" \
       --arg include_re "${KIMI_GM_INCLUDE_RE}" --arg exclude_re "${KIMI_GM_EXCLUDE_RE}" '
    [ .[]
        | select((.methods | index("generateContent")) != null)
        | select(($all == 1) or (.model | test($nonchat_re; "i") | not))
        | select(($stable == 0) or (.model | test($preview_re; "i") | not))
        | select(.input_tokens >= $min_ctx)
        | select(($include_re == "") or (.model | test($include_re; "i")))
        | select(($exclude_re == "") or (.model | test($exclude_re; "i") | not))
    ]
    | unique_by(.model)
    | (if $sort == "context" then sort_by(-.input_tokens, .model)
       elif $sort == "output" then sort_by(-.output_tokens, .model)
       else sort_by(.model | ascii_downcase) end)
    | if $limit > 0 then .[:$limit] else . end
    '
}

# 200 = answers; 429 = valid model, just throttled -> ok. Network failures
# (000) are retried; HTTP answers are final.
_gemini_probe_one() {
    local model="$1" base="$2" tout="$3" outdir="$4" key body code attempt detail="" safe
    key=$(cat "${outdir}/.key")
    safe="${model//\//_}"
    body=$(mktemp) || return 1
    for attempt in 1 2 3; do
        code=$(_gemini_curl_key "${key}" -sS -m "${tout}" -o "${body}" -w '%{http_code}' \
            -X POST "${base}/v1beta/models/${model}:generateContent" \
            -H 'Content-Type: application/json' \
            -d '{"contents":[{"role":"user","parts":[{"text":"ping"}]}],"generationConfig":{"maxOutputTokens":16}}' \
            2>/dev/null) || code="000"
        [[ "${code}" != "000" ]] && break
        sleep "${attempt}"
    done
    if [[ "${code}" != "200" ]]; then
        detail=$(jq -r '.error | (.status // "") + " " + (.message // "")' "${body}" 2>/dev/null | head -c 160)
        [[ -n "${detail}" ]] || detail=$(head -c 120 "${body}" 2>/dev/null | tr '\n' ' ')
    fi
    if [[ "${code}" == "200" || "${code}" == "429" ]]; then
        printf '%s\tok\tHTTP %s\n' "${model}" "${code}" > "${outdir}/${safe}.probe"
    else
        printf '%s\tfail\tHTTP %s %s\n' "${model}" "${code}" "${detail}" > "${outdir}/${safe}.probe"
    fi
    rm -f "${body}"
}
export -f _gemini_probe_one

# args: KEY MODELS_FILE -> "model\tok|fail\tdetail" lines
_gemini_run_verify() {
    local key="$1" models_file="$2" outdir m
    outdir=$(mktemp -d) || return 1
    ( umask 077; printf '%s' "${key}" > "${outdir}/.key" )
    xargs -P "${KIMI_GM_VERIFY_JOBS}" -I{} bash -c '_gemini_probe_one "$1" "$2" "$3" "$4"' _ {} \
        "${KIMI_GM_BASE_URL}" "${KIMI_GM_VERIFY_TIMEOUT}" "${outdir}" < "${models_file}" >/dev/null 2>&1 || true
    while IFS= read -r m; do
        if [[ -f "${outdir}/${m//\//_}.probe" ]]; then
            cat "${outdir}/${m//\//_}.probe"
        else
            printf '%s\tfail\tprobe missing\n' "${m}"
        fi
    done < "${models_file}"
    rm -rf "${outdir}"
}

# rows JSON on stdin; $1 = key (ignored when KIMI_GM_API_KEY_ENV is set).
# Strings go through tojson: a JSON string literal is a valid TOML basic string.
_gemini_emit_block() {
    jq -r --arg provider "${KIMI_GM_PROVIDER}" --arg prefix "${KIMI_GM_ALIAS_PREFIX}" \
       --arg base "${KIMI_GM_BASE_URL}" --arg key "$1" --arg key_env "${KIMI_GM_API_KEY_ENV}" \
       --arg marker "${KIMI_GM_MARKER}" \
       --argjson ctx "${KIMI_GM_CONTEXT_WINDOW}" --argjson maxout "${KIMI_GM_MAX_OUTPUT}" '
    def caps:
      [ "tool_use" ]
      + (if (.model | test("^gemini"; "i")) then [ "image_in", "video_in" ]
         elif (.model | test("^gemma-?[3-9]"; "i")) and (.model | test("-1b"; "i") | not) then [ "image_in" ]
         else [] end)
      + (if .thinking then [ "thinking" ] else [] end);
    "# >>> " + $marker + " (regenerated by kimo gemini; do not hand-edit) >>>",
    "[providers." + $provider + "]",
    "type = \"google-genai\"",
    "base_url = " + ($base | tojson),
    (if $key_env != "" then "api_key_env = " + ($key_env | tojson) else "api_key = " + ($key | tojson) end),
    "",
    ( .[] |
      "[models." + (($prefix + .model) | tojson) + "]",
      "provider = " + ($provider | tojson),
      "model = " + (.model | tojson),
      "max_context_size = " + ((if $ctx > 0 then $ctx elif .input_tokens > 0 then .input_tokens else 131072 end) | tostring),
      "max_output_size = " + ((if $maxout > 0 then $maxout elif .output_tokens > 0 then .output_tokens else 8192 end) | tostring),
      "capabilities = [ " + (caps | map(tojson) | join(", ")) + " ]",
      "display_name = " + (((if .display_name != "" then .display_name else .model end) + " (Gemini)") | tojson),
      ""
    ),
    "# <<< " + $marker + " <<<"
  '
}

# Remove the managed provider + its model aliases (and our marker comments)
# from a config.toml on stdin. Matching is literal (index), not regex, so a
# sibling like [providers.gemini-paid] or [models."gemini-x/..."] survives.
# Trailing blank lines are dropped so repeated syncs do not grow the file.
_gemini_strip_managed() {
    awk -v provider="${KIMI_GM_PROVIDER}" -v prefix="${KIMI_GM_ALIAS_PREFIX}" -v marker="${KIMI_GM_MARKER}" '
      index($0, marker) { next }
      /^[[:space:]]*\[/ {
        h = $0; sub(/^[[:space:]]+/, "", h)
        skip = (index(h, "[providers." provider "]") == 1 ||
                index(h, "[providers." provider ".") == 1 ||
                index(h, "[providers.\"" provider "\"]") == 1 ||
                index(h, "[providers.\"" provider "\".") == 1 ||
                index(h, "[models.\"" prefix) == 1)
      }
      skip { next }
      /^[[:space:]]*$/ { blanks++; next }
      { while (blanks > 0) { print ""; blanks-- } print }
    '
}

# Set the top-level default_model (keys before the first table header only;
# provider tables have their own default_model key that must stay intact).
_gemini_set_default_model() {
    local file="$1" alias="$2" tmp
    tmp=$(mktemp) || return 1
    awk -v alias="${alias}" '
      BEGIN { line = "default_model = \"" alias "\"" }
      !done && /^[[:space:]]*\[/ { if (!found) print line; done = 1 }
      !done && /^[[:space:]]*default_model[[:space:]]*=/ { print line; found = 1; next }
      { print }
      END { if (!done && !found) print line }
    ' "${file}" > "${tmp}" && cat "${tmp}" > "${file}"
    rm -f "${tmp}"
}

# rows JSON (selected) on stdin
_gemini_write_config() {
    local rows key="" n default_alias="" candidate rc=0
    rows=$(cat)
    n=$(printf '%s' "${rows}" | jq length)
    case "${KIMI_GM_SET_DEFAULT}" in
        ""|none) default_alias="" ;;
        first) default_alias="${KIMI_GM_ALIAS_PREFIX}$(printf '%s' "${rows}" | jq -r '.[0].model // ""')" ;;
        *) default_alias="${KIMI_GM_SET_DEFAULT}" ;;
    esac
    if [[ -n "${default_alias}" && ! "${default_alias}" =~ ^[A-Za-z0-9._/:@+-]+$ ]]; then
        echo "${C_RED}Error: invalid --set-default alias: ${default_alias}${C_RESET}" >&2
        return 1
    fi

    if [[ "${KIMI_GM_DRY_RUN}" -eq 1 ]]; then
        echo "${C_DIM}[dry-run] would replace the [providers.${KIMI_GM_PROVIDER}] group with ${n} models in ${KIMI_GM_CONFIG}${C_RESET}" >&2
        if [[ -n "${default_alias}" ]]; then
            echo "${C_DIM}[dry-run] default_model -> ${default_alias}${C_RESET}" >&2
        fi
        printf '%s' "${rows}" | jq -r --arg p "${KIMI_GM_ALIAS_PREFIX}" '.[] | "\($p)\(.model)\tctx=\(.input_tokens)\tout=\(.output_tokens)\(if .thinking then "\tthinking" else "" end)"'
        return 0
    fi

    if [[ -z "${KIMI_GM_API_KEY_ENV}" ]]; then
        key=$(_gemini_resolve_key) || return 1
    fi

    mkdir -p "$(dirname "${KIMI_GM_CONFIG}")"
    if command -v flock >/dev/null 2>&1; then
        exec 8>"${KIMI_CONFIG_LOCK}"
        flock 8
    fi

    candidate=$(mktemp) || return 1
    if [[ -f "${KIMI_GM_CONFIG}" ]]; then
        _gemini_strip_managed < "${KIMI_GM_CONFIG}" > "${candidate}"
        printf '\n' >> "${candidate}"
    else
        printf '# %s\n\n' "${KIMI_GM_CONFIG}" > "${candidate}"
    fi
    printf '%s' "${rows}" | _gemini_emit_block "${key}" >> "${candidate}"
    if [[ -n "${default_alias}" ]]; then
        _gemini_set_default_model "${candidate}" "${default_alias}"
    fi

    # Validate: kimi's own parser+schema when available, else a TOML parse check.
    if command -v kimi >/dev/null 2>&1; then
        if ! kimi doctor config "${candidate}" >/dev/null 2>&1; then
            kimi doctor config "${candidate}" >&2 || true
            echo "${C_RED}Error: kimi doctor rejected the candidate; ${KIMI_GM_CONFIG} untouched.${C_RESET}" >&2
            rc=1
        fi
    elif command -v python3 >/dev/null 2>&1; then
        if ! python3 -c 'import sys,tomllib; tomllib.load(open(sys.argv[1],"rb"))' "${candidate}"; then
            echo "${C_RED}Error: TOML parse failed; ${KIMI_GM_CONFIG} untouched.${C_RESET}" >&2
            rc=1
        fi
    else
        echo "${C_YELLOW}[!] warning: no kimi/python3 validator found; writing unvalidated${C_RESET}" >&2
    fi
    if [[ "${rc}" -ne 0 ]]; then
        rm -f "${candidate}"
        return "${rc}"
    fi

    if [[ -f "${KIMI_GM_CONFIG}" ]]; then
        local backup
        backup="${KIMI_GM_CONFIG}.before-gemini-$(date -u +%Y%m%dT%H%M%S%z)"
        cp -p "${KIMI_GM_CONFIG}" "${backup}"
        chmod 600 "${backup}"
        echo "${C_DIM}backup: ${backup}${C_RESET}" >&2
    fi
    chmod 600 "${candidate}"
    mv "${candidate}" "${KIMI_GM_CONFIG}"
    echo "${C_GREEN}[+] wrote ${KIMI_GM_CONFIG}: ${n} Gemini models under [providers.${KIMI_GM_PROVIDER}]${default_alias:+ default_model=${default_alias}}${C_RESET}" >&2
    echo "${C_DIM}    use one with: kimi -m ${KIMI_GM_ALIAS_PREFIX}$(printf '%s' "${rows}" | jq -r '.[0].model')${C_RESET}" >&2
}

_gemini_usage() {
    cat <<EOF
${C_BOLD}kimo gemini${C_RESET} - register Google Gemini API models (with their token limits) in Kimi Code

${C_YELLOW}Source:${C_RESET} GET ${KIMI_GM_BASE_URL_DEFAULT}/v1beta/models  (every page the key can see)
  Key: --api-key, --api-key-env VAR, GEMINI_API_KEY, GOOGLE_API_KEY,
       GOOGLE_GENERATIVE_AI_API_KEY, then ${KIMI_GM_DOTENV}

${C_YELLOW}Writes${C_RESET} (surgical edit, timestamped backup first, everything else preserved):
  [providers.gemini] (type = "google-genai") + one [models."gemini/<id>"] per
  chat-capable model, with max_context_size = inputTokenLimit and
  max_output_size = outputTokenLimit from the API, and capabilities
  tool_use/image_in/video_in (+ thinking when the API flags it).
  Media-generation, TTS, live/bidi, embedding and agent-only models are
  skipped unless --all. default_model is untouched unless --set-default.

${C_YELLOW}Options:${C_RESET}
  --dry-run               Plan and print selected models; write nothing
  --list-only             Print selected model ids and exit
  --output-json           With --list-only, emit JSON rows instead of ids
  --from-json FILE        Skip live fetch; read a /v1beta/models payload from FILE
  --save-json FILE        Also dump the fetched raw payload to FILE
  --verify                Probe each selected model with a tiny generateContent first
  --verify-prune          Also drop models that fail the probe (implies --verify)
  --verify-timeout N      Per-probe timeout in seconds (default 30)
  --jobs N                Parallel probe workers (default 6)
  --stable-only           Drop preview/experimental model ids
  --all                   Keep non-chat families too (still requires generateContent)
  --include RE            Keep only models matching RE
  --exclude RE            Drop models matching RE
  --min-context N         Require inputTokenLimit >= N (default 0)
  --sort name|context|output   Selection order (default name)
  --limit N               Cap selection to N models
  --set-default first|none|ALIAS   Optionally rewrite default_model
  --context-window N      Override max_context_size for every model (default: API value)
  --max-output N          Override max_output_size for every model (default: API value)
  --provider NAME         Provider id / alias prefix (default gemini -> "gemini/<id>")
  --base-url URL          Gemini API base URL (default ${KIMI_GM_BASE_URL_DEFAULT})
  --api-key KEY           API key to fetch with and embed in config.toml
  --api-key-env VAR       Write api_key_env = "VAR" instead of embedding the key
  --config FILE           Target config.toml (default: ${KIMI_CONFIG})
  --verbose               Per-model details on stderr
  -h, --help              Show this help

${C_YELLOW}Examples:${C_RESET}
  ${0##*/} gemini --dry-run
  ${0##*/} gemini --verify --verify-prune
  ${0##*/} gemini --stable-only --set-default gemini/gemini-2.5-pro
  ${0##*/} gemini --api-key-env GEMINI_API_KEY      # keep the secret out of config.toml
  kimi -m gemini/gemini-2.5-flash
EOF
    return 0
}

cmd_gemini() {
    KIMI_GM_CONFIG="${KIMI_CONFIG}"
    KIMI_GM_BASE_URL="${KIMO_GEMINI_BASE_URL:-${KIMI_GM_BASE_URL_DEFAULT}}"
    KIMI_GM_PROVIDER="gemini"
    KIMI_GM_API_KEY=""
    KIMI_GM_API_KEY_ENV=""
    KIMI_GM_FROM_JSON=""
    KIMI_GM_SAVE_JSON=""
    KIMI_GM_ALL=0
    KIMI_GM_STABLE_ONLY=0
    KIMI_GM_INCLUDE_RE=""
    KIMI_GM_EXCLUDE_RE=""
    KIMI_GM_MIN_CONTEXT=0
    KIMI_GM_SORT="name"
    KIMI_GM_LIMIT=0
    KIMI_GM_VERIFY=0
    KIMI_GM_VERIFY_PRUNE=0
    KIMI_GM_VERIFY_TIMEOUT=30
    KIMI_GM_VERIFY_JOBS=6
    KIMI_GM_TIMEOUT="${KIMO_GEMINI_TIMEOUT:-30}"
    KIMI_GM_SET_DEFAULT=""
    KIMI_GM_CONTEXT_WINDOW="${KIMO_KIMI_GEMINI_CONTEXT:-0}"
    KIMI_GM_MAX_OUTPUT="${KIMO_KIMI_GEMINI_MAX_OUTPUT:-0}"
    KIMI_GM_DRY_RUN=0
    KIMI_GM_LIST_ONLY=0
    KIMI_GM_OUTPUT_JSON=0
    KIMI_GM_VERBOSE=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --config|--base-url|--api-key|--api-key-env|--from-json|--save-json|--include|--exclude|--min-context|--sort|--limit|--verify-timeout|--jobs|--set-default|--context-window|--max-output|--provider)
                if [[ $# -lt 2 ]]; then
                    echo "${C_RED}Error: $1 requires a value.${C_RESET}" >&2
                    return 1
                fi
                ;;
        esac
        case "$1" in
            --config) KIMI_GM_CONFIG="$2"; shift 2 ;;
            --base-url) KIMI_GM_BASE_URL="$2"; shift 2 ;;
            --api-key) KIMI_GM_API_KEY="$2"; shift 2 ;;
            --api-key-env) KIMI_GM_API_KEY_ENV="$2"; shift 2 ;;
            --from-json) KIMI_GM_FROM_JSON="$2"; shift 2 ;;
            --save-json) KIMI_GM_SAVE_JSON="$2"; shift 2 ;;
            --all) KIMI_GM_ALL=1; shift ;;
            --stable-only) KIMI_GM_STABLE_ONLY=1; shift ;;
            --include) KIMI_GM_INCLUDE_RE="$2"; shift 2 ;;
            --exclude) KIMI_GM_EXCLUDE_RE="$2"; shift 2 ;;
            --min-context) KIMI_GM_MIN_CONTEXT="$2"; shift 2 ;;
            --sort) KIMI_GM_SORT="$2"; shift 2 ;;
            --limit) KIMI_GM_LIMIT="$2"; shift 2 ;;
            --verify) KIMI_GM_VERIFY=1; shift ;;
            --verify-prune) KIMI_GM_VERIFY=1; KIMI_GM_VERIFY_PRUNE=1; shift ;;
            --verify-timeout) KIMI_GM_VERIFY_TIMEOUT="$2"; shift 2 ;;
            --jobs) KIMI_GM_VERIFY_JOBS="$2"; shift 2 ;;
            --set-default) KIMI_GM_SET_DEFAULT="$2"; shift 2 ;;
            --context-window) KIMI_GM_CONTEXT_WINDOW="$2"; shift 2 ;;
            --max-output) KIMI_GM_MAX_OUTPUT="$2"; shift 2 ;;
            --provider) KIMI_GM_PROVIDER="$2"; shift 2 ;;
            --dry-run) KIMI_GM_DRY_RUN=1; shift ;;
            --list-only) KIMI_GM_LIST_ONLY=1; shift ;;
            --output-json) KIMI_GM_OUTPUT_JSON=1; shift ;;
            --verbose) KIMI_GM_VERBOSE=1; shift ;;
            -h|--help) _gemini_usage; return 0 ;;
            *) echo "${C_RED}Error: unknown flag: $1 (try --help)${C_RESET}" >&2; return 1 ;;
        esac
    done

    if ! command -v jq >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1 || ! command -v awk >/dev/null 2>&1; then
        echo "${C_RED}Error: kimo gemini requires jq, curl and awk.${C_RESET}" >&2
        return 1
    fi
    local num_opt
    for num_opt in KIMI_GM_MIN_CONTEXT KIMI_GM_LIMIT KIMI_GM_VERIFY_TIMEOUT KIMI_GM_VERIFY_JOBS KIMI_GM_CONTEXT_WINDOW KIMI_GM_MAX_OUTPUT KIMI_GM_TIMEOUT; do
        if [[ ! "${!num_opt}" =~ ^[0-9]+$ ]]; then
            echo "${C_RED}Error: ${num_opt#KIMI_GM_} must be a non-negative integer (got '${!num_opt}').${C_RESET}" >&2
            return 1
        fi
    done
    if [[ ! "${KIMI_GM_PROVIDER}" =~ ^[A-Za-z0-9_-]+$ ]]; then
        echo "${C_RED}Error: --provider must match [A-Za-z0-9_-]+ (got '${KIMI_GM_PROVIDER}').${C_RESET}" >&2
        return 1
    fi
    if [[ -n "${KIMI_GM_API_KEY_ENV}" && ! "${KIMI_GM_API_KEY_ENV}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        echo "${C_RED}Error: --api-key-env must be an environment variable name.${C_RESET}" >&2
        return 1
    fi
    case "${KIMI_GM_SORT}" in
        name|context|output) ;;
        *) echo "${C_RED}Error: --sort must be name, context or output.${C_RESET}" >&2; return 1 ;;
    esac
    KIMI_GM_ALIAS_PREFIX="${KIMI_GM_PROVIDER}/"
    KIMI_GM_BASE_URL="${KIMI_GM_BASE_URL%/}"
    # Accept a base URL pasted with the API version on it.
    KIMI_GM_BASE_URL="${KIMI_GM_BASE_URL%/v1beta}"
    KIMI_GM_BASE_URL="${KIMI_GM_BASE_URL%/v1}"

    # A key is needed to fetch and/or probe; --from-json without --verify can
    # plan/list keyless, and the writer resolves its own key later.
    local key=""
    if [[ -z "${KIMI_GM_FROM_JSON}" || "${KIMI_GM_VERIFY}" -eq 1 ]]; then
        key=$(_gemini_resolve_key) || return 1
    fi

    local rows selected n total models_file results ok_ids
    if [[ -z "${KIMI_GM_FROM_JSON}" ]]; then
        echo "${C_DIM}fetching models from ${KIMI_GM_BASE_URL}/v1beta/models ...${C_RESET}" >&2
    fi
    rows=$(_gemini_load_rows "${key}") || return 1
    total=$(printf '%s' "${rows}" | jq length)
    selected=$(printf '%s' "${rows}" | _gemini_filter_rows) || return 1
    n=$(printf '%s' "${selected}" | jq length)
    if [[ "${n}" -lt 1 ]]; then
        echo "${C_RED}Error: no chat-capable Gemini models left after filtering (${total} listed).${C_RESET}" >&2
        return 1
    fi
    echo "${C_DIM}selected ${n} of ${total} Gemini models${C_RESET}" >&2

    if [[ "${KIMI_GM_VERBOSE}" -eq 1 ]]; then
        printf '%s' "${selected}" | jq -r '.[] | "  \(.model)\tctx=\(.input_tokens)\tout=\(.output_tokens)\tthinking=\(.thinking)"' >&2
    fi

    if [[ "${KIMI_GM_VERIFY}" -eq 1 ]]; then
        models_file=$(mktemp) || return 1
        printf '%s' "${selected}" | jq -r '.[].model' > "${models_file}"
        echo "${C_DIM}probing ${n} models at ${KIMI_GM_BASE_URL} ...${C_RESET}" >&2
        results=$(_gemini_run_verify "${key}" "${models_file}")
        rm -f "${models_file}"
        ok_ids=$(printf '%s\n' "${results}" | awk -F'\t' '$2=="ok"{print $1}')
        printf '%s\n' "${results}" | awk -F'\t' '{printf "  %-44s %-4s %s\n", $1, $2, $3}' >&2
        if [[ "${KIMI_GM_VERIFY_PRUNE}" -eq 1 ]]; then
            selected=$(printf '%s' "${selected}" | jq --arg ok "${ok_ids}" '
              ($ok | split("\n") | map(select(. != ""))) as $ids
              | [ .[] | select(.model as $m | $ids | index($m) != null) ]')
            n=$(printf '%s' "${selected}" | jq length)
            if [[ "${n}" -lt 1 ]]; then
                echo "${C_RED}Error: every probed model failed; nothing written.${C_RESET}" >&2
                return 1
            fi
            echo "${C_DIM}after verify-prune: ${n} models${C_RESET}" >&2
        fi
    fi

    if [[ "${KIMI_GM_LIST_ONLY}" -eq 1 ]]; then
        if [[ "${KIMI_GM_OUTPUT_JSON}" -eq 1 || "${OPT_JSON}" == "true" ]]; then
            printf '%s\n' "${selected}" | jq '.'
        else
            printf '%s' "${selected}" | jq -r '.[].model'
        fi
        return 0
    fi

    # Reuse the key already resolved for the fetch, so the writer embeds the
    # same one (it resolves on its own for keyless --from-json runs).
    if [[ -n "${key}" && -z "${KIMI_GM_API_KEY}" && -z "${KIMI_GM_API_KEY_ENV}" ]]; then
        KIMI_GM_API_KEY="${key}"
    fi
    printf '%s' "${selected}" | _gemini_write_config
}

# -----------------------------------------------------------------------------
# Command: web (WebBridge real-browser relay & quota-free research)
# -----------------------------------------------------------------------------
cmd_web() {
    local subcmd="${1:-}"
    shift || true

    case "${subcmd}" in
        status)
            local base_url="${WEBBRIDGE_URL%/command}"
            local code="000"
            if command -v curl >/dev/null 2>&1; then
                code=$(curl -s -m 3 -o /dev/null -w "%{http_code}" "${base_url}/" 2>/dev/null) || code="000"
            fi
            [[ -z "${code}" ]] && code="000"
            local reachable="false"
            if [[ "${code}" =~ ^[1-5][0-9][0-9]$ ]]; then
                reachable="true"
            fi
            if [[ "${OPT_JSON:-false}" == "true" ]]; then
                jq -nc \
                    --arg url "${WEBBRIDGE_URL}" \
                    --argjson port "${WEBBRIDGE_PORT}" \
                    --arg code "${code}" \
                    --argjson reachable "${reachable}" \
                    --arg engine "${WEB_ENGINE}" \
                    --argjson max_results "${WEB_MAX_RESULTS}" \
                    '{url: $url, port: $port, http_code: $code, reachable: $reachable, engine: $engine, max_results: $max_results}'
                return 0
            fi
            if [[ "${reachable}" == "true" ]]; then
                echo "${C_GREEN}[✓] WebBridge daemon is reachable at ${WEBBRIDGE_URL} (HTTP ${code})${C_RESET}"
                echo "    Relay port: ${WEBBRIDGE_PORT} | Search engine: ${WEB_ENGINE} | Max results: ${WEB_MAX_RESULTS}"
            else
                echo "${C_RED}[✗] WebBridge daemon is offline / unreachable at ${WEBBRIDGE_URL} (HTTP ${code})${C_RESET}"
                echo "${C_DIM}    Ensure the Kimi WebBridge extension or browser relay is running on port ${WEBBRIDGE_PORT}.${C_RESET}"
                echo "${C_DIM}    Reference: ~/.agents/skills/custom-web/SKILL.md${C_RESET}"
                return 1
            fi
            ;;
        url)
            local target_url="${1:-}"
            if [[ -z "${target_url}" || "${target_url}" == "-h" || "${target_url}" == "--help" ]]; then
                echo "${C_RED}Usage: ${0##*/} web url <url>${C_RESET}" >&2
                return 1
            fi
            [[ "${target_url}" =~ ^https?:// ]] || target_url="https://${target_url}"
            local payload
            payload=$(jq -nc --arg u "${target_url}" \
                '{"action":"navigate","args":{"url":$u,"newTab":true,"group_title":"kimo-research"},"session":"kimo-web"}')
            if [[ "${OPT_JSON:-false}" == "true" ]]; then
                jq -nc --arg url "${WEBBRIDGE_URL}" --arg payload "${payload}" '{endpoint: $url, payload: ($payload | fromjson)}'
            else
                echo "${C_BOLD}Ready-to-paste navigation command:${C_RESET}"
                cat <<EOF
curl -s -X POST ${WEBBRIDGE_URL} \\
  -H 'Content-Type: application/json' \\
  -d '${payload}'
EOF
            fi
            ;;
        fetch)
            local target_url="${1:-}"
            if [[ -z "${target_url}" || "${target_url}" == "-h" || "${target_url}" == "--help" ]]; then
                echo "${C_RED}Usage: ${0##*/} web fetch <url>${C_RESET}" >&2
                return 1
            fi
            [[ "${target_url}" =~ ^https?:// ]] || target_url="https://${target_url}"
            local payload
            payload=$(jq -nc --arg u "${target_url}" \
                '{"action":"navigate","args":{"url":$u,"newTab":true,"group_title":"kimo-research"},"session":"kimo-web"}')
            echo "${C_DIM}[*] Navigating to ${target_url} via WebBridge (${WEBBRIDGE_URL})...${C_RESET}"
            local res
            if res=$(curl -s -S -m 5 -X POST "${WEBBRIDGE_URL}" \
                -H 'Content-Type: application/json' \
                -d "${payload}" 2>&1); then
                if [[ "${OPT_JSON:-false}" == "true" ]]; then
                    if echo "${res}" | jq . >/dev/null 2>&1; then
                        echo "${res}"
                    else
                        jq -nc --arg u "${target_url}" --arg r "${res}" '{url: $u, result: $r}'
                    fi
                else
                    echo "${C_GREEN}[✓] Page navigation command dispatched to WebBridge.${C_RESET}"
                fi
            else
                echo "${C_RED}[✗] Failed to connect to WebBridge daemon at ${WEBBRIDGE_URL}.${C_RESET}" >&2
                echo "${C_DIM}    Manual command:${C_RESET}" >&2
                printf "    curl -s -X POST %s -H 'Content-Type: application/json' -d '%s'\n" "${WEBBRIDGE_URL}" "${payload}" >&2
                return 1
            fi
            ;;
        search)
            local query="$*"
            if [[ -z "${query}" || "${query}" == "-h" || "${query}" == "--help" ]]; then
                echo "${C_RED}Usage: ${0##*/} web search <query>${C_RESET}" >&2
                return 1
            fi
            local q_encoded
            q_encoded=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote_plus(sys.argv[1]))" "${query}")
            local search_url
            case "${WEB_ENGINE}" in
                bing)
                    search_url="https://www.bing.com/search?q=${q_encoded}"
                    ;;
                google)
                    search_url="https://www.google.com/search?q=${q_encoded}"
                    ;;
                duckduckgo|*)
                    search_url="https://html.duckduckgo.com/html/?q=${q_encoded}"
                    ;;
            esac
            local payload
            payload=$(jq -nc --arg u "${search_url}" --arg q "${query}" \
                '{"action":"navigate","args":{"url":$u,"newTab":true,"group_title":("search: " + $q)},"session":"kimo-web"}')
            echo "${C_DIM}[*] Searching '${query}' via ${WEB_ENGINE} on WebBridge (${WEBBRIDGE_URL})...${C_RESET}"
            local res
            if res=$(curl -s -S -m 5 -X POST "${WEBBRIDGE_URL}" \
                -H 'Content-Type: application/json' \
                -d "${payload}" 2>&1); then
                if [[ "${OPT_JSON:-false}" == "true" ]]; then
                    if echo "${res}" | jq . >/dev/null 2>&1; then
                        echo "${res}"
                    else
                        jq -nc --arg q "${query}" --arg u "${search_url}" --arg r "${res}" '{query: $q, url: $u, result: $r}'
                    fi
                else
                    echo "${C_GREEN}[✓] Search navigation dispatched to browser tab.${C_RESET}"
                    echo "${C_DIM}    URL: ${search_url}${C_RESET}"
                    echo "${C_DIM}    Extraction snippet:${C_RESET}"
                    printf "    curl -s -X POST %s -H 'Content-Type: application/json' -d '{\"action\":\"evaluate\",\"args\":{\"code\":\"(() => { const a = [...document.querySelectorAll(\\\"a.result__a, h2 a, .b_algo h2 a\\\")]; return JSON.stringify(a.slice(0,%s).map(x => ({t: x.textContent, h: x.href}))); })()\"},\"session\":\"kimo-web\"}'\n" "${WEBBRIDGE_URL}" "${WEB_MAX_RESULTS}"
                fi
            else
                echo "${C_YELLOW}[!] WebBridge daemon unreachable at ${WEBBRIDGE_URL}.${C_RESET}" >&2
                echo "${C_DIM}    Direct search URL: ${search_url}${C_RESET}" >&2
                echo "${C_DIM}    Manual command:${C_RESET}" >&2
                printf "    curl -s -X POST %s -H 'Content-Type: application/json' -d '%s'\n" "${WEBBRIDGE_URL}" "${payload}" >&2
                return 1
            fi
            ;;
        help|-h|--help|"")
            cat <<EOF
${C_BOLD}kimo web${C_RESET} – WebBridge real-browser relay & quota-free research

${C_YELLOW}Usage:${C_RESET}
  kimo web status                       Probe the WebBridge daemon reachability
  kimo web search <query>             Search the web via WebBridge (no API key, no Moonshot quota)
  kimo web fetch <url>                   Open <url> in the user's real browser (via WebBridge)
  kimo web url <url>                    Print a ready-to-paste curl command for browser navigation

${C_YELLOW}Configuration:${C_RESET}
  Endpoint:   ${WEBBRIDGE_URL} (port: ${WEBBRIDGE_PORT})
  Engine:     ${WEB_ENGINE} (duckduckgo | bing | google)
  Max Limit:  ${WEB_MAX_RESULTS}
EOF
            ;;
        *)
            echo "${C_RED}Error: Unknown web subcommand '${subcmd}'.${C_RESET}" >&2
            echo "Try: kimo web status | search | fetch | url" >&2
            return 1
            ;;
    esac
}

# -----------------------------------------------------------------------------
# Main Dispatcher
# -----------------------------------------------------------------------------
# With several --host values, read-only/aggregate commands query every host;
# commands that act on one model go to the first host that has it (else the
# first --host).
if [[ "${HOST_MODE}" == "multi" ]]; then
    case "${COMMAND}" in
        check|ping|hosts|init|scan|discover|ps|top|list|ls|search|find|stop|unload|info|show|status|health|status-report|report|logs|log|rotate-token|rotate|install|setup|update|upgrade|doctor|diagnose|diag|config|cfg|completion|sync|freetier|free-tier|kimi-sync|quotas|gemini|gemini-sync|kimi-gemini|web|version|help|-h|--help) ;;
        *)
            _model="${ARGS[0]:-}"
            if [[ "${COMMAND}" == "launch" ]]; then
                _model=""
                for ((_i = 0; _i < ${#ARGS[@]}; _i++)); do
                    case "${ARGS[_i]}" in
                        --model) _model="${ARGS[_i+1]:-}"; break ;;
                        --model=*) _model="${ARGS[_i]#*=}"; break ;;
                    esac
                done
            fi
            TARGET_HOST="${OPT_HOSTS[0]}"
            if [[ -n "${_model}" && "${_model}" != -* ]]; then
                for _h in "${OPT_HOSTS[@]}"; do
                    if resolve_model_name "${_model}" "${_h}" >/dev/null 2>&1; then
                        TARGET_HOST="${_h}"
                        break
                    fi
                done
            fi
            HOST_MODE="custom"
            echo "${C_DIM}[*] Multiple --host: routing '${COMMAND}' to ${TARGET_HOST}${C_RESET}" >&2
            ;;
    esac
fi

# First-run / unconfigured auto-discovery prompt:
# Offer discovery if invoking a remote-dependent command when remote endpoint is unconfigured & unreachable
if [[ -t 0 && "${OPT_JSON:-false}" != "true" && "${KIMO_NO_AUTOSCAN:-0}" != "1" ]]; then
    _remote_needed=false
    if [[ "${HOST_MODE}" == "remote" ]]; then
        _remote_needed=true
    else
        case "${COMMAND}" in
            check|ping|hosts|sync)
                _remote_needed=true
                ;;
        esac
    fi

    if [[ "${_remote_needed}" == "true" && -z "${KIMO_CONFIG_VALUES[remote_url]:-}" ]]; then
        if ! probe_ollama_url "${REMOTE_HOST_URL}"; then
            if [[ -z "${REMOTE_DIRECT_URL:-}" ]] || ! probe_ollama_url "${REMOTE_DIRECT_URL}"; then
                echo "${C_YELLOW}[!] Notice: Remote Ollama endpoint is not configured and unreachable (${REMOTE_HOST_URL}).${C_RESET}"
                read -r -p "Would you like to scan your network to discover active Ollama instances? [Y/n] " _autoscan_resp
                if [[ -z "${_autoscan_resp}" || "${_autoscan_resp}" =~ ^[Yy] ]]; then
                    echo ""
                    cmd_init
                    if [[ "${HOST_MODE}" == "remote" ]]; then
                        TARGET_HOST="${REMOTE_HOST_URL}"
                    fi
                    echo ""
                fi
            fi
        fi
    fi
    unset _remote_needed _autoscan_resp
fi

case "${COMMAND}" in
    check|ping)
        cmd_check
        ;;
    hosts)
        cmd_hosts
        ;;
    init)
        cmd_init "${ARGS[@]}"
        ;;
    scan|discover)
        cmd_scan "${ARGS[@]}"
        ;;
    ps)
        cmd_ps "${ARGS[@]}"
        ;;
    top)
        cmd_top "${ARGS[@]}"
        ;;
    status|health)
        cmd_status
        ;;
    status-report|report)
        cmd_status_report
        ;;
    logs|log)
        cmd_logs "${ARGS[0]:-}"
        ;;
    rotate-token|rotate)
        cmd_rotate_token "${ARGS[@]}"
        ;;
    stop|unload)
        cmd_stop "${ARGS[0]:-}"
        ;;
    warm|preload)
        cmd_warm "${ARGS[0]:-}" "${ARGS[1]:-}"
        ;;
    tune|set-ctx|param)
        cmd_tune "${ARGS[@]}"
        ;;
    bench|eval|benchmark)
        cmd_bench "${ARGS[@]}"
        ;;
    list|ls)
        cmd_list "${ARGS[0]:-}"
        ;;
    search|find)
        cmd_search "${ARGS[@]}"
        ;;
    info|show)
        cmd_info "${ARGS[0]:-}"
        ;;
    tag|alias|cp)
        cmd_tag "${ARGS[0]:-}" "${ARGS[1]:-}"
        ;;
    rm|delete)
        cmd_rm "${ARGS[0]:-}"
        ;;
    pull|download)
        cmd_pull "${ARGS[@]}"
        ;;
    sync)
        cmd_sync "${ARGS[@]}"
        ;;
    stream)
        cmd_stream "${ARGS[@]}"
        ;;
    run)
        cmd_run "${ARGS[@]}"
        ;;
    launch)
        cmd_launch "${ARGS[@]}"
        ;;
    install|setup)
        cmd_install "${ARGS[@]}"
        ;;
    update|upgrade)
        cmd_update "${ARGS[@]}"
        ;;
    doctor|diagnose|diag)
        cmd_doctor "${ARGS[@]}"
        ;;
    config|cfg)
        cmd_config "${ARGS[@]}"
        ;;
    completion)
        cmd_completion "${ARGS[@]}"
        ;;
    freetier|free-tier|kimi-sync|quotas)
        cmd_freetier "${ARGS[@]}"
        ;;
    gemini|gemini-sync|kimi-gemini)
        cmd_gemini "${ARGS[@]}"
        ;;
    web)
        cmd_web "${ARGS[@]}"
        ;;
    version)
        echo "kimo v${KIMO_VERSION}"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "${C_RED}Error: Unknown command '${COMMAND}'.${C_RESET}" >&2
        usage
        exit 1
        ;;
esac
