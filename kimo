# Command: tunnel
# First-class management and monitoring for the remote Ollama SSH tunnel.
# -----------------------------------------------------------------------------
tunnel_usage() {
    cat <<EOF
${C_BOLD}kimo tunnel${C_RESET} - Remote Ollama SSH tunnel management and health

${C_YELLOW}Usage:${C_RESET}
  ${0##*/} tunnel [status] [--json]
  ${0##*/} tunnel start [user@host]
  ${0##*/} tunnel stop
  ${0##*/} tunnel restart [user@host]
  ${0##*/} tunnel logs [-n lines]
  ${0##*/} tunnel setup [user@host]

${C_YELLOW}Subcommands:${C_RESET}
  ${C_CYAN}status${C_RESET}      Show tunnel service state, port 11438 binding, target host and latency (default)
  ${C_CYAN}start${C_RESET}       Start the tunnel service (systemd ollama-remote-tunnel or standalone SSH)
  ${C_CYAN}stop${C_RESET}        Stop the tunnel service and kill active port 11438 forwards
  ${C_CYAN}restart${C_RESET}     Restart the tunnel service
  ${C_CYAN}logs${C_RESET}        Show recent journald logs for ollama-remote-tunnel.service
  ${C_CYAN}setup${C_RESET}       Generate/inspect systemd unit template for persistent remote GPU forwarding

${C_YELLOW}Options:${C_RESET}
  ${C_CYAN}--json${C_RESET}      Output status in machine-readable JSON
  ${C_CYAN}-n, --lines${C_RESET} Number of log lines to show (default: 30)
  ${C_CYAN}-h, --help${C_RESET}  Show this help message
EOF
}

cmd_tunnel() {
    local subcmd="status"
    local opt_json="${OPT_JSON:-false}"
    local log_lines=30
    local target_host=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            status|start|stop|restart|logs|setup)
                subcmd="$1"
                shift
                if [[ "${subcmd}" == "start" || "${subcmd}" == "restart" || "${subcmd}" == "setup" ]]; then
                    if [[ $# -gt 0 && "$1" != -* ]]; then
                        target_host="$1"
                        shift
                    fi
                fi
                ;;
            --json)
                opt_json=true
                shift
                ;;
            -n|--lines)
                require_value "$@"
                log_lines="$2"
                shift 2
                ;;
            -h|--help|help)
                tunnel_usage
                return 0
                ;;
            *)
                if [[ "$1" == -* ]]; then
                    echo "${C_RED}Error: unknown option $1${C_RESET}" >&2
                    tunnel_usage
                    return 1
                elif [[ -z "${target_host}" && ( "${subcmd}" == "start" || "${subcmd}" == "restart" || "${subcmd}" == "setup" ) ]]; then
                    target_host="$1"
                    shift
                else
                    echo "${C_RED}Error: unknown argument '$1'${C_RESET}" >&2
                    tunnel_usage
                    return 1
                fi
                ;;
        esac
    done

    local tunnel_unit="ollama-remote-tunnel.service"
    local tunnel_port="11438"
    local tunnel_url="${KIMO_REMOTE_TUNNEL_URL:-http://127.0.0.1:11438}"

    case "${subcmd}" in
        status)
            local svc_active="unknown" svc_entered="" svc_pid=""
            if command -v systemctl >/dev/null 2>&1; then
                svc_active=$(systemctl is-active "${tunnel_unit}" 2>/dev/null) || svc_active="inactive"
                svc_entered=$(systemctl show "${tunnel_unit}" -p ActiveEnterTimestamp --value 2>/dev/null) || svc_entered=""
                svc_pid=$(systemctl show "${tunnel_unit}" -p MainPID --value 2>/dev/null) || svc_pid=""
                [[ "${svc_pid}" == "0" ]] && svc_pid=""
            fi

            local port_listening=false
            if timeout 1 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/${tunnel_port}" 2>/dev/null; then
                port_listening=true
            fi

            local detected_target="" detected_pid=""
            detected_target=$(_detect_tunnel_target "${tunnel_port}") || detected_target=""
            if [[ -z "${svc_pid}" ]]; then
                for c in /proc/[0-9]*/cmdline; do
                    [[ -f "${c}" ]] || continue
                    if grep -a -q ":${tunnel_port}:" "${c}" 2>/dev/null; then
                        local p="${c#/proc/}"
                        detected_pid="${p%/cmdline}"
                        break
                    fi
                done
            else
                detected_pid="${svc_pid}"
            fi

            local ep_reachable=false ep_version="unknown" ep_latency_ms="-" ep_models="[]"
            local probe_out
            probe_out=$(mktemp) || return 1
            local t_start t_end
            t_start=$(date +%s%N 2>/dev/null || date +%s)
            local http_code
            http_code=$(curl -s -m 2 -o "${probe_out}" -w '%{http_code}' "${tunnel_url%/}/api/version" 2>/dev/null) || http_code="000"
            t_end=$(date +%s%N 2>/dev/null || date +%s)

            if [[ "${http_code}" == "200" ]]; then
                ep_reachable=true
                ep_version=$(jq -r '.version // "unknown"' "${probe_out}" 2>/dev/null) || ep_version="unknown"
                if [[ ${#t_start} -gt 10 && ${#t_end} -gt 10 ]]; then
                    ep_latency_ms=$(( (t_end - t_start) / 1000000 ))
                else
                    ep_latency_ms="<1000"
                fi
                local ps_code
                ps_code=$(curl -s -m 2 -o "${probe_out}" -w '%{http_code}' "${tunnel_url%/}/api/ps" 2>/dev/null) || ps_code="000"
                if [[ "${ps_code}" == "200" ]]; then
                    ep_models=$(jq -c '.models // []' "${probe_out}" 2>/dev/null) || ep_models="[]"
                fi
            fi
            rm -f "${probe_out}"

            if ${opt_json} || [[ "${OPT_JSON:-false}" == "true" ]]; then
                jq -n \
                    --arg service "${tunnel_unit}" \
                    --arg service_state "${svc_active}" \
                    --arg service_entered "${svc_entered:--}" \
                    --argjson service_pid "${detected_pid:-null}" \
                    --argjson port "${tunnel_port}" \
                    --argjson listening "${port_listening}" \
                    --arg target "${detected_target:--}" \
                    --arg url "${tunnel_url}" \
                    --argjson reachable "${ep_reachable}" \
                    --arg version "${ep_version}" \
                    --arg latency "${ep_latency_ms}" \
                    --argjson resident_models "${ep_models}" \
                    '{
                        service: $service,
                        service_state: $service_state,
                        service_entered: $service_entered,
                        pid: $service_pid,
                        port: $port,
                        listening: $listening,
                        target_host: $target,
                        endpoint: {
                            url: $url,
                            reachable: $reachable,
                            version: $version,
                            latency_ms: $latency
                        },
                        resident_models: $resident_models
                    }'
                return 0
            fi

            echo "${C_BOLD}Remote Ollama SSH Tunnel Status${C_RESET}"
            echo "----------------------------------------------------"
            local st_badge
            if [[ "${svc_active}" == "active" ]]; then
                st_badge="${C_GREEN}active${C_RESET}"
            elif [[ "${svc_active}" == "unknown" ]]; then
                st_badge="${C_DIM}not managed by systemd${C_RESET}"
            else
                st_badge="${C_YELLOW}${svc_active}${C_RESET}"
            fi
            printf "  %-18s : %s\n" "Service Unit" "${tunnel_unit} (${st_badge})"
            [[ -n "${svc_entered}" ]] && printf "  %-18s : %s\n" "Active Since" "${svc_entered}"
            [[ -n "${detected_pid}" ]] && printf "  %-18s : %s\n" "Process PID" "${detected_pid}"

            local port_badge
            if ${port_listening}; then
                port_badge="${C_GREEN}LISTENING${C_RESET}"
            else
                port_badge="${C_RED}CLOSED${C_RESET}"
            fi
            printf "  %-18s : 127.0.0.1:%s (%s)\n" "Local Port" "${tunnel_port}" "${port_badge}"
            printf "  %-18s : %s\n" "Detected Target" "${detected_target:-none / unforwarded}"
            printf "  %-18s : %s\n" "Tunnel URL" "${tunnel_url}"

            local reach_badge
            if ${ep_reachable}; then
                reach_badge="${C_GREEN}ONLINE${C_RESET} (v${ep_version}, latency: ${ep_latency_ms}ms)"
            else
                reach_badge="${C_RED}OFFLINE / UNREACHABLE${C_RESET}"
            fi
            printf "  %-18s : %s\n" "Remote Daemon" "${reach_badge}"

            if [[ "${ep_models}" != "[]" ]]; then
                local res_names
                res_names=$(echo "${ep_models}" | jq -r '.[].name' 2>/dev/null | tr '\n' ' ' | sed 's/ $//')
                printf "  %-18s : %s\n" "Resident Models" "${res_names:-none}"
            fi

            if ! ${port_listening} && [[ "${svc_active}" != "active" ]]; then
                echo ""
                echo "${C_YELLOW}[!] Tunnel is inactive. To start:${C_RESET}"
                echo "    kimo tunnel start [user@host]"
                echo "    or: sudo systemctl start ${tunnel_unit}"
            fi
            ;;
        start)
            if [[ -n "${target_host}" ]]; then
                if timeout 1 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/${tunnel_port}" 2>/dev/null; then
                    echo "${C_YELLOW}[!] Port ${tunnel_port} is already listening. Stop existing tunnel first or run 'kimo tunnel status'.${C_RESET}" >&2
                    return 1
                fi
                echo "[*] Spawning background SSH tunnel: 127.0.0.1:${tunnel_port} -> ${target_host}:11434..."
                if ssh -f -N -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -L "${tunnel_port}:127.0.0.1:11434" "${target_host}"; then
                    sleep 1
                    if timeout 1 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/${tunnel_port}" 2>/dev/null; then
                        echo "${C_GREEN}[✓] SSH tunnel successfully established to ${target_host}.${C_RESET}"
                    else
                        echo "${C_YELLOW}[!] Tunnel started, but port ${tunnel_port} is not yet reachable. Check SSH keys/firewall.${C_RESET}"
                    fi
                else
                    echo "${C_RED}Error: Failed to launch SSH tunnel to ${target_host}.${C_RESET}" >&2
                    return 1
                fi
            elif command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files "${tunnel_unit}" >/dev/null 2>&1; then
                echo "[*] Starting ${tunnel_unit} via systemctl..."
                if systemctl start "${tunnel_unit}"; then
                    sleep 1
                    cmd_tunnel status
                else
                    echo "${C_RED}Error: Failed to start ${tunnel_unit}. Check 'kimo tunnel logs'.${C_RESET}" >&2
                    return 1
                fi
            else
                echo "${C_YELLOW}[!] Systemd unit ${tunnel_unit} not installed.${C_RESET}" >&2
                echo "To launch directly, provide your remote host: kimo tunnel start <user@host>"
                echo "To install systemd service, run: kimo tunnel setup <user@host>"
                return 1
            fi
            ;;
        stop)
            local stopped=false
            if command -v systemctl >/dev/null 2>&1 && systemctl is-active "${tunnel_unit}" >/dev/null 2>&1; then
                echo "[*] Stopping ${tunnel_unit}..."
                systemctl stop "${tunnel_unit}" 2>/dev/null || true
                stopped=true
            fi
            for c in /proc/[0-9]*/cmdline; do
                [[ -f "${c}" ]] || continue
                if grep -a -q ":${tunnel_port}:" "${c}" 2>/dev/null; then
                    local p="${c#/proc/}"
                    local pid="${p%/cmdline}"
                    if [[ -n "${pid}" && "${pid}" =~ ^[0-9]+$ ]]; then
                        echo "[*] Terminating SSH tunnel process PID ${pid}..."
                        kill -15 "${pid}" 2>/dev/null || true
                        stopped=true
                    fi
                fi
            done
            sleep 1
            if timeout 1 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/${tunnel_port}" 2>/dev/null; then
                echo "${C_YELLOW}[!] Port ${tunnel_port} is still open.${C_RESET}" >&2
            elif ${stopped}; then
                echo "${C_GREEN}[✓] Remote tunnel stopped; port ${tunnel_port} closed.${C_RESET}"
            else
                echo "${C_DIM}[·] No tunnel was running; port ${tunnel_port} is closed.${C_RESET}"
            fi
            ;;
        restart)
            cmd_tunnel stop
            sleep 1
            if [[ -n "${target_host}" ]]; then
                cmd_tunnel start "${target_host}"
            else
                cmd_tunnel start
            fi
            ;;
        logs)
            if command -v journalctl >/dev/null 2>&1; then
                journalctl -u "${tunnel_unit}" -n "${log_lines}" --no-pager
            else
                echo "${C_RED}Error: journalctl not found on this system.${C_RESET}" >&2
                return 1
            fi
            ;;
        setup)
            local host_target="${target_host:-<user@remote-gpu-host>}"
            cat <<EOF
${C_BOLD}Remote Ollama SSH Tunnel Setup Guide${C_RESET}
----------------------------------------------------
To keep a persistent, auto-restarting SSH tunnel from 127.0.0.1:11438 to
the remote Ollama host (port 11434), install the following systemd service:

${C_CYAN}/etc/systemd/system/${tunnel_unit}${C_RESET}
[Unit]
Description=Ollama Remote SSH Tunnel (11438 -> remote 11434)
After=network.target

[Service]
Type=simple
User=${USER:-root}
ExecStart=/usr/bin/ssh -NT -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -L 11438:127.0.0.1:11434 ${host_target}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

${C_BOLD}Commands to enable and start:${C_RESET}
  sudo systemctl daemon-reload
  sudo systemctl enable --now ${tunnel_unit}
  kimo tunnel status
EOF
            ;;
    esac
}

