        *)
            echo "${C_RED}Error: Unknown CLI '${cli}'.${C_RESET}" >&2
            echo "Supported CLIs: kimi, claude, grok, codex, qwen, opencode, cyberstrike, openclaw, hermes, agy, all" >&2
            return 1
            ;;
    esac
}

