_agy_latest_version() {
    local base="https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests"
    local os arch slug
    case "$(uname -s)" in
        Darwin) os="darwin" ;;
        Linux)
            if [[ "$(uname -o 2>/dev/null)" == "Android" ]]; then os="android"; else os="linux"; fi
            ;;
        *) return 0 ;;
    esac
    case "$(uname -m)" in
        x86_64|amd64) arch="amd64" ;;
        arm64|aarch64) arch="arm64" ;;
        *) return 0 ;;
    esac
    slug="${os}_${arch}"
    if [[ "${os}" == "linux" ]] && { [[ -f /lib/libc.musl-x86_64.so.1 ]] || [[ -f /lib/libc.musl-aarch64.so.1 ]] || ldd /bin/ls 2>&1 | grep -q musl; }; then
        slug="${slug}_musl"
    fi
    curl -fsSL --connect-timeout 2 -m 4 "${base}/${slug}.json" 2>/dev/null \
        | grep -oE '"version"[[:space:]]*:[[:space:]]*"[0-9][0-9A-Za-z._-]*"' \
        | grep -oE '[0-9][0-9A-Za-z._-]*' | head -n 1 || true
}

_bounded_update_lookup() {
    python3 - "$@" <<'PY'
import subprocess, sys
try:
    result = subprocess.run(sys.argv[1:], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, timeout=10, check=True)
    print(result.stdout.strip())
except (OSError, subprocess.SubprocessError, UnicodeError):
    sys.exit(1)
PY
}

_get_cli_latest_version() {
    local cmd="$1"
    local latest=""
    case "${cmd}" in
        gh) latest=$(_gh_latest_version 2>/dev/null || true) ;;
        claude)
            latest=$(_bounded_update_lookup npm view @anthropic-ai/claude-code version 2>/dev/null || true)
            ;;
        codex)
            latest=$(_bounded_update_lookup npm view @openai/codex version 2>/dev/null || _bounded_update_lookup npm view codex version 2>/dev/null || true)
            ;;
        qwen)
            latest=$(_bounded_update_lookup npm view @qwen-code/qwen-code version 2>/dev/null || true)
            ;;
        grok)
            latest=$(_bounded_update_lookup grok update --check 2>/dev/null | grep -oE 'latest: [0-9A-Za-z.+-]+' | awk '{print $2}' || true)
            ;;
        kimi)
            latest=$(curl -fsSL --connect-timeout 2 -m 4 https://code.kimi.com/kimi-code/latest 2>/dev/null | tr -d ' \r\n' || true)
            ;;
        opencode)
            latest=$(_bounded_update_lookup npm view opencode-ai version 2>/dev/null || true)
            ;;
        openclaw)
            latest=$(_bounded_update_lookup npm view openclaw version 2>/dev/null || true)
            ;;
        hermes)
            latest=$(_bounded_update_lookup npm view hermes-agent version 2>/dev/null || true)
            ;;
        agy)
            # Version feed: the release manifest served alongside the official
            # install script (same host the bootstrapper downloads from).
            latest=$(_agy_latest_version)
            ;;
        cyberstrike)
            latest=$(curl -fsSL --connect-timeout 2 -m 4 https://api.github.com/repos/CyberStrikeus/CyberStrike/releases/latest 2>/dev/null | grep -oE '"tag_name": *"v[0-9.]+"' | grep -oE '[0-9.]+' | head -n 1 || true)
            ;;
        cursor)
            latest=$(curl -fsSL --connect-timeout 2 -m 4 https://cursor.com/install 2>/dev/null | grep -oE '[0-9]{4}\.[0-9]{2}\.[0-9]{2}(-[a-f0-9]+)?' | head -n 1 || true)
            ;;
    esac
    echo "${latest:-}"
}

_compare_cli_versions() {
    python3 - "$1" "$2" "$3" <<'PY'
import datetime, re, sys
cli, current, latest = sys.argv[1:]
def parse(value):
    m = re.fullmatch(r'(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:\.(0|[1-9][0-9]*))?(?:-([0-9A-Za-z.-]+))?(?:\+([0-9A-Za-z.-]+))?', value)
    if not m:
        raise ValueError()
    major, minor, patch, pre, build = m.groups()
    for suffix in (pre, build):
        if suffix is not None and any(not part for part in suffix.split('.')):
            raise ValueError()
    parts = []
    if pre is not None:
        for part in pre.split('.'):
            if part.isdigit():
                if len(part) > 1 and part.startswith('0'):
                    raise ValueError()
                parts.append((0, int(part)))
            else:
                parts.append((1, part))
    return (int(major), int(minor), int(patch or 0)), pre is None, parts
try:
    if cli == 'cursor':
        pattern = r'(\d{4})\.(\d{2})\.(\d{2})(?:-([0-9A-Za-z.-]+))?'
        a, b = re.fullmatch(pattern, current), re.fullmatch(pattern, latest)
        if not a or not b:
            raise ValueError()
        x, y = [datetime.date(*map(int, m.groups()[:3])) for m in (a, b)]
        if x == y and current != latest:
            raise ValueError()
    else:
        x, y = parse(current), parse(latest)
    print('update available' if x < y else 'ahead' if x > y else 'up to date')
except ValueError:
    print('lookup failed/unknown')
PY
}

_update_cli_binary() {
    local cli="$1" bin
    if [[ "${cli}" == cursor ]]; then
        for bin in cursor cursor-agent agent; do
            if command -v "${bin}" >/dev/null 2>&1; then echo "${bin}"; return 0; fi
        done
        return 1
    fi
    bin="${EXTERNAL_CLI_MAP[$cli]:-$cli}"
    command -v "${bin}" >/dev/null 2>&1 || return 1
    echo "${bin}"
}

_process_present_cli_updates() {
    local apply="$1" target="${2:-all}"
    local clis=(claude codex qwen grok kimi cursor opencode cyberstrike agy openclaw hermes gh)
    [[ "${target}" != all ]] && clis=("${target}")
    local c bin current latest state after
    local present=0 available=0 skipped=0 unknown=0 attempts=0 verified=0 failures=0
    printf '  %-12s %-24s %-24s %s\n' CLI CURRENT LATEST STATUS
    for c in "${clis[@]}"; do
        if ! bin=$(_update_cli_binary "${c}"); then
            if [[ "${target}" != all ]]; then
                echo "${c} is not installed; use '${0##*/} install ${c}'." >&2
                return 1
            fi
            continue
        fi
        present=$((present + 1))
        current=$(_get_cli_version "${bin}")
        latest=$(_get_cli_latest_version "${c}")
        state=$(_compare_cli_versions "${c}" "${current}" "${latest}")
        state="${state:-lookup failed/unknown}"
        printf '  %-12s %-24s %-24s %s\n' "${c}" "${current}" "${latest:--}" "${state}"
        if [[ "${state}" != 'update available' ]]; then
            skipped=$((skipped + 1))
            [[ "${state}" == 'lookup failed/unknown' ]] && unknown=$((unknown + 1))
            continue
        fi
        available=$((available + 1))
        [[ "${apply}" == true ]] || continue
        attempts=$((attempts + 1))
        if _install_single_cli "${c}" false true; then
            after=$(_get_cli_version "${bin}")
            if [[ "$(_compare_cli_versions "${c}" "${current}" "${after}")" == 'update available' ]]; then
                verified=$((verified + 1))
                echo "${c}: verified upgrade ${current} -> ${after}"
                continue
            fi
            echo "${c}: updater exited successfully, but upgrade could not be verified." >&2
        else
            echo "${c}: update failed." >&2
        fi
        failures=$((failures + 1))
    done
    echo "Summary: ${present} present, ${available} available, ${skipped} skipped (${unknown} unknown), ${attempts} attempted, ${verified} verified, ${failures} failed."
    if ((present == 0)); then
        echo "No external CLIs currently installed in PATH; use '${0##*/} install <name>'."
    fi
    ((failures == 0))
}

_check_updates_for_present_clis() { _process_present_cli_updates false "${1:-all}"; }
_update_all_present() { _process_present_cli_updates true "${1:-all}"; }

update_usage() {
    cat <<EOF
${C_BOLD}kimo update${C_RESET} – Check and apply updates for installed external CLIs

${C_YELLOW}Usage:${C_RESET}
  ${0##*/} update [cli|all] [options]

${C_YELLOW}Arguments:${C_RESET}
  ${C_CYAN}[none]${C_RESET}       Check for updates across only the CLIs currently installed (read-only audit)
  ${C_CYAN}<cli>${C_RESET}        Apply a confirmed newer release to an installed CLI
  ${C_CYAN}all${C_RESET}          Apply only confirmed newer releases to installed CLIs
  Equal, locally newer, and unknown versions are skipped; missing CLIs require install.

${C_YELLOW}Options:${C_RESET}
  ${C_CYAN}-y, --apply${C_RESET}   Apply available updates to all installed CLIs
  ${C_CYAN}-c, --check${C_RESET}   Check for updates without installing (default behavior when no CLI is specified)
  ${C_CYAN}--allow-system-path${C_RESET}  Only with named gh: update an owned standalone PATH executable in place
  ${C_CYAN}-h, --help${C_RESET}    Show this help message
  GitHub CLI rejects package-owned files, symlinks (including parents), and unowned/unwritable directories.
  No sudo or shadowing; keeps a backup and rolls back if installed-version verification fails.

${C_YELLOW}Examples:${C_RESET}
  ${0##*/} update             # Check updates for all present CLIs
  ${0##*/} update qwen --check # Read-only check of one CLI (flags may precede target)
  ${0##*/} update all --check  # Read-only check; cannot combine --check and --apply
  ${0##*/} update qwen        # Update only Qwen Code CLI when confirmed newer
  ${0##*/} update agy         # Update Antigravity CLI with its native updater
  ${0##*/} update gh          # Update user-local GitHub CLI; package-managed gh must use its package manager
  ${0##*/} update gh --allow-system-path # Opt in to standalone /usr/local/bin/gh (when owned/writable)
  ${0##*/} update gh --allow-system-path --check # Read-only eligibility and release check
  ${0##*/} update --apply     # Update all installed CLIs with available updates
EOF
}

cmd_update() {
    local target=""
    local opt_apply=false opt_check=false gh_allow_system_path=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help|help) update_usage; return 0 ;;
            --apply|-y|--yes) opt_apply=true ;;
            --check|-c|check) opt_check=true ;;
            --allow-system-path) gh_allow_system_path=true ;;
            -*) echo "Error: unknown update option: $1" >&2; return 1 ;;
            *)
                [[ -z "${target}" ]] || { echo "Error: only one update target is allowed." >&2; return 1; }
                target="$1"
                ;;
        esac
        shift
    done
    if ${opt_check} && ${opt_apply}; then
        echo "Error: --check and --apply cannot be combined." >&2
        return 1
    fi
    case "${target}" in
        kimi-code) target=kimi ;; claude-code) target=claude ;;
        grok-cli) target=grok ;; qwen-code) target=qwen ;;
        antigravity) target=agy ;; cursor-agent|agent) target=cursor ;;
    esac
    case "${target}" in
        ''|all|claude|codex|qwen|grok|kimi|cursor|opencode|cyberstrike|agy|openclaw|hermes|gh) ;;
        *) echo "Error: unsupported update target: ${target}" >&2; return 1 ;;
    esac
    if ${gh_allow_system_path}; then
        [[ "${target}" == gh ]] || {
            echo "Error: --allow-system-path is only valid for the named 'update gh' target, not batch updates." >&2; return 1
        }
        local gh_path
        gh_path=$(type -P gh 2>/dev/null) || {
            echo "Error: --allow-system-path requires an existing GitHub CLI in PATH." >&2; return 1
        }
        _gh_check_destination "${gh_path}" true || return 1
        if ${opt_check}; then
            echo "GitHub CLI at ${gh_path} is eligible for an in-place update (--check: no files changed)."
        fi
    fi
    if ${opt_check} || { [[ -z "${target}" ]] && ! ${opt_apply}; }; then
        _check_updates_for_present_clis "${target:-all}"
    else
        _update_all_present "${target:-all}"
    fi
}

