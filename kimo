                local cs_tar="cyberstrike-${os}-${arch}.tar.gz"
                local dl_url="https://github.com/CyberStrikeus/CyberStrike/releases/download/v${cs_ver}/${cs_tar}"
                local tmp_dir
                tmp_dir=$(mktemp -d 2>/dev/null || echo "/tmp/cyberstrike-install")
                mkdir -p "${tmp_dir}"
                if curl -fsSL "${dl_url}" -o "${tmp_dir}/${cs_tar}" 2>/dev/null && tar -xzf "${tmp_dir}/${cs_tar}" -C "${tmp_dir}" 2>/dev/null; then
                    local target_dir="/usr/local/bin"
