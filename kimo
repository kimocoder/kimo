#!/usr/bin/env bash
# kimo – Unified manager for local and remote Ollama instances & external LLM CLIs.
# Utility for managing models, VRAM, and CLI routing in the Kalidroid environment.
# -----------------------------------------------------------------------------------

set -euo pipefail

# Remote server configuration
# NOTE: 192.168.1.131 binds ollama to 127.0.0.1:11434 only, so direct LAN
# connections are refused by design. The reachable path from this host is the
# SSH tunnel (ollama-remote-tunnel.service):
#   127.0.0.1:11438 -> 127.0.0.1:11434 on 192.168.1.131
# Resolution order: $OLLAMA_REMOTE_URL > tunnel > direct. Probing uses a short
# timeout so --help / local-only commands never hang.
REMOTE_HOST_IP="192.168.1.131"
REMOTE_HOST_PORT="11434"
REMOTE_DIRECT_URL="http://${REMOTE_HOST_IP}:${REMOTE_HOST_PORT}"
REMOTE_TUNNEL_URL="http://127.0.0.1:11438"
REMOTE_DAEMON_URL="http://${REMOTE_HOST_IP}:11436"
REMOTE_HOST_URL="${OLLAMA_REMOTE_URL:-${REMOTE_TUNNEL_URL}}"
LOCAL_HOST_URL="${OLLAMA_LOCAL_URL:-http://127.0.0.1:11434}"

# Per-model tuned defaults baked into run/launch. Keyed by exact resolved model
# name; values mirror Ollama request option names (num_ctx/num_batch/...).
# Written by 'tune', consumed by 'run' and 'launch'.
TUNINGS_FILE="/var/lib/ollama/tunings.json"

# Map of default models for external CLIs and native Ollama runs
declare -A DEFAULT_MODELS=(
    ["claude"]="kalidroid-27b:latest"
    ["qwen"]="qwen3.8:latest"
    ["llama3"]="llama3.2:3b-text-fp16"
    ["codex"]="kalidroid-27b:latest"
    ["opencode"]="kalidroid-27b:latest"
    ["hermes"]="kalidroid-27b:latest"
    ["openclaw"]="kalidroid-27b:latest"
    ["agy"]="kalidroid-27b:latest"
    ["grok"]="kalidroid-27b:latest"
    ["kimi"]="kalidroid-27b:latest"
)

# Map of external CLI binary names
declare -A EXTERNAL_CLI_MAP=(
    ["claude"]="claude"
    ["codex"]="codex"
    ["qwen"]="qwen"
    ["opencode"]="opencode"
    ["hermes"]="hermes"
    ["openclaw"]="openclaw"
    ["agy"]="agy"
    ["grok"]="grok"
    ["kimi"]="kimi"
)

# grok installs into ~/.grok/bin and reaches PATH only through ~/.bashrc, which a
# non-interactive caller (cron, systemd, Apache, sh -c) never sources. Without
# this the 'command -v' gate in cmd_launch misses the binary and silently
# degrades to 'ollama run' instead of launching grok.
GROK_BIN_DIR="${GROK_BIN_DIR:-${HOME:-/root}/.grok/bin}"
if [[ -x "${GROK_BIN_DIR}/grok" && ":${PATH}:" != *":${GROK_BIN_DIR}:"* ]]; then
    PATH="${GROK_BIN_DIR}:${PATH}"
    export PATH
fi

# kimi (Kimi Code CLI) installs into ~/.kimi-code/bin; same non-interactive PATH
# hazard as grok, so the 'command -v' gate in cmd_launch can find it everywhere.
KIMI_BIN_DIR="${KIMI_BIN_DIR:-${HOME:-/root}/.kimi-code/bin}"
if [[ -x "${KIMI_BIN_DIR}/kimi" && ":${PATH}:" != *":${KIMI_BIN_DIR}:"* ]]; then
    PATH="${KIMI_BIN_DIR}:${PATH}"
    export PATH
fi

# Terminal color initialization
setup_colors() {
    if [[ -t 1 && "${NO_COLOR:-0}" != "1" && "${FORCE_NO_COLOR:-false}" != "true" ]]; then
        C_RESET=$'\033[0m'
        C_BOLD=$'\033[1m'
        C_DIM=$'\033[2m'
        C_RED=$'\033[0;31m'
        C_GREEN=$'\033[0;32m'
        C_YELLOW=$'\033[0;33m'
        C_BLUE=$'\033[0;34m'
        C_MAGENTA=$'\033[0;35m'
        C_CYAN=$'\033[0;36m'
        C_WHITE=$'\033[1;37m'
    else
        C_RESET=""
        C_BOLD=""
        C_DIM=""
        C_RED=""
        C_GREEN=""
        C_YELLOW=""
        C_BLUE=""
        C_MAGENTA=""
        C_CYAN=""
        C_WHITE=""
    fi
}

usage() {
    cat <<EOF
${C_BOLD}kimo (Ollama Manager)${C_RESET} – Unified Local & Remote Model Management & External CLI Hub

${C_YELLOW}Usage:${C_RESET}
  ${0##*/} [options] <command> [arguments...]

${C_YELLOW}Global Options:${C_RESET}
  --remote                 Connect to remote server (${REMOTE_TUNNEL_URL} tunnel -> 192.168.1.131; \$OLLAMA_REMOTE_URL overrides)
  --local                  Connect strictly to local daemon (${LOCAL_HOST_URL}; \$OLLAMA_LOCAL_URL overrides)
  --host <address>         Specify a custom Ollama host (e.g. 127.0.0.1:11438)
                           Combine with --local to set the local daemon address (--local --host 127.0.0.1:11436),
                           or with --remote to set the remote address. --local --remote targets both.
                           Repeat --host to target several hosts: check/hosts/ps/list/search/stop/info query all,
                           model commands (run/warm/rm/tag/launch...) go to the first host that has the model.
  --json                   Output responses in structured JSON format
  --no-color               Disable colored terminal output
  -h, --help               Show this help message

${C_YELLOW}Commands:${C_RESET}
  ${C_CYAN}list [filter]${C_RESET}            List all installed models (local & remote). Highlights active VRAM models.
  ${C_CYAN}search <keyword>${C_RESET}         Keyword search across local & remote catalogs (name/params/capabilities); marks pinned/tuned.
  ${C_CYAN}ps${C_RESET}                    Display all models currently resident in GPU/CPU VRAM with memory stats.
  ${C_CYAN}status, health${C_RESET}       Snapshot: tunnel, remote API, VRAM residency, keepalive timer, public endpoint.
  ${C_CYAN}status-report${C_RESET}        Append the status snapshot to /var/log/ollama-status-report.log.
  ${C_CYAN}logs [tunnel|keepalive|timer|apache|all]${C_RESET}  Show recent journald output for the ops services.
  ${C_CYAN}rotate-token${C_RESET}         Generate a new public API token, regenerate the proxy conf, reload Apache (backup in ollama-api.token.bk).
  ${C_CYAN}stop, unload [model|all]${C_RESET} Free GPU VRAM immediately by unloading active models (keep_alive: 0).
  ${C_CYAN}warm, preload <model> [dur]${C_RESET} Pre-warm model into GPU VRAM (keep_alive: 24h) to eliminate cold-start.
  ${C_CYAN}check, ping${C_RESET}              Run connectivity, latency, and health check for local and remote hosts.
  ${C_CYAN}hosts${C_RESET}                    One row per server: host, port, state, version, models, disk GB, source.
                           ssh -L tunnels are merged with the server they reach; no --host = discover.
  ${C_CYAN}info, show <model>${C_RESET}       Display detailed metadata (parameters, context, quant, capabilities).
  ${C_CYAN}tag, alias <src> <dst>${C_RESET}   Create a tag/alias for an existing model on target host.
  ${C_CYAN}rm, delete <model>${C_RESET}       Delete a model from the local or remote Ollama server.
  ${C_CYAN}stream <model> [opts]${C_RESET}  Pin remote model for durable availability (warm + keepalive; --pull for full local copy).
                                ${C_CYAN}stream --status${C_RESET} (dashboard), ${C_CYAN}stream --test${C_RESET} (smoke probe), ${C_CYAN}stream --resident-only${C_RESET}.
  ${C_CYAN}tune <model> [opts...]${C_RESET}  Bake per-model defaults (num_ctx, num_batch, num_predict, temp, num_gpu) into run/launch.
                                  --target <name> also creates a tuned variant via /api/create; --show / --clear for the registry.
  ${C_CYAN}bench, eval [model]${C_RESET}      Benchmark TTFT, generation tokens/sec throughput, and VRAM residency.
  ${C_CYAN}run <model> [args...]${C_RESET}    Run an Ollama model directly (auto-connects to remote if remote-only).
  ${C_CYAN}launch <cli> [opts...]${C_RESET}   Launch an external LLM CLI (claude, codex, qwen, grok, kimi, hermes, agy, etc.)
                           with automatic Ollama routing and model override (--model <name>).
                           agy speaks only the Gemini wire format, so a per-session shim is
                           started on a free localhost port and its modelProvider setting is
                           patched for the duration of the session, then restored on exit.
                           grok takes no endpoint flag; its catalog and inference are aimed at
                           the resolved host via GROK_MODELS_BASE_URL, so --model accepts real
                           Ollama tags. A tuned num_ctx (tune --ctx) also becomes that model's
                           context_window in config.toml for the session, reverted on exit.
                           kimi (Kimi Code CLI) registers an additive, idempotent provider +
                           model alias in ~/.kimi-code/config.toml for the resolved host (same
                           pattern as its other custom providers; nothing is reverted on exit)
                           and launches with -m <alias>. Tuned num_ctx (capped at the probed
                           runtime num_ctx, so kimi's 85% auto-compaction always fires before
                           Ollama would truncate history) becomes max_context_size; Ollama's
                           reported
                           capabilities (thinking/tools/vision) are mapped; thinking models
                           declare support_efforts low..max + off_effort none, so the
                           in-session /effort picker works and reaches the wire as
                           reasoning_effort (Ollama's non-standard 'reasoning' field is mapped
                           via reasoning_key). Overrides: KIMO_KIMI_EFFORT / OM_KIMI_EFFORT (default effort),
                           KIMO_KIMI_EFFORTS / OM_KIMI_EFFORTS, KIMO_KIMI_CAPABILITIES / OM_KIMI_CAPABILITIES,
                           KIMO_KIMI_REASONING_KEY / OM_KIMI_REASONING_KEY.
                           Without python3-tomlkit it falls back to the KIMI_MODEL_* env
                           channel: zero footprint, but /effort is limited to on/off and the
                           graded effort must be set at launch via KIMO_KIMI_EFFORT=xhigh (or OM_KIMI_EFFORT).

${C_YELLOW}Examples:${C_RESET}
  ${0##*/} check
  ${0##*/} status
  ${0##*/} list nemotron
  ${0##*/} ps
  ${0##*/} stop nemotron3:latest
  ${0##*/} info nemotron3:33b
  ${0##*/} stream nemotron-3.5-lightning:latest
  ${0##*/} stream --status
  ${0##*/} stream --test
  ${0##*/} stream --all
  ${0##*/} --remote launch claude --model nemotron3:33b
  ${0##*/} launch codex --model kalidroid-27b:latest
  ${0##*/} launch grok --model kalidroid-27b:latest
  ${0##*/} --remote launch kimi --model kalidroid-27b:latest
  ${0##*/} --remote launch grok --model nemotron3:33b
  ${0##*/} tune kalidroid-27b:latest --ctx 32768   # launch grok then honors it
  ${0##*/} --remote tag nemotron3:33b nemotron3:latest
  ${0##*/} --local --host 127.0.0.1:11436 check
  ${0##*/} --local --remote list
  ${0##*/} --host 127.0.0.1:11436 --host 192.168.1.131:11436 check
  ${0##*/} --host 127.0.0.1:11434 --host 127.0.0.1:11438 --host 192.168.1.131 hosts
EOF
}

# -----------------------------------------------------------------------------
# Global Option Parsing (Permits flags anywhere on command line)
# -----------------------------------------------------------------------------
OPT_REMOTE=false
OPT_LOCAL=false
OPT_HOST=""
OPT_HOSTS=()
OPT_JSON=false
FORCE_NO_COLOR=false
POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --remote)
            OPT_REMOTE=true
            shift
            ;;
        --local)
            OPT_LOCAL=true
            shift
            ;;
        --host)
            shift
            if [[ -z "${1:-}" ]]; then
                echo "Error: --host requires an address argument." >&2
                exit 1
            fi
            OPT_HOSTS+=("$1")
            shift
            ;;
        --host=*)
            OPT_HOSTS+=("${1#*=}")
            shift
            ;;
        --json)
            OPT_JSON=true
            shift
            ;;
        --no-color)
            FORCE_NO_COLOR=true
            shift
            ;;
        -h|--help)
            if [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]]; then
                setup_colors
                usage
                exit 0
            else
                POSITIONAL_ARGS+=("$1")
                shift
            fi
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

setup_colors

if [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]]; then
    usage
    exit 1
fi

COMMAND="${POSITIONAL_ARGS[0]}"
ARGS=("${POSITIONAL_ARGS[@]:1}")

# Resolve which remote URL is actually reachable (tunnel-first).
# Honors $OLLAMA_REMOTE_URL when set. Falls back to the tunnel default even
# when nothing answers so callers always have a stable value to report.
probe_ollama_url() {
    # -f: a 401 from a bridge that now requires a token is not "reachable" -
    # accepting it made every remote model lookup fail and launch fall back to
    # the Pi, where a 27B load is refused or OOM-killed.
    curl -sf --connect-timeout 1 -m 2 "$1/api/tags" >/dev/null 2>&1
}
resolve_remote_url() {
    if [[ -n "${OLLAMA_REMOTE_URL:-}" ]]; then
        echo "${OLLAMA_REMOTE_URL}"
        return
    fi
    if probe_ollama_url "${REMOTE_TUNNEL_URL}"; then
        echo "${REMOTE_TUNNEL_URL}"
        return
    fi
    if probe_ollama_url "${REMOTE_DIRECT_URL}"; then
        echo "${REMOTE_DIRECT_URL}"
        return
    fi
    # The Desktop's own Ollama daemon (no bridge, no token; dashboard ep1 uses it).
    if probe_ollama_url "${REMOTE_DAEMON_URL}"; then
        echo "${REMOTE_DAEMON_URL}"
        return
    fi
    echo "${REMOTE_TUNNEL_URL}"
}

normalize_host_url() {
    local url="${1%/}"
    if [[ ! "${url}" =~ ^https?:// ]]; then
        url="http://${url}"
    fi
    if [[ ! "${url}" =~ :[0-9]+$ ]]; then
        url="${url}:11434"
    fi
    echo "${url}"
}

# --host may be repeated; normalize and de-duplicate, keeping the given order.
if [[ ${#OPT_HOSTS[@]} -gt 0 ]]; then
    declare -A _seen_hosts=()
    _norm_hosts=()
    for _h in "${OPT_HOSTS[@]}"; do
        _h="$(normalize_host_url "${_h}")"
        [[ -n "${_seen_hosts[${_h}]:-}" ]] && continue
        _seen_hosts[${_h}]=1
        _norm_hosts+=("${_h}")
    done
    OPT_HOSTS=("${_norm_hosts[@]}")
    OPT_HOST="${OPT_HOSTS[0]}"
fi
MULTI_HOSTS=""
[[ -n "${OLLAMA_LOCAL_URL:-}" ]] && LOCAL_HOST_URL="$(normalize_host_url "${OLLAMA_LOCAL_URL}")"

# Determine Active Target Host
# --host combined with --local/--remote redefines that side's address instead
# of replacing the mode, so local/remote labels and routing stay intact.
if [[ ${#OPT_HOSTS[@]} -gt 1 ]]; then
    if ${OPT_LOCAL} || ${OPT_REMOTE}; then
        echo "${C_RED}Error: multiple --host values cannot be combined with --local/--remote; use \$OLLAMA_LOCAL_URL / \$OLLAMA_REMOTE_URL.${C_RESET}" >&2
        exit 1
    fi
    TARGET_HOST=""
    HOST_MODE="multi"
    MULTI_HOSTS="${OPT_HOSTS[*]}"
elif ${OPT_LOCAL} && ${OPT_REMOTE}; then
    if [[ -n "${OPT_HOST}" ]]; then
        echo "${C_RED}Error: --host is ambiguous with both --local and --remote; use \$OLLAMA_LOCAL_URL / \$OLLAMA_REMOTE_URL.${C_RESET}" >&2
        exit 1
    fi
    TARGET_HOST=""
    HOST_MODE="auto"
    REMOTE_HOST_URL="$(resolve_remote_url)"
elif ${OPT_LOCAL} && [[ -n "${OPT_HOST}" ]]; then
    LOCAL_HOST_URL="${OPT_HOST}"
    TARGET_HOST="${LOCAL_HOST_URL}"
    HOST_MODE="local"
elif ${OPT_REMOTE} && [[ -n "${OPT_HOST}" ]]; then
    REMOTE_HOST_URL="${OPT_HOST}"
    TARGET_HOST="${REMOTE_HOST_URL}"
    HOST_MODE="remote"
    if ! probe_ollama_url "${TARGET_HOST}"; then
        echo "${C_YELLOW}[!] Remote ${TARGET_HOST} unreachable${C_RESET}" >&2
    fi
elif [[ -n "${OPT_HOST}" ]]; then
    TARGET_HOST="${OPT_HOST}"
    HOST_MODE="custom"
elif ${OPT_REMOTE}; then
    REMOTE_HOST_URL="$(resolve_remote_url)"
    TARGET_HOST="${REMOTE_HOST_URL}"
    HOST_MODE="remote"
    if ! probe_ollama_url "${TARGET_HOST}"; then
        echo "${C_YELLOW}[!] Remote ${TARGET_HOST} unreachable (tunnel ollama-remote-tunnel.service down?)${C_RESET}" >&2
    fi
elif ${OPT_LOCAL}; then
    TARGET_HOST="${LOCAL_HOST_URL}"
    HOST_MODE="local"
else
    TARGET_HOST=""
    HOST_MODE="auto"
    # In auto mode every command that touches the remote resolves it lazily via
    # $REMOTE_HOST_URL; refresh it here when it still points at the default so
    # a recovered direct path is picked up without an env override.
    if [[ "${REMOTE_HOST_URL}" == "${REMOTE_TUNNEL_URL}" || "${REMOTE_HOST_URL}" == "${REMOTE_DIRECT_URL}" ]]; then
        REMOTE_HOST_URL="$(resolve_remote_url)"
    fi
fi

# -----------------------------------------------------------------------------
# Helper Functions
# -----------------------------------------------------------------------------

# Resolve model name to its exact tag on target host (exact match, :latest, prefix, substring)
resolve_model_name() {
    local target="$1"
    local host_url="${2:-${LOCAL_HOST_URL}}"
    local tags
    tags=$(curl -s --connect-timeout 2 -m 4 "${host_url}/api/tags" 2>/dev/null) || return 1

    # 1. Exact match
    local match
    match=$(echo "${tags}" | jq -r --arg t "${target}" '.models[].name | select(. == $t)' 2>/dev/null | head -n1)
    if [[ -n "${match}" ]]; then
        echo "${match}"
        return 0
    fi

    # 2. Check :latest tag
    match=$(echo "${tags}" | jq -r --arg t "${target}:latest" '.models[].name | select(. == $t)' 2>/dev/null | head -n1)
    if [[ -n "${match}" ]]; then
        echo "${match}"
        return 0
    fi

    # 3. Check prefix match (e.g. nemotron3 -> nemotron3:33b)
    match=$(echo "${tags}" | jq -r --arg t "${target}:" '.models[].name | select(startswith($t))' 2>/dev/null | head -n1)
    if [[ -n "${match}" ]]; then
        echo "${match}"
        return 0
    fi

    # 4. Substring match
    match=$(echo "${tags}" | jq -r --arg t "${target,,}" '.models[].name | select(ascii_downcase | contains($t))' 2>/dev/null | head -n1)
    if [[ -n "${match}" ]]; then
        echo "${match}"
        return 0
    fi

    return 1
}

# Check if model is present locally
is_local_model() {
    resolve_model_name "$1" "${LOCAL_HOST_URL}" >/dev/null 2>&1
}

# Check if model is present on remote host
is_remote_model() {
    resolve_model_name "$1" "${REMOTE_HOST_URL}" >/dev/null 2>&1
}

# Read per-model tuned defaults (JSON) for an exact resolved model name.
# Prints the JSON object when tuned, empty output otherwise.
tuned_params() {
    local model="$1"
    if [[ ! -f "${TUNINGS_FILE}" ]]; then
        return 0
    fi
    python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1])) or {}
    p = d.get(sys.argv[2])
except Exception:
    p = None
if p:
    print(json.dumps(p))' "${TUNINGS_FILE}" "${model}"
}

# -----------------------------------------------------------------------------
# Command: check / ping
# -----------------------------------------------------------------------------
cmd_check() {
    OM_REMOTE_HOST_URL="${REMOTE_HOST_URL}" OM_LOCAL_HOST_URL="${LOCAL_HOST_URL}" OM_TARGET_HOST="${TARGET_HOST}" OM_HOST_MODE="${HOST_MODE}" OM_OPT_JSON="${OPT_JSON}" OM_MULTI_HOSTS="${MULTI_HOSTS}" OM_REMOTE_HOST_IP="${REMOTE_HOST_IP}" OM_C_RESET="${C_RESET}" OM_C_BOLD="${C_BOLD}" OM_C_GREEN="${C_GREEN}" OM_C_RED="${C_RED}" OM_C_CYAN="${C_CYAN}" OM_C_YELLOW="${C_YELLOW}" \
        python3 - <<'PYEOF'
import os as _om_os
OM_REMOTE_HOST_URL = _om_os.environ["OM_REMOTE_HOST_URL"]
OM_LOCAL_HOST_URL = _om_os.environ["OM_LOCAL_HOST_URL"]
OM_TARGET_HOST = _om_os.environ["OM_TARGET_HOST"]
OM_HOST_MODE = _om_os.environ["OM_HOST_MODE"]
OM_OPT_JSON = _om_os.environ["OM_OPT_JSON"]
OM_MULTI_HOSTS = _om_os.environ["OM_MULTI_HOSTS"]
OM_REMOTE_HOST_IP = _om_os.environ["OM_REMOTE_HOST_IP"]
OM_C_RESET = _om_os.environ["OM_C_RESET"]
OM_C_BOLD = _om_os.environ["OM_C_BOLD"]
OM_C_GREEN = _om_os.environ["OM_C_GREEN"]
OM_C_RED = _om_os.environ["OM_C_RED"]
OM_C_CYAN = _om_os.environ["OM_C_CYAN"]
OM_C_YELLOW = _om_os.environ["OM_C_YELLOW"]
import urllib.request, json, time, sys

remote_url = OM_REMOTE_HOST_URL
local_url = OM_LOCAL_HOST_URL
target = OM_TARGET_HOST
mode = OM_HOST_MODE
as_json = OM_OPT_JSON.lower() == "true"

hosts_to_check = []
if mode == 'multi':
    hosts_to_check.extend((u.split('://', 1)[-1], u) for u in OM_MULTI_HOSTS.split())
elif mode == 'custom':
    hosts_to_check.append(('Custom Host', target))
elif mode == 'remote':
    hosts_to_check.append((f'Remote ({OM_REMOTE_HOST_IP})', remote_url))
elif mode == 'local':
    hosts_to_check.append(('Local Daemon', local_url))
else:
    hosts_to_check.append(('Local Daemon', local_url))
    hosts_to_check.append((f'Remote ({OM_REMOTE_HOST_IP})', remote_url))

results = []
for label, url in hosts_to_check:
    t0 = time.time()
    try:
        req = urllib.request.Request(url + '/api/version', headers={'User-Agent': 'kimo'})
        with urllib.request.urlopen(req, timeout=2.5) as r:
            ver = json.loads(r.read().decode('utf-8')).get('version', 'unknown')
            lat = int((time.time() - t0) * 1000)
            status = 'online'
    except Exception as e:
        results.append({'host': label, 'url': url, 'status': 'offline', 'error': str(e), 'latency_ms': None})
        continue

    models_cnt = 0
    try:
        req = urllib.request.Request(url + '/api/tags', headers={'User-Agent': 'kimo'})
        with urllib.request.urlopen(req, timeout=2.5) as r:
            models_cnt = len(json.loads(r.read().decode('utf-8')).get('models', []))
    except Exception:
        pass

    active_cnt = 0
    vram_bytes = 0
    try:
        req = urllib.request.Request(url + '/api/ps', headers={'User-Agent': 'kimo'})
        with urllib.request.urlopen(req, timeout=2.5) as r:
            ps_models = json.loads(r.read().decode('utf-8')).get('models', [])
            active_cnt = len(ps_models)
            vram_bytes = sum(m.get('size_vram', 0) for m in ps_models)
    except Exception:
        pass

    results.append({
        'host': label,
        'url': url,
        'status': 'online',
        'latency_ms': lat,
        'version': ver,
        'models_count': models_cnt,
        'active_models': active_cnt,
        'vram_usage_bytes': vram_bytes,
        'vram_usage_gb': round(vram_bytes / (1024**3), 2)
    })

if as_json:
    print(json.dumps(results, indent=2))
    sys.exit(0)

C_RESET = OM_C_RESET
C_BOLD = OM_C_BOLD
C_GREEN = OM_C_GREEN
C_RED = OM_C_RED
C_CYAN = OM_C_CYAN
C_YELLOW = OM_C_YELLOW

print(f"{C_BOLD}OLLAMA SERVER CONNECTIVITY & HEALTH CHECK:{C_RESET}")
header_fmt = "{:<24} {:<12} {:<10} {:<12} {:<10} {:<18}"
print(header_fmt.format("TARGET", "STATUS", "LATENCY", "VERSION", "MODELS", "VRAM USAGE"))
print("-" * 88)

for r in results:
    if r['status'] == 'online':
        st_badge = f"{C_GREEN}● ONLINE{C_RESET}"
        lat_str = f"{r['latency_ms']} ms"
        ver_str = r['version']
        mod_str = str(r['models_count'])
        if r['active_models'] > 0:
            vram_str = f"{r['vram_usage_gb']} GB ({r['active_models']} active)"
        else:
            vram_str = "Idle (0 loaded)"
    else:
        st_badge = f"{C_RED}○ OFFLINE{C_RESET}"
        lat_str = "-"
        ver_str = "-"
        mod_str = "-"
        vram_str = "-"

    print(f"{r['host']:<24} {st_badge:<21} {lat_str:<10} {ver_str:<12} {mod_str:<10} {vram_str:<18}")
print()
PYEOF
}

# -----------------------------------------------------------------------------
# Command: hosts
# -----------------------------------------------------------------------------
# One row per Ollama server. A localhost port that is an `ssh -L` forward is
# resolved to the server it reaches, so the tunnel and that server's direct
# address collapse into a single "tunnel" row instead of showing up twice.
# Without --host, local listeners on 11430-11449, ssh forwards and the Desktop
# are discovered; discovered ports that do not speak the Ollama API are dropped.
cmd_hosts() {
    OM_REMOTE_HOST_URL="${REMOTE_HOST_URL}" OM_REMOTE_DIRECT_URL="${REMOTE_DIRECT_URL}" OM_LOCAL_HOST_URL="${LOCAL_HOST_URL}" OM_TARGET_HOST="${TARGET_HOST}" OM_HOST_MODE="${HOST_MODE}" OM_OPT_JSON="${OPT_JSON}" OM_MULTI_HOSTS="${MULTI_HOSTS}" OM_C_RESET="${C_RESET}" OM_C_BOLD="${C_BOLD}" OM_C_DIM="${C_DIM}" OM_C_GREEN="${C_GREEN}" OM_C_RED="${C_RED}" OM_C_YELLOW="${C_YELLOW}" OM_C_CYAN="${C_CYAN}" \
        python3 - <<'PYEOF'
import os, sys, json, time, socket, subprocess
import urllib.request, urllib.error, urllib.parse
from concurrent.futures import ThreadPoolExecutor

env = os.environ
mode = env["OM_HOST_MODE"]
as_json = env["OM_OPT_JSON"].lower() == "true"
C_RESET, C_BOLD, C_DIM = env["OM_C_RESET"], env["OM_C_BOLD"], env["OM_C_DIM"]
C_GREEN, C_RED, C_YELLOW, C_CYAN = env["OM_C_GREEN"], env["OM_C_RED"], env["OM_C_YELLOW"], env["OM_C_CYAN"]

LOOPBACK = {"127.0.0.1", "localhost", "::1", "0.0.0.0", "::", "*"}
SCAN_PORTS = range(11430, 11450)
# ssh options that consume the next argument (or the rest of their cluster).
SSH_VALUE_OPTS = set("BbcDEeFIiJLlmOoPpQRSWw")


def run(argv):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=3).stdout
    except Exception:
        return ""


def local_addresses():
    addrs = set(LOOPBACK)
    addrs.update(run(["hostname", "-I"]).split())
    try:
        addrs.add(socket.gethostname())
    except Exception:
        pass
    return addrs


def resolve_ssh_host(dest):
    """An ssh destination may be a config alias; ask ssh what it really dials."""
    host = dest.split("@")[-1]
    for line in run(["ssh", "-G", dest]).splitlines():
        key, _, value = line.partition(" ")
        if key == "hostname" and value:
            return value.strip()
    return host


def ssh_forwards():
    """local port -> (host, port) for every running `ssh -L` forward."""
    forwards = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
        except OSError:
            continue
        if not argv or os.path.basename(argv[0]) != "ssh":
            continue
        specs, dest, i = [], None, 1
        while i < len(argv):
            arg = argv[i]
            if arg.startswith("-") and len(arg) > 1:
                for j, opt in enumerate(arg[1:], start=1):
                    if opt in SSH_VALUE_OPTS:
                        value = arg[j + 1:]
                        if not value and i + 1 < len(argv):
                            i += 1
                            value = argv[i]
                        if opt == "L":
                            specs.append(value)
                        break
                i += 1
                continue
            dest = arg
            break
        if not dest or not specs:
            continue
        dest_host = None
        for spec in specs:
            parts = spec.split(":")
            if len(parts) == 4:
                _, lport, host, hport = parts
            elif len(parts) == 3:
                lport, host, hport = parts
            else:
                continue  # unix-socket or IPv6 forms; not used for Ollama here
            if not (lport.isdigit() and hport.isdigit()):
                continue
            if host in LOOPBACK:
                dest_host = dest_host or resolve_ssh_host(dest)
                host = dest_host
            forwards[int(lport)] = (host, int(hport))
    return forwards


def listening_local_ports():
    ports = set()
    for line in run(["ss", "-Htln"]).splitlines():
        cols = line.split()
        if len(cols) < 4:
            continue
        addr, _, port = cols[3].rpartition(":")
        addr = addr.strip("[]").split("%")[0]
        if port.isdigit() and addr in LOOPBACK:
            ports.add(int(port))
    return ports


def split_url(url):
    parts = urllib.parse.urlsplit(url if "://" in url else f"http://{url}")
    host = parts.hostname or ""
    port = parts.port or (443 if parts.scheme == "https" else 11434)
    return host, port


def get_json(url, path):
    req = urllib.request.Request(url.rstrip("/") + path, headers={"User-Agent": "kimo"})
    with urllib.request.urlopen(req, timeout=2.5) as r:
        return json.loads(r.read().decode("utf-8"))


def probe(url):
    res = {"url": url, "state": "down", "version": None, "models": None,
           "disk_bytes": None, "latency_ms": None, "error": None}
    t0 = time.time()
    try:
        ver = get_json(url, "/api/version")
    except urllib.error.HTTPError as e:
        res["state"] = "auth" if e.code in (401, 403) else "down"
        res["error"] = f"HTTP {e.code}"
        return res
    except Exception as e:
        res["error"] = str(getattr(e, "reason", e))
        return res
    if not isinstance(ver, dict) or "version" not in ver:
        res["error"] = "not an Ollama API"
        return res
    res.update(state="live", version=ver["version"], latency_ms=int((time.time() - t0) * 1000))
    try:
        models = get_json(url, "/api/tags").get("models", [])
        res["models"] = len(models)
        res["disk_bytes"] = sum(int(m.get("size") or 0) for m in models)
    except Exception:
        pass
    return res


forwards = ssh_forwards()
local_addrs = local_addresses()

# (url, discovered) - discovered entries are dropped when they don't answer.
targets = []
if mode == "multi":
    targets = [(u, False) for u in env["OM_MULTI_HOSTS"].split()]
elif mode == "custom":
    targets = [(env["OM_TARGET_HOST"], False)]
elif mode == "remote":
    targets = [(env["OM_REMOTE_HOST_URL"], False)]
else:
    targets.append((env["OM_LOCAL_HOST_URL"], False))
    listening = listening_local_ports()
    for port in sorted(listening):
        is_tunnel = port in forwards
        if mode == "local" and is_tunnel:
            continue
        if port in SCAN_PORTS or (is_tunnel and forwards[port][1] in SCAN_PORTS):
            targets.append((f"http://127.0.0.1:{port}", True))
    if mode == "auto":
        targets.append((env["OM_REMOTE_DIRECT_URL"], False))

seen, unique = set(), []
for url, discovered in targets:
    host, port = split_url(url)
    key = ("127.0.0.1" if host in LOOPBACK else host, port)
    if key in seen:
        continue
    seen.add(key)
    unique.append((url, discovered, host, port))

with ThreadPoolExecutor(max_workers=max(1, min(16, len(unique)))) as pool:
    probes = list(pool.map(lambda t: probe(t[0]), unique))

rows, by_key = [], {}
for (url, discovered, host, port), res in zip(unique, probes):
    if discovered and res["state"] != "live":
        continue
    is_local = host in local_addrs
    if is_local and port in forwards:
        server, via = forwards[port], "tunnel"
    else:
        server, via = ("127.0.0.1" if host in LOOPBACK else host, port), ("local" if is_local else "remote")
    path = {"url": url, "via": via, "local_port": port if via == "tunnel" else None, **res}
    row = by_key.get(server)
    if row is None:
        row = {"host": server[0], "port": server[1], "paths": []}
        by_key[server] = row
        rows.append(row)
    row["paths"].append(path)

STATE_RANK = {"live": 0, "auth": 1, "down": 2}
for row in rows:
    best = min(row["paths"], key=lambda p: STATE_RANK[p["state"]])
    tunnel_ports = [p["local_port"] for p in row["paths"] if p["via"] == "tunnel"]
    if tunnel_ports:
        source = "tunnel"
    elif any(p["via"] == "local" for p in row["paths"]):
        source = "local"
    else:
        source = "remote"
    row.update(
        state=best["state"], version=best["version"], models=best["models"],
        disk_bytes=best["disk_bytes"],
        disk_gb=None if best["disk_bytes"] is None else round(best["disk_bytes"] / 1e9, 1),
        latency_ms=best["latency_ms"], source=source, tunnel_ports=tunnel_ports,
    )

if as_json:
    print(json.dumps(rows, indent=2))
    sys.exit(0)

if not rows:
    print(f"{C_YELLOW}No Ollama servers found.{C_RESET}")
    sys.exit(0)

host_w = max(16, *(len(r["host"]) for r in rows)) + 2
fmt = "  {:<%d} {:<6} {:<9} {:<12} {:<7} {:<8} {}" % host_w
print(f"{C_BOLD}OLLAMA HOSTS:{C_RESET}")
print(fmt.format("HOST", "PORT", "STATE", "VERSION", "MODELS", "DISK GB", "SOURCE"))
STATE_COLOR = {"live": C_GREEN, "auth": C_YELLOW, "down": C_RED}
for r in rows:
    # Pad before colouring so ANSI codes don't skew the column widths.
    state = f"{STATE_COLOR[r['state']]}{r['state']:<9}{C_RESET}"
    source = r["source"]
    if r["tunnel_ports"]:
        source += " " + ",".join(f":{p}" for p in r["tunnel_ports"])
    line = fmt.format(
        r["host"], r["port"], "", r["version"] or "-",
        "-" if r["models"] is None else r["models"],
        "-" if r["disk_gb"] is None else r["disk_gb"],
        source,
    )
    # Splice the coloured state into the blank STATE cell.
    cut = 2 + host_w + 1 + 6 + 1
    print(line[:cut] + state + line[cut + 9:])

notes = []
for r in rows:
    for p in r["paths"]:
        if p["state"] != "live":
            notes.append(f"  {p['url'].split('://', 1)[-1]}: {p['state']} ({p['error']})")
    if r["tunnel_ports"]:
        ports = ",".join(f":{p}" for p in r["tunnel_ports"])
        notes.append(f"  {r['host']}:{r['port']} is reached through ssh -L 127.0.0.1{ports} (one server, one row)")
if notes:
    print(C_DIM + "\n".join(notes) + C_RESET)
PYEOF
}

# -----------------------------------------------------------------------------
# Command: ps / status
# -----------------------------------------------------------------------------
cmd_ps() {
    OM_REMOTE_HOST_URL="${REMOTE_HOST_URL}" OM_LOCAL_HOST_URL="${LOCAL_HOST_URL}" OM_TARGET_HOST="${TARGET_HOST}" OM_HOST_MODE="${HOST_MODE}" OM_OPT_JSON="${OPT_JSON}" OM_MULTI_HOSTS="${MULTI_HOSTS}" OM_REMOTE_HOST_IP="${REMOTE_HOST_IP}" OM_C_RESET="${C_RESET}" OM_C_BOLD="${C_BOLD}" OM_C_GREEN="${C_GREEN}" OM_C_YELLOW="${C_YELLOW}" OM_C_CYAN="${C_CYAN}" OM_C_DIM="${C_DIM}" \
        python3 - <<'PYEOF'
import os as _om_os
OM_REMOTE_HOST_URL = _om_os.environ["OM_REMOTE_HOST_URL"]
OM_LOCAL_HOST_URL = _om_os.environ["OM_LOCAL_HOST_URL"]
OM_TARGET_HOST = _om_os.environ["OM_TARGET_HOST"]
OM_HOST_MODE = _om_os.environ["OM_HOST_MODE"]
OM_OPT_JSON = _om_os.environ["OM_OPT_JSON"]
OM_MULTI_HOSTS = _om_os.environ["OM_MULTI_HOSTS"]
OM_REMOTE_HOST_IP = _om_os.environ["OM_REMOTE_HOST_IP"]
OM_C_RESET = _om_os.environ["OM_C_RESET"]
OM_C_BOLD = _om_os.environ["OM_C_BOLD"]
OM_C_GREEN = _om_os.environ["OM_C_GREEN"]
OM_C_YELLOW = _om_os.environ["OM_C_YELLOW"]
OM_C_CYAN = _om_os.environ["OM_C_CYAN"]
OM_C_DIM = _om_os.environ["OM_C_DIM"]
import urllib.request, json, time, datetime, sys

remote_url = OM_REMOTE_HOST_URL
local_url = OM_LOCAL_HOST_URL
target = OM_TARGET_HOST
mode = OM_HOST_MODE
as_json = OM_OPT_JSON.lower() == "true"

hosts_to_query = []
if mode == 'multi':
    hosts_to_query.extend((u.split('://', 1)[-1], u) for u in OM_MULTI_HOSTS.split())
elif mode == 'custom':
    hosts_to_query.append(('custom', target))
elif mode == 'remote':
    hosts_to_query.append((f'remote ({OM_REMOTE_HOST_IP})', remote_url))
elif mode == 'local':
    hosts_to_query.append(('local', local_url))
else:
    hosts_to_query.append(('local', local_url))
    hosts_to_query.append((f'remote ({OM_REMOTE_HOST_IP})', remote_url))

all_ps = []
for label, url in hosts_to_query:
    try:
        req = urllib.request.Request(url + '/api/ps', headers={'User-Agent': 'kimo'})
        with urllib.request.urlopen(req, timeout=2.5) as r:
            data = json.loads(r.read().decode('utf-8'))
            for m in data.get('models', []):
                m['host_label'] = label
                m['host_url'] = url
                all_ps.append(m)
    except Exception:
        pass

if as_json:
    print(json.dumps(all_ps, indent=2))
    sys.exit(0)

C_RESET = OM_C_RESET
C_BOLD = OM_C_BOLD
C_GREEN = OM_C_GREEN
C_YELLOW = OM_C_YELLOW
C_CYAN = OM_C_CYAN
C_DIM = OM_C_DIM

if not all_ps:
    print(f"{C_DIM}No models currently loaded in VRAM (Local: idle, Remote: idle).{C_RESET}")
    sys.exit(0)

print(f"{C_BOLD}CURRENTLY LOADED MODELS IN VRAM:{C_RESET}")
printf_fmt = "{:<22} {:<38} {:<12} {:<24} {:<10} {:<16}"
print(printf_fmt.format("HOST", "MODEL NAME", "ID", "VRAM / TOTAL", "CONTEXT", "STATUS / UNTIL"))
print("-" * 124)

for m in all_ps:
    name = m.get('name', 'unknown')
    raw_digest = m.get('digest', '')
    short_id = raw_digest.replace('sha256:', '')[:12] if raw_digest else '-'
    size_total = m.get('size', 0)
    size_vram = m.get('size_vram', 0)
    ctx = str(m.get('context_length') or '-')

    total_gb = size_total / (1024**3)
    vram_gb = size_vram / (1024**3)
    if size_total > 0:
        gpu_pct = int(round((size_vram / size_total) * 100))
        vram_desc = f"{vram_gb:.1f}/{total_gb:.1f} GB ({gpu_pct}% GPU)"
    else:
        vram_desc = f"{vram_gb:.1f} GB"

    expires_at = m.get('expires_at', '')
    status_desc = "Loaded"
    if 'Stopping' in str(expires_at):
        status_desc = f"{C_YELLOW}Stopping...{C_RESET}"
    elif expires_at:
        try:
            exp_clean = expires_at.split('.')[0]
            if '+' in exp_clean:
                exp_clean = exp_clean.split('+')[0]
            exp_dt = datetime.datetime.fromisoformat(exp_clean)
            now_dt = datetime.datetime.now()
            diff = (exp_dt - now_dt).total_seconds()
            if diff > 0:
                mins = int(diff // 60)
                secs = int(diff % 60)
                status_desc = f"{mins}m {secs}s"
            else:
                status_desc = f"{C_YELLOW}Stopping...{C_RESET}"
        except Exception:
            status_desc = "Active"

    print(printf_fmt.format(m['host_label'], name, short_id, vram_desc, ctx, status_desc))
print()
PYEOF
}

# -----------------------------------------------------------------------------
# Command: status
# -----------------------------------------------------------------------------
cmd_status() {
    local as_json="${OPT_JSON}"

    local tunnel_state
    tunnel_state=$(systemctl is-active ollama-remote-tunnel.service 2>/dev/null || echo "unknown")
    local tunnel_enter
    tunnel_enter=$(systemctl show ollama-remote-tunnel.service -p ActiveEnterTimestamp --value 2>/dev/null || true)

    local timer_last timer_next svc_start
    timer_last=$(systemctl show ollama-stream-keepalive.timer -p LastTriggerUSec --value 2>/dev/null || true)
    timer_next=$(systemctl show ollama-stream-keepalive.timer -p NextElapseUSecRealtime --value 2>/dev/null || true)
    if [[ -z "${timer_next}" || "${timer_next}" == "n/a" ]]; then
        timer_next=$(systemctl list-timers ollama-stream-keepalive.timer --no-pager 2>/dev/null | sed -n '2p' | cut -c1-28)
    fi
    svc_start=$(systemctl show ollama-stream-keepalive.service -p ExecMainStartTimestamp --value 2>/dev/null || true)

    # Remote daemon via the tunnel (version + latency)
    local vresp vcode vlat remote_ver
    vresp=$(curl -s --connect-timeout 2 -m 4 -w '|%{http_code}|%{time_total}' "${REMOTE_HOST_URL}/api/version" 2>/dev/null || true)
    vcode=$(echo "${vresp}" | awk -F'|' '{print $2}')
    vlat=$(echo "${vresp}" | awk -F'|' '{print $3}')
    remote_ver=$(echo "${vresp}" | awk -F'|' '{print $1}' | jq -r '.version? // empty' 2>/dev/null || true)

    # VRAM residency
    local psresp nloaded rmodel rvram runtil
    psresp=$(curl -s --connect-timeout 2 -m 4 "${REMOTE_HOST_URL}/api/ps" 2>/dev/null || true)
    nloaded=$(echo "${psresp}" | jq -r '.models | length' 2>/dev/null || echo 0)
    rmodel=$(echo "${psresp}" | jq -r '.models[0].name // empty' 2>/dev/null || true)
    rvram=$(echo "${psresp}" | jq -r '.models[0].size_vram? // 0' 2>/dev/null | awk '{printf "%.1f", $1/1073741824}')
    runtil=$(echo "${psresp}" | jq -r '.models[0].expires_at? // empty' 2>/dev/null | cut -d. -f1)

    # Public token-gated endpoint (via the local Apache vhost, bypassing NAT hairpin)
    local tok pubbody pubresp pub_models
    tok=""
    if [[ -f /etc/apache2/ollama-api.token ]]; then
        tok=$(awk '{print $2}' /etc/apache2/ollama-api.token 2>/dev/null || true)
    fi
    pubbody=$(curl -s --resolve www.kalidroid.com:443:127.0.0.1 -m 8 -w '\n%{http_code}' -H "Authorization: Bearer ${tok}" "https://www.kalidroid.com/ollama/api/tags" 2>/dev/null || true)
    pubresp=$(echo "${pubbody}" | tail -n1)
    pub_models=$(echo "${pubbody}" | head -n-1 | jq -r '.models | length' 2>/dev/null || true)
    [[ "${pub_models}" == "-" || -z "${pub_models}" ]] && pub_models="0"

    [[ -n "${vlat}" ]] && vlat=$(printf "%.0f" "$(echo "${vlat}" | awk '{print $1*1000}')")
    if [[ -z "${remote_ver}" ]] && [[ "${vcode}" != "200" ]]; then
        vcode=""
    fi

    if [[ "${as_json}" == "true" ]]; then
        [[ "${vcode}" != "200" ]] && vcode=""
        jq -n \
          --arg tunnel "${tunnel_state}" \
          --arg tunnel_enter "${tunnel_enter:--}" \
          --arg remote_version "${remote_ver:--}" \
          --arg remote_latency_ms "${vlat:--}" \
          --argjson resident_models "${nloaded:-0}" \
          --arg resident_name "${rmodel:--}" \
          --arg resident_vram_gb "${rvram:-0}" \
          --arg resident_until "${runtil:--}" \
          --arg timer_last "${timer_last:--}" \
          --arg timer_next "${timer_next:--}" \
          --arg service_last "${svc_start:--}" \
          --arg public_url "https://www.kalidroid.com/ollama" \
          --arg public_http "${pubresp:--}" \
          --argjson public_models "${pub_models:-0}" \
          '{tunnel:{service:"ollama-remote-tunnel.service",state:$tunnel,entered:$tunnel_enter},remote:{url:"'"${REMOTE_HOST_URL}"'",version:$remote_version,latency_ms:$remote_latency_ms,resident:{count:$resident_models,name:$resident_name,vram_gb:$resident_vram_gb,until:$resident_until}},keepalive:{timer_last_run:$timer_last,timer_next_run:$timer_next,service_last_start:$service_last},public:{url:$public_url,http:$public_http,models:$public_models}}'
        exit 0
    fi

    local tbadge rbadge pbadge
    if [[ "${tunnel_state}" == "active" ]]; then
        tbadge="${C_GREEN}${tunnel_state}${C_RESET}"
    else
        tbadge="${C_RED}${tunnel_state}${C_RESET}"
    fi
    if [[ "${vcode}" == "200" ]]; then
        rbadge="${C_GREEN}online${C_RESET}"
    else
        rbadge="${C_RED}offline${C_RESET}"
    fi
    if [[ "${pubresp}" == "200" ]]; then
        pbadge="${C_GREEN}200 OK${C_RESET}"
    else
        pbadge="${C_RED}${pubresp:-no response}${C_RESET}"
    fi

    echo "${C_BOLD}KIMO (OLLAMA MANAGER) — STATUS${C_RESET}"
    echo "---------------------------------------------------------------------"
    printf "  %-38s : %s\n" "Tunnel (ollama-remote-tunnel.service)" "${tbadge} (entered ${tunnel_enter:-?})"
    printf "  %-38s : %s  %s  ~%sms\n" "Remote API (${REMOTE_HOST_URL})" "${rbadge}" "${remote_ver:--}" "${vlat:--}"
    if [[ "${nloaded:-0}" -gt 0 ]]; then
        printf "  %-38s : %s loaded — %s (%s GB, until %s)\n" "VRAM residency" "${C_GREEN}${nloaded}${C_RESET}" "${C_CYAN}${rmodel}${C_RESET}" "${rvram}" "${runtil:-n/a}"
    else
        printf "  %-38s : %s\n" "VRAM residency" "${C_DIM}idle (0 loaded)${C_RESET}"
    fi
    echo "  Keepalive timer (ollama-stream-keepalive.timer):"
    printf "      %-28s : %s\n" "last trigger" "${timer_last:-never}"
    printf "      %-28s : %s\n" "next trigger" "${timer_next:-n/a}"
    printf "      %-28s : %s\n" "service last start" "${svc_start:-never}"
    printf "  %-38s : %s  %s models (token: /etc/apache2/ollama-api.token)\n" "Public endpoint https://www.kalidroid.com/ollama" "${pbadge}" "${pub_models}"
    echo "---------------------------------------------------------------------"
}

# -----------------------------------------------------------------------------
# Command: status-report
