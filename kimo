# -----------------------------------------------------------------------------
# Global Option Parsing (Permits flags anywhere on command line)
# -----------------------------------------------------------------------------
OPT_REMOTE=false
OPT_LOCAL=false
OPT_HOST=""
OPT_HOSTS=()
OPT_JSON=false
FORCE_NO_COLOR=false
POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --remote)
            OPT_REMOTE=true
            shift
            ;;
        --local)
            OPT_LOCAL=true
            shift
            ;;
        --host)
            shift
            if [[ -z "${1:-}" ]]; then
                echo "Error: --host requires an address argument." >&2
                exit 1
            fi
            OPT_HOSTS+=("$1")
            shift
            ;;
        --host=*)
            OPT_HOSTS+=("${1#*=}")
            shift
            ;;
        --json)
            OPT_JSON=true
            shift
            ;;
        --no-color)
            FORCE_NO_COLOR=true
            shift
            ;;
        -v|--version)
            echo "kimo v${KIMO_VERSION}"
            exit 0
            ;;
        -h|--help)
            if [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]]; then
                setup_colors
                usage
                exit 0
            else
                POSITIONAL_ARGS+=("$1")
                shift
            fi
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

# Apply default_host from persistent config if not overridden on command line
if [[ -n "${KIMO_CONFIG_VALUES[default_host]:-}" && ${#OPT_HOSTS[@]} -eq 0 && ! ${OPT_LOCAL} && ! ${OPT_REMOTE} ]]; then
    case "${KIMO_CONFIG_VALUES[default_host]}" in
        remote) OPT_REMOTE=true ;;
        local)  OPT_LOCAL=true ;;
        *)      OPT_HOSTS+=("${KIMO_CONFIG_VALUES[default_host]}") ;;
    esac
fi

setup_colors

if [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]]; then
    usage
    exit 0
fi

COMMAND="${POSITIONAL_ARGS[0]}"
ARGS=("${POSITIONAL_ARGS[@]:1}")

# Resolve which remote URL is actually reachable (tunnel-first).
# Honors $OLLAMA_REMOTE_URL when set. Falls back to the tunnel default even
# when nothing answers so callers always have a stable value to report.
probe_ollama_url() {
    # -f: a 401 from a bridge that now requires a token is not "reachable" -
    # accepting it made every remote model lookup fail and launch fall back to
    # the Pi, where a 27B load is refused or OOM-killed.
    curl -sf --connect-timeout 1 -m 2 "$1/api/tags" >/dev/null 2>&1
}
resolve_remote_url() {
    if [[ -n "${OLLAMA_REMOTE_URL:-}" ]]; then
        echo "${OLLAMA_REMOTE_URL}"
        return
    fi
    if probe_ollama_url "${REMOTE_TUNNEL_URL}"; then
        echo "${REMOTE_TUNNEL_URL}"
        return
    fi
    if probe_ollama_url "${REMOTE_DIRECT_URL}"; then
        echo "${REMOTE_DIRECT_URL}"
        return
    fi
    # The Desktop's own Ollama daemon (no bridge, no token; dashboard ep1 uses it).
    if probe_ollama_url "${REMOTE_DAEMON_URL}"; then
        echo "${REMOTE_DAEMON_URL}"
        return
    fi
    echo "${REMOTE_TUNNEL_URL}"
}

normalize_host_url() {
    local url="${1%/}"
    if [[ ! "${url}" =~ ^https?:// ]]; then
        url="http://${url}"
    fi
    if [[ ! "${url}" =~ :[0-9]+$ ]]; then
        url="${url}:11434"
    fi
    echo "${url}"
}

# --host may be repeated; normalize and de-duplicate, keeping the given order.
if [[ ${#OPT_HOSTS[@]} -gt 0 ]]; then
    declare -A _seen_hosts=()
    _norm_hosts=()
    for _h in "${OPT_HOSTS[@]}"; do
        _h="$(normalize_host_url "${_h}")"
        [[ -n "${_seen_hosts[${_h}]:-}" ]] && continue
        _seen_hosts[${_h}]=1
        _norm_hosts+=("${_h}")
    done
    OPT_HOSTS=("${_norm_hosts[@]}")
    OPT_HOST="${OPT_HOSTS[0]}"
fi
MULTI_HOSTS=""
[[ -n "${OLLAMA_LOCAL_URL:-}" ]] && LOCAL_HOST_URL="$(normalize_host_url "${OLLAMA_LOCAL_URL}")"

# Determine Active Target Host
# --host combined with --local/--remote redefines that side's address instead
# of replacing the mode, so local/remote labels and routing stay intact.
if [[ ${#OPT_HOSTS[@]} -gt 1 ]]; then
    if ${OPT_LOCAL} || ${OPT_REMOTE}; then
        echo "${C_RED}Error: multiple --host values cannot be combined with --local/--remote; use \$OLLAMA_LOCAL_URL / \$OLLAMA_REMOTE_URL.${C_RESET}" >&2
        exit 1
    fi
    TARGET_HOST=""
    HOST_MODE="multi"
    MULTI_HOSTS="${OPT_HOSTS[*]}"
elif ${OPT_LOCAL} && ${OPT_REMOTE}; then
    if [[ -n "${OPT_HOST}" ]]; then
        echo "${C_RED}Error: --host is ambiguous with both --local and --remote; use \$OLLAMA_LOCAL_URL / \$OLLAMA_REMOTE_URL.${C_RESET}" >&2
        exit 1
    fi
    TARGET_HOST=""
    HOST_MODE="auto"
    REMOTE_HOST_URL="$(resolve_remote_url)"
elif ${OPT_LOCAL} && [[ -n "${OPT_HOST}" ]]; then
    LOCAL_HOST_URL="${OPT_HOST}"
    TARGET_HOST="${LOCAL_HOST_URL}"
    HOST_MODE="local"
elif ${OPT_REMOTE} && [[ -n "${OPT_HOST}" ]]; then
    REMOTE_HOST_URL="${OPT_HOST}"
    TARGET_HOST="${REMOTE_HOST_URL}"
    HOST_MODE="remote"
    if ! probe_ollama_url "${TARGET_HOST}"; then
        echo "${C_YELLOW}[!] Remote ${TARGET_HOST} unreachable${C_RESET}" >&2
    fi
elif [[ -n "${OPT_HOST}" ]]; then
    TARGET_HOST="${OPT_HOST}"
    HOST_MODE="custom"
elif ${OPT_REMOTE}; then
    REMOTE_HOST_URL="$(resolve_remote_url)"
    TARGET_HOST="${REMOTE_HOST_URL}"
    HOST_MODE="remote"
    if ! probe_ollama_url "${TARGET_HOST}"; then
        echo "${C_YELLOW}[!] Remote ${TARGET_HOST} unreachable (tunnel ollama-remote-tunnel.service down?)${C_RESET}" >&2
    fi
elif ${OPT_LOCAL}; then
    TARGET_HOST="${LOCAL_HOST_URL}"
    HOST_MODE="local"
else
    TARGET_HOST=""
    HOST_MODE="auto"
    # In auto mode every command that touches the remote resolves it lazily via
    # $REMOTE_HOST_URL; refresh it here when it still points at the default so
    # a recovered direct path is picked up without an env override.
    if [[ "${REMOTE_HOST_URL}" == "${REMOTE_TUNNEL_URL}" || "${REMOTE_HOST_URL}" == "${REMOTE_DIRECT_URL}" ]]; then
        REMOTE_HOST_URL="$(resolve_remote_url)"
    fi
fi

# -----------------------------------------------------------------------------
# Helper Functions
# -----------------------------------------------------------------------------

# Resolve model name to its exact tag on target host (exact match, :latest, prefix, substring)
resolve_model_name() {
    local target="$1"
    local host_url="${2:-${LOCAL_HOST_URL}}"
    local tags
    tags=$(curl -s --connect-timeout 3 -m 8 "${host_url}/api/tags" 2>/dev/null) || return 1

    # 1. Exact match
    local match
    match=$(echo "${tags}" | jq -r --arg t "${target}" '.models[].name | select(. == $t)' 2>/dev/null | head -n1)
    if [[ -n "${match}" ]]; then
        echo "${match}"
        return 0
    fi

    # 2. Check :latest tag
    match=$(echo "${tags}" | jq -r --arg t "${target}:latest" '.models[].name | select(. == $t)' 2>/dev/null | head -n1)
    if [[ -n "${match}" ]]; then
        echo "${match}"
        return 0
    fi

    # 3. Check prefix match (e.g. nemotron3 -> nemotron3:33b)
    match=$(echo "${tags}" | jq -r --arg t "${target}:" '.models[].name | select(startswith($t))' 2>/dev/null | head -n1)
    if [[ -n "${match}" ]]; then
        echo "${match}"
        return 0
    fi

    # 4. Substring match
    match=$(echo "${tags}" | jq -r --arg t "${target,,}" '.models[].name | select(ascii_downcase | contains($t))' 2>/dev/null | head -n1)
    if [[ -n "${match}" ]]; then
        echo "${match}"
        return 0
    fi

    return 1
}

# Check if model is present locally
is_local_model() {
    resolve_model_name "$1" "${LOCAL_HOST_URL}" >/dev/null 2>&1
}

# Check if model is present on remote host
is_remote_model() {
    resolve_model_name "$1" "${REMOTE_HOST_URL}" >/dev/null 2>&1
}

# Read per-model tuned defaults (JSON) for an exact resolved model name.
# Prints the JSON object when tuned, empty output otherwise.
tuned_params() {
    local model="$1"
    if [[ ! -f "${TUNINGS_FILE}" ]]; then
        return 0
    fi
    python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1])) or {}
    p = d.get(sys.argv[2])
except Exception:
    p = None
if p:
    print(json.dumps(p))' "${TUNINGS_FILE}" "${model}"
}

