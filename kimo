_ps_snapshot() {
    OM_REMOTE_HOST_URL="${REMOTE_HOST_URL}" OM_LOCAL_HOST_URL="${LOCAL_HOST_URL}" OM_TARGET_HOST="${TARGET_HOST}" OM_HOST_MODE="${HOST_MODE}" OM_OPT_JSON="${OPT_JSON}" OM_MULTI_HOSTS="${MULTI_HOSTS}" OM_REMOTE_HOST_IP="${REMOTE_HOST_IP}" OM_C_RESET="${C_RESET}" OM_C_BOLD="${C_BOLD}" OM_C_GREEN="${C_GREEN}" OM_C_YELLOW="${C_YELLOW}" OM_C_CYAN="${C_CYAN}" OM_C_DIM="${C_DIM}" \
        python3 - <<'PYEOF'
import os as _om_os
OM_REMOTE_HOST_URL = _om_os.environ["OM_REMOTE_HOST_URL"]
OM_LOCAL_HOST_URL = _om_os.environ["OM_LOCAL_HOST_URL"]
OM_TARGET_HOST = _om_os.environ["OM_TARGET_HOST"]
OM_HOST_MODE = _om_os.environ["OM_HOST_MODE"]
OM_OPT_JSON = _om_os.environ["OM_OPT_JSON"]
OM_MULTI_HOSTS = _om_os.environ["OM_MULTI_HOSTS"]
OM_REMOTE_HOST_IP = _om_os.environ["OM_REMOTE_HOST_IP"]
OM_C_RESET = _om_os.environ["OM_C_RESET"]
OM_C_BOLD = _om_os.environ["OM_C_BOLD"]
OM_C_GREEN = _om_os.environ["OM_C_GREEN"]
OM_C_YELLOW = _om_os.environ["OM_C_YELLOW"]
OM_C_CYAN = _om_os.environ["OM_C_CYAN"]
OM_C_DIM = _om_os.environ["OM_C_DIM"]
import urllib.request, json, time, datetime, sys

remote_url = OM_REMOTE_HOST_URL
local_url = OM_LOCAL_HOST_URL
target = OM_TARGET_HOST
mode = OM_HOST_MODE
as_json = OM_OPT_JSON.lower() == "true"

hosts_to_query = []
remote_label = f'remote ({OM_REMOTE_HOST_IP})' if OM_REMOTE_HOST_IP and OM_REMOTE_HOST_IP != 'remote' else 'remote'
if mode == 'multi':
    hosts_to_query.extend((u.split('://', 1)[-1], u) for u in OM_MULTI_HOSTS.split())
elif mode == 'custom':
    hosts_to_query.append(('custom', target))
elif mode == 'remote':
    hosts_to_query.append((remote_label, remote_url))
elif mode == 'local':
    hosts_to_query.append(('local', local_url))
else:
    hosts_to_query.append(('local', local_url))
    hosts_to_query.append((remote_label, remote_url))

all_ps = []
for label, url in hosts_to_query:
    try:
        req = urllib.request.Request(url + '/api/ps', headers={'User-Agent': 'kimo'})
        with urllib.request.urlopen(req, timeout=2.5) as r:
            data = json.loads(r.read().decode('utf-8'))
            for m in data.get('models', []):
                m['host_label'] = label
                m['host_url'] = url
                all_ps.append(m)
    except Exception:
        pass

if as_json:
    print(json.dumps(all_ps, indent=2))
    sys.exit(0)

C_RESET = OM_C_RESET
C_BOLD = OM_C_BOLD
C_GREEN = OM_C_GREEN
C_YELLOW = OM_C_YELLOW
C_CYAN = OM_C_CYAN
C_DIM = OM_C_DIM

if not all_ps:
    print(f"{C_DIM}No models currently loaded in VRAM (Local: idle, Remote: idle).{C_RESET}")
    sys.exit(0)

print(f"{C_BOLD}CURRENTLY LOADED MODELS IN VRAM:{C_RESET}")
printf_fmt = "{:<22} {:<38} {:<12} {:<24} {:<10} {:<16}"
print(printf_fmt.format("HOST", "MODEL NAME", "ID", "VRAM / TOTAL", "CONTEXT", "STATUS / UNTIL"))
print("-" * 124)

for m in all_ps:
    name = m.get('name', 'unknown')
    raw_digest = m.get('digest', '')
    short_id = raw_digest.replace('sha256:', '')[:12] if raw_digest else '-'
    size_total = m.get('size', 0)
    size_vram = m.get('size_vram', 0)
    ctx = str(m.get('context_length') or '-')

    total_gb = size_total / (1024**3)
    vram_gb = size_vram / (1024**3)
    if size_total > 0:
        gpu_pct = int(round((size_vram / size_total) * 100))
        vram_desc = f"{vram_gb:.1f}/{total_gb:.1f} GB ({gpu_pct}% GPU)"
    else:
        vram_desc = f"{vram_gb:.1f} GB"

    expires_at = m.get('expires_at', '')
    status_desc = "Loaded"
    if 'Stopping' in str(expires_at):
        status_desc = f"{C_YELLOW}Stopping...{C_RESET}"
    elif expires_at:
        try:
            exp_clean = expires_at.split('.')[0]
            if '+' in exp_clean:
                exp_clean = exp_clean.split('+')[0]
            exp_dt = datetime.datetime.fromisoformat(exp_clean)
            now_dt = datetime.datetime.now()
            diff = (exp_dt - now_dt).total_seconds()
            if diff > 0:
                mins = int(diff // 60)
                secs = int(diff % 60)
                status_desc = f"{mins}m {secs}s"
            else:
                status_desc = f"{C_YELLOW}Stopping...{C_RESET}"
        except Exception:
            status_desc = "Active"

    print(printf_fmt.format(m['host_label'], name, short_id, vram_desc, ctx, status_desc))
print()
PYEOF
}

cmd_ps() {
    local opt_watch=false
    local opt_interval=2

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -w|--watch) opt_watch=true; shift ;;
            -n|--interval) opt_interval="${2:-2}"; shift 2 ;;
