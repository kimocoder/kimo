KIMI_FT_QWEN_SETTINGS="${HOME:-/root}/.qwen/settings.json"

# Filters ported from populate-freetier-qwen.py (same semantics).
KIMI_FT_QWEN_RE='^(qwen|qwq|qvq)'
KIMI_FT_REALTIME_RE='realtime|livetranslate|s2s|webrtc|aoq'
KIMI_FT_NONCHAT_RE='image|wan2|z-image|tts|asr|embed|tingwu|vl-ocr|-mt-|rerank|ccai|character|voice|-vace|kf2v|i2v|t2v'
