cmd_logs() {
    local target="${1:-}"
    local lines="${LOG_LINES:-60}"
    case "${target}" in
        tunnel)
            journalctl -u ollama-remote-tunnel.service -n "${lines}" --no-pager
            ;;
        keepalive|stream|warm)
            journalctl -u ollama-stream-keepalive.service -n "${lines}" --no-pager
            ;;
        timer)
            journalctl -u ollama-stream-keepalive.timer -n "${lines}" --no-pager
            ;;
        apache|web)
            journalctl -u apache2.service -n "${lines}" --no-pager
            ;;
        all|"")
            cmd_logs tunnel && echo && cmd_logs keepalive
            ;;
        *)
            if journalctl -u "${target}" -n "${lines}" --no-pager 2>/dev/null; then
                :
            else
                echo "${C_RED}Unknown log target '${target}'. Try: tunnel | keepalive | timer | apache | all${C_RESET}" >&2
                return 1
            fi
            ;;
    esac
}

# -----------------------------------------------------------------------------
# Command: rotate-token
# -----------------------------------------------------------------------------
cmd_rotate_token() {
    local force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes|--force) force=true; shift ;;
            *) shift ;;
        esac
    done

    local tfile="/etc/apache2/ollama-api.token"
    if [[ ! -f "${tfile}" ]]; then
        echo "${C_RED}Error: ${tfile} not found.${C_RESET}" >&2
        exit 1
    fi
    local old
    old=$(awk '{print $2}' "${tfile}")

    if ! ${force}; then
        read -r -p "Rotate the public API token? This invalidates https://www.kalidroid.com/ollama auth for all clients. [y/N] " ans
        [[ "${ans}" == "y" || "${ans}" == "Y" ]] || { echo "Aborted."; exit 0; }
    fi

    local new
    new=$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
    cp -a "${tfile}" "${tfile}.bk"
    printf 'token %s\n' "${new}" > "${tfile}"
    chmod 640 "${tfile}"
    chown root:www-data "${tfile}" 2>/dev/null || true

    if ! /root/render-ollama-proxy.sh; then
        cp -a "${tfile}.bk" "${tfile}"
        echo "${C_RED}[!] Proxy render failed; old token restored.${C_RESET}" >&2
        exit 1
    fi
    if ! apache2ctl configtest >/dev/null 2>&1; then
        cp -a "${tfile}.bk" "${tfile}"
        /root/render-ollama-proxy.sh || true
        echo "${C_RED}[!] Apache configtest failed; rolled back to previous token.${C_RESET}" >&2
        exit 1
    fi

    local old_code new_code url="https://www.kalidroid.com/ollama/api/tags"
    systemctl reload apache2
    new_code=$(curl -s --resolve www.kalidroid.com:443:127.0.0.1 -m 8 -o /dev/null -w '%{http_code}' -H "Authorization: Bearer ${new}" "${url}" || true)
    old_code=$(curl -s --resolve www.kalidroid.com:443:127.0.0.1 -m 8 -o /dev/null -w '%{http_code}' -H "Authorization: Bearer ${old}" "${url}" || true)
    if [[ "${new_code}" != "200" || "${old_code}" == "200" ]]; then
        cp -a "${tfile}.bk" "${tfile}"
        /root/render-ollama-proxy.sh || true
        systemctl reload apache2
        echo "${C_RED}[!] Live verification failed (new=${new_code:-down}, old=${old_code:-down}); rolled back to previous token.${C_RESET}" >&2
        exit 1
    fi

    echo "${C_GREEN}[✓] Token rotated and verified (new: HTTP ${new_code}, old: HTTP ${old_code}). Previous token kept at ${tfile}.bk.${C_RESET}"
    echo "  endpoint : https://www.kalidroid.com/ollama"
    echo "  new token: ${new}"
    echo "  curl     : curl -H 'Authorization: Bearer ${new}' https://www.kalidroid.com/ollama/api/tags"
}
