    OM_REMOTE_HOST_URL="${REMOTE_HOST_URL}" OM_LOCAL_HOST_URL="${LOCAL_HOST_URL}" OM_query="${query}" OM_OPT_JSON="${OPT_JSON}" OM_HOST_MODE="${HOST_MODE}" OM_MULTI_HOSTS="${MULTI_HOSTS}" OM_TARGET_HOST="${TARGET_HOST}" OM_C_RESET="${C_RESET}" OM_C_BOLD="${C_BOLD}" OM_C_GREEN="${C_GREEN}" OM_C_YELLOW="${C_YELLOW}" OM_C_DIM="${C_DIM}" \
        python3 - <<'PYEOF'
import os as _om_os
OM_REMOTE_HOST_URL = _om_os.environ["OM_REMOTE_HOST_URL"]
OM_LOCAL_HOST_URL = _om_os.environ["OM_LOCAL_HOST_URL"]
OM_query = _om_os.environ["OM_query"]
OM_OPT_JSON = _om_os.environ["OM_OPT_JSON"]
OM_HOST_MODE = _om_os.environ["OM_HOST_MODE"]
OM_MULTI_HOSTS = _om_os.environ["OM_MULTI_HOSTS"]
OM_TARGET_HOST = _om_os.environ["OM_TARGET_HOST"]
OM_C_RESET = _om_os.environ["OM_C_RESET"]
OM_C_BOLD = _om_os.environ["OM_C_BOLD"]
OM_C_GREEN = _om_os.environ["OM_C_GREEN"]
OM_C_YELLOW = _om_os.environ["OM_C_YELLOW"]
OM_C_DIM = _om_os.environ["OM_C_DIM"]
import urllib.request, json, sys

remote_url = OM_REMOTE_HOST_URL
local_url = OM_LOCAL_HOST_URL
query = str(OM_query).strip().lower()
as_json = OM_OPT_JSON.lower() == "true"

def fetch(url, path, timeout=3):
    try:
        req = urllib.request.Request(url + path, headers={'User-Agent': 'kimo'})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode('utf-8'))
    except Exception:
        return {}

mode = OM_HOST_MODE
if mode == 'multi':
    hosts = [(u.split('://', 1)[-1], u) for u in OM_MULTI_HOSTS.split()]
elif mode == 'custom':
    hosts = [('custom', OM_TARGET_HOST)]
else:
    hosts = [('local', local_url), ('remote', remote_url)]

active = set()
for _, url in hosts:
    for m in fetch(url, '/api/ps').get('models', []):
        if m.get('name'):
            active.add(m['name'])

pins = {}
try:
    with open('/var/lib/ollama/streamed-models.json') as f:
        pins = json.load(f) or {}
except Exception:
    pins = {}

tuned = {}
try:
    with open('/var/lib/ollama/tunings.json') as f:
        tuned = json.load(f) or {}
except Exception:
    tuned = {}

rows = []
for label, url in hosts:
    for m in fetch(url, '/api/tags').get('models', []):
        name = m.get('name', '')
        details = m.get('details') or {}
        family = str(details.get('family', '')).lower()
        param = str(details.get('parameter_size', '')).lower()
        caps = str(' '.join(details.get('capabilities') or [])).lower()
        hay = f"{name} {family} {param} {caps}".lower()
        if query not in hay:
            continue
        rows.append({
            'name': name,
            'host': label,
            'size_gb': m.get('size', 0) / (1024 ** 3),
            'param': details.get('parameter_size', '-'),
            'active': name in active,
            'pinned': name in pins,
            'tuned': name in tuned,
        })

if as_json:
    print(json.dumps(rows, indent=2))
    sys.exit(0)

C_RESET = OM_C_RESET
C_BOLD = OM_C_BOLD
C_GREEN = OM_C_GREEN
C_YELLOW = OM_C_YELLOW
C_DIM = OM_C_DIM

if not rows:
    print(f"{C_YELLOW}No models matching \"{query}\" found.{C_RESET}")
    sys.exit(0)

hw = max(8, max(len(r['host']) for r in rows))
fmt = "{:<44} {:<" + str(hw) + "} {:<9} {:<14} {:<9} {:<9} {:<7}"
print(f"{C_BOLD}" + fmt.format("NAME", "HOST", "SIZE", "PARAMS", "VRAM", "PINNED", "TUNED") + f"{C_RESET}")
print("-" * (96 + hw))
for r in sorted(rows, key=lambda x: x['name']):
    vram = f"{C_GREEN}● ACTIVE{C_RESET}" if r['active'] else f"{C_DIM}-{C_RESET}"
    pin = f"{C_GREEN}yes{C_RESET}" if r['pinned'] else f"{C_DIM}-{C_RESET}"
    tun = f"{C_YELLOW}yes{C_RESET}" if r['tuned'] else f"{C_DIM}-{C_RESET}"
    print(fmt.format(r['name'], r['host'], f"{r['size_gb']:.1f} GB", r['param'], vram, pin, tun))

print(f"\n{C_DIM}Matches: {len(rows)}{C_RESET}\n")
