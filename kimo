merged_models.sort(key=lambda x: x.get('name', ''))

hw = max(10, max(len(m.get('source_host', '')) for m in merged_models))
fmt = "{:<44} {:<" + str(hw) + "} {:<11} {:<24} {:<14} {:<12}"
print(f"{C_BOLD}" + fmt.format("NAME", "HOST", "SIZE", "FAMILY / PARAMS", "VRAM STATE", "MODIFIED") + f"{C_RESET}")
print("-" * (110 + hw))

for m in merged_models:
    name = m.get('name', '')
    host = m.get('source_host', '')
    size_b = m.get('size', 0)
    size_str = f"{size_b / (1024**3):.1f} GB" if size_b else '-'
    
    details = m.get('details') or {}
    param = details.get('parameter_size') or '-'
    family = details.get('family') or '-'
