rotate_token_usage() {
    cat <<EOF
${C_BOLD}kimo rotate-token${C_RESET} – Rotate public API bearer token

${C_YELLOW}Usage:${C_RESET}
  ${0##*/} rotate-token [options]

${C_YELLOW}Options:${C_RESET}
  ${C_CYAN}-y, --yes, --force${C_RESET}          Bypass confirmation prompt
  ${C_CYAN}--show-token${C_RESET}                Display unmasked token in output
  ${C_CYAN}--file <path>${C_RESET}               Custom token file path (default: \${KIMO_TOKEN_FILE:-/etc/apache2/ollama-api.token})
  ${C_CYAN}--domain <domain>${C_RESET}           Public endpoint domain (default: \${KIMO_PUBLIC_DOMAIN:-www.kalidroid.com})
  ${C_CYAN}--render-script <path>${C_RESET}      Proxy render script path (default: \${KIMO_PROXY_RENDER_SCRIPT:-/root/render-ollama-proxy.sh})
  ${C_CYAN}--verify / --no-verify${C_RESET}       Force or bypass live live curl verification (default: auto)
  ${C_CYAN}--reload / --no-reload${C_RESET}       Force or skip proxy re-render + Apache configtest/reload
                              (default: on, except for an ad-hoc --file without --render-script)
  ${C_CYAN}-h, --help${C_RESET}                  Show this help message

${C_YELLOW}Environment Overrides:${C_RESET}
  ${C_BOLD}KIMO_TOKEN_FILE${C_RESET}             Token file path
  ${C_BOLD}KIMO_PUBLIC_DOMAIN${C_RESET}          Public domain
  ${C_BOLD}KIMO_PROXY_RENDER_SCRIPT${C_RESET}    Proxy render script
EOF
}

cmd_rotate_token() {
    local force=false
    local show_token=false
    local do_verify="auto"
    local do_proxy="auto"
    local file_given=false
    local tfile="${KIMO_TOKEN_FILE:-/etc/apache2/ollama-api.token}"
    local render_script="${KIMO_PROXY_RENDER_SCRIPT:-/root/render-ollama-proxy.sh}"
    local public_domain="${KIMO_PUBLIC_DOMAIN:-www.kalidroid.com}"
    local public_url="${KIMO_PUBLIC_URL:-https://${public_domain}/ollama}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --file|--domain|--render-script)
                # A missing value must be an error: 'shift 2' on the last
                # argument shifts nothing and the loop would spin forever.
                if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
                    echo "${C_RED}Error: $1 requires a value.${C_RESET}" >&2
                    return 1
                fi
                ;;
        esac
        case "$1" in
            -y|--yes|--force) force=true; shift ;;
            --show-token) show_token=true; shift ;;
            --verify) do_verify="true"; shift ;;
            --no-verify) do_verify="false"; shift ;;
            --file) tfile="$2"; file_given=true; shift 2 ;;
            --domain) public_domain="$2"; public_url="https://${public_domain}/ollama"; shift 2 ;;
            --render-script)
                render_script="$2"
                [[ "${do_proxy}" == "auto" ]] && do_proxy="true"
                shift 2
                ;;
            --reload) do_proxy="true"; shift ;;
            --no-reload) do_proxy="false"; shift ;;
            -h|--help) rotate_token_usage; return 0 ;;
            *)
                # Never fall back to the production defaults on a typo.
                echo "${C_RED}Error: unknown rotate-token option '$1' (see --help).${C_RESET}" >&2
                return 1
                ;;
        esac
    done

    if [[ "${do_verify}" == "auto" ]]; then
        if [[ "${tfile}" == "/etc/apache2/ollama-api.token" ]]; then
            do_verify="true"
        else
            do_verify="false"
        fi
    fi
    # An ad-hoc --file is not the token the live proxy serves: re-rendering and
    # reloading Apache for it would push the production token through the real
    # render script, so that needs an explicit --reload or --render-script.
    if [[ "${do_proxy}" == "auto" ]]; then
        if ${file_given}; then
            do_proxy="false"
        else
            do_proxy="true"
        fi
    fi

    if [[ ! -f "${tfile}" ]]; then
        echo "${C_RED}Error: Token file '${tfile}' not found.${C_RESET}" >&2
        return 1
    fi
    local old=""
    old=$(awk '{print $2}' "${tfile}" 2>/dev/null || true)

    if ! ${force}; then
        read -r -p "Rotate the public API token? This invalidates ${public_url} auth for all clients. [y/N] " ans
        [[ "${ans}" == "y" || "${ans}" == "Y" ]] || { echo "Aborted."; return 0; }
    fi

    local new
    new=$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
    cp -a "${tfile}" "${tfile}.bk"
    printf 'token %s\n' "${new}" > "${tfile}"
    chmod 640 "${tfile}" 2>/dev/null || true
    chown root:www-data "${tfile}" 2>/dev/null || true

    local apache_reloaded=false
    if [[ "${do_proxy}" == "true" ]]; then
        if [[ -x "${render_script}" ]]; then
            if ! "${render_script}"; then
                cp -a "${tfile}.bk" "${tfile}"
                echo "${C_RED}[!] Proxy render failed; old token restored.${C_RESET}" >&2
                return 1
            fi
        fi

        if command -v apache2ctl >/dev/null 2>&1; then
            if ! apache2ctl configtest >/dev/null 2>&1; then
                cp -a "${tfile}.bk" "${tfile}"
                [[ -x "${render_script}" ]] && "${render_script}" || true
                echo "${C_RED}[!] Apache configtest failed; rolled back to previous token.${C_RESET}" >&2
                return 1
            fi
        fi

        if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet apache2 2>/dev/null; then
            if ! systemctl reload apache2 2>/dev/null; then
                # The running proxy still serves the old token: hand that back
                # rather than reporting a rotation clients cannot use.
                cp -a "${tfile}.bk" "${tfile}"
                [[ -x "${render_script}" ]] && "${render_script}" || true
                echo "${C_RED}[!] Apache reload failed; rolled back to previous token (the running proxy still accepts it).${C_RESET}" >&2
                return 1
            fi
            apache_reloaded=true
        fi
    fi

    local old_code="" new_code="" url="${public_url}/api/tags"
    if [[ "${apache_reloaded}" == "true" && "${do_verify}" == "true" ]]; then
        # curl_bearer keeps both tokens out of argv (ps, /proc/*/cmdline).
        new_code=$(curl_bearer "${new}" -s --resolve "${public_domain}:443:127.0.0.1" -m 8 -o /dev/null -w '%{http_code}' "${url}" 2>/dev/null || true)
        old_code=$(curl_bearer "${old}" -s --resolve "${public_domain}:443:127.0.0.1" -m 8 -o /dev/null -w '%{http_code}' "${url}" 2>/dev/null || true)
        if [[ "${new_code}" != "200" || "${old_code}" == "200" ]]; then
            cp -a "${tfile}.bk" "${tfile}"
            [[ -x "${render_script}" ]] && "${render_script}" || true
            systemctl reload apache2 2>/dev/null || true
            echo "${C_RED}[!] Live verification failed (new=${new_code:-down}, old=${old_code:-down}); rolled back to previous token.${C_RESET}" >&2
            return 1
        fi
    fi

    local masked_token="${new:0:8}...${new: -4}"
    local display_token="${masked_token}"
    if [[ "${show_token}" == "true" ]]; then
        display_token="${new}"
    fi

    if [[ "${apache_reloaded}" == "true" && "${do_verify}" == "true" ]]; then
        echo "${C_GREEN}[✓] Token rotated and verified (new: HTTP ${new_code}, old: HTTP ${old_code}). Previous token kept at ${tfile}.bk.${C_RESET}"
    else
        echo "${C_GREEN}[✓] Token rotated in ${tfile}. Previous token kept at ${tfile}.bk.${C_RESET}"
    fi
    if [[ "${do_proxy}" != "true" ]]; then
        echo "${C_DIM}  proxy    : not re-rendered or reloaded (pass --reload to apply it to Apache)${C_RESET}"
    fi
    echo "  endpoint : ${public_url}"
    echo "  new token: ${display_token}"
    if [[ "${show_token}" == "true" ]]; then
        echo "  curl     : curl -H 'Authorization: Bearer ${new}' ${public_url}/api/tags"
    else
        echo "  curl     : curl -H 'Authorization: Bearer <TOKEN>' ${public_url}/api/tags (pass --show-token to view plaintext)"
    fi
    return 0
}
