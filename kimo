}

# -----------------------------------------------------------------------------
# Command: tag / alias
# -----------------------------------------------------------------------------
cmd_tag() {
    reject_model_options "tag <source_model> <target_tag>" "$@"
    local src="${1:-}"
    local dst="${2:-}"

    if [[ -z "${src}" || -z "${dst}" ]]; then
        echo "${C_RED}Error: 'tag' requires <source> and <destination> model names.${C_RESET}" >&2
        echo "Usage: ${0##*/} tag <source_model> <target_tag>" >&2
        exit 1
    fi

    local target_host="${TARGET_HOST}"
    if [[ -z "${target_host}" ]]; then
        if is_remote_model "${src}" && ! is_local_model "${src}"; then
            target_host="${REMOTE_HOST_URL}"
        else
            target_host="${LOCAL_HOST_URL}"
        fi
    fi

    echo "Creating alias on ${target_host}: '${dst}' -> '${src}'..."
    local resp
    resp=$(curl -s --connect-timeout 5 -m 60 -w "%{http_code}" -X POST "${target_host}/api/copy" \
        -H "Content-Type: application/json" \
        -d "$(jq -nc --arg s "${src}" --arg d "${dst}" '{source: $s, destination: $d}')") || resp="000"

    local code="${resp: -3}"
    if [[ "${code}" == "200" ]]; then
        echo "${C_GREEN}[✓] Successfully created tag '${dst}' pointing to '${src}' on ${target_host}.${C_RESET}"
    else
        echo "${C_RED}[!] Failed to create tag (HTTP ${code}): ${resp%???}${C_RESET}" >&2
        exit 1
    fi
}

# -----------------------------------------------------------------------------
# Command: rm / delete
# -----------------------------------------------------------------------------
# exact_model_name <host_url> <model>: the installed name equal to <model> or
# <model>:latest. Deletion never uses resolve_model_name's prefix/substring
# fallbacks, which could select a different model.
exact_model_name() {
    # An unreachable host just has no match; under pipefail a failed curl must
    # not abort the caller (set -e) before it can try the next host.
    curl -s --connect-timeout 3 -m 8 "$1/api/tags" 2>/dev/null \
        | jq -r --arg t "$2" '.models[]?.name | select(. == $t or . == ($t + ":latest"))' 2>/dev/null \
        | head -n1 || true
}

cmd_rm() {
    local usage="rm <model>... [-y|--yes]" assume_yes=false arg
    local -a names=()
    for arg in "$@"; do
        case "${arg}" in
            -y|--yes|--force) assume_yes=true ;;
            *) names+=("${arg}") ;;
        esac
    done
    reject_model_options "${usage}" "${names[@]}"
    if [[ ${#names[@]} -eq 0 ]]; then
        echo "${C_RED}Error: 'rm' requires at least one model name.${C_RESET}" >&2
        echo "Usage: ${0##*/} ${usage}" >&2
        exit 1
    fi

    # Hosts to search, in order: every --host, the one chosen host, or local
    # then remote in auto mode. Each model is deleted only where its exact name
    # (or <name>:latest) is installed - never on a guessed host.
    local -a hosts=()
    if [[ "${HOST_MODE}" == "multi" ]]; then
        hosts=("${OPT_HOSTS[@]}")
    elif [[ -n "${TARGET_HOST}" ]]; then
        hosts=("${TARGET_HOST}")
    else
        hosts=("${LOCAL_HOST_URL}" "${REMOTE_HOST_URL}")
    fi

    # Resolve everything first: one missing name aborts before any deletion.
    local -a plan_host=() plan_model=() missing=()
    local name host exact found
    for name in "${names[@]}"; do
        found=false
        for host in "${hosts[@]}"; do
            exact=$(exact_model_name "${host}" "${name}")
            if [[ -n "${exact}" ]]; then
                plan_host+=("${host}")
                plan_model+=("${exact}")
                found=true
                break
            fi
        done
        ${found} || missing+=("${name}")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "${C_RED}Error: not installed on ${hosts[*]} (exact name required; see 'kimo list'): ${missing[*]}${C_RESET}" >&2
        echo "${C_DIM}Nothing was deleted.${C_RESET}" >&2
        exit 1
    fi

    local i n=${#plan_model[@]}
    if ! ${assume_yes}; then
        if [[ ! -t 0 ]]; then
            echo "${C_RED}Error: refusing to delete ${n} model(s) without confirmation; pass --yes.${C_RESET}" >&2
            for ((i = 0; i < n; i++)); do echo "  ${plan_model[i]} (${plan_host[i]})" >&2; done
            exit 1
        fi
        echo "About to delete:"
        for ((i = 0; i < n; i++)); do echo "  ${plan_model[i]}  ${C_DIM}from ${plan_host[i]}${C_RESET}"; done
        local ans=""
        read -r -p "Delete ${n} model(s)? [y/N] " ans || true
        [[ "${ans}" == "y" || "${ans}" == "Y" ]] || { echo "Aborted."; return 0; }
    fi

    local resp code failed=0
    for ((i = 0; i < n; i++)); do
        echo "Deleting model '${plan_model[i]}' from ${plan_host[i]}..."
        resp=$(curl -s --connect-timeout 5 -m 60 -w "%{http_code}" -X DELETE "${plan_host[i]}/api/delete" \
            -H "Content-Type: application/json" \
            -d "$(jq -nc --arg n "${plan_model[i]}" '{name: $n}')") || resp="000"
        code="${resp: -3}"
        if [[ "${code}" == "200" ]]; then
            echo "${C_GREEN}[✓] Successfully deleted model '${plan_model[i]}' from ${plan_host[i]}.${C_RESET}"
        else
            echo "${C_RED}[!] Failed to delete '${plan_model[i]}' (HTTP ${code}): ${resp%???}${C_RESET}" >&2
            failed=$((failed + 1))
        fi
    done
    if [[ ${failed} -gt 0 ]]; then
        echo "${C_RED}[!] ${failed} of ${n} deletion(s) failed.${C_RESET}" >&2
        exit 1
    fi
}

# -----------------------------------------------------------------------------
# Command: tune
# -----------------------------------------------------------------------------
cmd_tune() {
    reject_model_options "tune <model> [--ctx <N>] [--batch <N>] [--predict <N>] [--temp <F>] [--num-gpu <N>] [--target <name>] | --show | --clear" "${1:-}"
    local source_model="${1:-}"
    if [[ -z "${source_model}" ]]; then
        echo "${C_RED}Error: 'tune' requires a model name.${C_RESET}" >&2
        echo "Usage: ${0##*/} tune <model> [--ctx <N>] [--batch <N>] [--predict <N>] [--temp <F>] [--num-gpu <N>] [--target <name>]" >&2
        echo "       ${0##*/} tune <model> --show | --clear" >&2
        exit 1
    fi
    shift

    local opt_ctx=""
    local opt_batch=""
    local opt_predict=""
    local opt_temp=""
    local opt_num_gpu=""
    local opt_target=""
    local opt_show=false
    local opt_clear=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ctx|--batch|--predict|--temp|--temperature|--num-gpu|--gpu|--target|--name) require_value "$@" ;;&
            --ctx) opt_ctx="$2"; shift 2 ;;
            --batch) opt_batch="$2"; shift 2 ;;
            --predict) opt_predict="$2"; shift 2 ;;
            --temp|--temperature) opt_temp="$2"; shift 2 ;;
            --num-gpu|--gpu) opt_num_gpu="$2"; shift 2 ;;
            --target|--name) opt_target="$2"; shift 2 ;;
            --show|--preview) opt_show=true; shift ;;
            --clear|--unset) opt_clear=true; shift ;;
            -h|--help) reject_model_options "tune <model> [--ctx <N>] [--batch <N>] [--predict <N>] [--temp <F>] [--num-gpu <N>] [--target <name>] | --show | --clear" "$1" ;;
            *) echo "${C_RED}Unknown tune option: $1${C_RESET}" >&2; exit 1 ;;
        esac
    done

    local active_host=""
    local resolved_source="${source_model}"
    if [[ -n "${TARGET_HOST}" ]]; then
        active_host="${TARGET_HOST}"
        local res
        res=$(resolve_model_name "${source_model}" "${active_host}" || true)
        [[ -n "${res}" ]] && resolved_source="${res}"
    else
        local local_res
        local_res=$(resolve_model_name "${source_model}" "${LOCAL_HOST_URL}" || true)
        if [[ -n "${local_res}" ]]; then
            resolved_source="${local_res}"
            active_host="${LOCAL_HOST_URL}"
        else
            local remote_res
            remote_res=$(resolve_model_name "${source_model}" "${REMOTE_HOST_URL}" || true)
            if [[ -n "${remote_res}" ]]; then
                resolved_source="${remote_res}"
                active_host="${REMOTE_HOST_URL}"
            else
                active_host="${LOCAL_HOST_URL}"
            fi
        fi
    fi

    local target_name="${opt_target:-${resolved_source}}"

    # Inspect or clear the baked per-model defaults (registry only).
    if ${opt_show} || ${opt_clear}; then
        if ${opt_show}; then
            local cur
            cur=$(tuned_params "${resolved_source}" || true)
            if [[ -n "${cur}" ]]; then
                echo "${C_CYAN}Tuned defaults for '${resolved_source}':${C_RESET}"
                echo "${cur}" | python3 -m json.tool | sed 's/^/    /'
            else
                echo "${C_DIM}No tuned defaults registered for '${resolved_source}'.${C_RESET}"
            fi
        fi
        if ${opt_clear}; then
            python3 -c '
import json, os, sys
f = sys.argv[1]
m = sys.argv[2]
if not os.path.exists(f):
    sys.exit(0)
d = json.load(open(f)) or {}
removed = d.pop(m, None)
if removed is not None:
    tmp = f + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(d, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, f)
    print("removed:" + m)
else:
    print("absent")' "${TUNINGS_FILE}" "${resolved_source}" || true
            echo "${C_GREEN}[✓] Cleared tuned defaults for '${resolved_source}'.${C_RESET}"
        fi
        exit 0
    fi

    echo "${C_CYAN}[*] Tuning model '${resolved_source}' on ${active_host}...${C_RESET}"

    OM_active_host="${active_host}" OM_resolved_source="${resolved_source}" OM_target_name="${target_name}" OM_TUNINGS_FILE="${TUNINGS_FILE}" OM_opt_ctx="${opt_ctx}" OM_opt_batch="${opt_batch}" OM_opt_predict="${opt_predict}" OM_opt_temp="${opt_temp}" OM_opt_num_gpu="${opt_num_gpu}" \
        python3 - <<'PYEOF'
import os as _om_os
OM_active_host = _om_os.environ["OM_active_host"]
OM_resolved_source = _om_os.environ["OM_resolved_source"]
OM_target_name = _om_os.environ["OM_target_name"]
OM_TUNINGS_FILE = _om_os.environ["OM_TUNINGS_FILE"]
OM_opt_ctx = _om_os.environ["OM_opt_ctx"]
OM_opt_batch = _om_os.environ["OM_opt_batch"]
OM_opt_predict = _om_os.environ["OM_opt_predict"]
OM_opt_temp = _om_os.environ["OM_opt_temp"]
OM_opt_num_gpu = _om_os.environ["OM_opt_num_gpu"]
import json
import os
import sys
import urllib.request

host = OM_active_host
source = OM_resolved_source
target = OM_target_name
tunings_file = OM_TUNINGS_FILE

params = {}
if OM_opt_ctx:
    params["num_ctx"] = int(OM_opt_ctx)
if OM_opt_batch:
    params["num_batch"] = int(OM_opt_batch)
if OM_opt_predict:
    params["num_predict"] = int(OM_opt_predict)
if OM_opt_temp:
    params["temperature"] = float(OM_opt_temp)
if OM_opt_num_gpu:
    params["num_gpu"] = int(OM_opt_num_gpu)

if not params:
    print("\033[0;31mError: No tuning options specified (e.g. --ctx 65536, --batch 2048, --predict 8192).\033[0m", file=sys.stderr)
    sys.exit(1)

# 1) Persist as per-model defaults so 'run'/'launch' apply them automatically
#    (baked per-model tuning; the base model manifest is left untouched).
tunings = {}
if os.path.exists(tunings_file):
    try:
        with open(tunings_file, "r", encoding="utf-8") as f:
            tunings = json.load(f) or {}
    except Exception:
        tunings = {}
tunings[source] = params
tmp = tunings_file + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(tunings, f, indent=2, sort_keys=True)
    f.write("\n")
os.replace(tmp, tunings_file)

print(f"\033[0;32m[✓] Registered tuned defaults for '{source}' (applies to run/launch):\033[0m")
for k, v in params.items():
    print(f"    • {k}: {v}")

# 2) Optionally create a standalone tuned variant when --target is given.
if target != source:
    payload = {
        "name": target,
        "from": source,
        "parameters": params,
        "stream": False
    }
    req = urllib.request.Request(
        f"{host}/api/create",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=45) as resp:
            res = json.loads(resp.read().decode("utf-8"))
            if res.get("status") == "success":
                print(f"\033[0;32m[✓] Created tuned variant '{target}' on {host}. (registry kept under '{source}')\033[0m")
            else:
                print(f"\033[0;31m[!] Failed to create variant: {res}\033[0m", file=sys.stderr)
                sys.exit(1)
    except Exception as e:
        print(f"\033[0;31m[!] HTTP error: {e}\033[0m", file=sys.stderr)
        sys.exit(1)
else:
    print("\033[0;36m[*] No --target given: defaults baked for run/launch (base model untouched).\033[0m")
PYEOF
}

# -----------------------------------------------------------------------------
# Command: bench / eval
# -----------------------------------------------------------------------------
cmd_bench() {
    local target_model=""
    local predict_tokens=60
    local temperature=0.2
    local custom_prompt=""
    local opt_json=false

    ${OPT_JSON} && opt_json=true

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--prompt)
                require_value "$@"
                custom_prompt="$2"
                shift 2
                ;;
            --prompt=*)
                custom_prompt="${1#*=}"
                shift
                ;;
            -n|--predict|--tokens)
                require_value "$@"
                predict_tokens="$2"
                shift 2
                ;;
            --predict=*|--tokens=*)
                predict_tokens="${1#*=}"
                shift
                ;;
            --temp|--temperature)
                require_value "$@"
                temperature="$2"
                shift 2
                ;;
            --temp=*|--temperature=*)
                temperature="${1#*=}"
                shift
                ;;
            --json)
                opt_json=true
                shift
                ;;
            --remote)
                TARGET_HOST="${REMOTE_HOST_URL}"
                shift
                ;;
            --local)
                TARGET_HOST="${LOCAL_HOST_URL}"
                shift
                ;;
            --host)
                require_value "$@"
                TARGET_HOST="$(normalize_host_url "$2")"
                shift 2
                ;;
            --host=*)
                TARGET_HOST="$(normalize_host_url "${1#*=}")"
                shift
                ;;
            -h|--help)
                echo "${C_BOLD}kimo bench${C_RESET} – Benchmark model performance, TTFT, throughput & VRAM residency"
                echo ""
                echo "${C_YELLOW}Usage:${C_RESET}"
                echo "  ${0##*/} bench [model] [options]"
                echo ""
                echo "${C_YELLOW}Options:${C_RESET}"
                echo "  -p, --prompt <text>     Custom evaluation prompt string"
                echo "  -n, --predict <tokens>  Number of tokens to generate (default: 60)"
                echo "  --temp <val>            Sampling temperature (default: 0.2)"
                echo "  --json                  Output benchmark results in structured JSON"
                echo "  --remote                Run benchmark on remote GPU server"
                echo "  --local                 Run benchmark on local Ollama daemon"
                echo "  --host <addr>           Target specific Ollama host"
                echo "  -h, --help              Show this help message"
                return 0
                ;;
            -*)
                echo "${C_RED}Error: Unknown option '$1' for bench.${C_RESET}" >&2
                return 1
                ;;
            *)
                if [[ -z "${target_model}" ]]; then
                    target_model="$1"
                fi
                shift
                ;;
        esac
    done

    local active_host=""
    local resolved_model="${target_model}"

    if [[ -n "${TARGET_HOST}" ]]; then
        active_host="${TARGET_HOST}"
    else
        active_host="${REMOTE_HOST_URL}"
    fi

    if [[ -z "${resolved_model}" ]]; then
        local vram_model
        vram_model=$(curl -s --connect-timeout 2 -m 3 "${active_host}/api/ps" 2>/dev/null | jq -r '.models[0].name // empty' 2>/dev/null || true)
        if [[ -n "${vram_model}" ]]; then
            resolved_model="${vram_model}"
        else
            resolved_model="kalidroid-27b:latest"
        fi
    fi

    local res
    res=$(resolve_model_name "${resolved_model}" "${active_host}" || true)
    [[ -n "${res}" ]] && resolved_model="${res}"

    if ! ${opt_json}; then
        echo "${C_CYAN}[*] Benchmarking '${resolved_model}' on ${active_host} (generating ${predict_tokens} tokens)...${C_RESET}"
    fi

    OM_ACTIVE_HOST="${active_host}" OM_RESOLVED_MODEL="${resolved_model}" OM_PREDICT_TOKENS="${predict_tokens}" \
    OM_TEMPERATURE="${temperature}" OM_CUSTOM_PROMPT="${custom_prompt}" OM_OPT_JSON="${opt_json}" \
    OM_C_RESET="${C_RESET}" OM_C_BOLD="${C_BOLD}" OM_C_GREEN="${C_GREEN}" OM_C_YELLOW="${C_YELLOW}" OM_C_CYAN="${C_CYAN}" OM_C_MAGENTA="${C_MAGENTA}" OM_C_RED="${C_RED}" OM_C_DIM="${C_DIM}" \
        python3 - <<'PYEOF'
import os, sys, json, time, urllib.request, urllib.error

host = os.environ.get("OM_ACTIVE_HOST", "http://127.0.0.1:11434")
model = os.environ.get("OM_RESOLVED_MODEL", "")
tokens_to_predict = int(os.environ.get("OM_PREDICT_TOKENS", "60"))
temp = float(os.environ.get("OM_TEMPERATURE", "0.2"))
custom_prompt = os.environ.get("OM_CUSTOM_PROMPT", "")
as_json = os.environ.get("OM_OPT_JSON", "false").lower() == "true"

C_RESET = os.environ.get("OM_C_RESET", "")
C_BOLD = os.environ.get("OM_C_BOLD", "")
C_GREEN = os.environ.get("OM_C_GREEN", "")
C_YELLOW = os.environ.get("OM_C_YELLOW", "")
C_CYAN = os.environ.get("OM_C_CYAN", "")
C_MAGENTA = os.environ.get("OM_C_MAGENTA", "")
C_RED = os.environ.get("OM_C_RED", "")
C_DIM = os.environ.get("OM_C_DIM", "")

prompt = custom_prompt if custom_prompt else "Explain the fundamental architecture differences between CPU and GPU memory bandwidth in 3 concise paragraphs."

payload = {
    "model": model,
    "prompt": prompt,
    "stream": True,
    "options": {
        "num_predict": tokens_to_predict,
        "temperature": temp
    }
}

req = urllib.request.Request(
    f"{host.rstrip('/')}/api/generate",
    data=json.dumps(payload).encode("utf-8"),
    headers={"Content-Type": "application/json"}
)

start_wall = time.time()
ttft_wall = None
gen_tokens = 0
final_data = {}

try:
    with urllib.request.urlopen(req, timeout=300) as resp:
        for raw_line in resp:
            line = raw_line.decode("utf-8", errors="replace").strip()
            if not line:
                continue
            try:
                chunk = json.loads(line)
            except Exception:
                continue

            if "error" in chunk:
                if not as_json and sys.stdout.isatty():
                    sys.stdout.write("\n")
                sys.stderr.write(f"{C_RED}[!] Benchmark error: {chunk['error']}{C_RESET}\n")
                sys.exit(1)

            if chunk.get("response"):
                if ttft_wall is None:
                    ttft_wall = time.time() - start_wall
                gen_tokens += 1
                if not as_json and sys.stdout.isatty():
                    sys.stdout.write(f"\r\033[2K  {C_DIM}[*] Generating tokens: {gen_tokens}/{tokens_to_predict}...{C_RESET}")
                    sys.stdout.flush()

            if chunk.get("done"):
                final_data = chunk

except urllib.error.HTTPError as e:
    err_body = e.read().decode("utf-8", errors="replace")
    if as_json:
        print(json.dumps({"error": f"HTTP {e.code}: {err_body or e.reason}"}, indent=2))
    else:
        sys.stderr.write(f"\n{C_RED}[!] Benchmark failed (HTTP {e.code}): {err_body or e.reason}{C_RESET}\n")
    sys.exit(1)
except Exception as e:
    if as_json:
        print(json.dumps({"error": str(e)}, indent=2))
    else:
        sys.stderr.write(f"\n{C_RED}[!] Benchmark failed: {e}{C_RESET}\n")
    sys.exit(1)

end_wall = time.time()
if not as_json and sys.stdout.isatty():
    sys.stdout.write("\r\033[2K")
    sys.stdout.flush()

vram_used_bytes = 0
total_model_bytes = 0
gpu_pct = 0.0
vram_used_str = "N/A"
gpu_pct_str = "N/A"

try:
    ps_req = urllib.request.Request(f"{host.rstrip('/')}/api/ps")
    with urllib.request.urlopen(ps_req, timeout=5) as ps_resp:
        ps_data = json.loads(ps_resp.read().decode("utf-8"))
        for m in ps_data.get("models", []):
            m_name = m.get("name", "")
            if m_name == model or m.get("model") == model or f"{m_name}:latest" == model or m_name.startswith(model):
                vram_used_bytes = m.get("size_vram", 0)
                total_model_bytes = m.get("size", 1)
                vram_used_str = f"{vram_used_bytes / (1024**3):.2f} GB"
                gpu_pct = (vram_used_bytes / total_model_bytes) * 100.0 if total_model_bytes else 0.0
                gpu_pct_str = f"{gpu_pct:.1f}% GPU"
                break
except Exception:
    pass

p_count = final_data.get("prompt_eval_count", 0)
p_dur_ns = final_data.get("prompt_eval_duration", 0)
e_count = final_data.get("eval_count", gen_tokens)
e_dur_ns = final_data.get("eval_duration", 0)

prompt_tps = (p_count / (p_dur_ns / 1e9)) if p_dur_ns > 0 else 0.0
eval_tps = (e_count / (e_dur_ns / 1e9)) if e_dur_ns > 0 else 0.0
ttft_ms = (p_dur_ns / 1e6) if p_dur_ns > 0 else ((ttft_wall * 1000.0) if ttft_wall else 0.0)

if as_json:
    out = {
        "model": model,
        "host": host,
        "prompt": prompt,
        "vram": {
            "used_bytes": vram_used_bytes,
            "used_gb": round(vram_used_bytes / (1024**3), 2),
            "total_bytes": total_model_bytes,
            "percent_gpu": round(gpu_pct, 1)
        },
        "prompt_eval": {
            "tokens": p_count,
            "duration_ms": round(p_dur_ns / 1e6, 2),
            "tokens_per_second": round(prompt_tps, 2)
        },
        "generation": {
            "tokens": e_count,
            "duration_ms": round(e_dur_ns / 1e6, 2),
            "tokens_per_second": round(eval_tps, 2)
        },
        "time_to_first_token_ms": round(ttft_ms, 2),
        "total_elapsed_sec": round(end_wall - start_wall, 2)
    }
    print(json.dumps(out, indent=2))
    sys.exit(0)

print()
print(f"{C_BOLD}BENCHMARK RESULTS: {model}{C_RESET}")
print("═" * 60)
print(f"  Target Host:           {host}")
print(f"  Memory Allocation:     {C_MAGENTA}{vram_used_str} ({gpu_pct_str}){C_RESET}")
print(f"  Prompt Prefill Tokens: {p_count} tokens")
print(f"  Time To First Token:   {C_YELLOW}{ttft_ms:.1f} ms{C_RESET}")
print(f"  Prompt Prefill Speed:  {C_GREEN}{prompt_tps:.2f} tokens/sec{C_RESET}")
print(f"  Generated Tokens:      {e_count} tokens")
print(f"  Generation Speed:      {C_GREEN}{eval_tps:.2f} tokens/sec{C_RESET}")
print(f"  Total Elapsed Time:    {end_wall - start_wall:.2f}s")
print("═" * 60)
PYEOF
}

# -----------------------------------------------------------------------------
# Command: stream
# -----------------------------------------------------------------------------
cmd_stream() {
    if [[ -z "${1:-}" ]]; then
        echo "${C_RED}Error: 'stream' requires a model name (or command flag).${C_RESET}" >&2
        echo "Usage: ${0##*/} stream <model> [--pull] [--keepalive DUR] [--no-warm] [--dry-run] [--json]" >&2
        echo "       ${0##*/} stream --status [--json]      (show tunnel health, latency, VRAM footprint, countdowns)" >&2
        echo "       ${0##*/} stream --test [model] [--json](run 1-token generation smoke test across tunnel)" >&2
        echo "       ${0##*/} stream --all                  (pin & keep every hosted model available; rotate-warms)" >&2
        echo "       ${0##*/} stream --repair-all           (reconcile + rotate-warm pins; keepalive timer)" >&2
        echo "       ${0##*/} stream --resident-only        (refresh keepalive only for active VRAM models; zero thrashing)" >&2
        echo "       ${0##*/} stream --unpin <model>        (remove a model pin from state file)" >&2
        echo "       ${0##*/} stream --unload <model>       (immediately evict model from remote VRAM; keep_alive: 0)" >&2
        echo "       ${0##*/} stream --list-pinned          (display pinned model catalog JSON)" >&2
        exit 1
    fi
    # Forward the resolved remote so stream_model.py never falls back to the
    # unreachable direct IP when the caller already selected a host.
    local extra_flags=()
    [[ "${OPT_JSON:-false}" == "true" ]] && extra_flags+=("--json")
    local stream_remote=""
    case "${HOST_MODE}" in
        custom|remote) stream_remote="${TARGET_HOST}" ;;
        local)         stream_remote="${REMOTE_HOST_URL}" ;;
    esac
    # resolve_remote_url() probes without the bridge token, so the tunnel's 401
    # makes it fall through to the Desktop daemon (:11436) - which then gets
    # saved as the pin's remote_url and bypasses bridge auth. Pins must go
    # through the tunnel (stream_model.py sends the token), so only forward a
    # remote the caller chose explicitly via --host or $OLLAMA_REMOTE_URL.
    if [[ -n "${stream_remote}" && -z "${OPT_HOST}" && -z "${OLLAMA_REMOTE_URL:-}" ]]; then
        stream_remote="${REMOTE_TUNNEL_URL}"
    fi
    if [[ -n "${stream_remote}" ]]; then
        exec python3 /root/stream_model.py --remote "${stream_remote}" "${extra_flags[@]}" "$@"
    fi
    exec python3 /root/stream_model.py "${extra_flags[@]}" "$@"
}

# -----------------------------------------------------------------------------
# Command: run
# -----------------------------------------------------------------------------
cmd_run() {
    # Only the model is checked; arguments after it pass through unchanged.
    reject_model_options "run <model> [args...]" "${1:-}"
    # No model: fall back to KIMO_DEFAULT_MODEL / config default_model.
    if [[ -z "${1:-}" && -n "${KIMO_DEFAULT_MODEL:-}" ]]; then
        set -- "${KIMO_DEFAULT_MODEL}" "${@:2}"
    fi
    local model="${1:-}"
    if [[ -z "${model}" ]]; then
        echo "${C_RED}Error: 'run' requires a model name (or set one: ${0##*/} config set default_model <model>).${C_RESET}" >&2
        echo "Usage: ${0##*/} run <model> [args...]" >&2
        exit 1
    fi
    if ! launch_gh_check "${model}"; then
        return 1
    fi

    shift

    local active_host=""
    local resolved_model="${model}"

    if [[ -n "${TARGET_HOST}" ]]; then
        active_host="${TARGET_HOST}"
        local res
        res=$(resolve_model_name "${model}" "${active_host}" || true)
        [[ -n "${res}" ]] && resolved_model="${res}"
    else
        # Desktop GPU first: a model on both hosts must not land on the Pi, which
        # has no GPU - its bridge refuses anything over the 8 GiB budget, and a
        # direct load is OOM-killed by ollama-memory-guard.
        local local_res="" remote_first
        remote_first=$(resolve_model_name "${model}" "${REMOTE_HOST_URL}" || true)
        [[ -z "${remote_first}" ]] && local_res=$(resolve_model_name "${model}" "${LOCAL_HOST_URL}" || true)
        if [[ -n "${remote_first}" ]]; then
            resolved_model="${remote_first}"
            active_host="${REMOTE_HOST_URL}"
        elif [[ -n "${local_res}" ]]; then
            resolved_model="${local_res}"
            active_host="${LOCAL_HOST_URL}"
        else
            local remote_res
            remote_res=$(resolve_model_name "${model}" "${REMOTE_HOST_URL}" || true)
            if [[ -n "${remote_res}" ]]; then
                echo "${C_YELLOW}Model '${model}' found on remote server. Auto-streaming from ${REMOTE_HOST_IP} (using ${remote_res})...${C_RESET}"
                resolved_model="${remote_res}"
                active_host="${REMOTE_HOST_URL}"
            else
                active_host="${LOCAL_HOST_URL}"
            fi
        fi
    fi

    # Unload conflicting active models from target host to prevent CUDA memory collision
    evict_other_models "${active_host}" "${resolved_model}" always

    # Apply per-model tuned defaults baked in via 'tune' (raw resolved model).
    local tp
    tp=$(tuned_params "${resolved_model}" || true)
    if [[ -n "${tp}" ]]; then
        local nctx nbatch npredict ntemp
        nctx=$(echo "${tp}" | jq -r '.num_ctx? // empty')
        nbatch=$(echo "${tp}" | jq -r '.num_batch? // empty')
        npredict=$(echo "${tp}" | jq -r '.num_predict? // empty')
        ntemp=$(echo "${tp}" | jq -r '.temperature? // empty')
        if [[ -n "${nctx}" ]]; then
            export OLLAMA_CONTEXT_LENGTH="${nctx}"
        fi
        echo "${C_DIM}[*] Tuned defaults for '${resolved_model}': num_ctx=${nctx:--} num_batch=${nbatch:--} num_predict=${npredict:--} temperature=${ntemp:--}${C_RESET}"
    fi

    export OLLAMA_HOST="${active_host}"
    export OLLAMA_BASE_URL="${active_host}"
    export OPENAI_API_BASE="${active_host}/v1"
    export OPENAI_BASE_URL="${active_host}/v1"
    export OPENAI_API_KEY="${OPENAI_API_KEY:-ollama}"
    export API_BASE="${active_host}/v1"
    export ANTHROPIC_BASE_URL="${active_host}"
    export ANTHROPIC_API_BASE="${active_host}/v1"
    export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-ollama}"

    echo "${C_CYAN}Running model: ${resolved_model} on ${active_host}...${C_RESET}"
    exec ollama run "${resolved_model}" "$@"
}

# -----------------------------------------------------------------------------
# Command: pull / download
# -----------------------------------------------------------------------------
cmd_pull() {
    local target_model=""
    local opt_insecure=false
    local opt_json="${OPT_JSON:-false}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --insecure)
                opt_insecure=true
                shift
                ;;
            --json)
                opt_json=true
                shift
                ;;
            -h|--help)
                echo "${C_BOLD}kimo pull${C_RESET} – Pull a model from Ollama library / registry with live progress"
                echo ""
                echo "${C_YELLOW}Usage:${C_RESET}"
                echo "  ${0##*/} pull <model> [options]"
                echo ""
                echo "${C_YELLOW}Options:${C_RESET}"
                echo "  --insecure          Allow insecure connections to model registry"
                echo "  --remote            Pull to remote Ollama server"
                echo "  --local             Pull to local Ollama server"
                echo "  --host <addr>       Pull to specific Ollama host"
                echo "  --json              Output progress as JSON lines"
                echo "  -h, --help          Show this help message"
                return 0
                ;;
            -*)
                echo "${C_RED}Error: Unknown option '$1' for pull.${C_RESET}" >&2
                return 1
                ;;
            *)
                if [[ -z "${target_model}" ]]; then
                    target_model="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "${target_model}" ]]; then
        echo "${C_RED}Error: 'pull' requires a model name.${C_RESET}" >&2
        echo "Usage: ${0##*/} pull <model>" >&2
        return 1
    fi

    local target_host="${TARGET_HOST:-${LOCAL_HOST_URL}}"
    if ! ${opt_json}; then
        echo "${C_BOLD}Pulling model '${target_model}' to ${target_host}...${C_RESET}"
    fi

    OM_TARGET_HOST="${target_host}" OM_TARGET_MODEL="${target_model}" OM_INSECURE="${opt_insecure}" OM_OPT_JSON="${opt_json}" \
        OM_C_RESET="${C_RESET}" OM_C_BOLD="${C_BOLD}" OM_C_GREEN="${C_GREEN}" OM_C_YELLOW="${C_YELLOW}" OM_C_CYAN="${C_CYAN}" OM_C_RED="${C_RED}" OM_C_DIM="${C_DIM}" \
        python3 - <<'PYEOF'
import os, sys, json, time, urllib.request, urllib.error

target_host = os.environ.get("OM_TARGET_HOST", "http://127.0.0.1:11434")
model = os.environ.get("OM_TARGET_MODEL", "")
insecure = os.environ.get("OM_INSECURE", "false").lower() == "true"
opt_json = os.environ.get("OM_OPT_JSON", "false").lower() == "true"

C_RESET = os.environ.get("OM_C_RESET", "")
C_BOLD = os.environ.get("OM_C_BOLD", "")
C_GREEN = os.environ.get("OM_C_GREEN", "")
C_RED = os.environ.get("OM_C_RED", "")
C_CYAN = os.environ.get("OM_C_CYAN", "")
C_YELLOW = os.environ.get("OM_C_YELLOW", "")
C_DIM = os.environ.get("OM_C_DIM", "")

url = f"{target_host.rstrip('/')}/api/pull"
payload = json.dumps({"name": model, "insecure": insecure, "stream": True}).encode("utf-8")
req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
tty = sys.stdout.isatty() and not opt_json


def human(n):
    n = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or unit == "TiB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def duration(seconds):
    seconds = int(seconds)
    return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m" if seconds >= 3600 else f"{seconds // 60}m{seconds % 60:02d}s"


line_open = False   # a TTY progress line is drawn but not yet terminated
layers = {}         # digest -> (first seen monotonic time, completed bytes then)
done_layers = set()


def end_line():
    global line_open
    if line_open:
        sys.stdout.write("\n")
        line_open = False


def fail(message):
    end_line()
    sys.stderr.write(f"{C_RED}[!] {message}{C_RESET}\n")
    sys.exit(1)


succeeded = False
try:
    with urllib.request.urlopen(req, timeout=3600) as resp:
        for raw_line in resp:
            line = raw_line.decode("utf-8", errors="replace").strip()
            if not line:
                continue
            try:
                data = json.loads(line)
            except ValueError:
                continue
            if not isinstance(data, dict):
                continue
            if opt_json:
                # Every event reaches stdout, the error event included; the
                # exit status is what tells automation the pull failed.
                print(json.dumps(data), flush=True)
            if "error" in data:
                fail(f"Error pulling '{model}': {data['error']}")
            status = data.get("status", "")
            if status == "success":
                succeeded = True
            if opt_json:
                continue
            total = data.get("total") or 0
            completed = data.get("completed") or 0
            digest = data.get("digest", "")
            if total > 0:
                pct = min(100.0, completed * 100.0 / total)
                bar_len = 20
                filled = min(bar_len, int(bar_len * completed / total))
                bar = "[" + "=" * filled + (">" if filled < bar_len else "") + " " * max(0, bar_len - filled - 1) + "]"
                if tty:
                    now = time.monotonic()
                    first = layers.setdefault(digest, (now, completed))
                    rate = (completed - first[1]) / (now - first[0]) if now - first[0] > 0.5 else 0
                    extra = f"  {human(rate)}/s" if rate > 0 else ""
                    if rate > 0 and completed < total:
                        extra += f"  ETA {duration((total - completed) / rate)}"
                    # Redraw one line in place: no newline until this layer
                    # ends or another message has to be printed.
                    sys.stdout.write(f"\r\033[2K  {C_CYAN}{digest[7:19] or digest[:12]}{C_RESET} {bar} "
                                     f"{C_BOLD}{pct:5.1f}%{C_RESET}  {human(completed)}/{human(total)}{extra}")
                    line_open = True
                    if completed >= total:
                        end_line()
                    sys.stdout.flush()
                elif completed >= total and digest not in done_layers:
                    done_layers.add(digest)
                    sys.stdout.write(f"  {digest[7:19] or digest[:12]} {bar} {pct:5.1f}% ({human(total)})\n")
                    sys.stdout.flush()
            elif status:
                end_line()
                if status == "success":
                    sys.stdout.write(f"{C_GREEN}[✓] Successfully pulled model '{model}' to {target_host}.{C_RESET}\n")
                else:
                    sys.stdout.write(f"  {C_DIM}→{C_RESET} {status}\n")
                sys.stdout.flush()
except urllib.error.HTTPError as e:
    err_body = e.read().decode("utf-8", errors="replace")
    fail(f"HTTP {e.code} Error pulling model: {err_body or e.reason}")
except urllib.error.URLError as e:
    fail(f"Connection error reaching {target_host}: {e.reason}")
except (TimeoutError, OSError) as e:
    fail(f"Pull of '{model}' from {target_host} was interrupted: {e}")
except KeyboardInterrupt:
    end_line()
    sys.stdout.write(f"{C_YELLOW}[!] Pull canceled by user.{C_RESET}\n")
    sys.exit(130)

# A stream that just stops (daemon restart, dropped connection, proxy
# timeout) is not a pull: only the final 'success' event is.
if not succeeded:
    fail(f"Pull of '{model}' ended before the server reported success; the model may be incomplete.")
PYEOF
}


# -----------------------------------------------------------------------------
# Command: sync
# -----------------------------------------------------------------------------
# Ollama's HTTP API can receive blobs (POST /api/blobs/<digest>) and build a
# model from them (/api/create), but it has no endpoint to download a blob. A
# real host-to-host copy therefore reads the source model from a model store
# on this machine: the manifest whose sha256 equals the digest the source
# daemon reports. Stores searched: $KIMO_OLLAMA_MODELS (colon-separated; when
# set, nothing else), else $OLLAMA_MODELS, ~/.ollama/models,
# /usr/share/ollama/.ollama/models, /var/lib/ollama/.ollama/models.
#
# argv: model source-digest dest-url force(true|false)
# Exit: 0 copied and verified, or already holds identical weights
#       2 no readable store holds that manifest (caller may fall back)
#       1 anything else (missing blob, upload/create/verify failure, refusal)
_sync_copy_local() {
    OM_C_RESET="${C_RESET}" OM_C_GREEN="${C_GREEN}" OM_C_YELLOW="${C_YELLOW}" OM_C_RED="${C_RED}" OM_C_DIM="${C_DIM}" \
        python3 - "$@" <<'PYEOF'
import hashlib, json, os, re, sys, urllib.error, urllib.request

model, src_digest, dst, force = sys.argv[1], sys.argv[2], sys.argv[3].rstrip("/"), sys.argv[4] == "true"
C = {k: os.environ.get("OM_C_" + k, "") for k in ("RESET", "GREEN", "YELLOW", "RED", "DIM")}

WEIGHTS = ("application/vnd.ollama.image.model", "application/vnd.ollama.image.adapter")
KNOWN = WEIGHTS + tuple("application/vnd.ollama.image." + t for t in
                        ("projector", "template", "system", "params", "license", "messages"))


def fail(message, code=1):
    sys.stderr.write(f"{C['RED']}[!] {message}{C['RESET']}\n")
    sys.exit(code)


def stores():
    if os.environ.get("KIMO_OLLAMA_MODELS"):
        return [d for d in os.environ["KIMO_OLLAMA_MODELS"].split(":") if d]
    home = os.path.expanduser("~")
    return [d for d in (os.environ.get("OLLAMA_MODELS"), f"{home}/.ollama/models",
                        "/usr/share/ollama/.ollama/models", "/var/lib/ollama/.ollama/models") if d]


def manifest_relpaths(name):
    last = name.split("/")[-1]
    if ":" in last:
        tag = last.rsplit(":", 1)[1]
        path = name[: -(len(tag) + 1)]
    else:
        tag, path = "latest", name
    parts = path.split("/")
    if len(parts) == 1:
        parts = ["registry.ollama.ai", "library"] + parts
    elif len(parts) == 2:
        parts = ["registry.ollama.ai"] + parts
    return os.path.join("manifests", *parts, tag), f"{path}:{tag}"


def request(method, path, body=None, data=None, headers=None):
    if body is not None:
        data = json.dumps(body).encode()
        headers = {"Content-Type": "application/json", **(headers or {})}
    req = urllib.request.Request(dst + path, data=data, method=method, headers=headers or {})
    return urllib.request.urlopen(req, timeout=3600)


def dest_weights(name):
    """Weight/adapter blob digests behind <name> on the destination, or None if absent."""
    try:
        with request("POST", "/api/show", {"model": name}) as resp:
            info = json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        fail(f"Could not inspect '{name}' on {dst}: HTTP {e.code}")
    except (urllib.error.URLError, OSError) as e:
        fail(f"Could not reach {dst}: {e}")
    found = re.findall(r"^(?:FROM|ADAPTER)\s+\S*sha256[-:]([0-9a-f]{64})", info.get("modelfile", ""), re.M)
    return {"sha256:" + h for h in found}


if not src_digest:
    fail(f"'{model}' was not found on the source host.")
relpath, full_name = manifest_relpaths(model)
manifest_path = store = None
for candidate in stores():
    path = os.path.join(candidate, relpath)
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except OSError:
        continue
    # /api/tags reports the manifest digest as bare hex; accept either form.
    if hashlib.sha256(raw).hexdigest() == src_digest.removeprefix("sha256:"):
        manifest_path, store = path, candidate
        break
if not manifest_path:
    sys.exit(2)

manifest = json.loads(raw)
layers = manifest.get("layers", [])
unknown = sorted({l.get("mediaType", "?") for l in layers} - set(KNOWN))
if unknown:
    fail(f"'{model}' has layer types this copier does not handle ({', '.join(unknown)}); not copying a partial model.")
expected = {l["digest"] for l in layers if l.get("mediaType") in WEIGHTS}

current = dest_weights(full_name)
if current is not None and not force:
    if expected <= current:
        print(f"{C['GREEN']}[✓] '{full_name}' on {dst} already has identical weights "
              f"({', '.join(sorted(d[7:19] for d in expected))}).{C['RESET']}")
        sys.exit(0)
    fail(f"'{full_name}' exists on {dst} with different weights; re-run with --force to overwrite it.")


def blob_path(digest):
    return os.path.join(store, "blobs", digest.replace(":", "-"))


def human(n):
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or unit == "TiB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


create = {"model": full_name, "stream": False}
licenses = []
for index, layer in enumerate(layers):
    digest, kind = layer["digest"], layer["mediaType"].rsplit(".", 1)[1]
    path = blob_path(digest)
    if not os.path.exists(path):
        fail(f"Blob {digest} of '{model}' is missing from {store}.")
    if kind in ("model", "adapter", "projector"):
        try:
            with request("HEAD", f"/api/blobs/{digest}"):
                present = True
        except urllib.error.HTTPError as e:
            if e.code != 404:
                fail(f"Checking blob {digest[:19]} on {dst} failed: HTTP {e.code}")
            present = False
        except (urllib.error.URLError, OSError) as e:
            fail(f"Could not reach {dst}: {e}")
        size = os.path.getsize(path)
        if present:
            print(f"  {C['DIM']}→{C['RESET']} {digest[7:19]} {kind} already on destination ({human(size)})")
        else:
            print(f"  {C['DIM']}→{C['RESET']} uploading {digest[7:19]} {kind} ({human(size)})...", flush=True)
            try:
                with open(path, "rb") as fh, request("POST", f"/api/blobs/{digest}", data=fh,
                                                     headers={"Content-Length": str(size)}):
                    pass
            except urllib.error.HTTPError as e:
                fail(f"Uploading blob {digest[:19]} to {dst} failed: HTTP {e.code} {e.read().decode(errors='replace')}")
            except (urllib.error.URLError, OSError) as e:
                fail(f"Uploading blob {digest[:19]} to {dst} failed: {e}")
        group = "adapters" if kind == "adapter" else "files"
        create.setdefault(group, {})[f"{kind}-{index}.gguf"] = digest
    else:
        with open(path, "rb") as fh:
            text = fh.read().decode("utf-8")
        if kind in ("template", "system"):
            create[kind] = text
        elif kind == "license":
            licenses.append(text)
        else:  # params, messages: JSON documents
            create["parameters" if kind == "params" else "messages"] = json.loads(text)
if licenses:
    create["license"] = licenses

try:
    with request("POST", "/api/create", create) as resp:
        result = json.loads(resp.read() or b"{}")
except urllib.error.HTTPError as e:
    fail(f"Creating '{full_name}' on {dst} failed: HTTP {e.code} {e.read().decode(errors='replace')}")
except (urllib.error.URLError, OSError) as e:
    fail(f"Creating '{full_name}' on {dst} failed: {e}")
if result.get("error") or result.get("status") != "success":
    fail(f"Creating '{full_name}' on {dst} failed: {result.get('error') or result}")

after = dest_weights(full_name)
if after is None or not expected <= after:
    fail(f"Verification failed: '{full_name}' on {dst} does not reference the copied weights.")
print(f"{C['GREEN']}[✓] Copied '{full_name}' to {dst}; weights verified "
      f"({', '.join(sorted(d[7:19] for d in expected))}).{C['RESET']}")
PYEOF
}

cmd_sync() {
    local target_model=""
    local opt_from=""
    local opt_to=""
    local opt_all=false
    local opt_force=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from)
                require_value "$@"
                opt_from="$2"
                shift 2
                ;;
            --from=*)
                opt_from="${1#*=}"
                shift
                ;;
            --to)
                require_value "$@"
                opt_to="$2"
                shift 2
                ;;
            --to=*)
                opt_to="${1#*=}"
                shift
                ;;
            --all)
                opt_all=true
                shift
                ;;
            --force)
                opt_force=true
                shift
                ;;
            -h|--help)
                echo "${C_BOLD}kimo sync${C_RESET} – Replicate and synchronize models across cluster hosts"
                echo ""
                echo "${C_YELLOW}Usage:${C_RESET}"
                echo "  ${0##*/} sync <model> [options]"
                echo "  ${0##*/} sync --all [options]"
                echo ""
                echo "${C_YELLOW}Options:${C_RESET}"
                echo "  --from <host>   Source host (local, remote, or address; auto-detected if omitted)"
                echo "  --to <host>     Destination host (local, remote, or address; auto-detected if omitted)"
                echo "  --all           Synchronize all models missing on destination host"
                echo "  --force         Force synchronization even if model already exists on destination"
                echo "  -h, --help      Show this help message"
                echo ""
                echo "${C_YELLOW}Examples:${C_RESET}"
                echo "  ${0##*/} sync granite4.2:latest              # Auto-detects local->remote and syncs"
                echo "  ${0##*/} sync llama-3.1-8b:uncensored        # Auto-detects remote->local and syncs"
                echo "  ${0##*/} sync kalidroid-27b:latest --to local # Pull remote model to local daemon"
                echo "  ${0##*/} sync --all --from remote --to local  # Sync all missing remote models to local"
                return 0
                ;;
            -*)
                echo "${C_RED}Error: Unknown sync option '$1'.${C_RESET}" >&2
                return 1
                ;;
            *)
                if [[ -z "${target_model}" ]]; then
                    target_model="$1"
                fi
                shift
                ;;
        esac
    done

    _resolve_sync_host() {
        local arg="$1"
        case "${arg}" in
            local)  echo "${LOCAL_HOST_URL}" ;;
            remote) echo "${REMOTE_HOST_URL}" ;;
            "")     echo "" ;;
            *)      normalize_host_url "${arg}" ;;
        esac
    }

    local src_url dst_url
    src_url="$(_resolve_sync_host "${opt_from}")"
    dst_url="$(_resolve_sync_host "${opt_to}")"

    _sync_host_label() {
        local u="$1"
        if [[ "${u}" == "${LOCAL_HOST_URL}" ]]; then
            echo "local (${u})"
        elif [[ "${u}" == "${REMOTE_HOST_URL}" ]]; then
            echo "remote (${u})"
        else
            echo "${u}"
        fi
    }

    _fetch_host_tags() {
        local u="$1"
        curl -s --connect-timeout 5 -m 15 "${u}/api/tags" 2>/dev/null || echo "{}"
    }

    _sync_single_model() {
        local m="$1"
        local s_url="$2"
        local d_url="$3"

        local s_label d_label
        s_label="$(_sync_host_label "${s_url}")"
        d_label="$(_sync_host_label "${d_url}")"

        echo "${C_BOLD}[*] Synchronizing '${m}' from ${s_label} -> ${d_label}...${C_RESET}"

        local s_tags d_tags s_digest d_digest
        s_tags="$(_fetch_host_tags "${s_url}")"
        d_tags="$(_fetch_host_tags "${d_url}")"

        s_digest=$(echo "${s_tags}" | jq -r --arg n "${m}" '.models[]? | select(.name == $n or .name == ($n + ":latest")) | .digest // empty' 2>/dev/null | head -n1)
        d_digest=$(echo "${d_tags}" | jq -r --arg n "${m}" '.models[]? | select(.name == $n or .name == ($n + ":latest")) | .digest // empty' 2>/dev/null | head -n1)

        if [[ -n "${d_digest}" && -n "${s_digest}" && "${s_digest}" == "${d_digest}" ]]; then
            if ! ${opt_force}; then
                echo "${C_GREEN}[✓] Model '${m}' is already synchronized on ${d_label} (digest: ${d_digest:0:12}).${C_RESET}"
                return 0
            fi
            echo "${C_DIM}[*] Re-synchronizing '${m}' due to --force...${C_RESET}"
        fi

        # A source on this machine: copy its blobs, the only true replication.
        if host_is_plain_local "${s_url}"; then
            local copy_rc=0
            _sync_copy_local "${m}" "${s_digest}" "${d_url}" "${opt_force}" || copy_rc=$?
            case "${copy_rc}" in
                0) return 0 ;;
                2) echo "${C_DIM}[*] No readable local model store holds '${m}'; falling back to a registry pull on ${d_label}, verified against the source digest.${C_RESET}" ;;
                *) echo "${C_RED}[!] Failed to synchronize '${m}' to ${d_label}.${C_RESET}" >&2
                   return 1 ;;
            esac
        fi

        if [[ -n "${d_digest}" ]]; then
            if [[ -n "${s_digest}" && "${s_digest}" != "${d_digest}" ]]; then
                if ! ${opt_force}; then
                    echo "${C_YELLOW}[!] Model '${m}' exists on ${d_label} with differing digest (${d_digest:0:12} vs ${s_digest:0:12}).${C_RESET}"
                    echo "    Use --force to overwrite: ${0##*/} sync ${m} --from ${s_url} --to ${d_url} --force"
                    return 1
                fi
            fi
        fi

        # Registry pull: Ollama cannot download blobs from the source host, so
        # the destination fetches the same tag from the registry. That is only
        # a copy if the result matches what the source has.
        TARGET_HOST="${d_url}" cmd_pull "${m}" || {
            echo "${C_RED}[!] Failed to synchronize '${m}' to ${d_label} (registry pull failed; a model that only exists on ${s_label} cannot be pulled).${C_RESET}" >&2
            return 1
        }

        if [[ -n "${s_digest}" ]]; then
            d_tags="$(_fetch_host_tags "${d_url}")"
            d_digest=$(echo "${d_tags}" | jq -r --arg n "${m}" '.models[]? | select(.name == $n or .name == ($n + ":latest")) | .digest // empty' 2>/dev/null | head -n1)
            if [[ "${d_digest}" != "${s_digest}" ]]; then
                echo "${C_RED}[!] '${m}' on ${d_label} (digest ${d_digest:-none}) does not match ${s_label} (${s_digest:0:19}): the registry serves a different build.${C_RESET}" >&2
                echo "    For an exact copy run 'kimo sync' on the source host, or point KIMO_OLLAMA_MODELS at a readable copy of its model store." >&2
                return 1
            fi
            echo "${C_GREEN}[✓] Synchronized '${m}' to ${d_label}; digest verified (${d_digest:0:19}).${C_RESET}"
        else
            echo "${C_YELLOW}[!] Pulled '${m}' to ${d_label} from the registry; the source reported no digest, so the copy could not be verified.${C_RESET}"
        fi
        return 0
    }

    if ${opt_all}; then
        local s_url="${src_url:-${LOCAL_HOST_URL}}"
        local d_url="${dst_url:-${REMOTE_HOST_URL}}"

        if [[ "${s_url}" == "${d_url}" ]]; then
            echo "${C_RED}Error: Source and destination hosts cannot be the same (${s_url}).${C_RESET}" >&2
            return 1
        fi

        local s_label d_label
        s_label="$(_sync_host_label "${s_url}")"
        d_label="$(_sync_host_label "${d_url}")"

        echo "${C_BOLD}Scanning for models to synchronize from ${s_label} -> ${d_label}...${C_RESET}"
        local s_tags d_tags
        s_tags="$(_fetch_host_tags "${s_url}")"
        d_tags="$(_fetch_host_tags "${d_url}")"

        local -a missing_models=()
        while IFS= read -r line; do
            [[ -z "${line}" ]] && continue
            local m_name m_dig
            m_name=$(echo "${line}" | awk '{print $1}')
            m_dig=$(echo "${line}" | awk '{print $2}')
            local on_dst
            on_dst=$(echo "${d_tags}" | jq -r --arg n "${m_name}" '.models[]? | select(.name == $n) | .digest // empty' 2>/dev/null)
            if [[ -z "${on_dst}" ]] || { ${opt_force} && [[ "${on_dst}" != "${m_dig}" ]]; }; then
                missing_models+=("${m_name}")
            fi
        done < <(echo "${s_tags}" | jq -r '.models[]? | "\(.name) \(.digest)"' 2>/dev/null)

        if [[ ${#missing_models[@]} -eq 0 ]]; then
            echo "${C_GREEN}[✓] All models on ${s_label} are already synchronized to ${d_label}.${C_RESET}"
            return 0
        fi

        echo "${C_CYAN}Found ${#missing_models[@]} model(s) to synchronize:${C_RESET}"
        for m in "${missing_models[@]}"; do
            echo "  • ${m}"
        done
        echo ""

        local failed=0
        for m in "${missing_models[@]}"; do
            if ! _sync_single_model "${m}" "${s_url}" "${d_url}"; then
                failed=$((failed + 1))
            fi
            echo ""
        done

        if [[ "${failed}" -gt 0 ]]; then
            echo "${C_RED}[!] Synchronization finished with ${failed} failure(s).${C_RESET}" >&2
            return 1
        fi
        echo "${C_GREEN}[✓] All ${#missing_models[@]} models synchronized successfully!${C_RESET}"
        return 0
    fi

    if [[ -z "${target_model}" ]]; then
        echo "${C_RED}Error: 'sync' requires a model name or --all.${C_RESET}" >&2
        echo "Usage: ${0##*/} sync <model> [--from <host>] [--to <host>]" >&2
        echo "       ${0##*/} sync --all [--from <host>] [--to <host>]" >&2
        return 1
    fi

    local s_url="${src_url}"
    local d_url="${dst_url}"

    if [[ -z "${s_url}" && -z "${d_url}" ]]; then
        local s_tags d_tags l_dig r_dig
        s_tags="$(_fetch_host_tags "${LOCAL_HOST_URL}")"
        d_tags="$(_fetch_host_tags "${REMOTE_HOST_URL}")"
        l_dig=$(echo "${s_tags}" | jq -r --arg n "${target_model}" '.models[]? | select(.name == $n or .name == ($n + ":latest")) | .digest // empty' 2>/dev/null | head -n1)
        r_dig=$(echo "${d_tags}" | jq -r --arg n "${target_model}" '.models[]? | select(.name == $n or .name == ($n + ":latest")) | .digest // empty' 2>/dev/null | head -n1)

        local on_local=false on_remote=false
        [[ -n "${l_dig}" ]] && on_local=true
        [[ -n "${r_dig}" ]] && on_remote=true

        if ${on_local} && ! ${on_remote}; then
            s_url="${LOCAL_HOST_URL}"
            d_url="${REMOTE_HOST_URL}"
        elif ${on_remote} && ! ${on_local}; then
            s_url="${REMOTE_HOST_URL}"
            d_url="${LOCAL_HOST_URL}"
        elif ${on_local} && ${on_remote}; then
            s_url="${LOCAL_HOST_URL}"
            d_url="${REMOTE_HOST_URL}"
            if [[ -n "${l_dig}" && "${l_dig}" == "${r_dig}" && "${opt_force}" != "true" ]]; then
                echo "${C_GREEN}[✓] Model '${target_model}' is already synchronized across local and remote (digest: ${l_dig:0:12}).${C_RESET}"
                return 0
            fi
            # A blob copy gets its own manifest digest on the destination, so
            # for a local source let the copier compare the actual weights.
            if ! ${opt_force} && ! host_is_plain_local "${s_url}"; then
                echo "${C_YELLOW}[!] Model '${target_model}' exists on both local and remote with differing digests.${C_RESET}"
                echo "    Specify direction and force: ${0##*/} sync ${target_model} --from <src> --to <dst> --force"
                return 1
            fi
        else
            echo "${C_RED}[!] Error: Model '${target_model}' not found on local (${LOCAL_HOST_URL}) or remote (${REMOTE_HOST_URL}).${C_RESET}" >&2
            return 1
        fi
    elif [[ -n "${s_url}" && -z "${d_url}" ]]; then
        if [[ "${s_url}" == "${LOCAL_HOST_URL}" ]]; then
            d_url="${REMOTE_HOST_URL}"
        else
            d_url="${LOCAL_HOST_URL}"
        fi
    elif [[ -z "${s_url}" && -n "${d_url}" ]]; then
        if [[ "${d_url}" == "${LOCAL_HOST_URL}" ]]; then
            s_url="${REMOTE_HOST_URL}"
        else
            s_url="${LOCAL_HOST_URL}"
        fi
    fi

    if [[ "${s_url}" == "${d_url}" ]]; then
        echo "${C_RED}Error: Source and destination hosts cannot be the same (${s_url}).${C_RESET}" >&2
        return 1
    fi

    _sync_single_model "${target_model}" "${s_url}" "${d_url}"
}

# -----------------------------------------------------------------------------
# Antigravity CLI (agy) support
# -----------------------------------------------------------------------------
# agy has exactly one overridable endpoint: with `modelProvider: "gemini"` in
# its settings.json it calls
#   {GOOGLE_GEMINI_BASE_URL}/v1beta/models/{model}:streamGenerateContent
# and it has no OpenAI-compatible or native-Ollama transport at all. Passing
# --model alone therefore does nothing: agy rejects the unknown id with a
# warning and quietly runs a Google model instead, while this script's banner
# claims an Ollama model and host. A per-session shim translates the Gemini
# wire format to /api/chat against whichever host the model resolved to.
AGY_SETTINGS="${AGY_SETTINGS:-${HOME:-/root}/.gemini/antigravity-cli/settings.json}"
GEMINI_SHIM_PATHS=(
    "${KIMO_GEMINI_SHIM:-}"
    "${SCRIPT_DIR}/lib/ollama-gemini-shim.py"
    "${SCRIPT_DIR}/ollama-gemini-shim.py"
    "${SCRIPT_DIR}/../share/kimo/ollama-gemini-shim.py"
    "${PREFIX:-/usr/local}/share/kimo/ollama-gemini-shim.py"
    "/usr/local/share/kimo/ollama-gemini-shim.py"
    "/opt/ollama/ollama-gemini-shim.py"
    "${HOME:-/root}/OLLAMA/ollama-gemini-shim.py"
)
# One claim file per launcher, so a second concurrent `launch agy` does not
# have its settings reverted by the first one exiting.
AGY_CLAIM_DIR="${KIMO_AGY_CLAIM_DIR:-${AGY_CLAIM_DIR:-${KIMO_RUNTIME_DIR}/agy-claims}}"
AGY_SHIM_PID=""
AGY_SHIM_PORT=""
AGY_SHIM_OUT=""
AGY_SHIM_ERR=""
AGY_CLAIM_FILE=""
AGY_SETTINGS_CREATED=0
AGY_PROVIDER_PRESET=0
AGY_PROVIDER_PREV=""
AGY_HAD_MODEL=false
AGY_MODEL_PREV=""
AGY_LAUNCHED_MODEL=""

find_gemini_shim() {
    local cand
    for cand in "${GEMINI_SHIM_PATHS[@]}"; do
        [[ -n "${cand}" && -f "${cand}" ]] && { echo "${cand}"; return 0; }
    done
    return 1
}

_agy_write_settings() {
    # Rewrites settings.json through a jq filter. All arguments go to jq
    # verbatim, so callers pass values with --arg rather than interpolating
    # them into the program - the same mistake the 2026-09-24 audit found in
    # this script's Python heredocs.
    #
    # cat > rather than mv: keeps the inode, so settings.json stays 0600 and
    # keeps its owner instead of inheriting mktemp's.
    local tmp
    tmp=$(mktemp) || return 1
    if jq "$@" "${AGY_SETTINGS}" >"${tmp}" 2>/dev/null; then
        cat "${tmp}" >"${AGY_SETTINGS}"
        rm -f "${tmp}"
        return 0
    fi
    rm -f "${tmp}"
    return 1
}

agy_patch_settings() {
    local model="$1"
    if [[ ! -f "${AGY_SETTINGS}" ]]; then
        mkdir -p "$(dirname "${AGY_SETTINGS}")" || return 1
        printf '{}' >"${AGY_SETTINGS}" || return 1
        chmod 600 "${AGY_SETTINGS}" 2>/dev/null || true
        AGY_SETTINGS_CREATED=1
    elif [[ ! -s "${AGY_SETTINGS}" ]]; then
        printf '{}' >"${AGY_SETTINGS}" || return 1
    fi

    if ! jq -e . "${AGY_SETTINGS}" >/dev/null 2>&1; then
        echo "${C_RED}Error: ${AGY_SETTINGS} is not valid JSON; refusing to edit it.${C_RESET}" >&2
        return 1
    fi

    AGY_PROVIDER_PREV=$(jq -r '.modelProvider // empty' "${AGY_SETTINGS}")
    [[ "${AGY_PROVIDER_PREV}" == "gemini" ]] && AGY_PROVIDER_PRESET=1
    AGY_HAD_MODEL=$(jq 'has("model")' "${AGY_SETTINGS}")
    AGY_MODEL_PREV=$(jq -r '.model // empty' "${AGY_SETTINGS}")
    AGY_LAUNCHED_MODEL="${model}"

    # modelProvider alone is not enough: agy validates --model against its own
    # catalogue and rejects anything unregistered, so the Ollama id has to be
    # declared as a custom model too. Without this the launch dies with
    # "model <id> is not recognized as a known model or custom model in settings".
    _agy_write_settings --arg m "${model}" '
        .modelProvider = "gemini"
        | .customModelsConfig.customModels[$m] = {modelName: $m}
    ' || return 1

    AGY_CLAIM_FILE=""
    if ensure_private_dir "${KIMO_RUNTIME_DIR}" && ensure_private_dir "${AGY_CLAIM_DIR}"; then
        AGY_CLAIM_FILE="${AGY_CLAIM_DIR}/$$"
        : >"${AGY_CLAIM_FILE}" 2>/dev/null || AGY_CLAIM_FILE=""
    fi
}

_agy_other_session_active() {
    # Claims left behind by a SIGKILLed launcher must not pin the key forever,
    # so a claim only counts while its owner is still alive.
    local f pid
    for f in "${AGY_CLAIM_DIR}"/*; do
        [[ -e "${f}" ]] || continue
        pid="${f##*/}"
        if [[ ! "${pid}" =~ ^[0-9]+$ ]]; then
            rm -f "${f}"
            continue
        fi
        kill -0 "${pid}" 2>/dev/null && return 0
        rm -f "${f}"
    done
    return 1
}

agy_restore_settings() {
    [[ -n "${AGY_CLAIM_FILE}" ]] && rm -f "${AGY_CLAIM_FILE}"
    if [[ "${AGY_SETTINGS_CREATED}" == "1" ]]; then
        rm -f "${AGY_SETTINGS}"
        AGY_SETTINGS_CREATED=0
        return 0
    fi
    [[ -f "${AGY_SETTINGS}" ]] || return 0
    # agy rewrites settings.json while it runs (selected model, permissions),
    # so only the keys this script added are touched - never a saved copy.
    _agy_other_session_active && return 0

    # .model is only put back if it still holds the value agy persisted for the
    # model we launched with; if the operator picked something else mid-session
    # via /model, that choice is theirs and stays.
    _agy_write_settings \
        --arg m "${AGY_LAUNCHED_MODEL}" \
        --arg prev_provider "${AGY_PROVIDER_PREV}" \
        --arg prev_model "${AGY_MODEL_PREV}" \
        --argjson had_model "${AGY_HAD_MODEL}" \
        --argjson keep_provider "$([[ "${AGY_PROVIDER_PRESET}" == "1" ]] && echo true || echo false)" '
        (if .customModelsConfig.customModels then del(.customModelsConfig.customModels[$m]) else . end)
        | (if ((.customModelsConfig.customModels // {}) | length) == 0 then del(.customModelsConfig) else . end)
        | (if $keep_provider then . else (if $prev_provider == "" then del(.modelProvider) else .modelProvider = $prev_provider end) end)
        | (if (.model == $m) then (if $had_model then .model = $prev_model else del(.model) end) else . end)
    ' || true
    AGY_PROVIDER_PREV=""
    AGY_LAUNCHED_MODEL=""
}

agy_cleanup() {
    local rc=$?
    trap - EXIT INT TERM HUP
    if [[ -n "${AGY_SHIM_PID}" ]]; then
        kill "${AGY_SHIM_PID}" 2>/dev/null || true
        wait "${AGY_SHIM_PID}" 2>/dev/null || true
        AGY_SHIM_PID=""
    fi
    agy_restore_settings
    rm -f "${AGY_SHIM_OUT}" "${AGY_SHIM_ERR}"
    exit "${rc}"
}

# Starts the shim on a kernel-assigned port and sets AGY_SHIM_PORT once the
# listener answers /healthz. Must not be called in a command substitution: the
# background python has to stay a child of this shell or agy_cleanup can
# neither wait on it nor kill it, and every launch would leak a listener.
agy_start_shim() {
    local shim="$1" upstream="$2" model="$3" tries=0
    AGY_SHIM_PORT=""
    AGY_SHIM_OUT=$(mktemp) || return 1
    AGY_SHIM_ERR=$(mktemp) || return 1
    python3 -u "${shim}" --host 127.0.0.1 --port 0 --upstream "${upstream}" \
        --default-model "${model}" --print-port >"${AGY_SHIM_OUT}" 2>"${AGY_SHIM_ERR}" &
    AGY_SHIM_PID=$!

    while ((tries++ < 100)); do
        AGY_SHIM_PORT=$(head -n1 "${AGY_SHIM_OUT}" 2>/dev/null || true)
        [[ "${AGY_SHIM_PORT}" =~ ^[0-9]+$ ]] && break
        if ! kill -0 "${AGY_SHIM_PID}" 2>/dev/null; then
            echo "${C_RED}Error: Gemini shim exited before binding a port:${C_RESET}" >&2
            sed 's/^/    /' "${AGY_SHIM_ERR}" >&2 2>/dev/null || true
            AGY_SHIM_PID=""
            return 1
        fi
        sleep 0.05
    done
    if [[ ! "${AGY_SHIM_PORT}" =~ ^[0-9]+$ ]]; then
        echo "${C_RED}Error: Gemini shim did not announce a port in time.${C_RESET}" >&2
        kill "${AGY_SHIM_PID}" 2>/dev/null || true
        AGY_SHIM_PID=""
        return 1
    fi

    tries=0
    until curl -sf -m 2 "http://127.0.0.1:${AGY_SHIM_PORT}/healthz" >/dev/null 2>&1; do
        if ((tries++ >= 40)); then
            echo "${C_RED}Error: Gemini shim on port ${AGY_SHIM_PORT} never became healthy.${C_RESET}" >&2
            kill "${AGY_SHIM_PID}" 2>/dev/null || true
            AGY_SHIM_PID=""
            return 1
        fi
        if ! kill -0 "${AGY_SHIM_PID}" 2>/dev/null; then
            echo "${C_RED}Error: Gemini shim died during startup:${C_RESET}" >&2
            sed 's/^/    /' "${AGY_SHIM_ERR}" >&2 2>/dev/null || true
            return 1
        fi
        sleep 0.05
    done
}

# -----------------------------------------------------------------------------
# Grok Build TUI (grok) support
# -----------------------------------------------------------------------------
# grok takes its endpoint from GROK_MODELS_BASE_URL (see the grok case in
# cmd_launch), so routing itself needs no config edit. Its context window does:
# that value drives auto-compaction, is settable only per model in config.toml,
# and a model prefetched from {base}/models that defines none defaults to 200k.
# For a tuned Ollama model that is wrong by an order of magnitude - grok
# compacts far too late and the request overflows the real window. So a tuned
# num_ctx is written to [model."<tag>"].context_window for the session and
# undone on exit.
#
# The table is deliberately partial. Verified 2026-10-08 against grok 1.0.46: a
# [model."<tag>"] carrying only context_window keeps the base_url prefetched
# from GROK_MODELS_BASE_URL, so the merge does not break routing.
#
# GROK_CONFIG_PATH was checked first and is NOT an alternate config file - a
# model defined through it never reaches 'grok models', and -m rejects it as
# "unknown model id". Editing the real file is unavoidable, hence the surgical
# revert below rather than a whole-file backup.
GROK_CONFIG="${GROK_CONFIG:-${HOME:-/root}/.grok/config.toml}"
# One claim file per launcher, so a second concurrent 'launch grok' does not
# have its override reverted by the first one exiting.
GROK_CLAIM_DIR="${KIMO_GROK_CLAIM_DIR:-${GROK_CLAIM_DIR:-${KIMO_RUNTIME_DIR}/grok-claims}}"
GROK_CLAIM_FILE=""
GROK_CTX_MODEL=""
GROK_CTX_TABLE_PREV=false
GROK_CTX_KEY_PREV=false
GROK_CTX_VALUE_PREV=""
GROK_CTX_TRAIL_PREV=1

# Rewrites config.toml through tomlkit so the user's formatting, comments and
# key order survive. stdlib tomllib is read-only, so there is no writer
# fallback: without tomlkit the override is skipped with a warning and grok
# still runs. Values reach Python through argv, never interpolated into the
# program - the same mistake the 2026-09-24 audit found in this script's
# heredocs. Exits 3 when tomlkit is missing, 4 on unparseable TOML, 5 if absent.
_grok_write_config() {
    python3 - "$@" <<'PY'
import sys

try:
    import tomlkit
except ImportError:
    sys.exit(3)

mode, path, key = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(path, "r", encoding="utf-8") as fh:
        src = fh.read()
    doc = tomlkit.parse(src)
except FileNotFoundError:
    sys.exit(5)
except Exception:
    sys.exit(4)

models = doc.get("model")

if mode == "set":
    existed = models is not None and key in models
    had = bool(existed and "context_window" in models[key])
    prev = str(models[key]["context_window"]) if had else ""
    if models is None:
        models = tomlkit.table()
        doc["model"] = models
    if key not in models:
        models[key] = tomlkit.table()
    models[key]["context_window"] = int(sys.argv[4])
else:
    existed = sys.argv[4] == "1"
    had = sys.argv[5] == "1"
    if models is None or key not in models:
        sys.exit(0)
    tbl = models[key]
    if had:
        tbl["context_window"] = int(sys.argv[6])
    elif "context_window" in tbl:
        del tbl["context_window"]
    # Drop the table - and the [model] parent - only when this launcher created
    # them and nothing else has been added since.
    if not existed and len(tbl) == 0:
        del models[key]
    if not existed and len(models) == 0:
        del doc["model"]

rendered = tomlkit.dumps(doc)
if mode == "clear":
    # Deleting the table leaves the separator newline tomlkit added behind, so
    # put the file back to the trailing-newline count it had before the set.
    trail = int(sys.argv[7]) if len(sys.argv) > 7 and sys.argv[7].isdigit() else 1
    rendered = rendered.rstrip("\n") + "\n" * trail

# Written through the original inode so config.toml keeps its mode and owner
# instead of inheriting mktemp's - why _agy_write_settings uses cat > too.
with open(path, "w", encoding="utf-8") as fh:
    fh.write(rendered)

if mode == "set":
    print("TABLE=%d" % existed)
    print("KEY=%d" % had)
    print("PREV=%s" % prev)
    print("TRAIL=%d" % (len(src) - len(src.rstrip("\n"))))
PY
}

_grok_config_error() {
    case "$1" in
        3)
            echo "${C_YELLOW}[!] python3 tomlkit is unavailable; grok keeps its 200k context default.${C_RESET}" >&2
            echo "    Install it (pip install tomlkit) for a tuned num_ctx to reach grok." >&2
            ;;
        4)
            echo "${C_RED}Error: ${GROK_CONFIG} is not valid TOML; refusing to edit it.${C_RESET}" >&2
            ;;
        5)
            echo "${C_YELLOW}[!] ${GROK_CONFIG} not found; skipping the context_window override.${C_RESET}" >&2
            ;;
        *)
            echo "${C_RED}Error: could not write ${GROK_CONFIG}.${C_RESET}" >&2
            ;;
    esac
}

# Writes the override and records enough prior state to undo exactly this change.
grok_patch_context() {
    local model="$1" ctx="$2" state k v rc=0
    [[ "${ctx}" =~ ^[0-9]+$ ]] || return 1
    state=$(_grok_write_config set "${GROK_CONFIG}" "${model}" "${ctx}") || rc=$?
    if ((rc != 0)); then
        _grok_config_error "${rc}"
        return "${rc}"
    fi
    while IFS='=' read -r k v; do
        case "${k}" in
            TABLE)
                if [[ "${v}" == "1" ]]; then GROK_CTX_TABLE_PREV=true; fi
                ;;
            KEY)
                if [[ "${v}" == "1" ]]; then GROK_CTX_KEY_PREV=true; fi
                ;;
            PREV)
                GROK_CTX_VALUE_PREV="${v}"
                ;;
            TRAIL)
                GROK_CTX_TRAIL_PREV="${v}"
                ;;
        esac
    done <<<"${state}"
    GROK_CTX_MODEL="${model}"

    GROK_CLAIM_FILE=""
    if ensure_private_dir "${KIMO_RUNTIME_DIR}" && ensure_private_dir "${GROK_CLAIM_DIR}"; then
        GROK_CLAIM_FILE="${GROK_CLAIM_DIR}/$$"
        : >"${GROK_CLAIM_FILE}" 2>/dev/null || GROK_CLAIM_FILE=""
    fi
}

_grok_other_session_active() {
    # Claims left behind by a SIGKILLed launcher must not pin the override
    # forever, so a claim only counts while its owner is still alive.
    local f pid
    for f in "${GROK_CLAIM_DIR}"/*; do
        [[ -e "${f}" ]] || continue
        pid="${f##*/}"
        if [[ ! "${pid}" =~ ^[0-9]+$ ]]; then
            rm -f "${f}"
            continue
        fi
        kill -0 "${pid}" 2>/dev/null && return 0
        rm -f "${f}"
    done
    return 1
}

grok_restore_config() {
    [[ -n "${GROK_CLAIM_FILE}" ]] && rm -f "${GROK_CLAIM_FILE}"
    [[ -n "${GROK_CTX_MODEL}" ]] || return 0
    if [[ ! -f "${GROK_CONFIG}" ]]; then
        GROK_CTX_MODEL=""
        return 0
    fi
    # grok rewrites config.toml while it runs, so reverting from a whole-file
    # backup would throw those edits away: only the key owned here is undone.
    _grok_other_session_active && return 0
    local tflag=0 kflag=0
    [[ "${GROK_CTX_TABLE_PREV}" == true ]] && tflag=1
    [[ "${GROK_CTX_KEY_PREV}" == true ]] && kflag=1
    _grok_write_config clear "${GROK_CONFIG}" "${GROK_CTX_MODEL}" "${tflag}" "${kflag}" "${GROK_CTX_VALUE_PREV}" "${GROK_CTX_TRAIL_PREV}" >/dev/null 2>&1 || true
    GROK_CLAIM_FILE=""
    GROK_CTX_MODEL=""
    GROK_CTX_TABLE_PREV=false
    GROK_CTX_KEY_PREV=false
    GROK_CTX_VALUE_PREV=""
    GROK_CTX_TRAIL_PREV=1
}

grok_cleanup() {
    # grok is run rather than exec'd so this teardown can happen; there is no
    # shim process to reap, unlike agy.
    grok_restore_config
}

# -----------------------------------------------------------------------------
# Kimi Code CLI (kimi) support
# -----------------------------------------------------------------------------
# kimi resolves models as ALIASES declared under [models] in its config.toml;
# only such aliases can carry support_efforts/off_effort, which is what unlocks
# the in-session /effort picker with real graded efforts. The KIMI_MODEL_* env
# channel (see the fallback in cmd_launch) synthesizes an alias that cannot
# declare efforts, so /effort there is limited to on/off - and both encode as
# *silent* (no reasoning_effort on the wire).
#
# Registration here is additive and idempotent - a provider per Ollama host and
# an alias per model, exactly like the xai/groq/alibaba entries users keep in
# that file - so, unlike grok/agy, there is nothing to revert on exit.
#
# Besides the provider + aliases, registration also pins `default_model` to the
# launched alias. kimi's non-interactive `-p/--prompt` mode resolves the model
# ONLY from config.toml's default_model and silently ignores `-m <alias>`
# (verified on kimi 2.1.1): without it a `kimo launch kimi ... -- -p ...` turn
# dies with "no default model configured". Interactive -m with a set
# default_model still selects the launched alias, so this is safe for both.
#
# The whole host catalogue is registered, not just the launched tag: otherwise
# 'launch kimi' leaves the /model picker with a single entry. The batch is one
# tomlkit read-modify-write under the config lock (see kimi_register_all_models).
KIMI_CONFIG="${KIMI_CONFIG:-${KIMI_CODE_HOME:-${HOME:-/root}/.kimi-code}/config.toml}"
# Serializes concurrent 'launch kimi' upserts so two read-modify-write cycles
# cannot drop each other's entries.
KIMI_CONFIG_LOCK="${KIMO_KIMI_CONFIG_LOCK:-${KIMI_CONFIG_LOCK:-${KIMO_RUNTIME_DIR}/kimi-config.lock}}"
CODEX_HOME="${CODEX_HOME:-${HOME:-/root}/.codex}"

# -----------------------------------------------------------------------------
# Codex authentication & token resolution for Kimi Code and Codex CLI.
# Resolves CODEX_AUTH_TOKEN and/or OPENAI_API_KEY from the environment or
# ~/.codex/auth.json.
#
# Context:
# Kimi Code's [providers.codex] routes to https://chatgpt.com/backend-api/codex,
# which expects a ChatGPT OAuth JWT bearer token via CODEX_AUTH_TOKEN (not an
# OpenAI Platform sk-proj-* API key, which returns 401 "API keys are not supported").
# If the caller sets CODEX_API_KEY as an sk-* key, we export OPENAI_API_KEY so
# OpenAI models work, and fall back to the cached access_token from ~/.codex/auth.json
# for CODEX_AUTH_TOKEN. If CODEX_API_KEY is itself a JWT (eyJ...), it is aliased.
# -----------------------------------------------------------------------------
_resolve_codex_auth() {
    local auth_file="${CODEX_HOME}/auth.json"
    local file_token=""

    if [[ -f "${auth_file}" ]] && command -v jq >/dev/null 2>&1; then
        file_token=$(jq -r '.tokens.access_token | select(type == "string")' "${auth_file}" 2>/dev/null || true)
    fi

    # 1. If CODEX_AUTH_TOKEN is already explicitly set and non-empty, keep it.
    # 2. If CODEX_API_KEY is set:
    if [[ -n "${CODEX_API_KEY:-}" ]]; then
        if [[ "${CODEX_API_KEY}" == eyJ* ]]; then
            # JWT OAuth bearer token passed via CODEX_API_KEY -> alias to CODEX_AUTH_TOKEN
            export CODEX_AUTH_TOKEN="${CODEX_AUTH_TOKEN:-${CODEX_API_KEY}}"
        else
            # OpenAI Platform API key (sk-...)
            # Export for OpenAI-compatible endpoints:
            export OPENAI_API_KEY="${CODEX_API_KEY}"
            # For CODEX_AUTH_TOKEN: prefer the cached ChatGPT OAuth token from auth.json
            # if present, because chatgpt.com/backend-api/codex rejects API keys.
            if [[ -z "${CODEX_AUTH_TOKEN:-}" ]]; then
                if [[ -n "${file_token}" ]]; then
                    export CODEX_AUTH_TOKEN="${file_token}"
                fi
            fi
        fi
    fi

    # 3. If CODEX_AUTH_TOKEN is still unset, auto-extract from auth.json
    if [[ -z "${CODEX_AUTH_TOKEN:-}" && -n "${file_token}" ]]; then
        export CODEX_AUTH_TOKEN="${file_token}"
    fi

    # 4. If OPENAI_API_KEY is unset but auth.json has an OPENAI_API_KEY, use it
    if [[ -z "${OPENAI_API_KEY:-}" && -f "${auth_file}" ]] && command -v jq >/dev/null 2>&1; then
        local file_api_key
        file_api_key=$(jq -r '.OPENAI_API_KEY | select(type == "string")' "${auth_file}" 2>/dev/null || true)
        [[ -n "${file_api_key}" ]] && export OPENAI_API_KEY="${file_api_key}"
    fi
    return 0
}

# The OpenAI platform API key for '--provider openai'. Env only, like every
# other hosted credential: kimi's [providers.openai] names OPENAI_API_KEY, so
# the key is never written to a config file and never travels in argv.
# auth.json may carry one alongside the ChatGPT login ('codex login --api-key').
_codex_platform_key() {
    local k="${OPENAI_API_KEY:-${CODEX_API_KEY:-}}"
    local auth_file="${CODEX_HOME}/auth.json"
    if [[ -z "${k}" && -f "${auth_file}" ]] && command -v jq >/dev/null 2>&1; then
        k=$(jq -r '.OPENAI_API_KEY | select(type == "string")' "${auth_file}" 2>/dev/null || true)
    fi
    # 'ollama' is kimo's own placeholder for a self-hosted daemon; sending it to
    # api.openai.com would only produce a 401 that looks like a broken key.
    [[ -n "${k}" && "${k}" != "ollama" ]] || return 1
    printf '%s\n' "${k}"
}

# True when a ChatGPT OAuth login exists - usable right now, or renewable from
# auth.json's refresh_token - which is what makes '--provider codex' viable.
# Offline: this only reports whether a refresh is possible, it never performs
# one (that is _ensure_codex_token's job).
_codex_oauth_available() {
    local state source refreshable
    read -r state source refreshable < <(_codex_helper token-state 2>/dev/null) || return 1
    [[ "${state}" == valid || "${state}" == expired || "${refreshable}" == yes ]]
}

# A ChatGPT OAuth access token lives for hours, and kimi reads CODEX_AUTH_TOKEN
# from the environment, so a stale cached token would 401 partway through a
# session. Renew it here the way the codex CLI does. The credential is never
# captured or printed: the helper rewrites auth.json and _resolve_codex_auth
# re-reads it from there.
#
# KIMO_CODEX_NO_REFRESH=1 keeps kimo offline; the launch then needs an already
# valid token in the environment or in auth.json.
_ensure_codex_token() {
    local state source refreshable refresh_attempted=false
    _resolve_codex_auth
    read -r state source refreshable < <(_codex_helper token-state) || return 1
    if [[ "${state}" != valid && "${refreshable}" == yes && "${KIMO_CODEX_NO_REFRESH:-0}" != 1 ]]; then
        refresh_attempted=true
        echo "${C_DIM}[*] ChatGPT OAuth token is ${state}; renewing it from ${CODEX_HOME}/auth.json...${C_RESET}" >&2
        # The helper reports its own reason on stderr; the summary below decides
        # whether the launch can continue.
        _codex_helper refresh || true
    fi
    # token-state validated one specific token, so make the environment carry
    # exactly that one. A stale CODEX_AUTH_TOKEN - an expired one the caller
    # exported, or one a previous resolve lifted from auth.json before it was
    # renewed - would otherwise shadow the good token and 401 mid-session.
    if [[ "${state}" != valid || "${source}" == file ]]; then
        unset CODEX_AUTH_TOKEN
        _resolve_codex_auth
        read -r state source refreshable < <(_codex_helper token-state) || return 1
    fi
    if [[ "${state}" == valid ]]; then
        _codex_helper check-token || return 1
        return 0
    fi
    echo "${C_RED}Error: no usable ChatGPT OAuth token (${state}).${C_RESET}" >&2
    case "${state}" in
        apikey)
            echo "${C_DIM}    An OpenAI platform key (sk-...) cannot authenticate ${CODEX_BACKEND_URL}.${C_RESET}" >&2
            echo "${C_DIM}    Use '${0##*/} launch <cli> --provider openai' for that key, or sign in with '${0##*/} codex login'.${C_RESET}" >&2
            ;;
        expired)
            if ${refresh_attempted}; then
                echo "${C_DIM}    The cached token has expired and the renewal above failed. Inspect the session with '${0##*/} codex'.${C_RESET}" >&2
            else
                echo "${C_DIM}    The cached token has expired and auth.json holds no refresh_token. Sign in again: '${0##*/} codex login'.${C_RESET}" >&2
            fi
            ;;
        *)
            echo "${C_DIM}    Sign in with '${0##*/} codex login' (writes ${CODEX_HOME}/auth.json), or export CODEX_AUTH_TOKEN.${C_RESET}" >&2
            echo "${C_DIM}    With only a platform key, use '--provider openai' instead.${C_RESET}" >&2
            ;;
    esac
    return 1
}

# The model id exactly as OpenAI's wire API expects it: kimo's alias namespace
# (codex/, openai/) is routing metadata and must not reach the request.
_codex_wire_model() {
    local want="${1#codex/}"
    printf '%s\n' "${want#openai/}"
}

# Codex picks its credential from auth.json's auth_mode, NOT from the
# environment: with a ChatGPT login stored it keeps billing the plan even though
# OPENAI_API_KEY is exported (verified against codex-cli 0.163.0). Say so rather
# than let '--provider openai' look like it switched the billing account.
# kimi is unaffected: its [providers.openai] names OPENAI_API_KEY explicitly.
_codex_warn_chatgpt_login() {
    local stored_mode=""
    stored_mode=$(_codex_helper auth-mode 2>/dev/null) || stored_mode=""
    [[ "${stored_mode}" == chatgpt ]] || return 0
    echo "${C_YELLOW}[!] Warning: ${CODEX_HOME}/auth.json holds a ChatGPT login, and Codex prefers it over \$OPENAI_API_KEY.${C_RESET}" >&2
    echo "${C_DIM}    This session bills your ChatGPT plan, not the platform key. To change that: '${0##*/} codex login --with-api-key' (stores the key) or '${0##*/} codex logout'.${C_RESET}" >&2
    return 0
}

# Resolve the kimi model alias for a hosted OpenAI backend. An explicit model
# keeps its name (namespaced with the backend), a preset Ollama tag or the CLI
# name falls back to that backend's default alias from the Codex catalog.
# argv: <codex|openai> <target-model> <true|false: was --model explicit>
_codex_kimi_model() {
    local backend="$1" want="$2" explicit="$3" slug
    # The model may arrive namespaced for the other OpenAI backend
    # ('--provider openai --model codex/gpt-x'); the alias namespace has to
    # match the backend being launched, so re-prefix from the bare slug.
    slug="${want#codex/}"
    slug="${slug#openai/}"
    if [[ "${want}" == "${backend}/"* ]]; then
        printf '%s\n' "${want}"
    elif ! ${explicit} || [[ -z "${want}" || "${want}" == kimi || "${want}" == codex || "${want}" == openai ]]; then
        _codex_helper default-model "${backend}"
    else
        printf '%s\n' "${backend}/${slug}"
    fi
}

# Upserts providers[pid] and a batch of models[alias] through tomlkit so the
# user's formatting, comments and key order survive (same contract as
# _grok_write_config: values travel via argv, never interpolated into the
# program). The model spec JSON array rides in argv[4] - NOT stdin, which the
# heredoc already owns. argv[5], when present, is the launched alias written to
# default_model (kimi's headless prompt mode requires it). Exits 3 when tomlkit
# is missing, 4 on unparseable TOML.
# argv: path pid base_url specs-json [default_alias]
# specs-json: [{"alias","model","ctx","caps","efforts","deff","off","rkey","display_name"}, ...]
_kimi_write_models() {
    python3 - "$@" <<'PY'
import sys
import json

try:
    import tomlkit
except ImportError:
    sys.exit(3)

path, pid, base_url, specs_raw = sys.argv[1:5]
default_alias = sys.argv[5] if len(sys.argv) > 5 else ""

try:
    specs = json.loads(specs_raw)
except Exception:
    specs = []
if not isinstance(specs, list):
    specs = []

try:
    with open(path, "r", encoding="utf-8") as fh:
        doc = tomlkit.parse(fh.read())
except FileNotFoundError:
    doc = tomlkit.document()
except Exception:
    sys.exit(4)

providers = doc.get("providers")
if providers is None:
    providers = tomlkit.table()
    doc["providers"] = providers
if pid not in providers:
    providers[pid] = tomlkit.table()
prov = providers[pid]
prov["type"] = "openai"
prov["base_url"] = base_url
# Static placeholder, never the caller's real key: this provider points at the
# LAN/tunnel Ollama host and forwarding a real secret there would leak it off
# this box. Ollama ignores the value.
prov["api_key"] = "ollama"

models = doc.get("models")
if models is None:
    models = tomlkit.table()
    doc["models"] = models


def _set(table, key, value):
    if value:
        table[key] = value
    elif key in table:
        del table[key]


for spec in specs:
    alias = spec.get("alias")
    model = spec.get("model")
    if not alias or not model:
        continue
    if alias not in models:
        models[alias] = tomlkit.table()
    mdl = models[alias]
    mdl["provider"] = pid
    mdl["model"] = model
    ctx = spec.get("ctx")
    if ctx is not None and str(ctx).isdigit():
        mdl["max_context_size"] = int(ctx)
    elif "max_context_size" in mdl:
        del mdl["max_context_size"]
    _set(mdl, "capabilities", [c for c in (spec.get("caps") or "").split(",") if c])
    _set(mdl, "support_efforts", [c for c in (spec.get("efforts") or "").split(",") if c])
    _set(mdl, "default_effort", spec.get("deff"))
    _set(mdl, "off_effort", spec.get("off"))
    _set(mdl, "reasoning_key", spec.get("rkey"))
    _set(mdl, "display_name", spec.get("display_name"))

# Pin default_model to the launched alias: kimi's -p prompt mode resolves the
# model from default_model and ignores -m, so without this a headless turn has
# "no default model configured". Interactive -m still selects the alias.
if default_alias:
    doc["default_model"] = default_alias

# Written through the original inode so config.toml keeps its mode and owner.
with open(path, "w", encoding="utf-8") as fh:
    fh.write(tomlkit.dumps(doc))
PY
}

# Probes one Ollama model and prints a compact JSON spec consumed by
# _kimi_write_models. Override arguments win over the probed values.
# argv: host_url pid model [ctx caps efforts default_effort off_effort reasoning_key]
_kimi_model_spec() {
    local host_url="$1" pid="$2" model="$3"
    local cov="${4:-}" capov="${5:-}" effov="${6:-}" deffov="${7:-}" offov="${8:-}" rkeyov="${9:-}"
    local alias="${pid}/${model}"
    local show="" runtime_ctx="" arch_ctx="" ctx="" caps=""

    show=$(curl -s --connect-timeout 2 -m 5 "${host_url}/api/show" \
        -d "$(jq -nc --arg m "${model}" '{model: $m}')") || show=""
    if [[ -n "${show}" ]]; then
        runtime_ctx=$(printf '%s' "${show}" | jq -r '(.parameters // "") | if test("num_ctx") then (capture("num_ctx\\s+(?<v>[0-9]+)") | .v) else empty end' 2>/dev/null) || runtime_ctx=""
        arch_ctx=$(printf '%s' "${show}" | jq -r '[.model_info // {} | to_entries[] | select(.key | endswith("context_length")) | .value] | max // empty' 2>/dev/null) || arch_ctx=""
        caps=$(printf '%s' "${show}" | jq -r '[(.capabilities // [])[] | if . == "thinking" then "thinking" elif . == "tools" then "tool_use" elif . == "vision" then "image_in" else empty end] | join(",")' 2>/dev/null) || caps=""
    fi

    if [[ -n "${cov}" && "${cov}" =~ ^[0-9]+$ ]]; then
        ctx="${cov}"
    elif [[ "${runtime_ctx}" =~ ^[0-9]+$ ]]; then
        ctx="${runtime_ctx}"
    elif [[ "${arch_ctx}" =~ ^[0-9]+$ ]]; then
        ctx="${arch_ctx}"
    fi

    caps="${capov:-${caps:-tool_use}}"
    local efforts="" off="" rkey="" deff=""
    if [[ ",${caps}," == *",thinking,"* ]]; then
        efforts="${effov:-low,medium,high,xhigh,max}"
        off="${offov:-none}"
        rkey="${rkeyov:-reasoning}"
        deff="${deffov:-high}"
    fi

    jq -nc \
        --arg alias "${alias}" --arg model "${model}" --arg ctx "${ctx}" \
        --arg caps "${caps}" --arg efforts "${efforts}" --arg deff "${deff}" \
        --arg off "${off}" --arg rkey "${rkey}" --arg dn "${model} (ollama)" \
        '{alias: $alias, model: $model, ctx: $ctx, caps: $caps, efforts: $efforts, deff: $deff, off: $off, rkey: $rkey, display_name: $dn}'
}

_kimi_config_error() {
    case "$1" in
        3)
            echo "${C_YELLOW}[!] python3 tomlkit is unavailable; falling back to kimi's KIMI_MODEL_* env channel${C_RESET}" >&2
            echo "    (graded /effort needs a config alias - pip install tomlkit to unlock it)." >&2
            ;;
        4)
            echo "${C_YELLOW}[!] ${KIMI_CONFIG} is not valid TOML; refusing to edit it - using the env channel.${C_RESET}" >&2
            ;;
        *)
            echo "${C_YELLOW}[!] could not write ${KIMI_CONFIG}; using the env channel.${C_RESET}" >&2
            ;;
    esac
}

# Upserts the host provider + the target model alias and prints the alias on
# success. Kept for the opt-out path (KIMO_KIMI_REGISTER_ALL=0), where only the
# launched tag is registered.
# argv: host_url model ctx caps efforts default_effort off_effort reasoning_key
kimi_register_model() {
    local host_url="$1" model="$2" ctx="$3" caps="$4" efforts="$5" default_effort="$6" off_effort="$7" reasoning_key="$8"
    local slug pid alias rc=0 spec
    slug="${host_url#*://}"
    slug="${slug//[^a-zA-Z0-9]/-}"
    pid="ollama-${slug}"
    alias="${pid}/${model}"
    spec=$(_kimi_model_spec "${host_url}" "${pid}" "${model}" "${ctx}" "${caps}" "${efforts}" "${default_effort}" "${off_effort}" "${reasoning_key}") || spec=""
    if [[ -z "${spec}" ]]; then
        return 1
    fi
    if command -v flock >/dev/null 2>&1; then
        # FD form, not 'flock <file> <cmd>': the command form execs a binary and
        # _kimi_write_models is a shell function. Append mode never truncates.
        ensure_private_dir "${KIMO_RUNTIME_DIR}" || return 1
        exec 9>>"${KIMI_CONFIG_LOCK}"
        flock 9
        _kimi_write_models "${KIMI_CONFIG}" "${pid}" "${host_url}/v1" "[${spec}]" "${alias}" || rc=$?
        exec 9>&-
    else
        _kimi_write_models "${KIMI_CONFIG}" "${pid}" "${host_url}/v1" "[${spec}]" "${alias}" || rc=$?
    fi
    if ((rc != 0)); then
        _kimi_config_error "${rc}"
        return 1
    fi
    printf '%s' "${alias}"
}

# Registers the target model AND every model the active host advertises, so the
# kimi /model picker shows the host's whole catalogue instead of only the
# launched tag. Idempotent; the whole batch is one atomic tomlkit read-modify-
# write under the config lock. Prints the target alias on success.
# argv: host_url target_model [ctx caps efforts default_effort off_effort reasoning_key]
kimi_register_all_models() {
    local host_url="$1" target="$2"
    local tctx="${3:-}" tcaps="${4:-}" tefforts="${5:-}" tdeff="${6:-}" toff="${7:-}" trkey="${8:-}"
    local slug pid alias
    slug="${host_url#*://}"
    slug="${slug//[^a-zA-Z0-9]/-}"
    pid="ollama-${slug}"
    alias="${pid}/${target}"

    local names
    names=$(curl -s --connect-timeout 2 -m 5 "${host_url}/api/tags" | jq -r '.models[]?.name' 2>/dev/null | sort -u) || names=""

    local specs="[]" spec model n=0 target_seen=false
    while IFS= read -r model; do
        [[ -z "${model}" ]] && continue
        if [[ "${model}" == "${target}" ]]; then
            spec=$(_kimi_model_spec "${host_url}" "${pid}" "${model}" "${tctx}" "${tcaps}" "${tefforts}" "${tdeff}" "${toff}" "${trkey}") || spec=""
            target_seen=true
        else
            spec=$(_kimi_model_spec "${host_url}" "${pid}" "${model}") || spec=""
        fi
        if [[ -n "${spec}" ]]; then
            if specs=$(printf '%s' "${specs}" | jq -c --argjson s "${spec}" '. + [$s]'); then
                n=$((n + 1))
            fi
        fi
    done <<< "${names}"

    # The launched tag can be missing from /api/tags (rename, or a transient
    # probe failure) - never leave the session without its requested alias.
    if ! ${target_seen}; then
        spec=$(_kimi_model_spec "${host_url}" "${pid}" "${target}" "${tctx}" "${tcaps}" "${tefforts}" "${tdeff}" "${toff}" "${trkey}") || spec=""
        if [[ -n "${spec}" ]]; then
            if specs=$(printf '%s' "${specs}" | jq -c --argjson s "${spec}" '. + [$s]'); then
                n=$((n + 1))
            fi
        fi
    fi

    local rc=0
    if command -v flock >/dev/null 2>&1; then
        ensure_private_dir "${KIMO_RUNTIME_DIR}" || return 1
        exec 9>>"${KIMI_CONFIG_LOCK}"
        flock 9
        _kimi_write_models "${KIMI_CONFIG}" "${pid}" "${host_url}/v1" "${specs}" "${alias}" || rc=$?
        exec 9>&-
    else
        _kimi_write_models "${KIMI_CONFIG}" "${pid}" "${host_url}/v1" "${specs}" "${alias}" || rc=$?
    fi
    if ((rc != 0)); then
        _kimi_config_error "${rc}"
        return 1
    fi
    echo "${C_DIM}[*] kimi: registered ${n} model(s) from ${host_url}${C_RESET}" >&2
    printf '%s' "${alias}"
}

launch_usage() {
    cat <<EOF
${C_BOLD}kimo launch${C_RESET} – Launch external LLM agent CLIs on Ollama or a hosted backend

${C_YELLOW}Usage:${C_RESET}
  ${0##*/} [global-options] launch <cli> [-m|--model <model>] [--ctx <tokens>] [cli-arguments...] [-- cli-arguments...]

${C_YELLOW}Launch Options:${C_RESET}
  -m, --model <model>       Target model name (default: \$KIMO_DEFAULT_MODEL / config
                            default_model, else the preset per CLI)
  -c, --ctx, --context <N>  Override context window length in tokens (for kimi, grok, etc.)
                            Codex keeps -c for its native key=value config overrides.
  --provider <name>         Inference backend: 'ollama' (default), 'abliteration',
                            'codex' (ChatGPT plan via OAuth), 'openai' (metered
                            platform API via an sk- key) or 'dashscope' (Alibaba
                            Model Studio via an sk- key). Read from
                            \$KIMO_CLOUD_PROVIDER or 'kimo config set cloud_provider'.
  -W, --webbridge           Inject WebBridge skill into session (for kimi)
  --evict / --no-evict      Unload / keep other models loaded on the target host
                            (default: ask on a terminal, keep when non-interactive)
  --dry-run                 Show host, model, argv and routing env (secrets masked),
                            then stop; nothing is started, unloaded or edited
  --                        Pass everything after it to the CLI untouched

  After 'launch <cli>', -v/--version, -h/--help and --json go to the CLI, not kimo.

${C_YELLOW}Supported CLIs:${C_RESET}
  ${C_CYAN}claude${C_RESET}        Anthropic Claude Code CLI
  ${C_CYAN}codex${C_RESET}         OpenAI Codex CLI
  ${C_CYAN}qwen${C_RESET}          Qwen Code CLI
  ${C_CYAN}grok${C_RESET}          Grok Build CLI / TUI
  ${C_CYAN}kimi${C_RESET}          Kimi Code CLI
  ${C_CYAN}agy${C_RESET}           Google Antigravity CLI
  ${C_CYAN}opencode${C_RESET}      OpenCode AI Assistant
  ${C_CYAN}openclaw${C_RESET}      OpenClaw CLI
  ${C_CYAN}hermes${C_RESET}        Hermes Agent CLI
  ${C_CYAN}cyberstrike${C_RESET}   Cyberstrike AI Penetration Testing Agent (cyberstrike.io)
  ${C_CYAN}cursor${C_RESET}        Cursor Agent CLI (cursor.com)

${C_YELLOW}Cloud Provider: abliteration.ai (--provider abliteration):${C_RESET}
  A hosted Anthropic- and OpenAI-compatible API instead of a self-hosted Ollama
  daemon. Currently wired for ${C_BOLD}${ABLITERATION_CLIS}${C_RESET}; other CLIs stay on Ollama routing.

  Requires \$ABLITERATION_API_KEY (an ak_... key from https://abliteration.ai/console;
  \$ABLIT_KEY is also accepted). The key lives in the environment only - kimo never
  writes it to a config file or passes it in argv, and --dry-run masks it.

  Models (id -> context window):
    abliterated-model-large-v2  1,000,000  text only   (default)
    abliterated-model-large     1,000,000  text only
    abliterated-model             262,144  text + images
  Short aliases 'large-v2', 'large' and 'base' resolve to those ids. Only
  abliterated-model accepts image input; the large models 400 on images.

  What changes versus Ollama routing: no host probing, no /api/tags resolution,
  no /api/show capability detection, no VRAM eviction and no tune registry - the
  model table above supplies the window and capabilities instead. The real key is
  forwarded to api.abliteration.ai rather than scrubbed, because that endpoint is
  the provider you selected (the scrub still applies to every Ollama host).

${C_YELLOW}Cloud Provider: OpenAI (--provider codex | --provider openai):${C_RESET}
  Two different OpenAI surfaces, and their credentials are NOT interchangeable:

  ${C_CYAN}codex${C_RESET}   ${CODEX_BACKEND_URL}
          Your ChatGPT plan (Plus/Pro/Team), authenticated with an OAuth bearer
          token. Sign in once with '${0##*/} codex login'; the token is cached in
          ${CODEX_HOME}/auth.json and renewed automatically from its refresh_token
          whenever it has expired, so a launch never dies mid-session on a 401.
          A platform sk- key is refused here by the endpoint itself.
  ${C_CYAN}openai${C_RESET}  ${OPENAI_BACKEND_URL}
          The metered platform API, authenticated with an sk- key from
          \$OPENAI_API_KEY (or \$CODEX_API_KEY, or the one 'codex login --api-key'
          stored in auth.json). Billed per token, and it works without a ChatGPT
          login.

  Wired for ${C_BOLD}${OPENAI_CLIS}${C_RESET}; every other CLI stays on Ollama routing. Both backends
  register a kimi provider entry plus <backend>/<slug> model aliases in
  config.toml, naming the credential's environment variable (api_key_env) rather
  than storing it - no secret is ever written to disk, and --dry-run masks them.
  The model catalog comes from ${CODEX_HOME}/models_cache.json (populated the
  first time the Codex CLI runs); an explicit --model needs no catalog.

  Neither backend probes hosts, resolves Ollama tags, evicts models or applies
  tune settings - there is no VRAM to manage. Set \$KIMO_CODEX_NO_REFRESH=1 to
  forbid the OAuth renewal (kimo then needs an already valid token).

${C_YELLOW}Cloud Provider: DashScope (--provider dashscope):${C_RESET}
  ${DASHSCOPE_BACKEND_URL}
  Alibaba Model Studio's international OpenAI-compatible surface, billed
  pay-as-you-go and authenticated with an sk- key from \$DASHSCOPE_API_KEY
  (MODELSTUDIO_API_KEY is accepted too). Wired for ${C_BOLD}${DASHSCOPE_CLIS}${C_RESET}; every other
  CLI stays on Ollama routing. kimi rides its zero-footprint KIMI_MODEL_* env
  channel, so nothing is written to kimi's config and the key never reaches
  argv or disk. Without -m the default model is ${DASHSCOPE_DEFAULT_MODEL}
  (context ${DASHSCOPE_DEFAULT_CTX} tokens; --ctx or \$KIMO_DASHSCOPE_CTX override).
  Like every hosted backend it skips host probing, Ollama tag resolution,
  eviction and tune settings.

${C_YELLOW}CLI Integration Mechanics:${C_RESET}
  ${C_BOLD}agy${C_RESET}          Google Antigravity CLI speaks only the Gemini wire protocol. A per-session
                shim is spawned on a free localhost port and modelProvider is patched
                for the duration of the session, then cleanly restored on exit.
                GEMINI_API_KEY is never scrubbed: it only reaches the loopback shim,
                whose upstream requests carry no auth, so the secret never leaves this box.
  ${C_BOLD}grok${C_RESET}         Grok Build takes no endpoint flag; its catalog and inference are directed
                to the resolved host via GROK_MODELS_BASE_URL. A tuned or specified num_ctx
                (--ctx, tune --ctx) becomes that model's context_window in config.toml, restored on exit.
  ${C_BOLD}kimi${C_RESET}         Kimi Code registers an additive, idempotent provider and the host's whole
                model catalogue as aliases in ~/.kimi-code/config.toml, then launches with
                -m <alias> (so the /model picker lists every model, not just the launched tag).
                Set KIMO_KIMI_REGISTER_ALL=0 to register only the launched model.
                Context length (--ctx, KIMO_KIMI_CONTEXT, or tuned num_ctx) becomes
                max_context_size, capped at the architecture maximum and then at the
                model's num_ctx (the window the runner actually allocates). Ollama
                does not set an output token cap. A Kimi window above num_ctx fills
                the runner and comes back as finish_reason=length, which Kimi reports
                as "Model hit max_tokens" before any tool call. Thinking models declare
                support_efforts low..max so the in-session /effort picker works (mapped via reasoning_key).
  ${C_BOLD}claude${C_RESET}       Directs Claude Code to the target host via ANTHROPIC_BASE_URL. A real
                ANTHROPIC_API_KEY/AUTH_TOKEN is forwarded only to a plain local daemon;
                remote/LAN/tunnel hosts get a placeholder ('ollama') so the secret never
                leaves this box. API_TIMEOUT_MS is left untouched (claude defaults to 600000 ms).
  ${C_BOLD}codex${C_RESET}        Configured with a custom Ollama API endpoint and model parameters.
  ${C_BOLD}qwen${C_RESET}         Routed via --openai-base-url/--auth-type openai (thinking + tools ride the
                OpenAI wire). A real OPENAI_API_KEY is forwarded only to a plain local daemon;
                remote/LAN/tunnel hosts get a placeholder ('ollama') so the token never leaves
                this box. QWEN_CODE_API_TIMEOUT_MS is raised to 600000 to clear qwen's 45s default.
  ${C_BOLD}opencode${C_RESET}    Routing is provider-config driven (~/.config/opencode/opencode.jsonc):
                no ANTHROPIC_*/OPENAI_* base-url env is read for inference (verified on
                opencode 1.19.0), so a real key cannot ride the env to the target host the way
                it can for qwen/claude. OPENAI_API_KEY/ANTHROPIC_API_KEY are still scrubbed for
                any non-local host, defence-in-depth in case a future SDK layer honours them.
  ${C_BOLD}cyberstrike${C_RESET}  Cyberstrike AI-Powered Penetration Testing Agent. Automatically registers
                 and routes the Ollama endpoint via 'cyberstrike provider' and CYBERSTRIKE_CONFIG_CONTENT,
                 addressing targets via the 'ollama/<model>' format.
  ${C_BOLD}cursor${C_RESET}       Cursor Agent CLI (cursor.com); routes inference and completions to the target
                 Ollama host via CURSOR_API_ENDPOINT, CURSOR_LOCAL_AGENT_BASE_URL,
                 and OPENAI_BASE_URL with model override (--model <model>).

${C_YELLOW}Environment Overrides:${C_RESET}
  ABLITERATION_API_KEY      abliteration.ai ak_... key (ABLIT_KEY also accepted); env only
  CODEX_AUTH_TOKEN          ChatGPT OAuth bearer token for the codex backend (auto-resolved from ~/.codex/auth.json)
  CODEX_API_KEY             Codex / OpenAI API key or bearer token (auto-maps to CODEX_AUTH_TOKEN / OPENAI_API_KEY)
  OPENAI_API_KEY            OpenAI platform sk- key; the credential for '--provider openai'
  KIMO_CLOUD_PROVIDER       Default backend for launch: ollama | abliteration | codex | openai
                            (or 'kimo config set cloud_provider abliteration')
  KIMO_ABLITERATION_BASE_URL  Override the API origin (default: https://api.abliteration.ai)
  KIMO_CODEX_BACKEND_URL    Override the ChatGPT Codex endpoint (default: https://chatgpt.com/backend-api/codex)
  KIMO_OPENAI_BACKEND_URL   Override the platform origin (default: https://api.openai.com)
  KIMO_CODEX_NO_REFRESH     Set 1 to never renew an expired ChatGPT OAuth token (default: renew)
  KIMO_CODEX_TOKEN_URL      Override the OAuth token endpoint used for that renewal
  KIMO_CODEX_REFRESH_TIMEOUT  Seconds to wait for the renewal request (default: 30)
  DASHSCOPE_API_KEY           DashScope sk- key; the credential for '--provider dashscope'
  KIMO_DASHSCOPE_BASE_URL     Override the DashScope compatible-mode origin
  KIMO_DASHSCOPE_CTX          Override the DashScope default context window in tokens
  KIMO_KIMI_CONTEXT         Override Kimi model max context size in tokens (or 'kimo config set kimi_context <N>')
  KIMO_CONTEXT              Global context window override in tokens for external CLIs
  KIMO_KIMI_EFFORT          Default thinking effort (low, medium, high, xhigh, max)
  KIMO_KIMI_EFFORTS         Supported thinking efforts list (e.g. low,medium,high,max)
  KIMO_KIMI_CAPABILITIES    Override detected model capabilities (e.g. tool_use,thinking)
  KIMO_KIMI_REASONING_KEY   Wire parameter name for thinking budget (default: reasoning)
  KIMO_KIMI_REGISTER_ALL    Register every model the host serves (default: 1); set 0 to only the launched tag
  KIMO_LAUNCH_EVICT         Default for unloading other host models: ask | always | never (default: ask)
  QWEN_CODE_API_TIMEOUT_MS  Per-request timeout for 'launch qwen' (default: 600000 ms)
  KIMO_RUNTIME_DIR          Private per-user directory for claims and locks
                            (\$XDG_RUNTIME_DIR/kimo, else \${TMPDIR:-/tmp}/kimo-<uid>)
  KIMO_AGY_CLAIM_DIR        Claim directory for concurrent Antigravity sessions (\$KIMO_RUNTIME_DIR/agy-claims)
  KIMO_GROK_CLAIM_DIR       Claim directory for concurrent Grok sessions (\$KIMO_RUNTIME_DIR/grok-claims)
  KIMO_KIMI_CONFIG_LOCK     Lockfile for concurrent Kimi config updates (\$KIMO_RUNTIME_DIR/kimi-config.lock)

${C_YELLOW}Examples:${C_RESET}
  ${0##*/} launch grok --model kalidroid-27b:latest --ctx 65536
  ${0##*/} --remote launch kimi --model kalidroid-27b:latest --ctx 262144
  ${0##*/} --remote launch claude --model nemotron3:33b
  ${0##*/} launch cyberstrike --model kalidroid-27b:latest
  ${0##*/} launch cursor --model kalidroid-27b:latest
  ${0##*/} launch agy --model kalidroid-27b:latest

  ${C_DIM}# abliteration.ai (hosted): export ABLITERATION_API_KEY=ak_... first${C_RESET}
  ${0##*/} launch kimi --provider abliteration
  ${0##*/} launch claude --provider abliteration --model abliterated-model-large-v2
  ${0##*/} launch kimi --provider abliteration --model base        ${C_DIM}# the image-capable model${C_RESET}
  ${0##*/} launch claude --provider abliteration --dry-run   ${C_DIM}# inspect routing, key masked${C_RESET}
  ${0##*/} config set cloud_provider abliteration            ${C_DIM}# make it the default backend${C_RESET}

  ${C_DIM}# OpenAI / Codex: auto-resolves the token from ~/.codex/auth.json or CODEX_API_KEY${C_RESET}
  ${0##*/} codex login                                        ${C_DIM}# sign in to your ChatGPT plan (once)${C_RESET}
  ${0##*/} launch kimi --provider codex                       ${C_DIM}# ChatGPT plan; renews an expired token${C_RESET}
  ${0##*/} launch kimi --model codex/gpt-6.1-sol
  ${0##*/} launch codex --provider codex
  ${0##*/} codex                                             ${C_DIM}# token/account status, renewal state${C_RESET}

  ${C_DIM}# OpenAI platform API (metered): export OPENAI_API_KEY=sk-... first${C_RESET}
  ${0##*/} launch kimi --provider openai
  ${0##*/} launch kimi --provider openai --model gpt-5.1-codex
  ${0##*/} launch codex --provider openai --dry-run   ${C_DIM}# inspect routing, key masked${C_RESET}

  ${C_DIM}# DashScope (Alibaba Model Studio): export DASHSCOPE_API_KEY=sk-... first${C_RESET}
  ${0##*/} launch kimi --provider dashscope
  ${0##*/} launch kimi --provider dashscope --model qwen3-coder-plus
EOF
}

# Shared helper: avoid using 'launch' for GitHub CLI management
launch_gh_check() {
    local target="${1:-}"
    if [[ "${target}" == "gh" ]]; then
        echo "Error: GitHub CLI is management-only; run gh directly, not through Ollama launch." >&2
        return 1
    fi
    return 0
}

cmd_launch() {
    local provider="${1:-}"
    if ! launch_gh_check "${provider}"; then
        return 1
    fi
    if [[ -z "${provider}" || "${provider}" == "-h" || "${provider}" == "--help" || "${provider}" == "help" ]]; then
        launch_usage
        return 0
    fi
    shift

    # -m/--model > KIMO_DEFAULT_MODEL (env, or the default_model config key)
    # > the per-CLI built-in in DEFAULT_MODELS.
    local target_model="${KIMO_DEFAULT_MODEL:-${DEFAULT_MODELS[$provider]:-}}"
    local cli_passthrough_args=()
    local opt_launch_ctx=""
    local opt_launch_webbridge=false
    local opt_launch_provider=""
    local opt_model_explicit=false
    local opt_evict="${KIMO_LAUNCH_EVICT:-ask}"
    local opt_dry_run=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --)
                # Everything after '--' goes to the CLI untouched, including
                # flags kimo would otherwise read (-m, --ctx, -W, --evict).
                shift
                cli_passthrough_args+=("$@")
                break
                ;;
            --provider)
                shift
                if [[ -z "${1:-}" ]]; then
                    echo "${C_RED}Error: --provider requires a name argument (${KIMO_LAUNCH_PROVIDERS// /, }).${C_RESET}" >&2
                    exit 1
                fi
                opt_launch_provider="$1"
                shift
                ;;
            --provider=*)
                opt_launch_provider="${1#*=}"
                if [[ -z "${opt_launch_provider}" ]]; then
                    echo "${C_RED}Error: --provider requires a name argument (${KIMO_LAUNCH_PROVIDERS// /, }).${C_RESET}" >&2
                    return 1
                fi
                shift
                ;;
            --evict)
                opt_evict="always"
                shift
                ;;
            --no-evict)
                opt_evict="never"
                shift
                ;;
            --dry-run)
                opt_dry_run=true
                shift
                ;;
            -m|--model)
                shift
                if [[ -z "${1:-}" ]]; then
                    echo "${C_RED}Error: --model requires a model name argument.${C_RESET}" >&2
                    exit 1
                fi
                target_model="$1"
                opt_model_explicit=true
                shift
                ;;
            -m=*|--model=*)
                target_model="${1#*=}"
                [[ -n "${target_model}" ]] || { echo "Error: --model requires a model name." >&2; return 1; }
                opt_model_explicit=true
                shift
                ;;
            -c|--ctx|--context)
                # Codex uses -c for native TOML overrides. --ctx/--context
                # remain kimo options; other CLIs retain the -c shorthand.
                if [[ "$1" == -c && "${provider}" == codex ]]; then
                    if [[ $# -lt 2 || -z "$2" ]]; then
                        echo "Error: -c requires a Codex key=value override." >&2
                        return 1
                    fi
                    cli_passthrough_args+=("$1" "$2")
                    shift 2
                    continue
                fi
                shift
                if [[ -z "${1:-}" ]]; then
                    echo "${C_RED}Error: --ctx requires a token count argument.${C_RESET}" >&2
                    exit 1
                fi
                opt_launch_ctx="$1"
                shift
                ;;
            --ctx=*|--context=*)
                opt_launch_ctx="${1#*=}"
                shift
                ;;
            -W|--webbridge)
                # Quota-free web tool: inject the custom-web skill into the
                # kimi launch session so the agent falls back to the WebBridge
                # real-browser daemon (127.0.0.1:10086) instead of Moonshot.
                opt_launch_webbridge=true
                shift
                ;;
            *)
                cli_passthrough_args+=("$1")
                shift
                ;;
        esac
    done

    if [[ -n "${opt_launch_ctx}" && ! "${opt_launch_ctx}" =~ ^[1-9][0-9]*$ ]]; then
        echo "${C_RED}Error: --ctx must be a positive integer in tokens (got '${opt_launch_ctx}').${C_RESET}" >&2
        exit 1
    fi

    if [[ -z "${target_model}" ]]; then
        target_model="${provider}"
    fi

    # Cloud provider selection: --provider > KIMO_CLOUD_PROVIDER > the
    # cloud_provider config key. Empty/'ollama'/'none' all mean the self-hosted
    # Ollama routing below, which stays the default and the only path that
    # probes hosts, resolves tags and evicts models.
    local cloud_provider="${opt_launch_provider:-${KIMO_CLOUD_PROVIDER:-${KIMO_CONFIG_VALUES[cloud_provider]:-}}}"
    local provider_selected="${cloud_provider}"
    case "${cloud_provider}" in
        ""|none|ollama) cloud_provider="" ;;
        abliteration|codex|openai|dashscope) ;;
        *)
            echo "${C_RED}Error: unknown --provider '${cloud_provider}' (expected one of: ${KIMO_LAUNCH_PROVIDERS}).${C_RESET}" >&2
            exit 1
            ;;
    esac

    # Auto-detect an OpenAI backend from the requested model or from the
    # credentials in the environment. A codex/... alias or a ChatGPT OAuth login
    # means the plan endpoint; a lone platform key means api.openai.com, which is
    # the only surface that accepts it.
    if [[ -z "${provider_selected}" ]]; then
        case "${target_model}" in
            codex/*|codex) cloud_provider="codex" ;;
            openai/*|openai) cloud_provider="openai" ;;
        esac
    fi
    if [[ -z "${cloud_provider}" && -z "${provider_selected}" && "${opt_model_explicit}" != true ]] \
        && { [[ -n "${CODEX_API_KEY:-}" || -n "${CODEX_AUTH_TOKEN:-}" || -n "${OPENAI_API_KEY:-}" ]]; }; then
        case "${provider}" in
            kimi|codex)
                if _codex_oauth_available; then
                    cloud_provider="codex"
                elif _codex_platform_key >/dev/null 2>&1; then
                    cloud_provider="openai"
                fi
                ;;
        esac
    fi
    if [[ -z "${provider_selected}" && "${provider}" == codex && -n "${CODEX_ACCESS_TOKEN:-}" ]] && ! ${opt_model_explicit}; then
        cloud_provider="codex"
    fi

    local active_host=""
    local resolved_model="${target_model}"
    # Set for abliteration: the canonical model id, its context window, the API
    # key, and the OpenAI-surface base URL. Ollama routing leaves them empty.
    local ablit_key="" ablit_ctx="" ablit_openai_url="" ablit_caps="" ablit_efforts=""
    local dashscope_key=""

    if openai_backend "${cloud_provider}"; then
        if [[ " ${OPENAI_CLIS} " != *" ${provider} "* ]]; then
            echo "${C_RED}Error: '--provider ${cloud_provider}' supports ${OPENAI_CLIS}; '${provider}' has no OpenAI launch branch yet.${C_RESET}" >&2
            echo "${C_DIM}    Those CLIs are wired for a self-hosted Ollama host. Drop --provider to route '${provider}' to Ollama.${C_RESET}" >&2
            return 1
        fi
        if [[ "${cloud_provider}" == openai ]]; then
            # Metered platform API: an sk- key, and no codex/ namespace on the
            # wire - kimi's openai/<slug> alias supplies the routing.
            active_host="${OPENAI_BACKEND_URL}"
            local openai_key=""
            if ! openai_key=$(_codex_platform_key); then
                echo "${C_RED}Error: '--provider openai' needs an OpenAI platform API key, and none was found.${C_RESET}" >&2
                echo "${C_DIM}    Export OPENAI_API_KEY=sk-... (CODEX_API_KEY is accepted too), or use '--provider codex' with a ChatGPT login.${C_RESET}" >&2
                echo "${C_DIM}    The key stays in the environment: kimi's [providers.openai] references OPENAI_API_KEY by name.${C_RESET}" >&2
                return 1
            fi
            export OPENAI_API_KEY="${openai_key}"
            if [[ "${provider}" == kimi ]]; then
                resolved_model=$(_codex_kimi_model openai "${target_model}" "${opt_model_explicit}") || return 1
            else
                _codex_warn_chatgpt_login
                if ! ${opt_model_explicit} && [[ "${target_model}" != openai/* ]]; then
                    # Let the Codex CLI resolve its own model and profile.
                    resolved_model=""
                else
                    resolved_model=$(_codex_wire_model "${target_model}")
                fi
            fi
        else
            active_host="${CODEX_BACKEND_URL}"
            if [[ "${provider}" == kimi ]]; then
                _ensure_codex_token || return 1
                resolved_model=$(_codex_kimi_model codex "${target_model}" "${opt_model_explicit}") || return 1
            else
                if ! ${opt_model_explicit} && [[ "${target_model}" != codex/* ]]; then
                    # Let Codex resolve its own model/profile and stored login.
                    resolved_model=""
                else
                    resolved_model=$(_codex_wire_model "${target_model}")
                fi
            fi
        fi
    elif [[ "${cloud_provider}" == "dashscope" ]]; then
        if [[ " ${DASHSCOPE_CLIS} " != *" ${provider} "* ]]; then
            echo "${C_RED}Error: '--provider dashscope' supports ${DASHSCOPE_CLIS}; '${provider}' has no DashScope launch branch yet.${C_RESET}" >&2
            echo "${C_DIM}    Those CLIs are wired for a self-hosted Ollama host. Drop --provider to route '${provider}' to Ollama.${C_RESET}" >&2
            return 1
        fi
        # A token-plan-class key (sk-sp-...) is bound to the subscription
        # surface and 401s on the pay-as-you-go intl endpoint, so it never
        # selects it: the next variable in line gets the chance instead.
        local dashscope_var="" dashscope_skipped=""
        for dashscope_var in DASHSCOPE_API_KEY MODELSTUDIO_API_KEY; do
            [[ -n "${!dashscope_var:-}" ]] || continue
            if [[ "${!dashscope_var}" == sk-sp-* ]]; then
                dashscope_skipped="${dashscope_var}"
                continue
            fi
            dashscope_key="${!dashscope_var}"
            break
        done
        if [[ -z "${dashscope_key}" || "${dashscope_key}" == "ollama" ]]; then
            echo "${C_RED}Error: '--provider dashscope' needs a DashScope API key, and none was found.${C_RESET}" >&2
            echo "${C_DIM}    Export DASHSCOPE_API_KEY=sk-... (MODELSTUDIO_API_KEY is accepted too).${C_RESET}" >&2
            if [[ -n "${dashscope_skipped}" ]]; then
                echo "${C_DIM}    ${dashscope_skipped} holds a token-plan key (sk-sp-...), which ${DASHSCOPE_BACKEND_URL} rejects; export a pay-as-you-go key instead.${C_RESET}" >&2
            fi
            echo "${C_DIM}    The key stays in the environment: kimi's KIMI_MODEL_* channel references it by name, never on disk.${C_RESET}" >&2
            return 1
        fi
        active_host="${DASHSCOPE_BACKEND_URL}"
        if ! ${opt_model_explicit} || [[ -z "${target_model}" || "${target_model}" == kimi ]]; then
            resolved_model="${DASHSCOPE_DEFAULT_MODEL}"
        else
            resolved_model="${target_model#dashscope/}"
        fi
    elif [[ "${cloud_provider}" == "abliteration" ]]; then
        if ! abliteration_cli_supported "${provider}"; then
            echo "${C_RED}Error: '--provider abliteration' supports ${ABLITERATION_CLIS}; '${provider}' has no abliteration launch branch yet.${C_RESET}" >&2
            echo "${C_DIM}    Those CLIs are wired for a self-hosted Ollama host. Drop --provider to route '${provider}' to Ollama.${C_RESET}" >&2
            exit 1
        fi
        # The per-CLI preset and the default_model config key are self-hosted
        # Ollama tags, which do not exist upstream. Unless the user named a
        # model explicitly, keep that value only when it happens to be an
        # abliteration id and otherwise use this provider's own default.
        if ! ${opt_model_explicit} && ! abliteration_resolve_model "${target_model}" >/dev/null 2>&1; then
            target_model="${ABLITERATION_DEFAULT_MODEL}"
        fi
        if ! ablit_key=$(abliteration_api_key); then
            echo "${C_RED}Error: no abliteration.ai API key. Export ABLITERATION_API_KEY=ak_... (create one at https://abliteration.ai/console).${C_RESET}" >&2
            echo "${C_DIM}    The key stays in the environment: kimo never writes it to a config file or passes it in argv.${C_RESET}" >&2
            exit 1
        fi
        if ! resolved_model=$(abliteration_resolve_model "${target_model}"); then
            echo "${C_RED}Error: unknown abliteration.ai model '${target_model}'.${C_RESET}" >&2
            echo "${C_DIM}    Available:${C_RESET}" >&2
            local _ablit_id
            while IFS= read -r _ablit_id; do
                [[ -n "${_ablit_id}" ]] || continue
                echo "${C_DIM}      ${_ablit_id}  (${ABLITERATION_MODELS[${_ablit_id}]} ctx)${C_RESET}" >&2
            done < <(printf '%s\n' "${!ABLITERATION_MODELS[@]}" | sort -r)
            exit 1
        fi
        ablit_ctx=$(abliteration_model_ctx "${resolved_model}")
        ablit_caps=$(abliteration_capabilities "${resolved_model}")
        ablit_efforts=$(abliteration_efforts "${resolved_model}")
        active_host="${ABLITERATION_BASE_URL}"
        ablit_openai_url="${ABLITERATION_BASE_URL}/v1"
        # An explicit --ctx still wins, but it cannot exceed the model's window.
        if [[ -n "${opt_launch_ctx}" ]]; then
            if ((opt_launch_ctx > ablit_ctx)); then
                echo "${C_YELLOW}[!] Warning: Requested context (${opt_launch_ctx}) exceeds ${resolved_model}'s window (${ablit_ctx}). Capping to ${ablit_ctx}.${C_RESET}" >&2
            else
                ablit_ctx="${opt_launch_ctx}"
            fi
        fi
    elif [[ -n "${TARGET_HOST}" ]]; then
        active_host="${TARGET_HOST}"
        local res
        res=$(resolve_model_name "${target_model}" "${active_host}" || true)
        [[ -n "${res}" ]] && resolved_model="${res}"
    else
        # Desktop GPU first: a model on both hosts must not land on the Pi, which
        # has no GPU - its bridge refuses anything over the 8 GiB budget, and a
        # direct load is OOM-killed by ollama-memory-guard.
        local local_res="" remote_first
        remote_first=$(resolve_model_name "${target_model}" "${REMOTE_HOST_URL}" || true)
        [[ -z "${remote_first}" ]] && local_res=$(resolve_model_name "${target_model}" "${LOCAL_HOST_URL}" || true)
        if [[ -n "${remote_first}" ]]; then
            resolved_model="${remote_first}"
            active_host="${REMOTE_HOST_URL}"
        elif [[ -n "${local_res}" ]]; then
            resolved_model="${local_res}"
            active_host="${LOCAL_HOST_URL}"
        else
            local remote_res
            remote_res=$(resolve_model_name "${target_model}" "${REMOTE_HOST_URL}" || true)
            if [[ -n "${remote_res}" ]]; then
                echo "${C_YELLOW}Model '${target_model}' found on remote GPU server. Routing to ${REMOTE_HOST_IP} (using ${remote_res})...${C_RESET}"
                resolved_model="${remote_res}"
                active_host="${REMOTE_HOST_URL}"
            else
                active_host="${LOCAL_HOST_URL}"
            fi
        fi
    fi

    # Other models on the target host are only unloaded when asked (--evict,
    # KIMO_LAUNCH_EVICT=always, or yes at the prompt): they may belong to other
    # users or sessions sharing that GPU. There is no VRAM to free on a hosted
    # API, so a cloud provider never evicts.
    if ! hosted_provider "${cloud_provider}"; then
        ${opt_dry_run} || evict_other_models "${active_host}" "${resolved_model}" "${opt_evict}"
    fi

    if [[ "${cloud_provider}" == "abliteration" ]]; then
        # Deliberately NOT scrubbed like a remote Ollama host: api.abliteration.ai
        # is the provider the user just selected, so the real key is meant to go
        # there. It rides in the environment only, never argv.
        unset OLLAMA_HOST OLLAMA_BASE_URL
        export OPENAI_BASE_URL="${ablit_openai_url}"
        export OPENAI_API_BASE="${ablit_openai_url}"
        export API_BASE="${ablit_openai_url}"
        export OPENAI_API_KEY="${ablit_key}"
        export ANTHROPIC_BASE_URL="${active_host}"
        export ANTHROPIC_API_BASE="${ablit_openai_url}"
        export ABLITERATION_API_KEY="${ablit_key}"
        # Bearer auth is what abliteration.ai documents as preferred. x-api-key
        # is left unset so the request carries exactly one credential, and so
        # Claude Code does not prompt about a "custom API key" it also sees.
        export ANTHROPIC_AUTH_TOKEN="${ablit_key}"
        unset ANTHROPIC_API_KEY
    elif openai_backend "${cloud_provider}"; then
        unset OLLAMA_HOST OLLAMA_BASE_URL CODEX_OSS_BASE_URL
        # Stale wrapper endpoints must not redirect the native OpenAI login, and
        # both backends take their base URL from kimi's config.toml (or from
        # codex's own default), never from the environment.
        unset OPENAI_BASE_URL OPENAI_API_BASE API_BASE
    elif [[ "${cloud_provider}" == "dashscope" ]]; then
        unset OLLAMA_HOST OLLAMA_BASE_URL
        # The DashScope base URL reaches kimi through the KIMI_MODEL_* channel
        # only; stale wrapper endpoints must not redirect it.
        unset OPENAI_BASE_URL OPENAI_API_BASE API_BASE
    else
        export OLLAMA_HOST="${active_host}"
        export OLLAMA_BASE_URL="${active_host}"
        export OPENAI_API_BASE="${active_host}/v1"
        export OPENAI_BASE_URL="${active_host}/v1"
        export OPENAI_API_KEY="${OPENAI_API_KEY:-ollama}"
        export API_BASE="${active_host}/v1"
        export ANTHROPIC_BASE_URL="${active_host}"
        export ANTHROPIC_API_BASE="${active_host}/v1"
        export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-ollama}"
    fi
    export CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT="${CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT:-1}"
    export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-100000}"
    export CLAUDE_CODE_MAX_OUTPUT_TOKENS="${CLAUDE_CODE_MAX_OUTPUT_TOKENS:-8192}"
    export CLAUDE_DISABLE_TELEMETRY="${CLAUDE_DISABLE_TELEMETRY:-1}"
    export DO_NOT_TRACK="${DO_NOT_TRACK:-1}"
    export DISABLE_AUTO_UPDATER="${DISABLE_AUTO_UPDATER:-1}"
    export ENABLE_CLAUDEAI_MCP_SERVERS="${ENABLE_CLAUDEAI_MCP_SERVERS:-false}"

    # Every CLI below is pointed at active_host through OPENAI_*/ANTHROPIC_*/
    # CURSOR_* base URLs, and an SDK sends the matching key to whatever base
    # URL it is given. Only a plain local daemon may see real credentials;
    # remote/LAN/tunnel hosts get the placeholder Ollama ignores. Done once
    # here so no branch (codex, cursor, cyberstrike, hermes, openclaw, or a
    # future one) can forget it; claude/qwen/opencode keep their own checks.
    # A selected cloud provider is the exception: its key is meant for that
    # endpoint, and scrubbing it would make every request 401.
    if ! hosted_provider "${cloud_provider}" && ! host_is_plain_local "${active_host}"; then
        export OPENAI_API_KEY="ollama"
        export ANTHROPIC_API_KEY="ollama"
        unset ANTHROPIC_AUTH_TOKEN CURSOR_API_KEY
        unset CODEX_API_KEY CODEX_AUTH_TOKEN CODEX_ACCESS_TOKEN DASHSCOPE_API_KEY MODELSTUDIO_API_KEY
    fi

    local cli_cmd="${EXTERNAL_CLI_MAP[$provider]:-}"

    # Apply per-model tuned defaults baked in via 'tune' (raw resolved model).
    # The tuning registry is keyed by Ollama tag and its num_ctx/num_gpu/...
    # options are daemon parameters, so it does not apply to a hosted API.
    local tp=""
    if ! hosted_provider "${cloud_provider}"; then
        tp=$(tuned_params "${resolved_model}" || true)
        if [[ -n "${tp}" ]]; then
            local nctx
            nctx=$(echo "${tp}" | jq -r '.num_ctx? // empty')
            if [[ -n "${nctx}" ]]; then
                export OLLAMA_CONTEXT_LENGTH="${nctx}"
            fi
            echo "${C_DIM}[*] Tuned defaults for '${resolved_model}': $(echo "${tp}" | jq -c .)${C_RESET}" >&2
        fi

        if [[ -n "${opt_launch_ctx}" ]]; then
            export OLLAMA_CONTEXT_LENGTH="${opt_launch_ctx}"
        fi
    fi

    # The Cursor CLI ships as 'cursor-agent' (or 'agent'), so treat those as
    # available too; the cursor branch below resolves the real binary.
    local cli_available=0
    if [[ -n "${cli_cmd}" ]]; then
        if command -v "${cli_cmd}" >/dev/null 2>&1; then
            cli_available=1
        elif [[ "${cli_cmd}" == "cursor" ]] \
            && { command -v cursor-agent >/dev/null 2>&1 || command -v agent >/dev/null 2>&1; }; then
            cli_available=1
        fi
    fi
    if openai_backend "${cloud_provider}" && [[ "${cli_available}" -eq 0 ]]; then
        echo "${C_RED}Error: '${cli_cmd}' is not installed. Run '${0##*/} install ${provider}'.${C_RESET}" >&2
        return 1
    fi

    # Build Codex argv once for execution and dry-run. Runtime flags belong
    # after exec/resume/fork; review accepts provider/model via -c instead.
    local -a codex_argv=(codex) codex_options=() codex_tail=("${cli_passthrough_args[@]}")
    if [[ "${cli_cmd}" == codex ]]; then
        local codex_idx=0
        while ((codex_idx < ${#codex_tail[@]})); do
            case "${codex_tail[codex_idx]}" in
                -c|--config|-p|--profile|-s|--sandbox|-C|--cd|-i|--image|--add-dir|--enable|--disable|--remote|--remote-auth-token-env|-a|--ask-for-approval)
                    ((codex_idx+=2)) ;;
                -*) ((codex_idx+=1)) ;;
                *) break ;;
            esac
        done
        # --oss is the Ollama routing switch; an OpenAI backend must not get it.
        hosted_provider "${cloud_provider}" || codex_options+=(--oss --local-provider ollama)
        [[ -z "${resolved_model}" ]] || codex_options+=(--model "${resolved_model}")
        [[ -z "${opt_launch_ctx}" ]] || codex_options+=(--config "model_context_window=${opt_launch_ctx}")
        case "${codex_tail[codex_idx]:-}" in
            exec|e|resume|fork)
                codex_argv+=("${codex_tail[@]:0:codex_idx}" "${codex_tail[codex_idx]}" "${codex_options[@]}" "${codex_tail[@]:codex_idx+1}") ;;
            review)
                if ! hosted_provider "${cloud_provider}"; then
                    codex_argv+=(--config 'model_provider="ollama"')
                fi
                [[ -z "${resolved_model}" ]] || codex_argv+=(--config "model=$(jq -nc --arg model "${resolved_model}" '$model')")
                [[ -z "${opt_launch_ctx}" ]] || codex_argv+=(--config "model_context_window=${opt_launch_ctx}")
                codex_argv+=("${codex_tail[@]}") ;;
            *) codex_argv+=("${codex_options[@]}" "${codex_tail[@]}") ;;
        esac
    fi

    # --dry-run: report what would run and stop before anything with side
    # effects (no eviction above, no shim, no CLI config edits, no exec).
    # Credentials are shown only as kept / placeholder / unset.
    if ${opt_dry_run}; then
        local -a dry_argv=()
        local kimi_slug="${active_host#*://}"
        case "${cli_cmd}" in
            codex) dry_argv=("${codex_argv[@]}") ;;
            qwen) dry_argv=(qwen --openai-base-url "${active_host}/v1" --auth-type openai --model "${resolved_model}") ;;
            kimi) dry_argv=(kimi -m "ollama-${kimi_slug//[^a-zA-Z0-9]/-}/${resolved_model}") ;;
            cyberstrike) dry_argv=(cyberstrike --model "$([[ "${resolved_model}" == */* ]] && echo "${resolved_model}" || echo "ollama/${resolved_model}")") ;;
            "") dry_argv=(ollama run "${resolved_model}") ;;
            *) dry_argv=("${cli_cmd}" --model "${resolved_model}") ;;
        esac
        # A cloud provider has no Ollama tag to resolve and no alias to register:
        # claude takes the context-suffixed id, kimi rides its KIMI_MODEL_* env
        # channel and so takes no -m at all.
        if [[ "${cloud_provider}" == "abliteration" ]]; then
            case "${cli_cmd}" in
                claude) dry_argv=(claude --model "$(abliteration_claude_model "${resolved_model}")") ;;
                kimi) dry_argv=(kimi) ;;
                *) dry_argv=("${cli_cmd}" --model "${resolved_model}") ;;
            esac
        elif openai_backend "${cloud_provider}"; then
            case "${cli_cmd}" in
                codex) dry_argv=("${codex_argv[@]}") ;;
                kimi) dry_argv=(kimi -m "${resolved_model}") ;;
                *) dry_argv=("${cli_cmd}" --model "${resolved_model}") ;;
            esac
        elif [[ "${cloud_provider}" == "dashscope" ]]; then
            case "${cli_cmd}" in
                kimi) dry_argv=(kimi) ;;
                *) dry_argv=("${cli_cmd}" --model "${resolved_model}") ;;
            esac
        fi
        [[ "${cli_available}" -eq 1 || -z "${cli_cmd}" ]] || dry_argv=(ollama run "${resolved_model}")
        [[ "${cli_cmd}" == codex && "${cli_available}" -eq 1 ]] || dry_argv+=("${cli_passthrough_args[@]}")
        _dry_secret() { # <var>: never print a credential
            if [[ -z "${!1+x}" ]]; then echo "<unset>"
            elif [[ "${!1}" == "ollama" ]]; then echo "ollama (placeholder)"
            elif [[ "${cloud_provider}" == "abliteration" ]]; then echo "<kept: real value, abliteration.ai provider>"
            elif [[ "${cloud_provider}" == "codex" ]]; then echo "<kept: real value, codex token/key>"
            elif [[ "${cloud_provider}" == "openai" ]]; then echo "<kept: real value, OpenAI platform key>"
            elif [[ "${cloud_provider}" == "dashscope" ]]; then echo "<kept: real value, DashScope key>"
            else echo "<kept: real value, plain local host>"; fi
        }
        local -a env_names=(OLLAMA_HOST OPENAI_BASE_URL ANTHROPIC_BASE_URL OLLAMA_CONTEXT_LENGTH)
        local -a secret_names=(OPENAI_API_KEY ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CURSOR_API_KEY CODEX_API_KEY CODEX_AUTH_TOKEN CODEX_ACCESS_TOKEN)
        [[ "${cloud_provider}" == "abliteration" ]] && secret_names+=(ABLITERATION_API_KEY)
        [[ "${cloud_provider}" == "dashscope" ]] && secret_names+=(DASHSCOPE_API_KEY MODELSTUDIO_API_KEY)
        if openai_backend "${cloud_provider}"; then
            env_names+=(CODEX_OSS_BASE_URL)
        fi
        local n
        if [[ "${OPT_JSON:-false}" == "true" ]]; then
            local env_json='{}'
            for n in "${env_names[@]}"; do
                [[ -n "${!n+x}" ]] && env_json=$(jq -c --arg k "${n}" --arg v "${!n}" '. + {($k): $v}' <<<"${env_json}")
            done
            for n in "${secret_names[@]}"; do
                env_json=$(jq -c --arg k "${n}" --arg v "$(_dry_secret "${n}")" '. + {($k): $v}' <<<"${env_json}")
            done
            # argv via NUL-separated stdin: jq would parse "--model" etc. as its
            # own options if they were passed as --args.
            local argv_json
            argv_json=$(printf '%s\0' "${dry_argv[@]}" | jq -Rsc 'split("\u0000") | .[:-1]')
            jq -nc --arg cli "${provider}" --arg host "${active_host}" --arg model "${resolved_model}" \
                --arg provider "${cloud_provider:-ollama}" \
                --argjson installed "$([[ "${cli_available}" -eq 1 ]] && echo true || echo false)" \
                --arg evict "${opt_evict}" --argjson env "${env_json}" --argjson argv "${argv_json}" \
                '{cli: $cli, provider: $provider, host: $host, model: $model, cli_installed: $installed,
                  evict_policy: $evict, argv: $argv, env: $env}'
        else
            echo "${C_BOLD}kimo launch ${provider} --dry-run${C_RESET} (nothing is started or changed)"
            echo "  provider: ${cloud_provider:-ollama}"
            echo "  host   : ${active_host}"
            echo "  model  : ${resolved_model:-<Codex default>}"
            if [[ "${cloud_provider}" == "abliteration" ]]; then
                echo "  evict  : n/a (hosted API, no VRAM to free)"
                echo "  context: ${ablit_ctx} tokens"
                echo "  caps   : ${ablit_caps}"
            elif [[ "${cloud_provider}" == "dashscope" ]]; then
                echo "  evict  : n/a (hosted API, no VRAM to free)"
                echo "  context: ${opt_launch_ctx:-${DASHSCOPE_DEFAULT_CTX}} tokens"
            elif hosted_provider "${cloud_provider}"; then
                echo "  evict  : n/a (hosted API, no VRAM to free)"
            else
                echo "  evict  : ${opt_evict} (other loaded models are left alone in a dry run)"
            fi
            [[ "${cli_available}" -eq 1 || -z "${cli_cmd}" ]] || echo "  note   : '${cli_cmd}' is not installed; kimo would fall back to 'ollama run'"
            printf '  argv   :'
            printf ' %q' "${dry_argv[@]}"
            echo
            for n in "${env_names[@]}"; do
                [[ -n "${!n+x}" ]] && printf '  env    : %s=%s\n' "${n}" "${!n}"
            done
            for n in "${secret_names[@]}"; do
                printf '  secret : %s %s\n' "${n}" "$(_dry_secret "${n}")"
            done
            case "${cli_cmd}" in
                kimi|grok|agy|cyberstrike)
                    if [[ "${cloud_provider}" == "abliteration" ]]; then
                        echo "  ${C_DIM}(kimi gets a zero-footprint KIMI_MODEL_* env provider; no config.toml is written)${C_RESET}"
                    elif [[ "${cloud_provider}" == "dashscope" ]]; then
                        echo "  ${C_DIM}(kimi gets a zero-footprint KIMI_MODEL_* env provider; no config.toml is written)${C_RESET}"
                    elif openai_backend "${cloud_provider}"; then
                        echo "  ${C_DIM}(Kimi's ${cloud_provider}/ aliases are synced at launch; this dry run writes no config)${C_RESET}"
                    else
                        echo "  ${C_DIM}(${cli_cmd} also gets session config at launch: kimi aliases, grok context_window, agy shim, cyberstrike provider)${C_RESET}"
                    fi
                    ;;
            esac
        fi
        return 0
    fi

    if [[ "${cli_available}" -eq 1 ]]; then
        echo "${C_GREEN}[*] Launching external CLI '${cli_cmd}' (Model: ${resolved_model:-Codex default}, Host: ${active_host})...${C_RESET}" >&2
        case "${cli_cmd}" in
            claude)
                # Same token-scrub rule as qwen: claude sends ANTHROPIC_API_KEY
                # as 'x-api-key' (and ANTHROPIC_AUTH_TOKEN as a Bearer token) to
                # ANTHROPIC_BASE_URL (= active_host), which may be the LAN Desktop
                # or its ssh -L tunnel; only a plain local daemon may see the real
                # secret. Ollama ignores the value. No timeout override is needed
                # here: claude's request timeout already defaults to 600000 ms
                # (API_TIMEOUT_MS), so it does not hit qwen's old 45s wall.
                if [[ "${cloud_provider}" == "abliteration" ]]; then
                    # The key is already in ANTHROPIC_AUTH_TOKEN (bearer) from the
                    # provider block above, with ANTHROPIC_API_KEY unset; nothing
                    # here may scrub or replace it.
                    # Claude Code assumes 200K for an unrecognized third-party id
                    # unless the model carries a context suffix; the suffix is
                    # stripped before the request, so the API sees the plain id.
                    local claude_model
                    claude_model=$(abliteration_claude_model "${resolved_model}")
                    export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-${ablit_ctx}}"
                    export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-$((ablit_ctx / 2))}"
                    # Route claude's internal tier requests (background haiku
                    # calls, summarization) at the same model instead of letting
                    # them fall back to real Anthropic ids this key cannot serve.
                    export ANTHROPIC_DEFAULT_OPUS_MODEL="${ANTHROPIC_DEFAULT_OPUS_MODEL:-${claude_model}}"
                    export ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_DEFAULT_SONNET_MODEL:-${claude_model}}"
                    export ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_DEFAULT_HAIKU_MODEL:-${claude_model}}"
                    export CLAUDE_CODE_EFFORT_LEVEL="${CLAUDE_CODE_EFFORT_LEVEL:-high}"
                    echo "${C_DIM}[*] claude on abliteration.ai: ${claude_model} (context ${ablit_ctx})${C_RESET}"
                    exec "${cli_cmd}" --model "${claude_model}" "${cli_passthrough_args[@]}"
                fi
                if host_is_plain_local "${active_host}"; then
                    export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-ollama}"
                else
                    export ANTHROPIC_API_KEY="ollama"
                    unset ANTHROPIC_AUTH_TOKEN
                fi
                export CLAUDE_CODE_EFFORT_LEVEL="${CLAUDE_CODE_EFFORT_LEVEL:-low}"
                exec "${cli_cmd}" --model "${resolved_model}" "${cli_passthrough_args[@]}"
                ;;
            codex)
                # An OpenAI backend needs no wrapper endpoint: codex reaches
                # api.openai.com (platform key) or its ChatGPT login natively.
                if openai_backend "${cloud_provider}"; then
                    exec "${codex_argv[@]}"
                fi
                export CODEX_OSS_BASE_URL="${active_host}/v1"
                exec "${codex_argv[@]}"
                ;;
            qwen)
                export OPENAI_MODEL="${resolved_model}"
                export QWEN_MODEL="${resolved_model}"
                export OPENAI_BASE_URL="${active_host}/v1"
                # A real OPENAI_API_KEY is only safe to forward to a plain local
                # daemon: active_host may be the LAN Desktop or its ssh -L
                # tunnel, where a bearer token would leak off this box; Ollama
                # ignores it. The key goes in the environment, never argv
                # (--openai-api-key is readable by any user via ps). qwen ranks
                # OPENAI_API_KEY above settings.json's security.auth.apiKey, so
                # dropping the flag keeps the same precedence.
                local qwen_key="ollama"
                if host_is_plain_local "${active_host}"; then
                    qwen_key="${OPENAI_API_KEY:-ollama}"
                fi
                export OPENAI_API_KEY="${qwen_key}"
                # qwen defaults to a 45s per-request timeout (contentGenerator
                # .timeout), which large models blow through on the first token
                # (cold load + long thinking) - every agentic request then dies
                # with 'Request timeout after 45s'. Raise it unless the user set
                # their own.
                export QWEN_CODE_API_TIMEOUT_MS="${QWEN_CODE_API_TIMEOUT_MS:-600000}"
                exec "${cli_cmd}" --openai-base-url "${active_host}/v1" --auth-type openai --model "${resolved_model}" "${cli_passthrough_args[@]}"
                ;;
            grok)
                # grok (xAI's Grok Build TUI) exposes no --base-url/--provider flag.
                # GROK_MODELS_BASE_URL redirects BOTH the startup catalog fetch
                # ({base}/models) and inference, which is what makes --model accept
                # real Ollama tags. Routing alone edits nothing; only the
                # context_window override below does, and that is reverted on exit.
                local grok_rc=0 grok_ctx=""
                export GROK_MODELS_BASE_URL="${active_host}/v1"
                # Deliberately forced rather than ${XAI_API_KEY:-ollama}: grok sends
                # this as 'Authorization: Bearer' to GROK_MODELS_BASE_URL/models, and
                # active_host may be the LAN/tunnel Desktop - forwarding a real xAI
                # key there would leak it off this box. Ollama ignores the value.
                export XAI_API_KEY="ollama"

                # A tuned or specified num_ctx goes into config.toml as this model's
                # context_window. Read from launch flag, config/env, or tuning.
                if [[ -n "${opt_launch_ctx}" ]]; then
                    grok_ctx="${opt_launch_ctx}"
                elif [[ -n "${tp:-}" ]]; then
                    grok_ctx=$(echo "${tp}" | jq -r '.num_ctx? // empty') || grok_ctx=""
                fi
                if [[ -n "${grok_ctx}" ]] && grok_patch_context "${resolved_model}" "${grok_ctx}"; then
                    echo "${C_DIM}[*] grok context_window=${grok_ctx} for '${resolved_model}' (reverted on exit)${C_RESET}"
                    trap grok_cleanup EXIT INT TERM HUP
                fi

                # No exec here: grok_cleanup must run once the session ends.
                "${cli_cmd}" --model "${resolved_model}" "${cli_passthrough_args[@]}" || grok_rc=$?
                exit "${grok_rc}"
                ;;
            kimi)
                if openai_backend "${cloud_provider}"; then
                    # Both OpenAI backends route through config.toml: kimi needs a
                    # [providers.<backend>] entry (base_url plus the NAME of the
                    # env var holding the credential) and an alias for the
                    # launched model. The credential itself stays in the
                    # environment, so nothing secret is written to disk.
                    if [[ "${cloud_provider}" == codex ]]; then
                        _resolve_codex_auth
                        _codex_sync_kimi "${resolved_model}" >&2 || return 1
                        echo "${C_DIM}[*] kimi on codex provider: ${resolved_model} (ChatGPT OAuth, renewed as needed)${C_RESET}" >&2
                    else
                        _openai_sync_kimi "${resolved_model}" >&2 || return 1
                        echo "${C_DIM}[*] kimi on openai provider: ${resolved_model} (platform API key)${C_RESET}" >&2
                    fi
                    unset KIMI_MODEL_NAME KIMI_MODEL_API_KEY KIMI_MODEL_PROVIDER_TYPE \
                        KIMI_MODEL_BASE_URL KIMI_MODEL_MAX_CONTEXT_SIZE KIMI_MODEL_CAPABILITIES \
                        KIMI_MODEL_REASONING_KEY KIMI_MODEL_THINKING_EFFORT
                    export KIMI_DISABLE_TELEMETRY="${KIMI_DISABLE_TELEMETRY:-1}"
                    export KIMI_CODE_NO_AUTO_UPDATE="${KIMI_CODE_NO_AUTO_UPDATE:-1}"
                    exec "${cli_cmd}" -m "${resolved_model}" "${cli_passthrough_args[@]}"
                fi
                if [[ "${cloud_provider}" == "abliteration" ]]; then
                    # abliteration.ai path: the KIMI_MODEL_* env channel only.
                    # A config.toml alias would have to store a third-party API
                    # key in plaintext on disk, and the whole point of routing
                    # through kimo is that kimi's own config is left alone - so
                    # this is deliberately the zero-footprint path, not the
                    # alias-preferred one used for Ollama below. There is no
                    # /api/show to probe either: capabilities and the context
                    # window come from the ABLITERATION_MODELS table.
                    unset KIMI_MODEL_NAME KIMI_MODEL_API_KEY KIMI_MODEL_PROVIDER_TYPE \
                        KIMI_MODEL_BASE_URL KIMI_MODEL_MAX_CONTEXT_SIZE KIMI_MODEL_CAPABILITIES \
                        KIMI_MODEL_REASONING_KEY KIMI_MODEL_THINKING_EFFORT
                    export KIMI_DISABLE_TELEMETRY="${KIMI_DISABLE_TELEMETRY:-1}"
                    export KIMI_CODE_NO_AUTO_UPDATE="${KIMI_CODE_NO_AUTO_UPDATE:-1}"
                    export KIMI_MODEL_NAME="${resolved_model}"
                    export KIMI_MODEL_PROVIDER_TYPE="openai"
                    export KIMI_MODEL_BASE_URL="${ablit_openai_url}"
                    export KIMI_MODEL_API_KEY="${ablit_key}"
                    export KIMI_MODEL_MAX_CONTEXT_SIZE="${ablit_ctx}"
                    export KIMI_MODEL_CAPABILITIES="${KIMO_KIMI_CAPABILITIES:-${ablit_caps}}"
                    # abliteration.ai returns its reasoning trace as
                    # 'reasoning_content' on /v1/chat/completions - the field
                    # kimi auto-detects, unlike Ollama's 'reasoning'.
                    export KIMI_MODEL_REASONING_KEY="${KIMO_KIMI_REASONING_KEY:-reasoning_content}"
                    local kimi_ablit_effort="${KIMO_KIMI_EFFORT:-${OM_KIMI_EFFORT:-high}}"
                    if [[ ",${ablit_efforts}," != *",${kimi_ablit_effort},"* ]]; then
                        echo "${C_YELLOW}[!] Warning: thinking effort '${kimi_ablit_effort}' is not offered by ${resolved_model} (${ablit_efforts}); using xhigh.${C_RESET}" >&2
                        kimi_ablit_effort="xhigh"
                    fi
                    export KIMI_MODEL_THINKING_EFFORT="${kimi_ablit_effort}"
                    if ${opt_launch_webbridge}; then
                        echo "${C_DIM}[*] -W/--webbridge is a Moonshot-quota fallback; abliteration.ai serves its own server-side web_search tool.${C_RESET}"
                    fi
                    echo "${C_DIM}[*] kimi on abliteration.ai '${resolved_model}' via ${ablit_openai_url} (context ${ablit_ctx}, caps ${KIMI_MODEL_CAPABILITIES}, effort ${kimi_ablit_effort})${C_RESET}"
                    exec "${cli_cmd}" "${cli_passthrough_args[@]}"
                fi
                if [[ "${cloud_provider}" == "dashscope" ]]; then
                    # DashScope path: the KIMI_MODEL_* env channel only, exactly
                    # like abliteration - a config.toml alias would store a
                    # third-party API key in plaintext on disk, and kimi's own
                    # config is deliberately left alone. There is no /api/show
                    # to probe: the context window and capabilities come from
                    # the endpoint's documented limits.
                    unset KIMI_MODEL_NAME KIMI_MODEL_API_KEY KIMI_MODEL_PROVIDER_TYPE \
                        KIMI_MODEL_BASE_URL KIMI_MODEL_MAX_CONTEXT_SIZE KIMI_MODEL_CAPABILITIES \
                        KIMI_MODEL_REASONING_KEY KIMI_MODEL_THINKING_EFFORT
                    export KIMI_DISABLE_TELEMETRY="${KIMI_DISABLE_TELEMETRY:-1}"
                    export KIMI_CODE_NO_AUTO_UPDATE="${KIMI_CODE_NO_AUTO_UPDATE:-1}"
                    export KIMI_MODEL_NAME="${resolved_model}"
                    export KIMI_MODEL_PROVIDER_TYPE="openai"
                    export KIMI_MODEL_BASE_URL="${active_host}"
                    export KIMI_MODEL_API_KEY="${dashscope_key}"
                    export KIMI_MODEL_MAX_CONTEXT_SIZE="${opt_launch_ctx:-${DASHSCOPE_DEFAULT_CTX}}"
                    export KIMI_MODEL_CAPABILITIES="${KIMO_KIMI_CAPABILITIES:-thinking,tool_use}"
                    # DashScope returns its reasoning trace as
                    # 'reasoning_content' on /v1/chat/completions - the field
                    # kimi auto-detects, unlike Ollama's 'reasoning'.
                    export KIMI_MODEL_REASONING_KEY="${KIMO_KIMI_REASONING_KEY:-reasoning_content}"
                    export KIMI_MODEL_THINKING_EFFORT="${KIMO_KIMI_EFFORT:-${OM_KIMI_EFFORT:-high}}"
                    echo "${C_DIM}[*] kimi on DashScope '${resolved_model}' via ${active_host} (context ${KIMI_MODEL_MAX_CONTEXT_SIZE}, caps ${KIMI_MODEL_CAPABILITIES}, effort ${KIMI_MODEL_THINKING_EFFORT})${C_RESET}"
                    exec "${cli_cmd}" "${cli_passthrough_args[@]}"
                fi
                # kimi (Kimi Code CLI). Two routing paths, tried in order:
                # 1. config.toml alias (preferred): kimi_register_all_models
                #    upserts a provider for the resolved host plus an alias for
                #    every model that host advertises (kimi_register_model
                #    registers only the resolved tag when KIMO_KIMI_REGISTER_ALL=0)
                #    - additive and idempotent, kept across sessions like the
                #    user's other providers, so (unlike grok/agy) nothing is
                #    reverted on exit. Only a config alias can declare
                #    support_efforts/off_effort, which unlocks the in-session
                #    /effort picker with graded efforts that reach the wire as
                #    reasoning_effort. Launched with -m <alias>.
                # 2. KIMI_MODEL_* env channel (fallback when tomlkit is missing
                #    or the config is unwritable): synthesizes a temporary
                #    in-memory provider; zero footprint, but efforts are locked
                #    to on/off and the graded effort is chosen at launch time.
                # One /api/show probe feeds both: the model's native context
                # length and its real capability list.
                local kimi_show="" kimi_caps="" kimi_ctx="" kimi_alias=""
                kimi_show=$(curl -s --connect-timeout 2 -m 5 "${active_host}/api/show" \
                    -d "$(jq -nc --arg m "${resolved_model}" '{model: $m}')") || kimi_show=""

                local kimi_runtime_ctx="" kimi_arch_ctx=""
                if [[ -n "${kimi_show}" ]]; then
                    kimi_runtime_ctx=$(echo "${kimi_show}" | jq -r '(.parameters // "") | if test("num_ctx") then (capture("num_ctx\\s+(?<v>[0-9]+)") | .v) else empty end' 2>/dev/null) || kimi_runtime_ctx=""
                    kimi_arch_ctx=$(echo "${kimi_show}" | jq -r '[.model_info // {} | to_entries[] | select(.key | endswith("context_length")) | .value] | max // empty' 2>/dev/null) || kimi_arch_ctx=""
                fi

                # Context length precedence:
                # 1. Explicit launch CLI flag (--ctx / --context)
                # 2. Environment variable (KIMO_KIMI_CONTEXT or KIMO_CONTEXT)
                # 3. Model tuning registry (tune --ctx)
                # 4. Model runtime Modelfile parameter (num_ctx)
                # 5. Model architecture maximum (context_length)
                # Then cap at the architecture maximum, and at the baked num_ctx.
                # The OpenAI endpoint cannot carry num_ctx, so a baked PARAMETER
                # num_ctx is the window every request gets. Telling Kimi a larger
                # max_context_size skips compaction; the runner then stops the
                # turn with finish_reason=length ("Model hit max_tokens") once
                # the prompt fills that window, before a tool call is emitted.
                # There is no separate output-token cap (num_predict stays -1).
                local requested_ctx="${opt_launch_ctx:-${KIMO_KIMI_CONTEXT:-${KIMO_CONTEXT:-}}}"
                if [[ -z "${requested_ctx}" && -n "${tp:-}" ]]; then
                    requested_ctx=$(echo "${tp}" | jq -r '.num_ctx? // empty') || requested_ctx=""
                fi

                if [[ -n "${requested_ctx}" && "${requested_ctx}" =~ ^[0-9]+$ ]]; then
                    kimi_ctx="${requested_ctx}"
                    if [[ "${kimi_arch_ctx}" =~ ^[0-9]+$ ]] && ((kimi_ctx > kimi_arch_ctx)); then
                        echo "${C_YELLOW}[!] Warning: Requested context (${kimi_ctx}) exceeds model architecture maximum (${kimi_arch_ctx}). Capping to ${kimi_arch_ctx}.${C_RESET}" >&2
                        kimi_ctx="${kimi_arch_ctx}"
                    fi
                elif [[ "${kimi_runtime_ctx}" =~ ^[0-9]+$ ]]; then
                    kimi_ctx="${kimi_runtime_ctx}"
                elif [[ "${kimi_arch_ctx}" =~ ^[0-9]+$ ]]; then
                    kimi_ctx="${kimi_arch_ctx}"
                fi

                # The runner window wins over a larger request. Raising num_ctx
                # on the daemon is a model rewrite; the served parameter is the
                # window this launch can actually use.
                if [[ -n "${kimi_ctx}" && "${kimi_runtime_ctx}" =~ ^[0-9]+$ ]] && ((kimi_ctx > kimi_runtime_ctx)); then
                    echo "${C_YELLOW}[!] Kimi context set to ${kimi_runtime_ctx} (${resolved_model} num_ctx). Requested ${kimi_ctx} is above the runner window, which stops the turn with \"Model hit max_tokens\" before a tool call.${C_RESET}" >&2
                    kimi_ctx="${kimi_runtime_ctx}"
                fi

                if [[ -n "${kimi_ctx}" ]]; then
                    export OLLAMA_CONTEXT_LENGTH="${kimi_ctx}"
                fi

                # Capabilities decide whether kimi enables thinking at all: with
                # no 'thinking' tag the effort is locked to 'off' ("Unsupported
                # thinking effort ... Available: off"). Map Ollama's own
                # capability list (thinking/tools/vision) rather than guessing;
                # tool_use-only is the fallback when the probe fails.
                if [[ -n "${kimi_show}" ]]; then
                    kimi_caps=$(echo "${kimi_show}" | jq -r '[(.capabilities // [])[] | if . == "thinking" then "thinking" elif . == "tools" then "tool_use" elif . == "vision" then "image_in" else empty end] | join(",")' 2>/dev/null) || kimi_caps=""
                fi
                kimi_caps="${KIMO_KIMI_CAPABILITIES:-${OM_KIMI_CAPABILITIES:-${kimi_caps:-tool_use}}}"
                local kimi_efforts="" kimi_off="" kimi_rkey="" kimi_deff=""
                if [[ ",${kimi_caps}," == *",thinking,"* ]]; then
                    # kalidroid's template maps high/max -> xhigh and raises on
                    # anything outside low/medium/xhigh, so all five kimi efforts
                    # are safe there; override via KIMO_KIMI_EFFORTS / OM_KIMI_EFFORTS for models
                    # whose templates are pickier.
                    kimi_efforts="${KIMO_KIMI_EFFORTS:-${OM_KIMI_EFFORTS:-low,medium,high,xhigh,max}}"
                    # Verified against Ollama 0.40 /v1: reasoning_effort=none is
                    # intercepted before the chat template and genuinely
                    # disables reasoning - so /effort 'off' is real, not silent.
                    kimi_off="none"
                    # Ollama's OpenAI layer returns reasoning under 'reasoning',
                    # not the 'reasoning_content' kimi auto-detects - without
                    # this override thinking output is silently dropped.
                    kimi_rkey="${KIMO_KIMI_REASONING_KEY:-${OM_KIMI_REASONING_KEY:-reasoning}}"
                    kimi_deff="${KIMO_KIMI_EFFORT:-${OM_KIMI_EFFORT:-high}}"
                fi
                export KIMI_DISABLE_TELEMETRY="${KIMI_DISABLE_TELEMETRY:-1}"
                export KIMI_CODE_NO_AUTO_UPDATE="${KIMI_CODE_NO_AUTO_UPDATE:-1}"

                # -W / --webbridge: point the session at the quota-free real-
                # browser channel. The skill file lives in ~/.agents/skills/
                # (picked up by kimi as "Extra" scope); if it exists, announce
                # it. The daemon is at ${WEBBRIDGE_URL} (default
                # http://127.0.0.1:10086/command). No API key on the wire.
                local webbridge_skill="${HOME:-/root}/.agents/skills/custom-web/SKILL.md"
                if ${opt_launch_webbridge} && [[ -f "${webbridge_skill}" ]]; then
                    echo "${C_DIM}[*] webbridge skill: ${webbridge_skill} (endpoint ${WEBBRIDGE_URL})${C_RESET}"
                    echo "${C_DIM}    Agent: on WebSearch 403 → route to WebBridge (curl POST ${WEBBRIDGE_URL})${C_RESET}"
                elif ${opt_launch_webbridge}; then
                    echo "${C_YELLOW}[!] webbridge skill not found at ${webbridge_skill} — agent will fall back to FetchURL only${C_RESET}"
                fi

                kimi_alias=""
                if [[ "${KIMO_KIMI_REGISTER_ALL:-1}" == "0" ]]; then
                    # Opt-out: only the launched tag (pre-existing behaviour).
                    kimi_alias=$(kimi_register_model "${active_host}" "${resolved_model}" "${kimi_ctx}" \
                        "${kimi_caps}" "${kimi_efforts}" "${kimi_deff}" "${kimi_off}" "${kimi_rkey}") || kimi_alias=""
                else
                    # Register the host's whole model catalogue so kimi's /model
                    # picker is not limited to the single launched tag.
                    kimi_alias=$(kimi_register_all_models "${active_host}" "${resolved_model}" "${kimi_ctx}" \
                        "${kimi_caps}" "${kimi_efforts}" "${kimi_deff}" "${kimi_off}" "${kimi_rkey}") || kimi_alias=""
                fi
                if [[ -n "${kimi_alias}" ]]; then
                    # Nested-launch guard: a kimi session started by this script
                    # exports KIMI_MODEL_* to all its children. A stale inherited
                    # env model must not be synthesized alongside the alias.
                    unset KIMI_MODEL_NAME KIMI_MODEL_API_KEY KIMI_MODEL_PROVIDER_TYPE \
                        KIMI_MODEL_BASE_URL KIMI_MODEL_MAX_CONTEXT_SIZE KIMI_MODEL_CAPABILITIES \
                        KIMI_MODEL_REASONING_KEY KIMI_MODEL_THINKING_EFFORT
                    echo "${C_DIM}[*] kimi alias '${kimi_alias}' -> ${active_host}/v1 (context ${kimi_ctx:-kimi default}${kimi_efforts:+, efforts off|${kimi_efforts}})${C_RESET}"
                    exec "${cli_cmd}" -m "${kimi_alias}" "${cli_passthrough_args[@]}"
                fi

                # --- Fallback: KIMI_MODEL_* env channel (no config footprint) ---
                export KIMI_MODEL_NAME="${resolved_model}"
                export KIMI_MODEL_PROVIDER_TYPE="openai"
                export KIMI_MODEL_BASE_URL="${active_host}/v1"
                # Deliberately forced rather than ${OPENAI_API_KEY:-ollama}: the
                # key is sent as 'Authorization: Bearer' to KIMI_MODEL_BASE_URL,
                # and active_host may be the LAN/tunnel Desktop - forwarding a
                # real key there would leak it off this box. Ollama ignores the
                # value. KIMI_MODEL_API_KEY is mandatory for the env model.
                export KIMI_MODEL_API_KEY="ollama"
                if [[ -n "${kimi_ctx}" ]]; then
                    export KIMI_MODEL_MAX_CONTEXT_SIZE="${kimi_ctx}"
                else
                    unset KIMI_MODEL_MAX_CONTEXT_SIZE
                fi
                export KIMI_MODEL_CAPABILITIES="${kimi_caps}"
                if [[ ",${kimi_caps}," == *",thinking,"* ]]; then
                    export KIMI_MODEL_REASONING_KEY="${kimi_rkey}"
                    # The env model cannot declare support_efforts, so the
                    # in-session /effort picker only offers on/off - and both
                    # encode as *silent* (no reasoning_effort field). A concrete
                    # effort must ride in env instead; it is sent verbatim:
                    #   KIMO_KIMI_EFFORT=xhigh kimo --remote launch kimi ...
                    export KIMI_MODEL_THINKING_EFFORT="${KIMO_KIMI_EFFORT:-${OM_KIMI_EFFORT:-high}}"
                else
                    # A stale inherited effort on a non-thinking model makes kimi
                    # fail the request outright ("does not support thinking").
                    unset KIMI_MODEL_REASONING_KEY KIMI_MODEL_THINKING_EFFORT
                fi
                echo "${C_DIM}[*] kimi on '${resolved_model}' via ${active_host}/v1 (context ${KIMI_MODEL_MAX_CONTEXT_SIZE:-kimi default}, caps ${KIMI_MODEL_CAPABILITIES}${KIMI_MODEL_THINKING_EFFORT:+, thinking effort ${KIMI_MODEL_THINKING_EFFORT}})${C_RESET}"
                exec "${cli_cmd}" "${cli_passthrough_args[@]}"
                ;;
            agy)
                # No exec here: the shim must be reaped and modelProvider
                # removed from agy's settings once the session ends.
                local shim rc=0
                if ! shim=$(find_gemini_shim); then
                    echo "${C_RED}Error: Gemini shim not found (looked in: ${GEMINI_SHIM_PATHS[*]}).${C_RESET}" >&2
                    echo "agy speaks only the Gemini wire format, so it cannot reach ${active_host} without it." >&2
                    exit 1
                fi
                if ! command -v jq >/dev/null 2>&1; then
                    echo "${C_RED}Error: jq is required to patch ${AGY_SETTINGS}.${C_RESET}" >&2
                    exit 1
                fi
                if ! agy_start_shim "${shim}" "${active_host}" "${resolved_model}"; then
                    exit 1
                fi
                echo "${C_DIM}[*] Gemini shim on 127.0.0.1:${AGY_SHIM_PORT} -> ${active_host} (pid ${AGY_SHIM_PID})${C_RESET}"

                if ! agy_patch_settings "${resolved_model}"; then
                    echo "${C_RED}Error: could not register ${resolved_model} in ${AGY_SETTINGS}; agy would fall back to Google.${C_RESET}" >&2
                    exit 1
                fi
                trap agy_cleanup EXIT INT TERM HUP

                export GEMINI_API_KEY="${GEMINI_API_KEY:-ollama}"
                export GOOGLE_GEMINI_BASE_URL="http://127.0.0.1:${AGY_SHIM_PORT}"
                echo "${C_DIM}[*] agy now runs on ${resolved_model} via the Gemini wire format.${C_RESET}"

                "${cli_cmd}" --model "${resolved_model}" "${cli_passthrough_args[@]}" || rc=$?
                exit "${rc}"
                ;;
            cyberstrike)
                # Cyberstrike AI-Powered Penetration Testing Agent (cyberstrike.io)
                # Registers/updates custom OpenAI-compatible provider 'ollama' and routes
                # inference using provider/model format (ollama/<model>).
                local cs_cfg_dir="${XDG_CONFIG_HOME:-${HOME:-/root}/.config}/cyberstrike"
                local cs_cfg_file="${cs_cfg_dir}/cyberstrike.jsonc"
                mkdir -p "${cs_cfg_dir}" 2>/dev/null || true

                local need_provider_add=true
                if [[ -f "${cs_cfg_file}" ]] && grep -q "${active_host}/v1" "${cs_cfg_file}" 2>/dev/null; then
                    need_provider_add=false
                fi
                if ${need_provider_add}; then
                    cyberstrike provider add --name ollama --url "${active_host}/v1" --scope global >/dev/null 2>&1 || true
                fi

                export OPENAI_API_BASE="${active_host}/v1"
                export OPENAI_BASE_URL="${active_host}/v1"
                export OLLAMA_HOST="${active_host}"
                CYBERSTRIKE_CONFIG_CONTENT="$(jq -nc \
                    --arg api "${active_host}/v1" \
                    --arg m "${resolved_model}" \
                    '{provider: {ollama: {name: "ollama", api: $api, models: {($m): {name: $m}}}}}' 2>/dev/null || true)"
                export CYBERSTRIKE_CONFIG_CONTENT

                local cs_model="${resolved_model}"
                [[ "${cs_model}" != *"/"* ]] && cs_model="ollama/${cs_model}"
                exec "${cli_cmd}" --model "${cs_model}" "${cli_passthrough_args[@]}"
                ;;
            cursor)
                # Cursor CLI (Cursor Agent - cursor.com)
                local cursor_bin="${cli_cmd}"
                if ! command -v "${cursor_bin}" >/dev/null 2>&1; then
                    if command -v "cursor-agent" >/dev/null 2>&1; then
                        cursor_bin="cursor-agent"
                    elif command -v "agent" >/dev/null 2>&1; then
                        cursor_bin="agent"
                    fi
                fi
                export CURSOR_API_ENDPOINT="${CURSOR_API_ENDPOINT:-${active_host}/v1}"
                export CURSOR_API_BASE_URL="${CURSOR_API_BASE_URL:-${active_host}/v1}"
                [[ -n "${CURSOR_API_KEY:-}" ]] && export CURSOR_API_KEY="${CURSOR_API_KEY}"
                export CURSOR_LOCAL_AGENT_BASE_URL="${active_host}/v1"
                export CURSOR_MODEL="${resolved_model}"
                export OPENAI_BASE_URL="${active_host}/v1"
                export OPENAI_API_BASE="${active_host}/v1"
                export OPENAI_API_KEY="${OPENAI_API_KEY:-ollama}"
                exec "${cursor_bin}" --model "${resolved_model}" "${cli_passthrough_args[@]}"
                ;;
            opencode)
                # opencode routes inference purely through its own provider
                # config (~/.config/opencode/opencode.jsonc): custom
                # 'openai-compatible' providers carry a fixed baseURL, and none
                # of the ANTHROPIC_*/OPENAI_* base-url env that kimo exports is
                # read for inference (verified against opencode 1.19.0), so a
                # real key cannot ride the env to active_host the way it can for
                # qwen/claude. Both keys are still scrubbed for any non-local
                # host, defence-in-depth in case a future SDK layer starts
                # honouring the base-url env. No timeout override is needed.
                if host_is_plain_local "${active_host}"; then
                    export OPENAI_API_KEY="${OPENAI_API_KEY:-ollama}"
                    export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-ollama}"
                else
                    export OPENAI_API_KEY="ollama"
                    export ANTHROPIC_API_KEY="ollama"
                    unset ANTHROPIC_AUTH_TOKEN
                fi
                exec "${cli_cmd}" --model "${resolved_model}" "${cli_passthrough_args[@]}"
                ;;
            *)
                exec "${cli_cmd}" --model "${resolved_model}" "${cli_passthrough_args[@]}"
                ;;
        esac
    elif [[ -n "${cli_cmd}" ]]; then
        echo "${C_YELLOW}[!] External CLI '${cli_cmd}' not found in PATH.${C_RESET}"
        echo "${C_DIM}    Tip: Install it with: ${0##*/} install ${provider}${C_RESET}"
        echo "${C_CYAN}[*] Falling back to native 'ollama run ${resolved_model}'...${C_RESET}"
        exec ollama run "${resolved_model}" "${cli_passthrough_args[@]}"
    else
        echo "${C_CYAN}[*] Executing provider '${provider}' via 'ollama run ${resolved_model}'...${C_RESET}"
        exec ollama run "${resolved_model}" "${cli_passthrough_args[@]}"
    fi
}

# -----------------------------------------------------------------------------
# Command: install / setup (External CLI Package Manager)
# -----------------------------------------------------------------------------
_get_cli_version() {
    local cmd="$1"
    local raw ver=""
    if [[ "${cmd}" == "cursor" ]]; then
        for _cb in cursor-agent agent cursor; do
            if command -v "${_cb}" >/dev/null 2>&1; then cmd="${_cb}"; break; fi
        done
    fi
    if ! command -v "${cmd}" >/dev/null 2>&1; then
        echo "-"
        return
    fi
    if [[ "${cmd}" == "cursor" && "$(id -u)" -eq 0 ]]; then
        local ctmp
        # No fixed fallback path: root would rm -rf whatever sits there.
        raw=""
        if ctmp=$(mktemp -d 2>/dev/null); then
            raw=$("${cmd}" --version --no-sandbox --user-data-dir="${ctmp}" 2>&1 | head -n 1) || raw=""
            rm -rf "${ctmp}" 2>/dev/null || true
        fi
    else
        raw=$("${cmd}" --version 2>&1) || raw=""
    fi
    [[ -z "${raw}" ]] && raw=$("${cmd}" -v 2>&1) || true
    ver=$(echo "${raw}" | grep -oE '[0-9]{4}\.[0-9]{2}\.[0-9]{2}(-[0-9A-Za-z.-]+)?|[0-9]+(\.[0-9]+)+(-[0-9A-Za-z.-]+)?' | head -n 1) || ver=""
    if [[ -n "${ver}" ]]; then
        echo "${ver}"
    elif [[ -n "${raw}" ]]; then
        echo "${raw:0:15}"
    else
        echo "unknown"
    fi
}

_install_list_status() {
    echo "${C_BOLD}EXTERNAL LLM CLI INVENTORY & STATUS:${C_RESET}"
    local fmt="  %-12s %-20s %-14s %-32s %s"
    printf "${C_CYAN}${fmt}${C_RESET}\n" "CLI" "STATUS" "VERSION" "BINARY PATH" "DEFAULT MODEL"
    echo "  ------------------------------------------------------------------------------------------------------"
    local clis=("claude" "codex" "qwen" "grok" "kimi" "cursor" "opencode" "cyberstrike" "agy" "openclaw" "hermes" "gh")
    for c in "${clis[@]}"; do
        local bin="${EXTERNAL_CLI_MAP[$c]:-$c}"
        if [[ "${c}" == "cursor" ]]; then
            for _cb in cursor-agent agent cursor; do
                if command -v "${_cb}" >/dev/null 2>&1; then bin="${_cb}"; break; fi
            done
        fi
        local dmodel="${KIMO_DEFAULT_MODEL:-${DEFAULT_MODELS[$c]:-n/a}}"
        local bin_path=""
        bin_path=$(command -v "${bin}" 2>/dev/null || true)
        local status_badge ver
        if [[ -n "${bin_path}" ]]; then
            ver=$(_get_cli_version "${bin}")
            status_badge="${C_GREEN}● INSTALLED${C_RESET}"
            printf "  %-12s %-29s %-14s %-32s %s\n" "${c}" "${status_badge}" "${ver}" "${bin_path}" "${dmodel}"
        else
            status_badge="${C_RED}○ MISSING${C_RESET}"
            printf "  %-12s %-29s %-14s %-32s %s\n" "${c}" "${status_badge}" "-" "-" "${dmodel}"
        fi
    done
    echo ""
    echo "${C_DIM}Install or update any CLI with: ${0##*/} install <name> [--update|--force]${C_RESET}"
    echo "${C_DIM}Install all supported CLIs with: ${0##*/} install all${C_RESET}"
}

_gh_latest_version() {
    curl -fsSL --connect-timeout 2 -m 10 https://api.github.com/repos/cli/cli/releases/latest \
        | jq -er '.tag_name | select(test("^v[0-9]+\\.[0-9]+\\.[0-9]+$")) | ltrimstr("v")'
}

_gh_check_destination() {
    local dest="$1" require_existing="${2:-false}" dir="${1%/*}" parent="$1" output status cellar entry
    case "${dest}" in
        /*) ;;
        *) echo "Error: GitHub CLI destination must be an absolute path: ${dest}." >&2; return 1 ;;
    esac
    case "${dest}" in
        *'/../'*|*'/./'*|*'//'*) echo "Error: ambiguous GitHub CLI path: ${dest}." >&2; return 1 ;;
        /bin/*|/sbin/*|/usr/bin/*|/usr/sbin/*|/nix/store/*|/gnu/store/*|/snap/*|/var/lib/flatpak/*|*/Cellar/*|*/Caskroom/*)
            echo "Error: GitHub CLI is in a package-managed system store: ${dest}. Use its package manager." >&2; return 1 ;;
    esac
    while [[ "${parent}" != / ]]; do
        if [[ -L "${parent}" ]]; then
            echo "Error: refusing symlink in GitHub CLI destination path: ${parent}." >&2
            return 1
        fi
        parent="${parent%/*}"
        [[ -n "${parent}" ]] || parent=/
    done
    if [[ -e "${dest}" ]]; then
        [[ -f "${dest}" && -x "${dest}" && -O "${dest}" && -w "${dest}" ]] || {
            echo "Error: GitHub CLI must be a writable regular executable owned by the current user: ${dest}." >&2; return 1
        }
    elif [[ "${require_existing}" == true ]]; then
        echo "Error: in-place GitHub CLI update requires an existing executable: ${dest}." >&2
        return 1
    fi
    parent="${dir}"
    while [[ ! -e "${parent}" ]]; do
        parent="${parent%/*}"
        [[ -n "${parent}" ]] || parent=/
    done
    [[ -d "${parent}" && -O "${parent}" && -w "${parent}" && -x "${parent}" ]] || {
        echo "Error: GitHub CLI destination directory must be owned and writable by the current user: ${parent}. No sudo is used." >&2; return 1
    }
    if command -v dpkg-query >/dev/null 2>&1; then
        status=0
        output=$(LC_ALL=C dpkg-query -S "${dest}" 2>&1) || status=$?
        if [[ "${status}" == 0 ]]; then
            echo "Error: package-owned GitHub CLI at ${dest}; use its package manager." >&2; return 1
        fi
        [[ "${status}" == 1 && "${output}" == "dpkg-query: no path found matching pattern ${dest}" ]] || {
            echo "Error: could not establish dpkg ownership of ${dest}; refusing replacement." >&2; return 1
        }
    fi
    if command -v rpm >/dev/null 2>&1; then
        status=0
        output=$(LC_ALL=C rpm -qf "${dest}" 2>&1) || status=$?
        [[ "${status}" != 0 ]] || {
            echo "Error: package-owned GitHub CLI at ${dest}; use its package manager." >&2; return 1
        }
        [[ "${status}" == 1 && "${output}" == "file ${dest} is not owned by any package" ]] || {
            echo "Error: could not establish RPM ownership of ${dest}; refusing replacement." >&2; return 1
        }
    fi
    if command -v brew >/dev/null 2>&1; then
        cellar=$(brew --cellar 2>/dev/null) && [[ "${cellar}" == /* ]] || {
            echo "Error: could not locate Homebrew's store; refusing replacement." >&2; return 1
        }
        [[ "${dest}" != "${cellar}"/* ]] || {
            echo "Error: GitHub CLI is in Homebrew's store; use brew upgrade gh." >&2; return 1
        }
        output=$(brew list --formula --verbose 2>/dev/null) || {
            echo "Error: could not establish Homebrew ownership of ${dest}; refusing replacement." >&2; return 1
        }
        while IFS= read -r entry; do
            if [[ "${entry}" == "${dest}" || ( "${entry}" == */ && "${dest}" == "${entry}"* ) ]]; then
                echo "Error: Homebrew-owned GitHub CLI at ${dest}; use brew upgrade gh." >&2; return 1
            fi
        done <<< "${output}"
    fi
}

_install_gh() (
    local force="$1" update="$2" cur_bin dest dir os arch ext version asset base tmp expected actual staged backup="" require_existing=false
    dir="${HOME}/.local/bin"
    dest="${dir}/gh"
    cur_bin=$(type -P gh 2>/dev/null || true)
    if [[ -n "${cur_bin}" && "${force}" != true && "${update}" != true ]]; then
        echo "GitHub CLI is already installed ($(_get_cli_version gh)) at ${cur_bin}."
        return 0
    fi
    if [[ -n "${cur_bin}" && "${cur_bin}" != "${dest}" ]]; then
        if [[ "${gh_allow_system_path:-false}" != true || "${update}" != true || " ${FUNCNAME[*]} " != *" cmd_update "* ]]; then
            echo "Error: refusing to replace or shadow GitHub CLI at ${cur_bin}. For an owned standalone executable, use 'kimo update gh --allow-system-path'; package-managed gh must use its package manager (see https://cli.github.com/manual/installation)." >&2
            return 1
        fi
        dest="${cur_bin}"
        dir="${dest%/*}"
        require_existing=true
    fi
    _gh_check_destination "${dest}" "${require_existing}" || return 1
    case "$(uname -s)" in
        Linux) os=linux; ext=tar.gz ;;
        Darwin) os=macOS; ext=zip ;;
        *) echo "Error: unsupported GitHub CLI platform." >&2; return 1 ;;
    esac
    case "$(uname -m)" in
        x86_64|amd64) arch=amd64 ;;
        aarch64|arm64) arch=arm64 ;;
        i386|i686) arch=386 ;;
        armv6l|armv7l) arch=armv6 ;;
        *) echo "Error: unsupported GitHub CLI architecture." >&2; return 1 ;;
    esac
    if [[ "${os}" == macOS && "${arch}" != amd64 && "${arch}" != arm64 ]]; then
        echo "Error: unsupported GitHub CLI architecture on macOS." >&2; return 1
    fi
    if ! command -v curl >/dev/null || ! command -v jq >/dev/null \
        || { ! command -v sha256sum >/dev/null && ! command -v shasum >/dev/null; } \
        || { [[ "${ext}" == zip ]] && ! command -v unzip >/dev/null; } \
        || { [[ "${ext}" == tar.gz ]] && ! command -v tar >/dev/null; }; then
        echo "Error: GitHub CLI installation requires curl, jq, SHA-256 tooling and tar (Linux) or unzip (macOS)." >&2; return 1
    fi
    version=$(_gh_latest_version) || { echo "Error: could not read GitHub CLI release metadata." >&2; return 1; }
    asset="gh_${version}_${os}_${arch}.${ext}"
    base="https://github.com/cli/cli/releases/download/v${version}"
    mkdir -p "${dir}" || return 1
    tmp=$(mktemp -d "${dir}/.gh-install.XXXXXXXX") || return 1
    trap 'rm -rf "${tmp}"' EXIT
    if ! curl -fsSL --connect-timeout 10 -m 120 "${base}/${asset}" -o "${tmp}/${asset}" \
        || ! curl -fsSL --connect-timeout 10 -m 30 "${base}/gh_${version}_checksums.txt" -o "${tmp}/checksums"; then
        echo "Error: GitHub CLI download failed." >&2; return 1
    fi
    expected=$(awk -v name="${asset}" '$2 == name {print $1}' "${tmp}/checksums")
    [[ "${expected}" =~ ^[0-9a-fA-F]{64}$ ]] || { echo "Error: missing or invalid GitHub CLI checksum." >&2; return 1; }
    if command -v sha256sum >/dev/null; then
        actual=$(sha256sum "${tmp}/${asset}") || return 1
    else
        actual=$(shasum -a 256 "${tmp}/${asset}") || return 1
    fi
    [[ "${actual%% *}" == "${expected}" ]] || { echo "Error: GitHub CLI checksum mismatch." >&2; return 1; }
    if [[ "${ext}" == zip ]]; then
        unzip -q "${tmp}/${asset}" "gh_${version}_${os}_${arch}/bin/gh" -d "${tmp}" || return 1
    else
        tar --no-same-owner -xzf "${tmp}/${asset}" -C "${tmp}" "gh_${version}_${os}_${arch}/bin/gh" || return 1
    fi
    staged="${tmp}/gh_${version}_${os}_${arch}/bin/gh"
    if [[ ! -f "${staged}" ]] || [[ -L "${staged}" ]] || ! chmod 755 "${staged}"; then
        return 1
    fi
    actual=$("${staged}" --version) || return 1
    [[ "${actual}" == "gh version ${version} "* || "${actual}" == "gh version ${version}" ]] || {
        echo "Error: staged GitHub CLI version does not match release." >&2; return 1
    }
    _gh_check_destination "${dest}" "${require_existing}" || return 1
    if [[ -e "${dest}" ]]; then
        backup=$(mktemp "${dir}/.gh-backup.XXXXXXXX") || return 1
        cp -p "${dest}" "${backup}" || {
            echo "Error: GitHub CLI backup failed at ${backup}; existing binary preserved." >&2; return 1
        }
    fi
    if [[ -L "${dest}" ]] || [[ -d "${dest}" ]] || ! mv -f "${staged}" "${dest}"; then
        echo "Error: GitHub CLI replacement failed; backup: ${backup:-none}." >&2; return 1
    fi
    if ! actual=$("${dest}" --version) || [[ "${actual}" != "gh version ${version} "* && "${actual}" != "gh version ${version}" ]]; then
        echo "Error: installed GitHub CLI failed version verification at ${dest}." >&2
        if [[ -n "${backup}" ]]; then
            if mv -f "${backup}" "${dest}"; then
                echo "Restored original GitHub CLI atomically at ${dest}." >&2
            else
                echo "Error: rollback failed; original GitHub CLI backup remains at ${backup}." >&2
            fi
        fi
        return 1
    fi
    echo "Installed GitHub CLI ${version} at ${dest}."
    [[ -z "${backup}" ]] || echo "Original GitHub CLI backup retained at ${backup}."
    if [[ ":${PATH}:" != *":${dir}:"* ]]; then
        echo "Add ${dir} to PATH to use gh."
    fi
)

_install_single_cli() {
    local cli="$1"
    local force="${2:-false}"
    local update="${3:-false}"

    case "${cli}" in
        kimi-code) cli="kimi" ;;
        claude-code) cli="claude" ;;
        grok-cli) cli="grok" ;;
        qwen-code) cli="qwen" ;;
        antigravity) cli="agy" ;;
        cursor-agent|agent) cli="cursor" ;;
    esac

    case "${cli}" in
        gh) _install_gh "${force}" "${update}"; return $? ;;
        kimi)
            local cur_bin
            cur_bin=$(command -v kimi 2>/dev/null || true)
            if [[ -n "${cur_bin}" && "${force}" != "true" && "${update}" != "true" ]]; then
                local ver
                ver=$(_get_cli_version kimi)
                echo "${C_GREEN}[✓] Kimi Code CLI is already installed (${ver}) at ${cur_bin}.${C_RESET}"
                echo "${C_DIM}    Run '${0##*/} install kimi --update' to update to latest version.${C_RESET}"
                return 0
            fi
            echo "${C_CYAN}[*] Installing Kimi Code CLI (via code.kimi.com)...${C_RESET}"
            if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
                echo "${C_RED}Error: curl or wget is required to install Kimi Code CLI.${C_RESET}" >&2
                return 1
            fi
            # Guarded, not a bare pipeline: under set -euo pipefail an installer
            # that exits nonzero would abort kimo before the friendly error below.
            if ! run_remote_installer https://code.kimi.com/kimi-code/install.sh; then
                echo "${C_RED}[!] Kimi Code CLI install script failed.${C_RESET}" >&2
                return 1
            fi
            local kimi_path="${HOME:-/root}/.kimi-code/bin"
            [[ -d "${kimi_path}" && ":${PATH}:" != *":${kimi_path}:"* ]] && export PATH="${kimi_path}:${PATH}"
            if command -v kimi >/dev/null 2>&1; then
                local new_ver
                new_ver=$(_get_cli_version kimi)
                echo "${C_GREEN}[✓] Successfully installed Kimi Code CLI (${new_ver})!${C_RESET}"
                echo "${C_CYAN}[*] Launch anytime with: ${0##*/} launch kimi${C_RESET}"
            else
                echo "${C_RED}[!] Installation completed but 'kimi' binary was not found in PATH.${C_RESET}" >&2
                return 1
            fi
            ;;
        claude)
            local cur_bin
            cur_bin=$(command -v claude 2>/dev/null || true)
            if [[ -n "${cur_bin}" && "${force}" != "true" && "${update}" != "true" ]]; then
                local ver
                ver=$(_get_cli_version claude)
                echo "${C_GREEN}[✓] Claude Code CLI is already installed (${ver}) at ${cur_bin}.${C_RESET}"
                echo "${C_DIM}    Run '${0##*/} install claude --update' to update to latest version.${C_RESET}"
                return 0
            fi
            if [[ -d "${HOME:-}/.claude" && ! -w "${HOME:-}/.claude" ]]; then
                echo "${C_YELLOW}[!] Warning: ${HOME:-}/.claude is not writable by current user ($(id -un)).${C_RESET}" >&2
                echo "${C_DIM}    If previously run under sudo, you may need: sudo chown -R $(id -u):$(id -g) ${HOME:-}/.claude${C_RESET}" >&2
            fi
            echo "${C_CYAN}[*] Installing Claude Code CLI (via claude.ai/install.sh)...${C_RESET}"
            local installed=false
            if command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1; then
                CLAUDE_INSTALL_ALLOW_SUDO=1 run_remote_installer https://claude.ai/install.sh latest && installed=true
            fi
            if ! ${installed} && command -v npm >/dev/null 2>&1; then
                echo "${C_YELLOW}[*] Falling back to npm for @anthropic-ai/claude-code...${C_RESET}"
                _npm_global_install @anthropic-ai/claude-code && installed=true
            fi
            local lbin="${HOME:-/root}/.local/bin"
            [[ -d "${lbin}" && ":${PATH}:" != *":${lbin}:"* ]] && export PATH="${lbin}:${PATH}"
            if command -v claude >/dev/null 2>&1; then
                local new_ver
                new_ver=$(_get_cli_version claude)
                echo "${C_GREEN}[✓] Successfully installed Claude Code CLI (${new_ver})!${C_RESET}"
                echo "${C_CYAN}[*] Launch anytime with: ${0##*/} launch claude${C_RESET}"
            else
                echo "${C_RED}[!] Claude Code installation failed.${C_RESET}" >&2
                return 1
            fi
            ;;
        grok)
            local cur_bin
            cur_bin=$(command -v grok 2>/dev/null || true)
            if [[ -n "${cur_bin}" && "${force}" != "true" && "${update}" != "true" ]]; then
                local ver
                ver=$(_get_cli_version grok)
                echo "${C_GREEN}[✓] Grok Build CLI is already installed (${ver}) at ${cur_bin}.${C_RESET}"
                echo "${C_DIM}    Run '${0##*/} install grok --update' to update to latest version.${C_RESET}"
                return 0
            fi
            echo "${C_CYAN}[*] Installing Grok Build CLI (via x.ai/cli)...${C_RESET}"
            if ! command -v curl >/dev/null 2>&1; then
                echo "${C_RED}Error: curl is required to install Grok CLI.${C_RESET}" >&2
                return 1
            fi
            # Guarded, not a bare pipeline: see the Kimi branch - a failing
            # installer must not abort kimo wholesale under set -euo pipefail.
            if ! run_remote_installer https://x.ai/cli/install.sh; then
                echo "${C_RED}[!] Grok Build CLI install script failed.${C_RESET}" >&2
                return 1
            fi
            local grok_path="${HOME:-/root}/.grok/bin"
            [[ -d "${grok_path}" && ":${PATH}:" != *":${grok_path}:"* ]] && export PATH="${grok_path}:${PATH}"
            if command -v grok >/dev/null 2>&1; then
                local new_ver
                new_ver=$(_get_cli_version grok)
                echo "${C_GREEN}[✓] Successfully installed Grok Build CLI (${new_ver})!${C_RESET}"
                echo "${C_CYAN}[*] Launch anytime with: ${0##*/} launch grok${C_RESET}"
            else
                echo "${C_RED}[!] Grok installation failed or binary not found.${C_RESET}" >&2
                return 1
            fi
            ;;
        codex)
            local cur_bin
            cur_bin=$(command -v codex 2>/dev/null || true)
            if [[ -n "${cur_bin}" && "${force}" != "true" && "${update}" != "true" ]]; then
                local ver
                ver=$(_get_cli_version codex)
                echo "${C_GREEN}[✓] Codex CLI is already installed (${ver}) at ${cur_bin}.${C_RESET}"
                echo "${C_DIM}    Run '${0##*/} install codex --update' to update to latest version.${C_RESET}"
                return 0
            fi
            # A standalone install (OpenAI's installer) owns its own release
            # tree; npm would only add a second copy that PATH never reaches.
            if [[ -n "${cur_bin}" ]] && _codex_is_standalone "${cur_bin}"; then
                echo "${C_CYAN}[*] Updating standalone Codex CLI via 'codex update'...${C_RESET}"
                if ! codex update </dev/null; then
                    echo "${C_RED}[!] 'codex update' failed; not falling back to npm, which would install a shadowed second copy.${C_RESET}" >&2
                    return 1
                fi
                echo "${C_GREEN}[✓] Codex CLI updater finished ($(_get_cli_version codex)).${C_RESET}"
                return 0
            fi
            echo "${C_CYAN}[*] Installing Codex CLI (via npm)...${C_RESET}"
            if ! command -v npm >/dev/null 2>&1; then
                echo "${C_RED}Error: npm is required to install Codex CLI.${C_RESET}" >&2
                return 1
            fi
            # Only the scoped package: the unscoped npm 'codex' is an unrelated
            # third-party project, so it is never a fallback.
            if ! _npm_global_install @openai/codex; then
                echo "${C_RED}[!] Codex installation failed (npm install -g @openai/codex).${C_RESET}" >&2
                return 1
            fi
            _npm_bin_on_path codex Codex || return 1
            echo "${C_GREEN}[✓] Successfully installed Codex CLI ($(_get_cli_version codex))!${C_RESET}"
            echo "${C_CYAN}[*] Launch anytime with: ${0##*/} launch codex${C_RESET}"
            ;;
        qwen)
            local cur_bin
            cur_bin=$(command -v qwen 2>/dev/null || true)
            if [[ -n "${cur_bin}" && "${force}" != "true" && "${update}" != "true" ]]; then
                local ver
                ver=$(_get_cli_version qwen)
                echo "${C_GREEN}[✓] Qwen Code CLI is already installed (${ver}) at ${cur_bin}.${C_RESET}"
                echo "${C_DIM}    Run '${0##*/} install qwen --update' to update to latest version.${C_RESET}"
                return 0
            fi
            # Same split as codex: the standalone installer's tree (a sh wrapper
            # into a dir with manifest.json) updates itself; npm would only add
            # a second copy behind it on PATH.
            if [[ -n "${cur_bin}" ]] && _qwen_standalone_dir "${cur_bin}" >/dev/null; then
                echo "${C_CYAN}[*] Updating standalone Qwen Code CLI via 'qwen update'...${C_RESET}"
                if ! qwen update </dev/null; then
                    echo "${C_RED}[!] 'qwen update' failed; not falling back to npm, which would install a shadowed second copy.${C_RESET}" >&2
                    return 1
                fi
                echo "${C_GREEN}[✓] Qwen Code CLI updater finished ($(_get_cli_version qwen)).${C_RESET}"
                return 0
            fi
            echo "${C_CYAN}[*] Installing Qwen Code CLI (via npm)...${C_RESET}"
            if ! command -v npm >/dev/null 2>&1; then
                echo "${C_RED}Error: npm is required to install Qwen Code CLI.${C_RESET}" >&2
                return 1
            fi
            if ! _npm_global_install @qwen-code/qwen-code; then
                echo "${C_RED}[!] Qwen installation failed (npm install -g @qwen-code/qwen-code).${C_RESET}" >&2
                return 1
