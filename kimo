else:
    hosts_to_check.append(('Local Daemon', local_url))
    hosts_to_check.append((f'Remote ({OM_REMOTE_HOST_IP})', remote_url))

results = []
for label, url in hosts_to_check:
    t0 = time.time()
    try:
        req = urllib.request.Request(url + '/api/version', headers={'User-Agent': 'kimo'})
        with urllib.request.urlopen(req, timeout=2.5) as r:
            ver = json.loads(r.read().decode('utf-8')).get('version', 'unknown')
            lat = int((time.time() - t0) * 1000)
            status = 'online'
    except Exception as e:
        results.append({'host': label, 'url': url, 'status': 'offline', 'error': str(e), 'latency_ms': None})
        continue

    models_cnt = 0
    try:
        req = urllib.request.Request(url + '/api/tags', headers={'User-Agent': 'kimo'})
        with urllib.request.urlopen(req, timeout=2.5) as r:
            models_cnt = len(json.loads(r.read().decode('utf-8')).get('models', []))
    except Exception:
        pass

    active_cnt = 0
    vram_bytes = 0
    try:
        req = urllib.request.Request(url + '/api/ps', headers={'User-Agent': 'kimo'})
        with urllib.request.urlopen(req, timeout=2.5) as r:
