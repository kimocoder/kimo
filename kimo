}

# run_remote_installer URL [SCRIPT_ARGS...]: fetch a vendor install script
# completely over HTTPS, then run it with SCRIPT_ARGS. 'curl | bash' can execute
# a script cut off mid-transfer and reports bash's status instead of the
# download's. Vendors rotate these scripts, so there is no stable checksum to
# pin; HTTPS-only is the floor. Env assignments prefixed to the call reach it.
run_remote_installer() {
    local url="$1" script rc=0
    shift
    script=$(mktemp) || return 1
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --connect-timeout 15 --proto '=https' --proto-redir '=https' -o "${script}" "${url}" || rc=$?
    elif command -v wget >/dev/null 2>&1; then
        wget -q --https-only --connect-timeout=15 -O "${script}" "${url}" || rc=$?
    else
        echo "${C_RED}Error: curl or wget is required to download ${url}.${C_RESET}" >&2
        rc=1
    fi
    if [[ ${rc} -eq 0 && ! -s "${script}" ]]; then
        echo "${C_RED}Error: ${url} returned an empty installer.${C_RESET}" >&2
        rc=1
    fi
    [[ ${rc} -eq 0 ]] && { bash "${script}" "$@" || rc=$?; }
    rm -f "${script}"
    return "${rc}"
}

cmd_install() {
    local target=""
    local opt_force=false
    local opt_update=false
    local opt_list=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help|help) install_usage; return 0 ;;
            --force|-f) opt_force=true; shift ;;
            --update|-u) opt_update=true; shift ;;
            --list|-l) opt_list=true; shift ;;
            --v2) export OPENCODE_CHANNEL="v2"; shift ;;
            --v1) export OPENCODE_CHANNEL="v1"; shift ;;
            *)
                if [[ -z "${target}" ]]; then
                    target="$1"
                fi
                shift
                ;;
        esac
    done

    case "${target}" in
        opencode:v2|opencode:2) target=opencode; export OPENCODE_CHANNEL="v2" ;;
        opencode:v1|opencode:1) target=opencode; export OPENCODE_CHANNEL="v1" ;;
    esac

    if [[ -z "${target}" || "${target}" == "list" || "${target}" == "--list" || "${opt_list}" == "true" ]]; then
        _install_list_status
        return 0
    fi

    if [[ "${target}" == "all" ]]; then
        echo "${C_BOLD}Installing / Updating All External LLM CLIs...${C_RESET}"
        echo "====================================================================="
        local clis=("kimi" "claude" "grok" "codex" "qwen" "cursor" "opencode" "cyberstrike" "agy" "openclaw" "hermes" "gh")
        local failed=()
        for c in "${clis[@]}"; do
            echo ""
            if ! _install_cli_checked "${c}" "${opt_force}" "${opt_update}"; then
                failed+=("${c}")
            fi
        done
        echo ""
        echo "====================================================================="
        if [[ ${#failed[@]} -eq 0 ]]; then
            echo "${C_GREEN}[✓] All CLIs processed successfully.${C_RESET}"
        else
            echo "${C_YELLOW}[!] Finished with errors for: ${failed[*]}${C_RESET}"
            return 1
        fi
        return 0
    fi

    _install_cli_checked "${target}" "${opt_force}" "${opt_update}"
}

