target_model = OM_target_model.strip()

hosts = []
if mode == 'multi':
    hosts.extend((u.split('://', 1)[-1], u) for u in OM_MULTI_HOSTS.split())
elif mode == 'custom':
    hosts.append(('custom', target_host))
elif mode == 'remote':
    hosts.append(('remote', remote_url))
elif mode == 'local':
    hosts.append(('local', local_url))
else:
    hosts.append(('local', local_url))
    hosts.append(('remote', remote_url))

stopped_count = 0

def unload_model(host_label, url, model_name):
    payload = json.dumps({'model': model_name, 'keep_alive': 0}).encode('utf-8')
    req = urllib.request.Request(
        url + '/api/generate',
        data=payload,
        headers={'Content-Type': 'application/json', 'User-Agent': 'kimo'}
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read().decode('utf-8'))
            print(f"{OM_C_GREEN}[✓] Unloaded model \"{model_name}\" from {host_label} (GPU VRAM freed).{OM_C_RESET}")
            return True
    except Exception as e:
        print(f"{OM_C_RED}[!] Failed to unload \"{model_name}\" on {host_label}: {e}{OM_C_RESET}", file=sys.stderr)
        return False

# Stop ALL loaded models if target is empty, 'all', or '--all'
if not target_model or target_model in ['all', '--all']:
    print(f"{OM_C_BOLD}Scanning active VRAM models to unload...{OM_C_RESET}")
    for label, url in hosts:
        try:
            req = urllib.request.Request(url + '/api/ps', headers={'User-Agent': 'kimo'})
            with urllib.request.urlopen(req, timeout=3) as r:
                models = json.loads(r.read().decode('utf-8')).get('models', [])
                for m in models:
                    name = m.get('name')
                    if name:
                        if unload_model(label, url, name):
                            stopped_count += 1
        except Exception:
            pass
    if stopped_count == 0:
        print(f"{OM_C_DIM}No active models found in VRAM to stop.{OM_C_RESET}")
else:
    for label, url in hosts:
        try:
            req = urllib.request.Request(url + '/api/tags', headers={'User-Agent': 'kimo'})
            with urllib.request.urlopen(req, timeout=3) as r:
                tags = json.loads(r.read().decode('utf-8')).get('models', [])
                matched = [m['name'] for m in tags if m['name'] == target_model or m['name'].startswith(target_model + ':')]
                if matched:
                    if unload_model(label, url, matched[0]):
                        stopped_count += 1
        except Exception:
            pass
    if stopped_count == 0:
        label, url = hosts[0]
        unload_model(label, url, target_model)
PYEOF
}

# -----------------------------------------------------------------------------
# Command: warm / preload
# -----------------------------------------------------------------------------
cmd_warm() {
    local target_model="${1:-}"
    if [[ -z "${target_model}" ]]; then
        echo "${C_RED}Error: 'warm' requires a model name.${C_RESET}" >&2
        echo "Usage: ${0##*/} warm <model> [duration]" >&2
        exit 1
    fi
    local duration="${2:-24h}"
    local active_host=""
    local resolved_model="${target_model}"

    if [[ -n "${TARGET_HOST}" ]]; then
        active_host="${TARGET_HOST}"
        local res
        res=$(resolve_model_name "${target_model}" "${active_host}" || true)
        [[ -n "${res}" ]] && resolved_model="${res}"
    else
        # Desktop GPU first: a model on both hosts must not land on the Pi, which
        # has no GPU - its bridge refuses anything over the 8 GiB budget, and a
        # direct load is OOM-killed by ollama-memory-guard.
        local local_res="" remote_first
        remote_first=$(resolve_model_name "${target_model}" "${REMOTE_HOST_URL}" || true)
        [[ -z "${remote_first}" ]] && local_res=$(resolve_model_name "${target_model}" "${LOCAL_HOST_URL}" || true)
        if [[ -n "${remote_first}" ]]; then
            resolved_model="${remote_first}"
            active_host="${REMOTE_HOST_URL}"
        elif [[ -n "${local_res}" ]]; then
            resolved_model="${local_res}"
            active_host="${LOCAL_HOST_URL}"
        else
            local remote_res
            remote_res=$(resolve_model_name "${target_model}" "${REMOTE_HOST_URL}" || true)
            if [[ -n "${remote_res}" ]]; then
                resolved_model="${remote_res}"
                active_host="${REMOTE_HOST_URL}"
            else
                active_host="${LOCAL_HOST_URL}"
            fi
        fi
    fi

    echo "${C_CYAN}[*] Pre-warming model '${resolved_model}' into GPU VRAM on ${active_host} (keep_alive: ${duration})...${C_RESET}"
    local tp_warm warm_opts="{}"
    tp_warm=$(tuned_params "${resolved_model}" || true)
    if [[ -n "${tp_warm}" ]]; then
        warm_opts="${tp_warm}"
    fi

    local resp
    resp=$(curl -s -X POST "${active_host}/api/generate" \
        -H "Content-Type: application/json" \
        -d "$(jq -nc --arg m "${resolved_model}" --arg k "${duration}" --argjson opt "${warm_opts}" '{model: $m, keep_alive: $k, stream: false, options: $opt}')")

    if echo "${resp}" | grep -q '"done_reason":"load"'; then
        echo "${C_GREEN}[✓] Successfully pre-warmed '${resolved_model}' into VRAM (resident for ${duration}).${C_RESET}"
    else
        echo "${C_YELLOW}[*] Warm result: ${resp}${C_RESET}"
    fi
}

