                    [[ -f "${tmp_dir}/hackbrowser-worker.js" ]] && cp -f "${tmp_dir}/hackbrowser-worker.js" "${target_dir}/" 2>/dev/null || true
                    installed=true
                fi
                rm -rf "${tmp_dir}" 2>/dev/null || true
            fi
            for _cs_dir in "${HOME:-/root}/.cyberstrike/bin" "${HOME:-/root}/.local/share/cyberstrike/bin" "/usr/local/bin"; do
                [[ -d "${_cs_dir}" && ":${PATH}:" != *":${_cs_dir}:"* ]] && export PATH="${_cs_dir}:${PATH}"
            done
            if command -v cyberstrike >/dev/null 2>&1; then
                local new_ver
                new_ver=$(_get_cli_version cyberstrike)
                echo "${C_GREEN}[✓] Successfully installed Cyberstrike CLI (${new_ver})!${C_RESET}"
