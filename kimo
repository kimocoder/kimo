quota_usage() {
    cat <<EOF
${C_BOLD}kimo quota${C_RESET} - Quota & Usage Dashboard for providers and supported CLI accounts

${C_YELLOW}Usage:${C_RESET}
  ${0##*/} quota [cli] [options]
  ${0##*/} quotas [options]
  ${0##*/} quote [options]

${C_YELLOW}Options:${C_RESET}
  ${C_CYAN}--provider <p>${C_RESET} Provider: ollama | gemini | freetier | openrouter | web | all
  ${C_CYAN}--cli <name>${C_RESET}   CLI: claude | codex | qwen | grok | kimi | cursor | agy |
                    opencode | cyberstrike | hermes | openclaw | gh | all
  ${C_CYAN}--offline${C_RESET}      List availability without network or native usage commands
  ${C_CYAN}--no-refresh${C_RESET}   Probe Claude/Kimi with cached credentials without token refresh
  ${C_CYAN}--show-all${C_RESET}     Also list CLIs that are not installed or report no quota
                    (hidden by default unless a single CLI is named)
  ${C_CYAN}--timeout <s>${C_RESET}  Per-source timeout in seconds (default: 5, maximum: 60)
  ${C_CYAN}--model <m>${C_RESET}    Filter output to models matching substring
  ${C_CYAN}--json${C_RESET}         Output dashboard in machine-readable JSON format
  ${C_CYAN}-h, --help${C_RESET}     Show this help message

${C_YELLOW}Examples:${C_RESET}
  ${0##*/} quota
  ${0##*/} quota --provider ollama
  ${0##*/} quota --provider gemini --model flash
  ${0##*/} quota codex --json
  ${0##*/} quota --cli all
  ${0##*/} quota --json
EOF
}

find_quota_helper() {
    local source_dir candidate
    source_dir=$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "${BASH_SOURCE[0]}") || return 1
    for candidate in "${KIMO_QUOTA_HELPER:-}" "${source_dir}/lib/kimo-quota.py" \
        "${SCRIPT_DIR}/../share/kimo/kimo-quota.py" \
        "${PREFIX:-/usr/local}/share/kimo/kimo-quota.py" "/usr/local/share/kimo/kimo-quota.py"; do
        [[ -n "${candidate}" && -f "${candidate}" ]] && { printf '%s\n' "${candidate}"; return 0; }
    done
    return 1
}

cmd_quota() {
    if ! command -v python3 >/dev/null 2>&1; then
        echo "Error: python3 is required for quota checks." >&2
        return 1
    fi
    local helper gemini_key="" opt_offline=false quota_provider="all" quota_cli=false
    local options=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help|help) quota_usage; return 0 ;;
            --provider|--cli|--model|--timeout)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: $1 requires a value." >&2
                    return 1
                fi
                [[ "$1" == --provider ]] && quota_provider="$2"
                [[ "$1" == --cli ]] && quota_cli=true
                options+=("$1" "$2"); shift 2 ;;
            --provider=*) quota_provider="${1#*=}"; options+=("$1"); shift ;;
            --cli=*) quota_cli=true; options+=("$1"); shift ;;
            --model=*|--timeout=*) options+=("$1"); shift ;;
            --offline) opt_offline=true; options+=("$1"); shift ;;
            --no-refresh|--show-all) options+=("$1"); shift ;;
            --json) options+=("$1"); shift ;;
            --*) echo "Error: unknown quota option '$1'." >&2; return 1 ;;
            *) quota_cli=true; options+=(--cli "$1"); shift ;;
        esac
    done
    if ! helper=$(find_quota_helper); then
        echo "Error: kimo-quota.py is missing; reinstall kimo or set KIMO_QUOTA_HELPER." >&2
        return 1
    fi
    if ! ${opt_offline} && ! ${quota_cli} && [[ "${quota_provider}" == all || "${quota_provider}" == gemini ]]; then
        gemini_key=$(_gemini_resolve_key 2>/dev/null) || gemini_key=""
    fi
    ${OPT_JSON} && options+=(--json)
    [[ -n "${C_RESET}" ]] && options+=(--color)
    # Keep secrets out of argv. Native adapters resolve their own account auth.
    KIMO_VERSION="${KIMO_VERSION}" KIMO_QUOTA_GEMINI_KEY="${gemini_key}" python3 "${helper}" \
        --local-url "${LOCAL_HOST_URL}" --remote-url "${REMOTE_HOST_URL}" \
        --web-url "${WEBBRIDGE_URL}" --host-mode "${HOST_MODE}" \
        --target-host "${TARGET_HOST}" --multi-hosts "${MULTI_HOSTS}" \
        "${options[@]}" --cli-names "${!EXTERNAL_CLI_MAP[@]}" gh
}


# -----------------------------------------------------------------------------
# Main Dispatcher
# -----------------------------------------------------------------------------
# Remote resolution probes the network, so it waits until here (every helper
# is defined) and only runs for commands that talk to an Ollama daemon.
if ${REMOTE_RESOLVE_PENDING} && command_needs_remote "${COMMAND}"; then
    REMOTE_HOST_URL="$(resolve_remote_url)"
    if [[ "${HOST_MODE}" == "remote" ]]; then
        TARGET_HOST="${REMOTE_HOST_URL}"
        if remote_known_down "${TARGET_HOST}" || ! probe_ollama_url "${TARGET_HOST}"; then
            echo "${C_YELLOW}[!] Remote ${TARGET_HOST} unreachable (tunnel ollama-remote-tunnel.service down?)${C_RESET}" >&2
        fi
    fi
fi

# With several --host values, read-only/aggregate commands query every host;
# commands that act on one model go to the first host that has it (else the
# first --host).
if [[ "${HOST_MODE}" == "multi" ]] && command_needs_remote "${COMMAND}"; then
    case "${COMMAND}" in
        check|ping|hosts|init|scan|discover|ps|top|list|ls|search|find|stop|unload|info|show|status|health|status-report|report|logs|log|rotate-token|rotate|install|setup|update|upgrade|doctor|diagnose|diag|config|cfg|completion|sync|freetier|free-tier|kimi-sync|gemini|gemini-sync|kimi-gemini|web|version|help|-h|--help|tunnel|quota|quotas|quote) ;;
        # rm finds each model's host itself (exact names, several models).
        rm|delete) ;;
        *)
            _model="${ARGS[0]:-}"
            if [[ "${COMMAND}" == "launch" ]]; then
                _model="${KIMO_DEFAULT_MODEL:-}"
                for ((_i = 0; _i < ${#ARGS[@]}; _i++)); do
                    case "${ARGS[_i]}" in
                        --) break ;;
                        -m|--model) _model="${ARGS[_i+1]:-}"; break ;;
                        -m=*|--model=*) _model="${ARGS[_i]#*=}"; break ;;
                    esac
                done
            fi
            TARGET_HOST="${OPT_HOSTS[0]}"
            if [[ -n "${_model}" && "${_model}" != -* ]]; then
                for _h in "${OPT_HOSTS[@]}"; do
                    if resolve_model_name "${_model}" "${_h}" >/dev/null 2>&1; then
                        TARGET_HOST="${_h}"
                        break
                    fi
                done
            fi
            HOST_MODE="custom"
            echo "${C_DIM}[*] Multiple --host: routing '${COMMAND}' to ${TARGET_HOST}${C_RESET}" >&2
            ;;
    esac
fi

# First-run / unconfigured auto-discovery prompt:
# Offer discovery if invoking a remote-dependent command when remote endpoint is unconfigured & unreachable
if [[ -t 0 && "${OPT_JSON:-false}" != "true" && "${KIMO_NO_AUTOSCAN:-0}" != "1" && "${COMMAND}" != quota && "${COMMAND}" != quotas && "${COMMAND}" != quote ]]; then
    _remote_needed=false
    if [[ "${HOST_MODE}" == "remote" ]]; then
        _remote_needed=true
    else
        case "${COMMAND}" in
            check|ping|hosts|sync)
                _remote_needed=true
                ;;
        esac
    fi

    if [[ "${_remote_needed}" == "true" && -z "${KIMO_CONFIG_VALUES[remote_url]:-}" ]]; then
        if ! probe_ollama_url "${REMOTE_HOST_URL}"; then
            if [[ -z "${REMOTE_DIRECT_URL:-}" ]] || ! probe_ollama_url "${REMOTE_DIRECT_URL}"; then
                echo "${C_YELLOW}[!] Notice: Remote Ollama endpoint is not configured and unreachable (${REMOTE_HOST_URL}).${C_RESET}"
                read -r -p "Would you like to scan your network to discover active Ollama instances? [Y/n] " _autoscan_resp
                if [[ -z "${_autoscan_resp}" || "${_autoscan_resp}" =~ ^[Yy] ]]; then
                    echo ""
                    cmd_init
                    if [[ "${HOST_MODE}" == "remote" ]]; then
                        TARGET_HOST="${REMOTE_HOST_URL}"
                    fi
                    echo ""
                fi
            fi
        fi
    fi
    unset _remote_needed _autoscan_resp
fi

case "${COMMAND}" in
    check|ping)
        cmd_check
        ;;
    hosts)
        cmd_hosts
        ;;
    init)
        cmd_init "${ARGS[@]}"
        ;;
    scan|discover)
        cmd_scan "${ARGS[@]}"
        ;;
    ps)
        cmd_ps "${ARGS[@]}"
        ;;
    top)
        cmd_top "${ARGS[@]}"
        ;;
    status|health)
        cmd_status
        ;;
    status-report|report)
        cmd_status_report
        ;;
    logs|log)
        cmd_logs "${ARGS[0]:-}"
        ;;
    rotate-token|rotate)
        cmd_rotate_token "${ARGS[@]}"
        ;;
    stop|unload)
        cmd_stop "${ARGS[@]}"
        ;;
    warm|preload)
        cmd_warm "${ARGS[@]}"
        ;;
    tune|set-ctx|param)
        cmd_tune "${ARGS[@]}"
        ;;
    quota|quotas|quote)
        cmd_quota "${ARGS[@]}"
        ;;
    tunnel)
        cmd_tunnel "${ARGS[@]}"
        ;;
    bench|eval|benchmark)
        cmd_bench "${ARGS[@]}"
        ;;
    list|ls)
        cmd_list "${ARGS[0]:-}"
        ;;
    search|find)
        cmd_search "${ARGS[@]}"
        ;;
    info|show)
        cmd_info "${ARGS[@]}"
        ;;
    tag|alias|cp)
        cmd_tag "${ARGS[@]}"
        ;;
    rm|delete)
        cmd_rm "${ARGS[@]}"
        ;;
    pull|download)
        cmd_pull "${ARGS[@]}"
        ;;
    sync)
        cmd_sync "${ARGS[@]}"
        ;;
    stream)
        cmd_stream "${ARGS[@]}"
        ;;
    run)
        cmd_run "${ARGS[@]}"
        ;;
    launch)
        cmd_launch "${ARGS[@]}"
        ;;
    install|setup)
        cmd_install "${ARGS[@]}"
        ;;
    update|upgrade)
        cmd_update "${ARGS[@]}"
        ;;
    doctor|diagnose|diag)
        cmd_doctor "${ARGS[@]}"
        ;;
    config|cfg)
        cmd_config "${ARGS[@]}"
        ;;
    completion)
        cmd_completion "${ARGS[@]}"
        ;;
    freetier|free-tier|kimi-sync)
        cmd_freetier "${ARGS[@]}"
        ;;
    gemini|gemini-sync|kimi-gemini)
        cmd_gemini "${ARGS[@]}"
        ;;
    codex)
        cmd_codex "${ARGS[@]}"
        ;;
    codex-sync|kimi-codex)
        cmd_codex --sync "${ARGS[@]}"
        ;;
    web)
        cmd_web "${ARGS[@]}"
        ;;
    version)
        echo "kimo v${KIMO_VERSION}"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "${C_RED}Error: Unknown command '${COMMAND}'.${C_RESET}" >&2
        usage
        exit 1
        ;;
esac
