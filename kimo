_get_cli_latest_version() {
    local cmd="$1"
    local latest=""
    case "${cmd}" in
        claude)
            latest=$(npm view @anthropic-ai/claude-code version 2>/dev/null || true)
            ;;
        codex)
            latest=$(npm view @openai/codex version 2>/dev/null || npm view codex version 2>/dev/null || true)
            ;;
        qwen)
            latest=$(npm view @qwen-code/qwen-code version 2>/dev/null || true)
            ;;
        grok)
            latest=$(grok update --check 2>&1 | grep -oE 'latest: [0-9.]+' | awk '{print $2}' || true)
            ;;
        kimi)
            latest=$(curl -fsSL --connect-timeout 2 -m 4 https://code.kimi.com/kimi-code/latest 2>/dev/null | tr -d ' \r\n' || true)
            ;;
        opencode)
            latest=$(npm view opencode-ai version 2>/dev/null || true)
            ;;
        openclaw)
            latest=$(npm view openclaw version 2>/dev/null || true)
            ;;
        hermes)
            latest=$(npm view hermes-agent version 2>/dev/null || true)
            ;;
        agy)
            latest=""
            ;;
        cyberstrike)
            latest=$(curl -fsSL --connect-timeout 2 -m 4 https://api.github.com/repos/CyberStrikeus/CyberStrike/releases/latest 2>/dev/null | grep -oE '"tag_name": *"v[0-9.]+"' | grep -oE '[0-9.]+' | head -n 1 || true)
            ;;
    esac
    echo "${latest:-}"
}

_check_updates_for_present_clis() {
    echo "${C_BOLD}CHECKING FOR UPDATES (PRESENT CLIs):${C_RESET}"
    local fmt="  %-12s %-16s %-16s %s"
    printf "${C_CYAN}${fmt}${C_RESET}\n" "CLI" "CURRENT" "LATEST" "STATUS"
    echo "  --------------------------------------------------------------------------------------"

    local clis=("claude" "codex" "qwen" "grok" "kimi" "opencode" "cyberstrike" "agy" "openclaw" "hermes")
    local present_count=0
    local updates_available=()

    for c in "${clis[@]}"; do
        local bin="${EXTERNAL_CLI_MAP[$c]:-$c}"
        if ! command -v "${bin}" >/dev/null 2>&1; then
            continue
        fi
        present_count=$((present_count + 1))
        local cur_ver latest_ver status_str
        cur_ver=$(_get_cli_version "${bin}")
        latest_ver=$(_get_cli_latest_version "${c}")

        if [[ -n "${latest_ver}" && "${latest_ver}" != "unknown" && "${latest_ver}" != "-" ]]; then
            if [[ "${cur_ver}" == "${latest_ver}" ]]; then
                status_str="${C_GREEN}● Up to date${C_RESET}"
            else
                status_str="${C_YELLOW}▲ Update available${C_RESET} (${C_YELLOW}${cur_ver}${C_RESET} -> ${C_GREEN}${latest_ver}${C_RESET})"
                updates_available+=("${c}")
            fi
        else
            status_str="${C_DIM}● Installed (${cur_ver})${C_RESET}"
            latest_ver="-"
        fi
        printf "  %-12s %-16s %-16s %b\n" "${c}" "${cur_ver}" "${latest_ver}" "${status_str}"
    done

    if ((present_count == 0)); then
        echo "  ${C_DIM}No external CLIs currently installed in PATH.${C_RESET}"
        echo ""
        echo "  Install any CLI with: ${0##*/} install <name>"
        return 0
    fi

    echo ""
    if [[ ${#updates_available[@]} -gt 0 ]]; then
        echo "${C_YELLOW}[!] Updates available for ${#updates_available[@]} CLI(s): ${updates_available[*]}${C_RESET}"
        echo "    To apply updates:  ${0##*/} update <name>"
        echo "    To update all:     ${0##*/} update --apply (or ${0##*/} update all)"
    else
        echo "${C_GREEN}[✓] All installed CLIs are up to date.${C_RESET}"
    fi
}

