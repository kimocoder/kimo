elif mode == 'local':
    hosts.append(('local', local_url))
else:
    hosts.append(('local', local_url))
    hosts.append(('remote', remote_url))

stopped_count = 0

def unload_model(host_label, url, model_name):
    payload = json.dumps({'model': model_name, 'keep_alive': 0}).encode('utf-8')
    req = urllib.request.Request(
        url + '/api/generate',
        data=payload,
        headers={'Content-Type': 'application/json', 'User-Agent': 'kimo'}
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read().decode('utf-8'))
            print(f"{OM_C_GREEN}[✓] Unloaded model \"{model_name}\" from {host_label} (GPU VRAM freed).{OM_C_RESET}")
            return True
    except Exception as e:
        print(f"{OM_C_RED}[!] Failed to unload \"{model_name}\" on {host_label}: {e}{OM_C_RESET}", file=sys.stderr)
        return False

# Stop ALL loaded models if target is empty, 'all', or '--all'
if not target_model or target_model in ['all', '--all']:
    print(f"{OM_C_BOLD}Scanning active VRAM models to unload...{OM_C_RESET}")
    for label, url in hosts:
        try:
            req = urllib.request.Request(url + '/api/ps', headers={'User-Agent': 'kimo'})
            with urllib.request.urlopen(req, timeout=3) as r:
                models = json.loads(r.read().decode('utf-8')).get('models', [])
                for m in models:
                    name = m.get('name')
                    if name:
                        if unload_model(label, url, name):
                            stopped_count += 1
        except Exception:
            pass
    if stopped_count == 0:
        print(f"{OM_C_DIM}No active models found in VRAM to stop.{OM_C_RESET}")
else:
    for label, url in hosts:
        try:
            req = urllib.request.Request(url + '/api/tags', headers={'User-Agent': 'kimo'})
            with urllib.request.urlopen(req, timeout=3) as r:
                tags = json.loads(r.read().decode('utf-8')).get('models', [])
                matched = [m['name'] for m in tags if m['name'] == target_model or m['name'].startswith(target_model + ':')]
                if matched:
                    if unload_model(label, url, matched[0]):
                        stopped_count += 1
        except Exception:
            pass
    if stopped_count == 0:
        label, url = hosts[0]
        unload_model(label, url, target_model)
PYEOF
}

