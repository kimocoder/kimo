  ${C_CYAN}stream <model> [opts]${C_RESET}        Pin remote model for durable availability via keepalive daemon
                                (modes: --status, --test, --resident-only, --repair-all)

${C_YELLOW}Maintenance, Config & Completion:${C_RESET}
  ${C_CYAN}config [subcmd] [args...]${C_RESET}    View or update persistent configuration (~/.config/kimo/config)
  ${C_CYAN}completion [bash|zsh]${C_RESET}        Generate shell tab-completion script for bash or zsh
  ${C_CYAN}logs [service|all]${C_RESET}           Show recent journald output (tunnel, keepalive, timer, apache, all)
