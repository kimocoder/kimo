#!/usr/bin/env bash
# kimo – Unified manager for local and remote Ollama instances & external LLM CLIs.
# Utility for managing models, VRAM, and CLI routing in the Kalidroid environment.
# -----------------------------------------------------------------------------------

set -euo pipefail

# Remote server configuration
# Dynamic resolution order:
#   1. $OLLAMA_REMOTE_URL / config file 'remote_url'
#   2. Active SSH tunnel forward (127.0.0.1:11438) -> detected destination host
#   3. Direct remote host probe (if remote_host is set in config or environment)
# Probing uses a short timeout so --help / local-only commands never hang.
REMOTE_HOST_PORT="${KIMO_REMOTE_HOST_PORT:-11434}"
REMOTE_TUNNEL_URL="${KIMO_REMOTE_TUNNEL_URL:-http://127.0.0.1:11438}"
REMOTE_HOST_IP="${KIMO_REMOTE_HOST_IP:-}"
REMOTE_DIRECT_URL=""
REMOTE_DAEMON_URL=""
KIMO_VERSION="1.1.0"

# Inspect /proc/*/cmdline to detect if an active SSH tunnel forwards a local port
_detect_tunnel_target() {
    local lport="${1:-11438}" target=""
    for cmd in /proc/[0-9]*/cmdline; do
        [[ -f "${cmd}" ]] || continue
        if grep -a -q ":${lport}:" "${cmd}" 2>/dev/null; then
            local words=()
            while IFS= read -r -d '' arg; do
                words+=("${arg}")
            done < "${cmd}" 2>/dev/null || true
            for ((i=${#words[@]}-1; i>=1; i--)); do
                local w="${words[i]}"
                [[ "${w}" == -* ]] && continue
                [[ "${w}" =~ :${lport}: ]] && continue
                if [[ "${w}" =~ ^([a-zA-Z0-9._-]+@)?([a-zA-Z0-9.-]+)$ ]]; then
                    local h="${BASH_REMATCH[2]}"
                    if [[ "${h}" != "127.0.0.1" && "${h}" != "localhost" && "${h}" != "::1" ]]; then
                        target="${h}"
                        break 2
                    fi
                fi
            done
        fi
    done
    echo "${target}"
}

# WebBridge (Kimi's real-browser relay, see 'kimo doctor' web bridge section).
# Its daemon listens on 127.0.0.1:10086 and is steered over a local /command
# JSON API - no API key, no Moonshot quota. Resolution order:
# $KIMO_WEBBRIDGE_URL (full URL incl. path) > env-var port > config > default.
WEBBRIDGE_PORT="${KIMO_WEBBRIDGE_PORT:-10086}"
WEBBRIDGE_URL="${KIMO_WEBBRIDGE_URL:-http://127.0.0.1:${WEBBRIDGE_PORT}/command}"
# Quota-free web tool defaults ('kimo web search' / 'launch kimi -W'),
# overridable via config file (web_engine, web_max_results).
WEB_ENGINE="${KIMO_WEB_ENGINE:-duckduckgo}"
WEB_MAX_RESULTS="${KIMO_WEB_MAX_RESULTS:-10}"

REMOTE_HOST_URL="${OLLAMA_REMOTE_URL:-${REMOTE_TUNNEL_URL}}"
LOCAL_HOST_URL="${OLLAMA_LOCAL_URL:-http://127.0.0.1:11434}"

# Persistent Configuration
KIMO_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME:-/root}/.config}/kimo"
KIMO_CONFIG_FILE="${KIMO_CONFIG_FILE:-${KIMO_CONFIG_DIR}/config}"
declare -A KIMO_CONFIG_VALUES=()
declare -A KIMO_CONFIG_SOURCES=()

load_kimo_config() {
    local cfg="${KIMO_CONFIG_FILE}"
    if [[ ! -f "${cfg}" && -f "/etc/kimo/config" ]]; then
        cfg="/etc/kimo/config"
    fi

    if [[ -f "${cfg}" ]]; then
        while IFS= read -r line || [[ -n "${line}" ]]; do
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            [[ -z "${line}" || "${line}" == \#* || "${line}" == \;* ]] && continue
            if [[ "${line}" =~ ^([a-zA-Z0-9_.-]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
                local k="${BASH_REMATCH[1]}"
                local v="${BASH_REMATCH[2]}"
                v="${v#[\"\']}"
                v="${v%[\"\']}"
                KIMO_CONFIG_VALUES["${k}"]="${v}"
                KIMO_CONFIG_SOURCES["${k}"]="file:${cfg}"
            fi
        done < "${cfg}"
    fi

    if [[ -n "${KIMO_CONFIG_VALUES[remote_url]:-}" && -z "${OLLAMA_REMOTE_URL:-}" ]]; then
        REMOTE_HOST_URL="${KIMO_CONFIG_VALUES[remote_url]}"
        OLLAMA_REMOTE_URL="${REMOTE_HOST_URL}"
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[local_url]:-}" && -z "${OLLAMA_LOCAL_URL:-}" ]]; then
        LOCAL_HOST_URL="${KIMO_CONFIG_VALUES[local_url]}"
        OLLAMA_LOCAL_URL="${LOCAL_HOST_URL}"
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[default_model]:-}" && -z "${KIMO_DEFAULT_MODEL:-}" ]]; then
        KIMO_DEFAULT_MODEL="${KIMO_CONFIG_VALUES[default_model]}"
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[kimi_effort]:-}" && -z "${KIMO_KIMI_EFFORT:-}" && -z "${OM_KIMI_EFFORT:-}" ]]; then
        KIMO_KIMI_EFFORT="${KIMO_CONFIG_VALUES[kimi_effort]}"
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[kimi_context]:-}" && -z "${KIMO_KIMI_CONTEXT:-}" ]]; then
        KIMO_KIMI_CONTEXT="${KIMO_CONFIG_VALUES[kimi_context]}"
    fi
    if [[ "${KIMO_CONFIG_VALUES[no_color]:-}" == "true" && -z "${FORCE_NO_COLOR:-}" && "${NO_COLOR:-0}" != "1" ]]; then
        FORCE_NO_COLOR=true
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[webbridge_url]:-}" && -z "${KIMO_WEBBRIDGE_URL:-}" ]]; then
        WEBBRIDGE_URL="${KIMO_CONFIG_VALUES[webbridge_url]}"
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[webbridge_port]:-}" && -z "${KIMO_WEBBRIDGE_PORT:-}" ]]; then
        WEBBRIDGE_PORT="${KIMO_CONFIG_VALUES[webbridge_port]}"
        # Rebuild the URL only if no full custom URL is set
        if [[ "${WEBBRIDGE_URL}" == "http://127.0.0.1:10086/command" ]]; then
            WEBBRIDGE_URL="http://127.0.0.1:${WEBBRIDGE_PORT}/command"
        fi
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[web_engine]:-}" ]]; then
        WEB_ENGINE="${KIMO_CONFIG_VALUES[web_engine]}"
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[web_max_results]:-}" ]]; then
        WEB_MAX_RESULTS="${KIMO_CONFIG_VALUES[web_max_results]}"
    fi

    # Dynamically derive REMOTE_HOST_IP if not explicitly set
    if [[ -z "${REMOTE_HOST_IP}" ]]; then
        if [[ -n "${KIMO_CONFIG_VALUES[remote_host]:-}" ]]; then
            REMOTE_HOST_IP="${KIMO_CONFIG_VALUES[remote_host]}"
        elif [[ -n "${REMOTE_HOST_URL:-}" && "${REMOTE_HOST_URL}" != *127.0.0.1* && "${REMOTE_HOST_URL}" != *localhost* ]]; then
            REMOTE_HOST_IP=$(echo "${REMOTE_HOST_URL}" | sed -E 's|https?://([^:/]+).*|\1|')
        else
            local t_host
            t_host=$(_detect_tunnel_target 11438)
            [[ -n "${t_host}" ]] && REMOTE_HOST_IP="${t_host}"
        fi
    fi

    if [[ -n "${REMOTE_HOST_IP}" && "${REMOTE_HOST_IP}" != "127.0.0.1" && "${REMOTE_HOST_IP}" != "localhost" ]]; then
        REMOTE_DIRECT_URL="http://${REMOTE_HOST_IP}:${REMOTE_HOST_PORT}"
        REMOTE_DAEMON_URL="http://${REMOTE_HOST_IP}:11436"
    else
        REMOTE_DIRECT_URL=""
        REMOTE_DAEMON_URL=""
    fi
}
load_kimo_config

