# -----------------------------------------------------------------------------
# Command: stream
# -----------------------------------------------------------------------------
cmd_stream() {
    if [[ -z "${1:-}" ]]; then
        echo "${C_RED}Error: 'stream' requires a model name (or command flag).${C_RESET}" >&2
        echo "Usage: ${0##*/} stream <model> [--pull] [--keepalive DUR] [--no-warm] [--dry-run] [--json]" >&2
        echo "       ${0##*/} stream --status [--json]      (show tunnel health, latency, VRAM footprint, countdowns)" >&2
        echo "       ${0##*/} stream --test [model] [--json](run 1-token generation smoke test across tunnel)" >&2
        echo "       ${0##*/} stream --all                  (pin & keep every hosted model available; rotate-warms)" >&2
        echo "       ${0##*/} stream --repair-all           (reconcile + rotate-warm pins; keepalive timer)" >&2
        echo "       ${0##*/} stream --resident-only        (refresh keepalive only for active VRAM models; zero thrashing)" >&2
        echo "       ${0##*/} stream --unpin <model>        (remove a model pin from state file)" >&2
        echo "       ${0##*/} stream --unload <model>       (immediately evict model from remote VRAM; keep_alive: 0)" >&2
        echo "       ${0##*/} stream --list-pinned          (display pinned model catalog JSON)" >&2
        exit 1
    fi
    # Forward the resolved remote so stream_model.py never falls back to the
    # unreachable direct IP when the caller already selected a host.
    local extra_flags=()
    [[ "${OPT_JSON:-false}" == "true" ]] && extra_flags+=("--json")
    local stream_remote=""
    case "${HOST_MODE}" in
        custom|remote) stream_remote="${TARGET_HOST}" ;;
        local)         stream_remote="${REMOTE_HOST_URL}" ;;
    esac
    # resolve_remote_url() probes without the bridge token, so the tunnel's 401
    # makes it fall through to the Desktop daemon (:11436) - which then gets
    # saved as the pin's remote_url and bypasses bridge auth. Pins must go
    # through the tunnel (stream_model.py sends the token), so only forward a
    # remote the caller chose explicitly via --host or $OLLAMA_REMOTE_URL.
    if [[ -n "${stream_remote}" && -z "${OPT_HOST}" && -z "${OLLAMA_REMOTE_URL:-}" ]]; then
        stream_remote="${REMOTE_TUNNEL_URL}"
    fi
    if [[ -n "${stream_remote}" ]]; then
        exec python3 /root/stream_model.py --remote "${stream_remote}" "${extra_flags[@]}" "$@"
    fi
    exec python3 /root/stream_model.py "${extra_flags[@]}" "$@"
}

# -----------------------------------------------------------------------------
# Command: run
# -----------------------------------------------------------------------------
cmd_run() {
    local model="${1:-}"
    if [[ -z "${model}" ]]; then
        echo "${C_RED}Error: 'run' requires a model name.${C_RESET}" >&2
        echo "Usage: ${0##*/} run <model> [args...]" >&2
        exit 1
    fi
    shift

    local active_host=""
    local resolved_model="${model}"

    if [[ -n "${TARGET_HOST}" ]]; then
        active_host="${TARGET_HOST}"
        local res
        res=$(resolve_model_name "${model}" "${active_host}" || true)
        [[ -n "${res}" ]] && resolved_model="${res}"
    else
        # Desktop GPU first: a model on both hosts must not land on the Pi, which
        # has no GPU - its bridge refuses anything over the 8 GiB budget, and a
        # direct load is OOM-killed by ollama-memory-guard.
        local local_res="" remote_first
        remote_first=$(resolve_model_name "${model}" "${REMOTE_HOST_URL}" || true)
        [[ -z "${remote_first}" ]] && local_res=$(resolve_model_name "${model}" "${LOCAL_HOST_URL}" || true)
        if [[ -n "${remote_first}" ]]; then
            resolved_model="${remote_first}"
            active_host="${REMOTE_HOST_URL}"
        elif [[ -n "${local_res}" ]]; then
            resolved_model="${local_res}"
            active_host="${LOCAL_HOST_URL}"
        else
            local remote_res
            remote_res=$(resolve_model_name "${model}" "${REMOTE_HOST_URL}" || true)
            if [[ -n "${remote_res}" ]]; then
                echo "${C_YELLOW}Model '${model}' found on remote server. Auto-streaming from ${REMOTE_HOST_IP} (using ${remote_res})...${C_RESET}"
                resolved_model="${remote_res}"
                active_host="${REMOTE_HOST_URL}"
            else
                active_host="${LOCAL_HOST_URL}"
            fi
        fi
    fi

    # Unload conflicting active models from target host to prevent CUDA memory collision
    local loaded_models
    loaded_models=$(curl -s --connect-timeout 2 -m 3 "${active_host}/api/ps" | jq -r '.models[].name' 2>/dev/null || true)
    if [[ -n "${loaded_models}" ]]; then
        for lm in ${loaded_models}; do
            if [[ "${lm}" != "${resolved_model}" && "${lm}:latest" != "${resolved_model}" ]]; then
                echo "${C_YELLOW}[*] Unloading active model '${lm}' from ${active_host} to prevent CUDA memory collision...${C_RESET}"
                curl -s -m 5 -X POST "${active_host}/api/generate" -H "Content-Type: application/json" -d "$(jq -nc --arg m "${lm}" '{model: $m, keep_alive: 0}')" >/dev/null 2>&1 || true
                sleep 1
            fi
        done
    fi

    # Apply per-model tuned defaults baked in via 'tune' (raw resolved model).
    local tp
    tp=$(tuned_params "${resolved_model}" || true)
    if [[ -n "${tp}" ]]; then
        local nctx nbatch npredict ntemp
        nctx=$(echo "${tp}" | jq -r '.num_ctx? // empty')
        nbatch=$(echo "${tp}" | jq -r '.num_batch? // empty')
        npredict=$(echo "${tp}" | jq -r '.num_predict? // empty')
        ntemp=$(echo "${tp}" | jq -r '.temperature? // empty')
        if [[ -n "${nctx}" ]]; then
            export OLLAMA_CONTEXT_LENGTH="${nctx}"
        fi
        echo "${C_DIM}[*] Tuned defaults for '${resolved_model}': num_ctx=${nctx:--} num_batch=${nbatch:--} num_predict=${npredict:--} temperature=${ntemp:--}${C_RESET}"
    fi

    export OLLAMA_HOST="${active_host}"
    export OLLAMA_BASE_URL="${active_host}"
    export OPENAI_API_BASE="${active_host}/v1"
    export OPENAI_BASE_URL="${active_host}/v1"
    export OPENAI_API_KEY="${OPENAI_API_KEY:-ollama}"
    export API_BASE="${active_host}/v1"
    export ANTHROPIC_BASE_URL="${active_host}"
    export ANTHROPIC_API_BASE="${active_host}/v1"
    export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-ollama}"

    echo "${C_CYAN}Running model: ${resolved_model} on ${active_host}...${C_RESET}"
    exec ollama run "${resolved_model}" "$@"
}

# -----------------------------------------------------------------------------
# Antigravity CLI (agy) support
# -----------------------------------------------------------------------------
# agy has exactly one overridable endpoint: with `modelProvider: "gemini"` in
# its settings.json it calls
#   {GOOGLE_GEMINI_BASE_URL}/v1beta/models/{model}:streamGenerateContent
# and it has no OpenAI-compatible or native-Ollama transport at all. Passing
# --model alone therefore does nothing: agy rejects the unknown id with a
# warning and quietly runs a Google model instead, while this script's banner
# claims an Ollama model and host. A per-session shim translates the Gemini
# wire format to /api/chat against whichever host the model resolved to.
AGY_SETTINGS="${AGY_SETTINGS:-${HOME:-/root}/.gemini/antigravity-cli/settings.json}"
GEMINI_SHIM_PATHS=(
    "/opt/ollama/ollama-gemini-shim.py"
    "/root/OLLAMA/ollama-gemini-shim.py"
)
# One claim file per launcher, so a second concurrent `launch agy` does not
# have its settings reverted by the first one exiting.
AGY_CLAIM_DIR="${KIMO_AGY_CLAIM_DIR:-${AGY_CLAIM_DIR:-${TMPDIR:-/tmp}/kimo-agy}}"
AGY_SHIM_PID=""
AGY_SHIM_PORT=""
AGY_SHIM_OUT=""
AGY_SHIM_ERR=""
AGY_CLAIM_FILE=""
AGY_SETTINGS_CREATED=0
AGY_PROVIDER_PRESET=0
AGY_PROVIDER_PREV=""
AGY_HAD_MODEL=false
AGY_MODEL_PREV=""
AGY_LAUNCHED_MODEL=""

find_gemini_shim() {
    local cand
    for cand in "${GEMINI_SHIM_PATHS[@]}"; do
        [[ -f "${cand}" ]] && { echo "${cand}"; return 0; }
    done
    return 1
}

_agy_write_settings() {
    # Rewrites settings.json through a jq filter. All arguments go to jq
    # verbatim, so callers pass values with --arg rather than interpolating
    # them into the program - the same mistake the 2026-09-24 audit found in
    # this script's Python heredocs.
    #
    # cat > rather than mv: keeps the inode, so settings.json stays 0600 and
    # keeps its owner instead of inheriting mktemp's.
    local tmp
    tmp=$(mktemp) || return 1
    if jq "$@" "${AGY_SETTINGS}" >"${tmp}" 2>/dev/null; then
        cat "${tmp}" >"${AGY_SETTINGS}"
        rm -f "${tmp}"
        return 0
    fi
    rm -f "${tmp}"
    return 1
}

agy_patch_settings() {
    local model="$1"
    if [[ ! -f "${AGY_SETTINGS}" ]]; then
        mkdir -p "$(dirname "${AGY_SETTINGS}")" || return 1
        printf '{}' >"${AGY_SETTINGS}" || return 1
        chmod 600 "${AGY_SETTINGS}" 2>/dev/null || true
        AGY_SETTINGS_CREATED=1
    elif [[ ! -s "${AGY_SETTINGS}" ]]; then
        printf '{}' >"${AGY_SETTINGS}" || return 1
    fi

    if ! jq -e . "${AGY_SETTINGS}" >/dev/null 2>&1; then
        echo "${C_RED}Error: ${AGY_SETTINGS} is not valid JSON; refusing to edit it.${C_RESET}" >&2
        return 1
    fi

    AGY_PROVIDER_PREV=$(jq -r '.modelProvider // empty' "${AGY_SETTINGS}")
    [[ "${AGY_PROVIDER_PREV}" == "gemini" ]] && AGY_PROVIDER_PRESET=1
    AGY_HAD_MODEL=$(jq 'has("model")' "${AGY_SETTINGS}")
    AGY_MODEL_PREV=$(jq -r '.model // empty' "${AGY_SETTINGS}")
    AGY_LAUNCHED_MODEL="${model}"

    # modelProvider alone is not enough: agy validates --model against its own
    # catalogue and rejects anything unregistered, so the Ollama id has to be
    # declared as a custom model too. Without this the launch dies with
    # "model <id> is not recognized as a known model or custom model in settings".
    _agy_write_settings --arg m "${model}" '
        .modelProvider = "gemini"
        | .customModelsConfig.customModels[$m] = {modelName: $m}
    ' || return 1

    mkdir -p "${AGY_CLAIM_DIR}" 2>/dev/null || true
    AGY_CLAIM_FILE="${AGY_CLAIM_DIR}/$$"
    : >"${AGY_CLAIM_FILE}" 2>/dev/null || AGY_CLAIM_FILE=""
}

_agy_other_session_active() {
    # Claims left behind by a SIGKILLed launcher must not pin the key forever,
    # so a claim only counts while its owner is still alive.
    local f pid
    for f in "${AGY_CLAIM_DIR}"/*; do
        [[ -e "${f}" ]] || continue
        pid="${f##*/}"
        if [[ ! "${pid}" =~ ^[0-9]+$ ]]; then
            rm -f "${f}"
            continue
        fi
        kill -0 "${pid}" 2>/dev/null && return 0
        rm -f "${f}"
    done
    return 1
}

agy_restore_settings() {
    [[ -n "${AGY_CLAIM_FILE}" ]] && rm -f "${AGY_CLAIM_FILE}"
    if [[ "${AGY_SETTINGS_CREATED}" == "1" ]]; then
        rm -f "${AGY_SETTINGS}"
        AGY_SETTINGS_CREATED=0
        return 0
    fi
    [[ -f "${AGY_SETTINGS}" ]] || return 0
    # agy rewrites settings.json while it runs (selected model, permissions),
    # so only the keys this script added are touched - never a saved copy.
    _agy_other_session_active && return 0

    # .model is only put back if it still holds the value agy persisted for the
    # model we launched with; if the operator picked something else mid-session
    # via /model, that choice is theirs and stays.
    _agy_write_settings \
        --arg m "${AGY_LAUNCHED_MODEL}" \
        --arg prev_provider "${AGY_PROVIDER_PREV}" \
        --arg prev_model "${AGY_MODEL_PREV}" \
        --argjson had_model "${AGY_HAD_MODEL}" \
        --argjson keep_provider "$([[ "${AGY_PROVIDER_PRESET}" == "1" ]] && echo true || echo false)" '
        (if .customModelsConfig.customModels then del(.customModelsConfig.customModels[$m]) else . end)
        | (if ((.customModelsConfig.customModels // {}) | length) == 0 then del(.customModelsConfig) else . end)
        | (if $keep_provider then . else (if $prev_provider == "" then del(.modelProvider) else .modelProvider = $prev_provider end) end)
        | (if (.model == $m) then (if $had_model then .model = $prev_model else del(.model) end) else . end)
    ' || true
    AGY_PROVIDER_PREV=""
    AGY_LAUNCHED_MODEL=""
}

agy_cleanup() {
    local rc=$?
    trap - EXIT INT TERM HUP
    if [[ -n "${AGY_SHIM_PID}" ]]; then
        kill "${AGY_SHIM_PID}" 2>/dev/null || true
        wait "${AGY_SHIM_PID}" 2>/dev/null || true
        AGY_SHIM_PID=""
    fi
    agy_restore_settings
    rm -f "${AGY_SHIM_OUT}" "${AGY_SHIM_ERR}"
    exit "${rc}"
}

# Starts the shim on a kernel-assigned port and sets AGY_SHIM_PORT once the
# listener answers /healthz. Must not be called in a command substitution: the
# background python has to stay a child of this shell or agy_cleanup can
# neither wait on it nor kill it, and every launch would leak a listener.
agy_start_shim() {
    local shim="$1" upstream="$2" model="$3" tries=0
    AGY_SHIM_PORT=""
    AGY_SHIM_OUT=$(mktemp) || return 1
    AGY_SHIM_ERR=$(mktemp) || return 1
    python3 -u "${shim}" --host 127.0.0.1 --port 0 --upstream "${upstream}" \
        --default-model "${model}" --print-port >"${AGY_SHIM_OUT}" 2>"${AGY_SHIM_ERR}" &
    AGY_SHIM_PID=$!

    while ((tries++ < 100)); do
        AGY_SHIM_PORT=$(head -n1 "${AGY_SHIM_OUT}" 2>/dev/null || true)
        [[ "${AGY_SHIM_PORT}" =~ ^[0-9]+$ ]] && break
        if ! kill -0 "${AGY_SHIM_PID}" 2>/dev/null; then
            echo "${C_RED}Error: Gemini shim exited before binding a port:${C_RESET}" >&2
            sed 's/^/    /' "${AGY_SHIM_ERR}" >&2 2>/dev/null || true
            AGY_SHIM_PID=""
            return 1
        fi
        sleep 0.05
    done
    if [[ ! "${AGY_SHIM_PORT}" =~ ^[0-9]+$ ]]; then
        echo "${C_RED}Error: Gemini shim did not announce a port in time.${C_RESET}" >&2
        AGY_SHIM_PORT=""
        return 1
    fi

    tries=0
    until curl -sf -m 2 "http://127.0.0.1:${AGY_SHIM_PORT}/healthz" >/dev/null 2>&1; do
        if ((tries++ >= 40)); then
            echo "${C_RED}Error: Gemini shim on port ${AGY_SHIM_PORT} never became healthy.${C_RESET}" >&2
            return 1
        fi
        if ! kill -0 "${AGY_SHIM_PID}" 2>/dev/null; then
            echo "${C_RED}Error: Gemini shim died during startup:${C_RESET}" >&2
            sed 's/^/    /' "${AGY_SHIM_ERR}" >&2 2>/dev/null || true
            return 1
        fi
        sleep 0.05
    done
}

# -----------------------------------------------------------------------------
# Grok Build TUI (grok) support
# -----------------------------------------------------------------------------
# grok takes its endpoint from GROK_MODELS_BASE_URL (see the grok case in
# cmd_launch), so routing itself needs no config edit. Its context window does:
# that value drives auto-compaction, is settable only per model in config.toml,
# and a model prefetched from {base}/models that defines none defaults to 200k.
# For a tuned Ollama model that is wrong by an order of magnitude - grok
# compacts far too late and the request overflows the real window. So a tuned
# num_ctx is written to [model."<tag>"].context_window for the session and
# undone on exit.
#
# The table is deliberately partial. Verified 2026-10-08 against grok 1.0.46: a
# [model."<tag>"] carrying only context_window keeps the base_url prefetched
# from GROK_MODELS_BASE_URL, so the merge does not break routing.
#
# GROK_CONFIG_PATH was checked first and is NOT an alternate config file - a
# model defined through it never reaches 'grok models', and -m rejects it as
# "unknown model id". Editing the real file is unavoidable, hence the surgical
# revert below rather than a whole-file backup.
GROK_CONFIG="${GROK_CONFIG:-${HOME:-/root}/.grok/config.toml}"
# One claim file per launcher, so a second concurrent 'launch grok' does not
# have its override reverted by the first one exiting.
GROK_CLAIM_DIR="${KIMO_GROK_CLAIM_DIR:-${GROK_CLAIM_DIR:-${TMPDIR:-/tmp}/kimo-grok}}"
GROK_CLAIM_FILE=""
GROK_CTX_MODEL=""
GROK_CTX_TABLE_PREV=false
GROK_CTX_KEY_PREV=false
GROK_CTX_VALUE_PREV=""
GROK_CTX_TRAIL_PREV=1

# Rewrites config.toml through tomlkit so the user's formatting, comments and
# key order survive. stdlib tomllib is read-only, so there is no writer
# fallback: without tomlkit the override is skipped with a warning and grok
# still runs. Values reach Python through argv, never interpolated into the
# program - the same mistake the 2026-09-24 audit found in this script's
# heredocs. Exits 3 when tomlkit is missing, 4 on unparseable TOML, 5 if absent.
_grok_write_config() {
    python3 - "$@" <<'PY'
import sys

try:
    import tomlkit
except ImportError:
    sys.exit(3)

mode, path, key = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(path, "r", encoding="utf-8") as fh:
        src = fh.read()
    doc = tomlkit.parse(src)
except FileNotFoundError:
    sys.exit(5)
except Exception:
    sys.exit(4)

models = doc.get("model")

if mode == "set":
    existed = models is not None and key in models
    had = bool(existed and "context_window" in models[key])
    prev = str(models[key]["context_window"]) if had else ""
    if models is None:
        models = tomlkit.table()
        doc["model"] = models
    if key not in models:
        models[key] = tomlkit.table()
    models[key]["context_window"] = int(sys.argv[4])
else:
    existed = sys.argv[4] == "1"
    had = sys.argv[5] == "1"
    if models is None or key not in models:
        sys.exit(0)
    tbl = models[key]
    if had:
        tbl["context_window"] = int(sys.argv[6])
    elif "context_window" in tbl:
        del tbl["context_window"]
    # Drop the table - and the [model] parent - only when this launcher created
    # them and nothing else has been added since.
    if not existed and len(tbl) == 0:
        del models[key]
    if not existed and len(models) == 0:
        del doc["model"]

rendered = tomlkit.dumps(doc)
if mode == "clear":
    # Deleting the table leaves the separator newline tomlkit added behind, so
    # put the file back to the trailing-newline count it had before the set.
    trail = int(sys.argv[7]) if len(sys.argv) > 7 and sys.argv[7].isdigit() else 1
    rendered = rendered.rstrip("\n") + "\n" * trail

# Written through the original inode so config.toml keeps its mode and owner
# instead of inheriting mktemp's - why _agy_write_settings uses cat > too.
with open(path, "w", encoding="utf-8") as fh:
    fh.write(rendered)

if mode == "set":
    print("TABLE=%d" % existed)
    print("KEY=%d" % had)
    print("PREV=%s" % prev)
    print("TRAIL=%d" % (len(src) - len(src.rstrip("\n"))))
PY
}

_grok_config_error() {
    case "$1" in
        3)
            echo "${C_YELLOW}[!] python3 tomlkit is unavailable; grok keeps its 200k context default.${C_RESET}" >&2
            echo "    Install it (pip install tomlkit) for a tuned num_ctx to reach grok." >&2
            ;;
        4)
            echo "${C_RED}Error: ${GROK_CONFIG} is not valid TOML; refusing to edit it.${C_RESET}" >&2
            ;;
        5)
            echo "${C_YELLOW}[!] ${GROK_CONFIG} not found; skipping the context_window override.${C_RESET}" >&2
            ;;
        *)
            echo "${C_RED}Error: could not write ${GROK_CONFIG}.${C_RESET}" >&2
            ;;
    esac
}

# Writes the override and records enough prior state to undo exactly this change.
grok_patch_context() {
    local model="$1" ctx="$2" state k v rc=0
    [[ "${ctx}" =~ ^[0-9]+$ ]] || return 1
    state=$(_grok_write_config set "${GROK_CONFIG}" "${model}" "${ctx}") || rc=$?
    if ((rc != 0)); then
        _grok_config_error "${rc}"
        return "${rc}"
    fi
    while IFS='=' read -r k v; do
        case "${k}" in
            TABLE)
                if [[ "${v}" == "1" ]]; then GROK_CTX_TABLE_PREV=true; fi
                ;;
            KEY)
                if [[ "${v}" == "1" ]]; then GROK_CTX_KEY_PREV=true; fi
                ;;
            PREV)
                GROK_CTX_VALUE_PREV="${v}"
                ;;
            TRAIL)
                GROK_CTX_TRAIL_PREV="${v}"
                ;;
        esac
    done <<<"${state}"
    GROK_CTX_MODEL="${model}"

    mkdir -p "${GROK_CLAIM_DIR}" 2>/dev/null || true
    GROK_CLAIM_FILE="${GROK_CLAIM_DIR}/$$"
    : >"${GROK_CLAIM_FILE}" 2>/dev/null || GROK_CLAIM_FILE=""
}

_grok_other_session_active() {
    # Claims left behind by a SIGKILLed launcher must not pin the override
    # forever, so a claim only counts while its owner is still alive.
    local f pid
    for f in "${GROK_CLAIM_DIR}"/*; do
        [[ -e "${f}" ]] || continue
        pid="${f##*/}"
        if [[ ! "${pid}" =~ ^[0-9]+$ ]]; then
            rm -f "${f}"
            continue
        fi
        kill -0 "${pid}" 2>/dev/null && return 0
        rm -f "${f}"
    done
    return 1
}

grok_restore_config() {
    [[ -n "${GROK_CLAIM_FILE}" ]] && rm -f "${GROK_CLAIM_FILE}"
    [[ -n "${GROK_CTX_MODEL}" ]] || return 0
    if [[ ! -f "${GROK_CONFIG}" ]]; then
        GROK_CTX_MODEL=""
        return 0
    fi
    # grok rewrites config.toml while it runs, so reverting from a whole-file
    # backup would throw those edits away: only the key owned here is undone.
    _grok_other_session_active && return 0
    local tflag=0 kflag=0
    [[ "${GROK_CTX_TABLE_PREV}" == true ]] && tflag=1
    [[ "${GROK_CTX_KEY_PREV}" == true ]] && kflag=1
    _grok_write_config clear "${GROK_CONFIG}" "${GROK_CTX_MODEL}" "${tflag}" "${kflag}" "${GROK_CTX_VALUE_PREV}" "${GROK_CTX_TRAIL_PREV}" >/dev/null 2>&1 || true
    GROK_CLAIM_FILE=""
    GROK_CTX_MODEL=""
    GROK_CTX_TABLE_PREV=false
    GROK_CTX_KEY_PREV=false
    GROK_CTX_VALUE_PREV=""
    GROK_CTX_TRAIL_PREV=1
}

grok_cleanup() {
    # grok is run rather than exec'd so this teardown can happen; there is no
    # shim process to reap, unlike agy.
    grok_restore_config
}

# -----------------------------------------------------------------------------
# Kimi Code CLI (kimi) support
# -----------------------------------------------------------------------------
# kimi resolves models as ALIASES declared under [models] in its config.toml;
# only such aliases can carry support_efforts/off_effort, which is what unlocks
# the in-session /effort picker with real graded efforts. The KIMI_MODEL_* env
# channel (see the fallback in cmd_launch) synthesizes an alias that cannot
# declare efforts, so /effort there is limited to on/off - and both encode as
# *silent* (no reasoning_effort on the wire).
#
# Registration here is additive and idempotent - a provider per Ollama host and
# an alias per model, exactly like the xai/groq/alibaba entries users keep in
# that file - so, unlike grok/agy, there is nothing to revert on exit.
KIMI_CONFIG="${KIMI_CONFIG:-${KIMI_CODE_HOME:-${HOME:-/root}/.kimi-code}/config.toml}"
# Serializes concurrent 'launch kimi' upserts so two read-modify-write cycles
# cannot drop each other's entries.
KIMI_CONFIG_LOCK="${KIMO_KIMI_CONFIG_LOCK:-${KIMI_CONFIG_LOCK:-${TMPDIR:-/tmp}/kimo-kimi-config.lock}}"

# Upserts providers[pid] and models[alias] through tomlkit so the user's
# formatting, comments and key order survive (same contract as
# _grok_write_config: values travel via argv, never interpolated into the
# program). Exits 3 when tomlkit is missing, 4 on unparseable TOML.
# argv: path pid base_url alias model ctx caps efforts default_effort off_effort reasoning_key display_name
_kimi_write_config() {
    python3 - "$@" <<'PY'
import sys

try:
    import tomlkit
except ImportError:
    sys.exit(3)

path, pid, base_url, alias, model = sys.argv[1:6]
ctx, caps, efforts, default_effort, off_effort, reasoning_key, display_name = sys.argv[6:13]

try:
    with open(path, "r", encoding="utf-8") as fh:
        doc = tomlkit.parse(fh.read())
except FileNotFoundError:
    doc = tomlkit.document()
except Exception:
    sys.exit(4)

providers = doc.get("providers")
if providers is None:
    providers = tomlkit.table()
    doc["providers"] = providers
if pid not in providers:
    providers[pid] = tomlkit.table()
prov = providers[pid]
prov["type"] = "openai"
prov["base_url"] = base_url
# Static placeholder, never the caller's real key: this provider points at the
# LAN/tunnel Ollama host and forwarding a real secret there would leak it off
# this box. Ollama ignores the value.
prov["api_key"] = "ollama"

models = doc.get("models")
if models is None:
    models = tomlkit.table()
    doc["models"] = models
if alias not in models:
    models[alias] = tomlkit.table()
mdl = models[alias]
mdl["provider"] = pid
mdl["model"] = model
if ctx:
    mdl["max_context_size"] = int(ctx)
if caps:
    mdl["capabilities"] = caps.split(",")
if efforts:
    mdl["support_efforts"] = efforts.split(",")
if default_effort:
    mdl["default_effort"] = default_effort
if off_effort:
    mdl["off_effort"] = off_effort
if reasoning_key:
    mdl["reasoning_key"] = reasoning_key
if display_name:
    mdl["display_name"] = display_name

# Written through the original inode so config.toml keeps its mode and owner.
with open(path, "w", encoding="utf-8") as fh:
    fh.write(tomlkit.dumps(doc))
PY
}

_kimi_config_error() {
    case "$1" in
        3)
            echo "${C_YELLOW}[!] python3 tomlkit is unavailable; falling back to kimi's KIMI_MODEL_* env channel${C_RESET}" >&2
            echo "    (graded /effort needs a config alias - pip install tomlkit to unlock it)." >&2
            ;;
        4)
            echo "${C_YELLOW}[!] ${KIMI_CONFIG} is not valid TOML; refusing to edit it - using the env channel.${C_RESET}" >&2
            ;;
        *)
            echo "${C_YELLOW}[!] could not write ${KIMI_CONFIG}; using the env channel.${C_RESET}" >&2
            ;;
    esac
}

# Upserts the host provider + model alias and prints the alias on success.
# argv: host_url model ctx caps efforts default_effort off_effort reasoning_key
kimi_register_model() {
    local host_url="$1" model="$2" ctx="$3" caps="$4" efforts="$5" default_effort="$6" off_effort="$7" reasoning_key="$8"
    local slug pid alias rc=0
    slug="${host_url#*://}"
    slug="${slug//[^a-zA-Z0-9]/-}"
    pid="ollama-${slug}"
    alias="${pid}/${model}"
    if command -v flock >/dev/null 2>&1; then
        # FD form, not 'flock <file> <cmd>': the command form execs a binary and
        # _kimi_write_config is a shell function.
        exec 9>"${KIMI_CONFIG_LOCK}"
        flock 9
        _kimi_write_config "${KIMI_CONFIG}" "${pid}" "${host_url}/v1" \
            "${alias}" "${model}" "${ctx}" "${caps}" "${efforts}" "${default_effort}" \
            "${off_effort}" "${reasoning_key}" "${model} (ollama)" || rc=$?
        exec 9>&-
    else
        _kimi_write_config "${KIMI_CONFIG}" "${pid}" "${host_url}/v1" \
            "${alias}" "${model}" "${ctx}" "${caps}" "${efforts}" "${default_effort}" \
            "${off_effort}" "${reasoning_key}" "${model} (ollama)" || rc=$?
    fi
    if ((rc != 0)); then
        _kimi_config_error "${rc}"
        return 1
    fi
    printf '%s' "${alias}"
}

# -----------------------------------------------------------------------------
# Command: launch
# -----------------------------------------------------------------------------
cmd_launch() {
    local provider="${1:-}"
    if [[ -z "${provider}" ]]; then
        echo "${C_RED}Error: 'launch' requires a provider or CLI name.${C_RESET}" >&2
        echo "Supported providers: ${!EXTERNAL_CLI_MAP[*]}" >&2
        exit 1
    fi
    shift

    local target_model="${DEFAULT_MODELS[$provider]:-}"
    local cli_passthrough_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --model)
                shift
                if [[ -z "${1:-}" ]]; then
                    echo "${C_RED}Error: --model requires a model name argument.${C_RESET}" >&2
                    exit 1
                fi
                target_model="$1"
                shift
                ;;
            --model=*)
                target_model="${1#*=}"
                shift
                ;;
            *)
                cli_passthrough_args+=("$1")
                shift
                ;;
        esac
    done

    if [[ -z "${target_model}" ]]; then
        target_model="${provider}"
    fi

    local active_host=""
    local resolved_model="${target_model}"

    if [[ -n "${TARGET_HOST}" ]]; then
        active_host="${TARGET_HOST}"
        local res
        res=$(resolve_model_name "${target_model}" "${active_host}" || true)
        [[ -n "${res}" ]] && resolved_model="${res}"
    else
        # Desktop GPU first: a model on both hosts must not land on the Pi, which
        # has no GPU - its bridge refuses anything over the 8 GiB budget, and a
        # direct load is OOM-killed by ollama-memory-guard.
        local local_res="" remote_first
        remote_first=$(resolve_model_name "${target_model}" "${REMOTE_HOST_URL}" || true)
        [[ -z "${remote_first}" ]] && local_res=$(resolve_model_name "${target_model}" "${LOCAL_HOST_URL}" || true)
        if [[ -n "${remote_first}" ]]; then
            resolved_model="${remote_first}"
            active_host="${REMOTE_HOST_URL}"
        elif [[ -n "${local_res}" ]]; then
            resolved_model="${local_res}"
            active_host="${LOCAL_HOST_URL}"
        else
            local remote_res
            remote_res=$(resolve_model_name "${target_model}" "${REMOTE_HOST_URL}" || true)
            if [[ -n "${remote_res}" ]]; then
                echo "${C_YELLOW}Model '${target_model}' found on remote GPU server. Routing to ${REMOTE_HOST_IP} (using ${remote_res})...${C_RESET}"
                resolved_model="${remote_res}"
                active_host="${REMOTE_HOST_URL}"
            else
                active_host="${LOCAL_HOST_URL}"
            fi
        fi
    fi

    # Unload conflicting active models from target host to prevent CUDA memory collision
    local loaded_models
    loaded_models=$(curl -s --connect-timeout 2 -m 3 "${active_host}/api/ps" | jq -r '.models[].name' 2>/dev/null || true)
    if [[ -n "${loaded_models}" ]]; then
        for lm in ${loaded_models}; do
            if [[ "${lm}" != "${resolved_model}" && "${lm}:latest" != "${resolved_model}" ]]; then
                echo "${C_YELLOW}[*] Unloading active model '${lm}' from ${active_host} to prevent CUDA memory collision...${C_RESET}"
                curl -s -m 5 -X POST "${active_host}/api/generate" -H "Content-Type: application/json" -d "$(jq -nc --arg m "${lm}" '{model: $m, keep_alive: 0}')" >/dev/null 2>&1 || true
                sleep 1
            fi
        done
    fi

    export OLLAMA_HOST="${active_host}"
    export OLLAMA_BASE_URL="${active_host}"
    export OPENAI_API_BASE="${active_host}/v1"
    export OPENAI_BASE_URL="${active_host}/v1"
    export OPENAI_API_KEY="${OPENAI_API_KEY:-ollama}"
    export API_BASE="${active_host}/v1"
    export ANTHROPIC_BASE_URL="${active_host}"
    export ANTHROPIC_API_BASE="${active_host}/v1"
    export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-ollama}"
    export CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT="${CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT:-1}"
    export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-100000}"
    export CLAUDE_CODE_MAX_OUTPUT_TOKENS="${CLAUDE_CODE_MAX_OUTPUT_TOKENS:-8192}"
    export CLAUDE_DISABLE_TELEMETRY="${CLAUDE_DISABLE_TELEMETRY:-1}"
    export DO_NOT_TRACK="${DO_NOT_TRACK:-1}"
    export DISABLE_AUTO_UPDATER="${DISABLE_AUTO_UPDATER:-1}"
    export ENABLE_CLAUDEAI_MCP_SERVERS="${ENABLE_CLAUDEAI_MCP_SERVERS:-false}"

    local cli_cmd="${EXTERNAL_CLI_MAP[$provider]:-}"

    # Apply per-model tuned defaults baked in via 'tune' (raw resolved model).
    local tp
    tp=$(tuned_params "${resolved_model}" || true)
    if [[ -n "${tp}" ]]; then
        local nctx
        nctx=$(echo "${tp}" | jq -r '.num_ctx? // empty')
        if [[ -n "${nctx}" ]]; then
            export OLLAMA_CONTEXT_LENGTH="${nctx}"
        fi
        echo "${C_DIM}[*] Tuned defaults for '${resolved_model}': $(echo "${tp}" | jq -c .)${C_RESET}"
    fi

    if [[ -n "${cli_cmd}" ]] && command -v "${cli_cmd}" >/dev/null 2>&1; then
        echo "${C_GREEN}[*] Launching external CLI '${cli_cmd}' (Model: ${resolved_model}, Host: ${active_host})...${C_RESET}"
        case "${cli_cmd}" in
            claude)
                export CLAUDE_CODE_EFFORT_LEVEL="${CLAUDE_CODE_EFFORT_LEVEL:-low}"
                exec "${cli_cmd}" --model "${resolved_model}" "${cli_passthrough_args[@]}"
                ;;
            codex)
                export CODEX_OSS_BASE_URL="${active_host}/v1"
                exec "${cli_cmd}" --oss --local-provider ollama --model "${resolved_model}" "${cli_passthrough_args[@]}"
                ;;
            qwen)
                export OPENAI_MODEL="${resolved_model}"
                export QWEN_MODEL="${resolved_model}"
                export OPENAI_BASE_URL="${active_host}/v1"
                export OPENAI_API_KEY="${OPENAI_API_KEY:-ollama}"
                exec "${cli_cmd}" --openai-base-url "${active_host}/v1" --openai-api-key "${OPENAI_API_KEY:-ollama}" --auth-type openai --model "${resolved_model}" "${cli_passthrough_args[@]}"
                ;;
            grok)
                # grok (xAI's Grok Build TUI) exposes no --base-url/--provider flag.
                # GROK_MODELS_BASE_URL redirects BOTH the startup catalog fetch
                # ({base}/models) and inference, which is what makes --model accept
                # real Ollama tags. Routing alone edits nothing; only the
                # context_window override below does, and that is reverted on exit.
                local grok_rc=0 grok_ctx=""
                export GROK_MODELS_BASE_URL="${active_host}/v1"
                # Deliberately forced rather than ${XAI_API_KEY:-ollama}: grok sends
                # this as 'Authorization: Bearer' to GROK_MODELS_BASE_URL/models, and
                # active_host may be the LAN/tunnel Desktop - forwarding a real xAI
                # key there would leak it off this box. Ollama ignores the value.
                export XAI_API_KEY="ollama"

                # A tuned num_ctx cannot reach grok through the environment, so it
                # goes into config.toml as this model's context_window. Read from the
                # tuning itself rather than $OLLAMA_CONTEXT_LENGTH, which a caller
                # may have set for unrelated reasons.
                if [[ -n "${tp:-}" ]]; then
                    grok_ctx=$(echo "${tp}" | jq -r '.num_ctx? // empty') || grok_ctx=""
                fi
                if [[ -n "${grok_ctx}" ]] && grok_patch_context "${resolved_model}" "${grok_ctx}"; then
                    echo "${C_DIM}[*] grok context_window=${grok_ctx} for '${resolved_model}' (reverted on exit)${C_RESET}"
                    trap grok_cleanup EXIT INT TERM HUP
                fi

                # No exec here: grok_cleanup must run once the session ends.
                "${cli_cmd}" --model "${resolved_model}" "${cli_passthrough_args[@]}" || grok_rc=$?
                exit "${grok_rc}"
                ;;
            kimi)
                # kimi (Kimi Code CLI). Two routing paths, tried in order:
                # 1. config.toml alias (preferred): kimi_register_model upserts a
                #    provider for the resolved host and an alias for the resolved
                #    tag - additive and idempotent, kept across sessions like the
                #    user's other providers, so (unlike grok/agy) nothing is
                #    reverted on exit. Only a config alias can declare
                #    support_efforts/off_effort, which unlocks the in-session
                #    /effort picker with graded efforts that reach the wire as
                #    reasoning_effort. Launched with -m <alias>.
                # 2. KIMI_MODEL_* env channel (fallback when tomlkit is missing
                #    or the config is unwritable): synthesizes a temporary
                #    in-memory provider; zero footprint, but efforts are locked
                #    to on/off and the graded effort is chosen at launch time.
                # One /api/show probe feeds both: the model's native context
                # length and its real capability list.
                local kimi_show="" kimi_caps="" kimi_ctx="" kimi_alias=""
                kimi_show=$(curl -s --connect-timeout 2 -m 5 "${active_host}/api/show" \
                    -d "$(jq -nc --arg m "${resolved_model}" '{model: $m}')") || kimi_show=""
                if [[ -n "${tp:-}" ]]; then
                    kimi_ctx=$(echo "${tp}" | jq -r '.num_ctx? // empty') || kimi_ctx=""
                fi
                # The runtime num_ctx (Modelfile PARAMETER, in .parameters) is what
                # the Ollama server actually enforces - NOT model_info's
                # *.context_length, which is only the architecture maximum.
                # Declaring the larger number is fatal for agent sessions: kimi
                # auto-compacts at 85% of the DECLARED window, so with 262144
                # declared it stays passive while Ollama silently truncates the
                # oldest messages past 131072 - and once truncation eats the
                # initial user prompt of a subagent run, every remaining
                # user-role message is a <tool_response> wrapper, which
                # kalidroid's Jinja template rejects with a hard 500 ("No user
                # query found in messages."). Cap the declaration at the runtime
                # value so compaction always fires first. A tuned --ctx larger
                # than the runtime is unenforceable here anyway: the /v1 path
                # carries no per-request num_ctx.
                local kimi_runtime_ctx=""
                if [[ -n "${kimi_show}" ]]; then
                    kimi_runtime_ctx=$(echo "${kimi_show}" | jq -r '(.parameters // "") | if test("num_ctx") then (capture("num_ctx\\s+(?<v>[0-9]+)") | .v) else empty end' 2>/dev/null) || kimi_runtime_ctx=""
                fi
                if [[ "${kimi_runtime_ctx}" =~ ^[0-9]+$ ]]; then
                    if [[ ! "${kimi_ctx}" =~ ^[0-9]+$ ]] || ((kimi_ctx > kimi_runtime_ctx)); then
                        kimi_ctx="${kimi_runtime_ctx}"
                    fi
                fi
                if [[ -z "${kimi_ctx}" && -n "${kimi_show}" ]]; then
                    # No tuning and no runtime num_ctx: fall back to the
                    # architecture maximum - the best observable estimate.
                    kimi_ctx=$(echo "${kimi_show}" | jq -r '[.model_info // {} | to_entries[] | select(.key | endswith("context_length")) | .value] | max // empty' 2>/dev/null) || kimi_ctx=""
                fi

                # Capabilities decide whether kimi enables thinking at all: with
                # no 'thinking' tag the effort is locked to 'off' ("Unsupported
                # thinking effort ... Available: off"). Map Ollama's own
                # capability list (thinking/tools/vision) rather than guessing;
                # tool_use-only is the fallback when the probe fails.
                if [[ -n "${kimi_show}" ]]; then
                    kimi_caps=$(echo "${kimi_show}" | jq -r '[(.capabilities // [])[] | if . == "thinking" then "thinking" elif . == "tools" then "tool_use" elif . == "vision" then "image_in" else empty end] | join(",")' 2>/dev/null) || kimi_caps=""
                fi
                kimi_caps="${KIMO_KIMI_CAPABILITIES:-${OM_KIMI_CAPABILITIES:-${kimi_caps:-tool_use}}}"
                local kimi_efforts="" kimi_off="" kimi_rkey="" kimi_deff=""
                if [[ ",${kimi_caps}," == *",thinking,"* ]]; then
                    # kalidroid's template maps high/max -> xhigh and raises on
                    # anything outside low/medium/xhigh, so all five kimi efforts
                    # are safe there; override via KIMO_KIMI_EFFORTS / OM_KIMI_EFFORTS for models
                    # whose templates are pickier.
                    kimi_efforts="${KIMO_KIMI_EFFORTS:-${OM_KIMI_EFFORTS:-low,medium,high,xhigh,max}}"
                    # Verified against Ollama 0.40 /v1: reasoning_effort=none is
                    # intercepted before the chat template and genuinely
                    # disables reasoning - so /effort 'off' is real, not silent.
                    kimi_off="none"
                    # Ollama's OpenAI layer returns reasoning under 'reasoning',
                    # not the 'reasoning_content' kimi auto-detects - without
                    # this override thinking output is silently dropped.
                    kimi_rkey="${KIMO_KIMI_REASONING_KEY:-${OM_KIMI_REASONING_KEY:-reasoning}}"
                    kimi_deff="${KIMO_KIMI_EFFORT:-${OM_KIMI_EFFORT:-high}}"
                fi
                export KIMI_DISABLE_TELEMETRY="${KIMI_DISABLE_TELEMETRY:-1}"
                export KIMI_CODE_NO_AUTO_UPDATE="${KIMI_CODE_NO_AUTO_UPDATE:-1}"
                kimi_alias=$(kimi_register_model "${active_host}" "${resolved_model}" "${kimi_ctx}" \
                    "${kimi_caps}" "${kimi_efforts}" "${kimi_deff}" "${kimi_off}" "${kimi_rkey}") || kimi_alias=""
                if [[ -n "${kimi_alias}" ]]; then
                    # Nested-launch guard: a kimi session started by this script
                    # exports KIMI_MODEL_* to all its children. A stale inherited
                    # env model must not be synthesized alongside the alias.
                    unset KIMI_MODEL_NAME KIMI_MODEL_API_KEY KIMI_MODEL_PROVIDER_TYPE \
                        KIMI_MODEL_BASE_URL KIMI_MODEL_MAX_CONTEXT_SIZE KIMI_MODEL_CAPABILITIES \
                        KIMI_MODEL_REASONING_KEY KIMI_MODEL_THINKING_EFFORT
                    echo "${C_DIM}[*] kimi alias '${kimi_alias}' -> ${active_host}/v1 (context ${kimi_ctx:-kimi default}${kimi_efforts:+, efforts off|${kimi_efforts}})${C_RESET}"
                    exec "${cli_cmd}" -m "${kimi_alias}" "${cli_passthrough_args[@]}"
                fi

                # --- Fallback: KIMI_MODEL_* env channel (no config footprint) ---
                export KIMI_MODEL_NAME="${resolved_model}"
                export KIMI_MODEL_PROVIDER_TYPE="openai"
                export KIMI_MODEL_BASE_URL="${active_host}/v1"
                # Deliberately forced rather than ${OPENAI_API_KEY:-ollama}: the
                # key is sent as 'Authorization: Bearer' to KIMI_MODEL_BASE_URL,
                # and active_host may be the LAN/tunnel Desktop - forwarding a
                # real key there would leak it off this box. Ollama ignores the
                # value. KIMI_MODEL_API_KEY is mandatory for the env model.
                export KIMI_MODEL_API_KEY="ollama"
                if [[ -n "${kimi_ctx}" ]]; then
                    export KIMI_MODEL_MAX_CONTEXT_SIZE="${kimi_ctx}"
                else
                    unset KIMI_MODEL_MAX_CONTEXT_SIZE
                fi
                export KIMI_MODEL_CAPABILITIES="${kimi_caps}"
                if [[ ",${kimi_caps}," == *",thinking,"* ]]; then
                    export KIMI_MODEL_REASONING_KEY="${kimi_rkey}"
                    # The env model cannot declare support_efforts, so the
                    # in-session /effort picker only offers on/off - and both
                    # encode as *silent* (no reasoning_effort field). A concrete
                    # effort must ride in env instead; it is sent verbatim:
                    #   KIMO_KIMI_EFFORT=xhigh kimo --remote launch kimi ...
                    export KIMI_MODEL_THINKING_EFFORT="${KIMO_KIMI_EFFORT:-${OM_KIMI_EFFORT:-high}}"
                else
                    # A stale inherited effort on a non-thinking model makes kimi
                    # fail the request outright ("does not support thinking").
                    unset KIMI_MODEL_REASONING_KEY KIMI_MODEL_THINKING_EFFORT
                fi
                echo "${C_DIM}[*] kimi on '${resolved_model}' via ${active_host}/v1 (context ${KIMI_MODEL_MAX_CONTEXT_SIZE:-kimi default}, caps ${KIMI_MODEL_CAPABILITIES}${KIMI_MODEL_THINKING_EFFORT:+, thinking effort ${KIMI_MODEL_THINKING_EFFORT}})${C_RESET}"
                exec "${cli_cmd}" "${cli_passthrough_args[@]}"
                ;;
            agy)
                # No exec here: the shim must be reaped and modelProvider
                # removed from agy's settings once the session ends.
                local shim rc=0
                if ! shim=$(find_gemini_shim); then
                    echo "${C_RED}Error: Gemini shim not found (looked in: ${GEMINI_SHIM_PATHS[*]}).${C_RESET}" >&2
                    echo "agy speaks only the Gemini wire format, so it cannot reach ${active_host} without it." >&2
                    exit 1
                fi
                if ! command -v jq >/dev/null 2>&1; then
                    echo "${C_RED}Error: jq is required to patch ${AGY_SETTINGS}.${C_RESET}" >&2
                    exit 1
                fi
                if ! agy_start_shim "${shim}" "${active_host}" "${resolved_model}"; then
                    exit 1
                fi
                echo "${C_DIM}[*] Gemini shim on 127.0.0.1:${AGY_SHIM_PORT} -> ${active_host} (pid ${AGY_SHIM_PID})${C_RESET}"

                if ! agy_patch_settings "${resolved_model}"; then
                    echo "${C_RED}Error: could not register ${resolved_model} in ${AGY_SETTINGS}; agy would fall back to Google.${C_RESET}" >&2
                    exit 1
                fi
                trap agy_cleanup EXIT INT TERM HUP

                export GEMINI_API_KEY="${GEMINI_API_KEY:-ollama}"
                export GOOGLE_GEMINI_BASE_URL="http://127.0.0.1:${AGY_SHIM_PORT}"
                echo "${C_DIM}[*] agy now runs on ${resolved_model} via the Gemini wire format.${C_RESET}"

                "${cli_cmd}" --model "${resolved_model}" "${cli_passthrough_args[@]}" || rc=$?
                exit "${rc}"
                ;;
            *)
                exec "${cli_cmd}" --model "${resolved_model}" "${cli_passthrough_args[@]}"
                ;;
        esac
    elif [[ -n "${cli_cmd}" ]]; then
        echo "${C_YELLOW}[!] External CLI '${cli_cmd}' not found in PATH.${C_RESET}"
        echo "${C_CYAN}[*] Falling back to native 'ollama run ${resolved_model}'...${C_RESET}"
        exec ollama run "${resolved_model}" "${cli_passthrough_args[@]}"
    else
        echo "${C_CYAN}[*] Executing provider '${provider}' via 'ollama run ${resolved_model}'...${C_RESET}"
        exec ollama run "${resolved_model}" "${cli_passthrough_args[@]}"
    fi
}

# -----------------------------------------------------------------------------
# Main Dispatcher
# -----------------------------------------------------------------------------
# With several --host values, read-only/aggregate commands query every host;
# commands that act on one model go to the first host that has it (else the
# first --host).
if [[ "${HOST_MODE}" == "multi" ]]; then
    case "${COMMAND}" in
        check|ping|hosts|ps|list|ls|search|find|stop|unload|info|show|status|health|status-report|report|logs|log|rotate-token|rotate|help|-h|--help) ;;
        *)
            _model="${ARGS[0]:-}"
            if [[ "${COMMAND}" == "launch" ]]; then
                _model=""
                for ((_i = 0; _i < ${#ARGS[@]}; _i++)); do
                    case "${ARGS[_i]}" in
                        --model) _model="${ARGS[_i+1]:-}"; break ;;
                        --model=*) _model="${ARGS[_i]#*=}"; break ;;
                    esac
                done
            fi
            TARGET_HOST="${OPT_HOSTS[0]}"
            if [[ -n "${_model}" && "${_model}" != -* ]]; then
                for _h in "${OPT_HOSTS[@]}"; do
                    if resolve_model_name "${_model}" "${_h}" >/dev/null 2>&1; then
                        TARGET_HOST="${_h}"
                        break
                    fi
                done
            fi
            HOST_MODE="custom"
            echo "${C_DIM}[*] Multiple --host: routing '${COMMAND}' to ${TARGET_HOST}${C_RESET}" >&2
            ;;
    esac
fi

case "${COMMAND}" in
    check|ping)
        cmd_check
        ;;
    hosts)
        cmd_hosts
        ;;
    ps)
        cmd_ps
        ;;
    status|health)
        cmd_status
        ;;
    status-report|report)
        cmd_status_report
        ;;
    logs|log)
        cmd_logs "${ARGS[0]:-}"
        ;;
    rotate-token|rotate)
        cmd_rotate_token "${ARGS[@]}"
        ;;
    stop|unload)
        cmd_stop "${ARGS[0]:-}"
        ;;
    warm|preload)
        cmd_warm "${ARGS[0]:-}" "${ARGS[1]:-}"
        ;;
    tune|set-ctx|param)
        cmd_tune "${ARGS[@]}"
        ;;
    bench|eval|benchmark)
        cmd_bench "${ARGS[@]}"
        ;;
    list|ls)
        cmd_list "${ARGS[0]:-}"
        ;;
    search|find)
        cmd_search "${ARGS[@]}"
        ;;
    info|show)
        cmd_info "${ARGS[0]:-}"
        ;;
    tag|alias|cp)
        cmd_tag "${ARGS[0]:-}" "${ARGS[1]:-}"
        ;;
    rm|delete)
        cmd_rm "${ARGS[0]:-}"
        ;;
    stream)
        cmd_stream "${ARGS[@]}"
        ;;
    run)
        cmd_run "${ARGS[@]}"
        ;;
    launch)
        cmd_launch "${ARGS[@]}"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "${C_RED}Error: Unknown command '${COMMAND}'.${C_RESET}" >&2
        usage
        exit 1
        ;;
esac
