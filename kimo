# Command: warm / preload
# -----------------------------------------------------------------------------
cmd_warm() {
    reject_model_options "warm <model> [duration]" "$@"
    local target_model="${1:-}"
    if [[ -z "${target_model}" ]]; then
        echo "${C_RED}Error: 'warm' requires a model name.${C_RESET}" >&2
        echo "Usage: ${0##*/} warm <model> [duration]" >&2
        exit 1
    fi
    local duration="${2:-24h}"
    local active_host=""
    local resolved_model="${target_model}"

    if [[ -n "${TARGET_HOST}" ]]; then
        active_host="${TARGET_HOST}"
        local res
        res=$(resolve_model_name "${target_model}" "${active_host}" || true)
        [[ -n "${res}" ]] && resolved_model="${res}"
    else
        # Desktop GPU first: a model on both hosts must not land on the Pi, which
        # has no GPU - its bridge refuses anything over the 8 GiB budget, and a
        # direct load is OOM-killed by ollama-memory-guard.
        local local_res="" remote_first
        remote_first=$(resolve_model_name "${target_model}" "${REMOTE_HOST_URL}" || true)
        [[ -z "${remote_first}" ]] && local_res=$(resolve_model_name "${target_model}" "${LOCAL_HOST_URL}" || true)
        if [[ -n "${remote_first}" ]]; then
            resolved_model="${remote_first}"
            active_host="${REMOTE_HOST_URL}"
        elif [[ -n "${local_res}" ]]; then
            resolved_model="${local_res}"
            active_host="${LOCAL_HOST_URL}"
        else
            local remote_res
            remote_res=$(resolve_model_name "${target_model}" "${REMOTE_HOST_URL}" || true)
            if [[ -n "${remote_res}" ]]; then
                resolved_model="${remote_res}"
                active_host="${REMOTE_HOST_URL}"
            else
                active_host="${LOCAL_HOST_URL}"
            fi
        fi
    fi

    echo "${C_CYAN}[*] Pre-warming model '${resolved_model}' into GPU VRAM on ${active_host} (keep_alive: ${duration})...${C_RESET}"
    local tp_warm warm_opts="{}"
    tp_warm=$(tuned_params "${resolved_model}" || true)
    if [[ -n "${tp_warm}" ]]; then
        warm_opts="${tp_warm}"
    fi

    # A cold load of a large model can take minutes; cap it so a stalled host
    # cannot hang kimo, and report a dead one instead of exiting silently.
    local resp rc=0
    resp=$(curl -s --connect-timeout 5 -m "${KIMO_WARM_TIMEOUT:-600}" -X POST "${active_host}/api/generate" \
        -H "Content-Type: application/json" \
        -d "$(jq -nc --arg m "${resolved_model}" --arg k "${duration}" --argjson opt "${warm_opts}" '{model: $m, keep_alive: $k, stream: false, options: $opt}')") || rc=$?
    if [[ ${rc} -ne 0 ]]; then
        echo "${C_RED}[!] Warm request to ${active_host} failed (curl exit ${rc}; 28 = timed out after ${KIMO_WARM_TIMEOUT:-600}s).${C_RESET}" >&2
        exit 1
    fi

    if echo "${resp}" | grep -q '"done_reason":"load"'; then
        echo "${C_GREEN}[✓] Successfully pre-warmed '${resolved_model}' into VRAM (resident for ${duration}).${C_RESET}"
    else
        echo "${C_YELLOW}[*] Warm result: ${resp}${C_RESET}"
    fi
}

