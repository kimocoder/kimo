# -----------------------------------------------------------------------------
# Global Option Parsing (Permits flags anywhere on command line)
# -----------------------------------------------------------------------------
OPT_REMOTE=false
OPT_LOCAL=false
OPT_HOST=""
OPT_HOSTS=()
OPT_JSON=false
# Keep a no_color=true the config loader already applied; --no-color adds to it.
FORCE_NO_COLOR="${FORCE_NO_COLOR:-false}"
POSITIONAL_ARGS=()
OPT_PASSTHROUGH=false

while [[ $# -gt 0 ]]; do
    # The direct Codex command owns every subsequent option, including its
    # native --remote transport flag. kimo globals go before 'codex'.
    if [[ "${POSITIONAL_ARGS[0]:-}" == codex ]]; then
        POSITIONAL_ARGS+=("$@")
        break
    fi
    # After '--' nothing is a kimo option: the rest is passed through verbatim.
    if ${OPT_PASSTHROUGH}; then
        POSITIONAL_ARGS+=("$1")
        shift
        continue
    fi
    # Once 'launch <cli>' is known, the flags child CLIs commonly define
    # themselves (-v, --version, -h, --help, --json) belong to that CLI, not
    # kimo. Routing options (--remote/--local/--host/--no-color) still apply.
    _child_args=false
    [[ "${POSITIONAL_ARGS[0]:-}" == "launch" && ${#POSITIONAL_ARGS[@]} -ge 2 ]] && _child_args=true
    case "$1" in
        --)
            OPT_PASSTHROUGH=true
            # Keep the marker for the command (cmd_launch strips it), unless
            # it precedes the command itself.
            [[ ${#POSITIONAL_ARGS[@]} -gt 0 ]] && POSITIONAL_ARGS+=("$1")
            shift
            ;;
        --remote)
            OPT_REMOTE=true
            shift
            ;;
        --local)
            OPT_LOCAL=true
            shift
            ;;
        --host)
            shift
            if [[ -z "${1:-}" ]]; then
                echo "Error: --host requires an address argument." >&2
                exit 1
            fi
            OPT_HOSTS+=("$1")
            shift
            ;;
        --host=*)
            OPT_HOSTS+=("${1#*=}")
            shift
            ;;
        --json)
            if ${_child_args}; then
                POSITIONAL_ARGS+=("$1")
            else
                OPT_JSON=true
            fi
            shift
            ;;
        --no-color)
            FORCE_NO_COLOR=true
            shift
            ;;
        -v|--version)
            if ${_child_args}; then
                POSITIONAL_ARGS+=("$1")
                shift
                continue
            fi
            echo "kimo v${KIMO_VERSION}"
            exit 0
            ;;
        -h|--help)
            if [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]]; then
                setup_colors
                usage
                exit 0
            else
                POSITIONAL_ARGS+=("$1")
                shift
            fi
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done
unset _child_args

# Apply default_host from persistent config if not overridden on command line
if [[ -n "${KIMO_CONFIG_VALUES[default_host]:-}" && ${#OPT_HOSTS[@]} -eq 0 && ! ${OPT_LOCAL} && ! ${OPT_REMOTE} ]]; then
    case "${KIMO_CONFIG_VALUES[default_host]}" in
        remote) OPT_REMOTE=true ;;
        local)  OPT_LOCAL=true ;;
        *)      OPT_HOSTS+=("${KIMO_CONFIG_VALUES[default_host]}") ;;
    esac
fi

setup_colors

if [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]]; then
    usage
    exit 0
fi

COMMAND="${POSITIONAL_ARGS[0]}"
ARGS=("${POSITIONAL_ARGS[@]:1}")

# Config values the loader skipped as invalid. `config` reports them itself
# (validate lists them) and completion output must stay clean.
if [[ ${#KIMO_CONFIG_IGNORED[@]} -gt 0 && "${COMMAND}" != config && "${COMMAND}" != cfg && "${COMMAND}" != completion ]]; then
    for _ign in "${KIMO_CONFIG_IGNORED[@]}"; do
        echo "${C_YELLOW}[!] Ignoring invalid setting ${_ign}; run '${0##*/} config validate'.${C_RESET}" >&2
    done
    unset _ign
fi

# Resolve which remote URL is actually reachable (tunnel-first).
# Honors $OLLAMA_REMOTE_URL when set. Falls back to the tunnel default even
# when nothing answers so callers always have a stable value to report.
probe_ollama_url() {
    # -f: a 401 from a bridge that now requires a token is not "reachable" -
    # accepting it made every remote model lookup fail and launch fall back to
    # the Pi, where a 27B load is refused or OOM-killed.
    curl -sf --connect-timeout 1 -m 2 "$1/api/tags" >/dev/null 2>&1
}
resolve_remote_url() {
    if [[ -n "${OLLAMA_REMOTE_URL:-}" ]]; then
        echo "${OLLAMA_REMOTE_URL}"
        return
    fi
    # Quota adapters own their requests and timeout budgets. In particular,
    # --offline and --help must not probe Ollama during global routing.
    case "${COMMAND}" in
        quota|quotas|quote) echo "${REMOTE_HOST_URL}"; return ;;
    esac
    # Candidates in priority order: the ssh tunnel, the direct LAN address,
    # then the Desktop's own Ollama daemon (no bridge, no token; dashboard ep1
    # uses it). The tunnel is also the fallback when nothing answers.
    local -a cands=("${REMOTE_TUNNEL_URL}" "${REMOTE_DIRECT_URL:-}" "${REMOTE_DAEMON_URL:-}")
    local -a pids=()
    local key="${cands[*]}" cache="" ttl="${KIMO_REMOTE_CACHE_TTL:-20}" now winner="${REMOTE_TUNNEL_URL}" i
    # A short-lived answer cache: an unreachable remote otherwise costs every
    # command a probe timeout. KIMO_REMOTE_CACHE_TTL=0 disables it.
    if [[ "${ttl}" =~ ^[0-9]+$ ]] && ((ttl > 0)) && [[ -n "${KIMO_RUNTIME_DIR:-}" ]] \
        && ensure_private_dir "${KIMO_RUNTIME_DIR}" 2>/dev/null; then
        cache="${KIMO_RUNTIME_DIR}/remote-url"
        now=$(date +%s)
        if [[ -f "${cache}" && ! -L "${cache}" ]]; then
            local c_time c_key c_url c_state
            IFS='|' read -r c_time c_key c_url c_state <"${cache}" || true
            if [[ "${c_time}" =~ ^[0-9]+$ && "${c_key}" == "${key}" && -n "${c_url}" ]] && ((now - c_time < ttl)); then
                echo "${c_url}"
                return
            fi
        fi
    fi
    # Probe all candidates at once (worst case one timeout, not three), then
    # take the highest-priority one that answered.
    local state="down"
    for i in "${!cands[@]}"; do
        [[ -n "${cands[i]}" ]] || continue
        probe_ollama_url "${cands[i]}" &
        pids[i]=$!
    done
    for i in "${!cands[@]}"; do
        [[ -n "${pids[i]:-}" ]] || continue
        if wait "${pids[i]}"; then
            winner="${cands[i]}"
            state="up"
            break
        fi
    done
    for i in "${!pids[@]}"; do
        kill "${pids[i]}" 2>/dev/null || true
        wait "${pids[i]}" 2>/dev/null || true
    done
    if [[ -n "${cache}" ]]; then
        printf '%s|%s|%s|%s\n' "${now}" "${key}" "${winner}" "${state}" >"${cache}.$$" 2>/dev/null \
            && mv -f "${cache}.$$" "${cache}" 2>/dev/null || rm -f "${cache}.$$"
    fi
    echo "${winner}"
}

# True when the last resolve_remote_url (cached within its TTL) found no
# candidate answering, so callers can warn without probing a dead host again.
remote_known_down() {
    local cache="${KIMO_RUNTIME_DIR:-}/remote-url" c_time c_key c_url c_state
    [[ -n "${KIMO_RUNTIME_DIR:-}" && -f "${cache}" && ! -L "${cache}" ]] || return 1
    IFS='|' read -r c_time c_key c_url c_state <"${cache}" || return 1
    [[ "${c_url}" == "$1" && "${c_state}" == "down" ]]
}

# Commands that never talk to an Ollama daemon skip remote resolution, so
# 'version', 'help', 'config', installers etc. stay instant when the remote is
# down (resolution probes the network; see resolve_remote_url).
command_needs_remote() {
    case "$1" in
        launch)
            local backend="${KIMO_CLOUD_PROVIDER:-${KIMO_CONFIG_VALUES[cloud_provider]:-}}"
            local cli="${ARGS[0]:-}" explicit=false model i
            [[ -n "${cli}" ]] || return 1
            model="${KIMO_DEFAULT_MODEL:-${DEFAULT_MODELS[$cli]:-}}"
            for ((i=1; i<${#ARGS[@]}; i++)); do
                case "${ARGS[i]}" in
                    --) break ;;
                    --provider) backend="${ARGS[i+1]:-}"; ((i+=1)) ;;
                    --provider=*) backend="${ARGS[i]#*=}" ;;
                    -m|--model) model="${ARGS[i+1]:-}"; explicit=true; ((i+=1)) ;;
                    -m=*|--model=*) model="${ARGS[i]#*=}"; explicit=true ;;
                esac
            done
            case "${backend}" in
                codex|openai|abliteration|dashscope) return 1 ;;
                "")
                    [[ "${model}" == codex/* || "${model}" == codex ]] && return 1
                    if [[ "${cli}" == codex || "${cli}" == kimi ]] && ! ${explicit} \
                        && [[ -n "${CODEX_API_KEY:-}${CODEX_AUTH_TOKEN:-}" ]]; then
                        return 1
                    fi
                    [[ "${cli}" == codex && -n "${CODEX_ACCESS_TOKEN:-}" ]] && ! ${explicit} && return 1
                    ;;
            esac
            return 0 ;;
        version|help|-h|--help|completion|config|cfg|quota|quotas|quote|web|gemini|gemini-sync|kimi-gemini|codex|codex-sync|kimi-codex|freetier|free-tier|kimi-sync|install|setup|update|upgrade|rotate-token|rotate|logs|log|scan|discover|init) return 1 ;;
        *) return 0 ;;
    esac
}

# Normalize a --host style address into a base URL:
#   host / host:port / [v6] -> http://...; Ollama's :11434 is added only to a
#   bare http host (no port, no path). https:// and URLs with a path (reverse
#   proxies such as https://example.com/ollama) keep their own default port,
#   and an added port always goes on the authority, never after the path.
normalize_host_url() {
    local url="${1%/}" scheme="http" rest authority path="" hostport
    if [[ "${url}" =~ ^([A-Za-z][A-Za-z0-9+.-]*)://(.*)$ ]]; then
        scheme="${BASH_REMATCH[1],,}"
        rest="${BASH_REMATCH[2]}"
    else
        rest="${url}"
    fi
    authority="${rest%%/*}"
    [[ "${rest}" == */* ]] && path="/${rest#*/}"
    hostport="${authority##*@}"
    if [[ "${scheme}" == "http" && -z "${path}" && ! "${hostport}" =~ ^(\[[^]]*\]|[^:]+):[0-9]+$ ]]; then
        authority="${authority}:11434"
    fi
    echo "${scheme}://${authority}${path}"
}

# --host may be repeated; normalize and de-duplicate, keeping the given order.
if [[ ${#OPT_HOSTS[@]} -gt 0 ]]; then
    declare -A _seen_hosts=()
    _norm_hosts=()
    for _h in "${OPT_HOSTS[@]}"; do
        _h="$(normalize_host_url "${_h}")"
        [[ -n "${_seen_hosts[${_h}]:-}" ]] && continue
        _seen_hosts[${_h}]=1
        _norm_hosts+=("${_h}")
    done
    OPT_HOSTS=("${_norm_hosts[@]}")
    OPT_HOST="${OPT_HOSTS[0]}"
fi
MULTI_HOSTS=""
REMOTE_RESOLVE_PENDING=false
[[ -n "${OLLAMA_LOCAL_URL:-}" ]] && LOCAL_HOST_URL="$(normalize_host_url "${OLLAMA_LOCAL_URL}")"

# Determine Active Target Host
# --host combined with --local/--remote redefines that side's address instead
# of replacing the mode, so local/remote labels and routing stay intact.
if [[ ${#OPT_HOSTS[@]} -gt 1 ]]; then
    if ${OPT_LOCAL} || ${OPT_REMOTE}; then
        echo "${C_RED}Error: multiple --host values cannot be combined with --local/--remote; use \$OLLAMA_LOCAL_URL / \$OLLAMA_REMOTE_URL.${C_RESET}" >&2
        exit 1
    fi
    TARGET_HOST=""
    HOST_MODE="multi"
    MULTI_HOSTS="${OPT_HOSTS[*]}"
elif ${OPT_LOCAL} && ${OPT_REMOTE}; then
    if [[ -n "${OPT_HOST}" ]]; then
        echo "${C_RED}Error: --host is ambiguous with both --local and --remote; use \$OLLAMA_LOCAL_URL / \$OLLAMA_REMOTE_URL.${C_RESET}" >&2
        exit 1
    fi
    TARGET_HOST=""
    HOST_MODE="auto"
    REMOTE_RESOLVE_PENDING=true
elif ${OPT_LOCAL} && [[ -n "${OPT_HOST}" ]]; then
    LOCAL_HOST_URL="${OPT_HOST}"
    TARGET_HOST="${LOCAL_HOST_URL}"
    HOST_MODE="local"
elif ${OPT_REMOTE} && [[ -n "${OPT_HOST}" ]]; then
    REMOTE_HOST_URL="${OPT_HOST}"
    TARGET_HOST="${REMOTE_HOST_URL}"
    HOST_MODE="remote"
    if [[ "${COMMAND}" != quota && "${COMMAND}" != quotas && "${COMMAND}" != quote ]] && ! probe_ollama_url "${TARGET_HOST}"; then
        echo "${C_YELLOW}[!] Remote ${TARGET_HOST} unreachable${C_RESET}" >&2
    fi
elif [[ -n "${OPT_HOST}" ]]; then
    TARGET_HOST="${OPT_HOST}"
    HOST_MODE="custom"
elif ${OPT_REMOTE}; then
    # Resolved (and probed) just before dispatch, see REMOTE_RESOLVE_PENDING.
    TARGET_HOST="${REMOTE_HOST_URL}"
    HOST_MODE="remote"
    REMOTE_RESOLVE_PENDING=true
elif ${OPT_LOCAL}; then
    TARGET_HOST="${LOCAL_HOST_URL}"
    HOST_MODE="local"
else
    TARGET_HOST=""
    HOST_MODE="auto"
    # In auto mode every command that touches the remote resolves it lazily via
    # $REMOTE_HOST_URL; refresh it here when it still points at the default so
    # a recovered direct path is picked up without an env override.
    if [[ "${REMOTE_HOST_URL}" == "${REMOTE_TUNNEL_URL}" || "${REMOTE_HOST_URL}" == "${REMOTE_DIRECT_URL}" ]]; then
        REMOTE_RESOLVE_PENDING=true
    fi
fi

# -----------------------------------------------------------------------------
# Helper Functions
# -----------------------------------------------------------------------------

# Call as `require_value "$@"` before reading "$2" for a value-taking option.
# A trailing option otherwise aborts on set -u ("$2: unbound variable") or exits
# silently on a failed `shift 2`. Values may begin with '-' (e.g. --temp -1).
require_value() {
    if [[ $# -lt 2 ]]; then
        echo "${C_RED}Error: $1 requires a value.${C_RESET}" >&2
        exit 1
    fi
}

# Per-user directory for session claims and config locks. A fixed name in the
# shared /tmp can be pre-created by another local user, who could then plant
# claim files or a lock symlink that `exec 9>` would follow and truncate.
if [[ -z "${KIMO_RUNTIME_DIR:-}" ]]; then
    if [[ -n "${XDG_RUNTIME_DIR:-}" && -d "${XDG_RUNTIME_DIR}" && -O "${XDG_RUNTIME_DIR}" ]]; then
        KIMO_RUNTIME_DIR="${XDG_RUNTIME_DIR}/kimo"
    else
        KIMO_RUNTIME_DIR="${TMPDIR:-/tmp}/kimo-$(id -u)"
    fi
fi

# ensure_private_dir DIR: create DIR (mode 700) if absent, then require a real
# directory owned by this user - never a symlink or another user's directory.
ensure_private_dir() {
    local dir="$1"
    # Only the leaf needs 700: callers secure KIMO_RUNTIME_DIR itself first.
    # shellcheck disable=SC2174
    [[ -e "${dir}" || -L "${dir}" ]] || mkdir -p -m 700 "${dir}" 2>/dev/null || true
    if [[ -L "${dir}" || ! -d "${dir}" || ! -O "${dir}" ]]; then
        echo "${C_RED}Error: ${dir} is not a directory owned by $(id -un); remove it or set KIMO_RUNTIME_DIR.${C_RESET}" >&2
        return 1
    fi
}

# curl_bearer KEY CURL_ARGS...: curl with "Authorization: Bearer KEY" passed as
# a config file on stdin, so the secret stays out of argv (ps, /proc/*/cmdline).
# Exported for helpers that xargs runs under `bash -c`.
curl_bearer() {
    local key="$1"
    shift
    key="${key//\\/\\\\}"
    key="${key//\"/\\\"}"
    printf 'header = "Authorization: Bearer %s"\n' "${key}" | curl -K - "$@"
}
export -f curl_bearer

# Model commands take positional names. Ollama names never start with '-', so
# such an argument is an option: -h/--help prints usage and anything else is
# rejected instead of reaching the API as a model name (`rm --help` used to
# DELETE a model called "--help"). Negative numbers pass (warm m -1 = forever).
reject_model_options() {
    local usage="$1" arg
    shift
    for arg in "$@"; do
        case "${arg}" in
            -h|--help) echo "Usage: ${0##*/} ${usage}"; exit 0 ;;
            -[0-9]*) ;;
            -*)
                echo "${C_RED}Error: unknown option '${arg}'.${C_RESET}" >&2
                echo "Usage: ${0##*/} ${usage}" >&2
                exit 1
                ;;
        esac
    done
}

# Resolve model name to its exact tag on target host (exact match, :latest, prefix, substring)
resolve_model_name() {
    local target="$1"
    local host_url="${2:-${LOCAL_HOST_URL}}"
    local tags
    tags=$(curl -s --connect-timeout 3 -m 8 "${host_url}/api/tags" 2>/dev/null) || return 1

    # 1. Exact match
    local match
    match=$(echo "${tags}" | jq -r --arg t "${target}" '.models[].name | select(. == $t)' 2>/dev/null | head -n1)
    if [[ -n "${match}" ]]; then
        echo "${match}"
        return 0
    fi

    # 2. Check :latest tag
    match=$(echo "${tags}" | jq -r --arg t "${target}:latest" '.models[].name | select(. == $t)' 2>/dev/null | head -n1)
    if [[ -n "${match}" ]]; then
        echo "${match}"
        return 0
    fi

    # 3. Check prefix match (e.g. nemotron3 -> nemotron3:33b)
    match=$(echo "${tags}" | jq -r --arg t "${target}:" '.models[].name | select(startswith($t))' 2>/dev/null | head -n1)
    if [[ -n "${match}" ]]; then
        echo "${match}"
        return 0
    fi

    # 4. Substring match
    match=$(echo "${tags}" | jq -r --arg t "${target,,}" '.models[].name | select(ascii_downcase | contains($t))' 2>/dev/null | head -n1)
    if [[ -n "${match}" ]]; then
        echo "${match}"
        return 0
    fi

    return 1
}

# Check if model is present locally
is_local_model() {
    resolve_model_name "$1" "${LOCAL_HOST_URL}" >/dev/null 2>&1
}

# Check if model is present on remote host
is_remote_model() {
    resolve_model_name "$1" "${REMOTE_HOST_URL}" >/dev/null 2>&1
}

# True when a host URL is a plain loopback Ollama endpoint on THIS box, i.e. a
# real bearer token may be forwarded to it without leaving the machine. False
# for the remote Desktop even when reached through its 127.0.0.1 ssh -L tunnel
# (which is loopback on this side but forwards off-box), for the direct LAN
# address, and for any user-configured remote URL.
host_is_plain_local() {
    local url="${1:-}"
    [[ -z "${url}" ]] && return 1
    [[ "${url}" == "${REMOTE_TUNNEL_URL}" ]] && return 1
    [[ "${url}" == "${REMOTE_DIRECT_URL}" ]] && return 1
    [[ -n "${REMOTE_HOST_URL:-}" && "${url}" == "${REMOTE_HOST_URL}" ]] && return 1
    local rest="${url#*://}" host
    if [[ "${rest}" == \[* ]]; then
        host="${rest#[}"; host="${host%%]*}"
    else
        host="${rest%%[:/]*}"
    fi
    case "${host}" in
        127.0.0.1|localhost|::1|0.0.0.0) return 0 ;;
        *) return 1 ;;
    esac
}

# The abliteration.ai API key. Environment only: it is never written to a config
# file or passed in argv, so it cannot be read back out of ~/.config/kimo or
# another user's 'ps' output. ABLIT_KEY is accepted because that is the name
# abliteration.ai's own opencode integration documents.
abliteration_api_key() {
    local k="${ABLITERATION_API_KEY:-${ABLIT_KEY:-}}"
    [[ -n "${k}" ]] || return 1
    echo "${k}"
}

# True when <cli> has a launch branch that can reach abliteration.ai.
abliteration_cli_supported() {
    local c
    for c in ${ABLITERATION_CLIS}; do
        [[ "${c}" == "$1" ]] && return 0
    done
    return 1
}

# Resolve a user-supplied model name to abliteration.ai's canonical model id.
# Accepts the exact id, the id with Claude Code's context suffix
# (abliterated-model-large-v2[1m]), and the short aliases base / large /
# large-v2. Prints the canonical id; returns 1 with a message on no match.
abliteration_resolve_model() {
    local want="${1:-}" id
    want="${want%%\[*}" # drop a [1m] / [256k] context suffix
    [[ -z "${want}" ]] && want="${ABLITERATION_DEFAULT_MODEL}"
    case "${want}" in
        base) want="${ABLITERATION_VISION_MODEL}" ;;
        large) want="abliterated-model-large" ;;
        large-v2|large_v2|lv2) want="abliterated-model-large-v2" ;;
    esac
    if [[ -n "${ABLITERATION_MODELS[${want}]:-}" ]]; then
        echo "${want}"
        return 0
    fi
    # Prefix/substring match so 'abliterated-model-large-v' and 'large-v2' work.
    for id in abliterated-model-large-v2 abliterated-model-large abliterated-model; do
        if [[ "${id}" == "${want}"* || "${id}" == *"${want}"* ]]; then
            echo "${id}"
            return 0
        fi
    done
    echo "${want}"
    return 1
}

# Context window for a canonical abliteration model id (tokens).
abliteration_model_ctx() {
    echo "${ABLITERATION_MODELS[${1:-}]:-}"
}

# Claude Code reads a '[1m]' suffix on the model id as "use a 1M window" and
# strips it before the request reaches the API; without it Claude Code 2.1.223+
# assumes 200K for an unrecognized third-party id. Only the 1M models get one.
abliteration_claude_model() {
    local id="$1" ctx
    ctx=$(abliteration_model_ctx "${id}")
    if [[ "${ctx}" == "1000000" ]]; then
        echo "${id}[1m]"
    else
        echo "${id}"
    fi
}

# kimi's capability vocabulary (thinking/tool_use/image_in). All abliteration
# models stream, call tools and think; only the base model takes images - the
# two large models answer an image request with a 400.
abliteration_capabilities() {
    local caps="tool_use,thinking"
    [[ "$1" == "${ABLITERATION_VISION_MODEL}" ]] && caps="${caps},image_in"
    echo "${caps}"
}

# Reasoning efforts a model accepts. The base model rejects 'max' (its ceiling
# is xhigh); both large models take the full range.
abliteration_efforts() {
    if [[ "$1" == "${ABLITERATION_VISION_MODEL}" ]]; then
        echo "low,medium,high,xhigh"
    else
        echo "low,medium,high,xhigh,max"
    fi
}

# Unload every model resident on <host> except <keep>, to free VRAM before a
# large model loads. The other models may belong to other users or sessions
# sharing that GPU, so <policy> decides: always | never | ask (prompt on an
# interactive terminal, default No; skip when non-interactive).
evict_other_models() { # <host> <keep-model> <policy>
    local host="$1" keep="$2" policy="$3" lm ans="" do_evict=false
    local -a loaded=() others=()
    mapfile -t loaded < <(curl -s --connect-timeout 2 -m 3 "${host}/api/ps" | jq -r '.models[]?.name' 2>/dev/null || true)
    for lm in "${loaded[@]}"; do
        [[ -z "${lm}" || "${lm}" == "${keep}" || "${lm}:latest" == "${keep}" ]] && continue
        others+=("${lm}")
    done
    [[ ${#others[@]} -eq 0 ]] && return 0
    case "${policy}" in
        always|1|yes|true) do_evict=true ;;
        never|0|no|false) ;;
        *)
            if [[ -t 0 && -t 2 ]]; then
                read -r -p "Unload ${#others[@]} other loaded model(s) from ${host} (${others[*]}) to free VRAM? [y/N] " ans || ans=""
                [[ "${ans}" == [yY]* ]] && do_evict=true
            fi
            ;;
    esac
    if ! ${do_evict}; then
        echo "${C_DIM}[*] Leaving ${#others[@]} other loaded model(s) on ${host} (${others[*]}); pass --evict to unload them first.${C_RESET}" >&2
        return 0
    fi
    for lm in "${others[@]}"; do
        echo "${C_YELLOW}[*] Unloading active model '${lm}' from ${host} to prevent CUDA memory collision...${C_RESET}"
        curl -s -m 5 -X POST "${host}/api/generate" -H "Content-Type: application/json" \
            -d "$(jq -nc --arg m "${lm}" '{model: $m, keep_alive: 0}')" >/dev/null 2>&1 || true
        sleep 1
    done
}

# Read per-model tuned defaults (JSON) for an exact resolved model name.
# Prints the JSON object when tuned, empty output otherwise.
tuned_params() {
    local model="$1"
    if [[ ! -f "${TUNINGS_FILE}" ]]; then
        return 0
    fi
    python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1])) or {}
    p = d.get(sys.argv[2])
except Exception:
    p = None
if p:
    print(json.dumps(p))' "${TUNINGS_FILE}" "${model}"
}

