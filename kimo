    local target_model="${1:-}"

    OM_REMOTE_HOST_URL="${REMOTE_HOST_URL}" OM_LOCAL_HOST_URL="${LOCAL_HOST_URL}" OM_TARGET_HOST="${TARGET_HOST}" OM_HOST_MODE="${HOST_MODE}" OM_target_model="${target_model}" OM_MULTI_HOSTS="${MULTI_HOSTS}" OM_C_GREEN="${C_GREEN}" OM_C_RESET="${C_RESET}" OM_C_RED="${C_RED}" OM_C_BOLD="${C_BOLD}" OM_C_DIM="${C_DIM}" \
