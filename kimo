#!/usr/bin/env bash
# kimo – Unified manager for local and remote Ollama instances & external LLM CLIs.
# Utility for managing models, VRAM, and CLI routing in the Kalidroid environment.
# -----------------------------------------------------------------------------------

set -euo pipefail

# Directory of the real script, not of a `make link` symlink in $BINDIR, so a
# development link still finds lib/ in the checkout (as find_quota_helper does).
_kimo_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${_kimo_self}")" && pwd)"
unset _kimo_self

# Remote server configuration
# Dynamic resolution order:
#   1. $OLLAMA_REMOTE_URL / config file 'remote_url'
#   2. Active SSH tunnel forward (127.0.0.1:11438) -> detected destination host
#   3. Direct remote host probe (if remote_host is set in config or environment)
# Probing uses a short timeout so --help / local-only commands never hang.
REMOTE_HOST_PORT="${KIMO_REMOTE_HOST_PORT:-11434}"
REMOTE_TUNNEL_URL="${KIMO_REMOTE_TUNNEL_URL:-http://127.0.0.1:11438}"
REMOTE_HOST_IP="${KIMO_REMOTE_HOST_IP:-}"
REMOTE_DIRECT_URL=""
REMOTE_DAEMON_URL=""
KIMO_VERSION="1.1.0"

# Inspect /proc/*/cmdline to detect if an active SSH tunnel forwards a local port
_detect_tunnel_target() {
    local lport="${1:-11438}" target=""
    for cmd in /proc/[0-9]*/cmdline; do
        [[ -f "${cmd}" ]] || continue
        if grep -a -q ":${lport}:" "${cmd}" 2>/dev/null; then
            local words=()
            while IFS= read -r -d '' arg; do
                words+=("${arg}")
            done < "${cmd}" 2>/dev/null || true
            for ((i=${#words[@]}-1; i>=1; i--)); do
                local w="${words[i]}"
                [[ "${w}" == -* ]] && continue
                [[ "${w}" =~ :${lport}: ]] && continue
                if [[ "${w}" =~ ^([a-zA-Z0-9._-]+@)?([a-zA-Z0-9.-]+)$ ]]; then
                    local h="${BASH_REMATCH[2]}"
                    if [[ "${h}" != "127.0.0.1" && "${h}" != "localhost" && "${h}" != "::1" ]]; then
                        target="${h}"
                        break 2
                    fi
                fi
            done
        fi
    done
    echo "${target}"
}

# WebBridge (Kimi's real-browser relay, see 'kimo doctor' web bridge section).
# Its daemon listens on 127.0.0.1:10086 and is steered over a local /command
# JSON API - no API key, no Moonshot quota. Resolution order:
# $KIMO_WEBBRIDGE_URL (full URL incl. path) > env-var port > config > default.
WEBBRIDGE_PORT="${KIMO_WEBBRIDGE_PORT:-10086}"
WEBBRIDGE_URL="${KIMO_WEBBRIDGE_URL:-http://127.0.0.1:${WEBBRIDGE_PORT}/command}"
# Quota-free web tool defaults ('kimo web search' / 'launch kimi -W'),
# overridable via config file (web_engine, web_max_results).
WEB_ENGINE="${KIMO_WEB_ENGINE:-duckduckgo}"
WEB_MAX_RESULTS="${KIMO_WEB_MAX_RESULTS:-10}"

REMOTE_HOST_URL="${OLLAMA_REMOTE_URL:-${REMOTE_TUNNEL_URL}}"
LOCAL_HOST_URL="${OLLAMA_LOCAL_URL:-http://127.0.0.1:11434}"

# Persistent Configuration
KIMO_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME:-/root}/.config}/kimo"
KIMO_CONFIG_FILE="${KIMO_CONFIG_FILE:-${KIMO_CONFIG_DIR}/config}"
declare -A KIMO_CONFIG_VALUES=()
declare -A KIMO_CONFIG_SOURCES=()
KIMO_CONFIG_KEYS=(default_host default_model remote_url local_url remote_host kimi_effort kimi_context
    no_color webbridge_url webbridge_port web_engine web_max_results cloud_provider)
KIMO_CONFIG_IGNORED=()

# _kimo_config_parse_line LINE: the one parser shared by the loader and
# `config validate`. Sets _CFG_KEY/_CFG_VAL; returns 0 for an entry, 1 for a
# blank or comment ('#' or ';') line, 2 for a malformed line. One matching pair
# of surrounding quotes is stripped.
_kimo_config_parse_line() {
    local line="$1"
    _CFG_KEY="" _CFG_VAL=""
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "${line}" || "${line}" == \#* || "${line}" == \;* ]] && return 1
    [[ "${line}" =~ ^([a-zA-Z0-9_.-]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || return 2
    _CFG_KEY="${BASH_REMATCH[1]}"
    _CFG_VAL="${BASH_REMATCH[2]}"
    if [[ ${#_CFG_VAL} -ge 2 && ( "${_CFG_VAL}" == \"*\" || "${_CFG_VAL}" == \'*\' ) ]]; then
        _CFG_VAL="${_CFG_VAL:1:${#_CFG_VAL}-2}"
    fi
    return 0
}

# _kimo_config_check KEY VALUE: the value rules shared by `config set`,
# `config validate` and the loader. Prints why VALUE is invalid and returns 1;
# unknown keys only get the control-character check.
_kimo_config_check() {
    local key="$1" val="$2"
    # A newline would let `config set` write extra keys into the file.
    if [[ "${val}" == *[[:cntrl:]]* ]]; then
        echo "contains a control character (newline/tab)"
        return 1
    fi
    # Optional http(s) scheme, a host, optional :port and path; no spaces.
    local url_re='^(https?://)?[A-Za-z0-9._~%-]+(:[0-9]{1,5})?(/[^[:space:]]*)?$'
    local url6_re='^(https?://)?\[[0-9A-Fa-f:.]+\](:[0-9]{1,5})?(/[^[:space:]]*)?$'
    case "${key}" in
        default_host)
            [[ "${val}" == local || "${val}" == remote || "${val}" =~ ${url_re} || "${val}" =~ ${url6_re} ]] ||
                { echo "expected 'local', 'remote' or a host/URL (got '${val}')"; return 1; }
            ;;
        remote_url|local_url|webbridge_url)
            [[ "${val}" =~ ${url_re} || "${val}" =~ ${url6_re} ]] ||
                { echo "expected an http(s) URL such as http://host:11434 (got '${val}')"; return 1; }
            ;;
        remote_host)
            [[ "${val}" =~ ^[A-Za-z0-9._-]+$ || "${val}" =~ ^[0-9A-Fa-f:.]+$ ]] ||
                { echo "expected a hostname or IP address without scheme or port (got '${val}')"; return 1; }
            ;;
        default_model)
            [[ "${val}" =~ ^[A-Za-z0-9._:/@+-]+$ ]] ||
                { echo "expected a model name such as llama3.2:3b (got '${val}')"; return 1; }
            ;;
        kimi_effort)
            case "${val}" in
                low|medium|high|xhigh|max) ;;
                *) echo "expected one of: low, medium, high, xhigh, max (got '${val}')"; return 1 ;;
            esac
            ;;
        kimi_context)
            [[ "${val}" =~ ^[1-9][0-9]*$ ]] ||
                { echo "expected a positive integer in tokens, e.g. 262144 (got '${val}')"; return 1; }
            ;;
        webbridge_port)
            [[ "${val}" =~ ^[0-9]{1,5}$ ]] && (( 10#${val} >= 1 && 10#${val} <= 65535 )) ||
                { echo "expected a port between 1 and 65535 (got '${val}')"; return 1; }
            ;;
        web_engine)
            case "${val}" in
                duckduckgo|bing|google) ;;
                *) echo "expected one of: duckduckgo, bing, google (got '${val}')"; return 1 ;;
            esac
            ;;
        cloud_provider)
            case "${val}" in
                ""|none|ollama|abliteration|codex|openai|dashscope) ;;
                *) echo "expected 'ollama', 'abliteration', 'codex'/'openai', or 'dashscope' (got '${val}')"; return 1 ;;
            esac
            ;;
        web_max_results)
            [[ "${val}" =~ ^[1-9][0-9]{0,2}$ ]] ||
                { echo "expected an integer from 1 to 999 (got '${val}')"; return 1; }
            ;;
        no_color)
            case "${val,,}" in
                true|false|1|0|yes|no) ;;
                *) echo "expected a boolean: true/false, yes/no, 1/0 (got '${val}')"; return 1 ;;
            esac
            ;;
    esac
    return 0
}

_kimo_config_known() {
    local k
    for k in "${KIMO_CONFIG_KEYS[@]}"; do [[ "${k}" == "$1" ]] && return 0; done
    return 1
}

load_kimo_config() {
    local cfg="${KIMO_CONFIG_FILE}"
    if [[ ! -f "${cfg}" && -f "/etc/kimo/config" ]]; then
        cfg="/etc/kimo/config"
    fi

    if [[ -f "${cfg}" ]]; then
        local line why
        while IFS= read -r line || [[ -n "${line}" ]]; do
            _kimo_config_parse_line "${line}" || continue
            # A bad value is skipped (built-in/env value stays) and reported
            # once the command is known; see KIMO_CONFIG_IGNORED below.
            if ! why=$(_kimo_config_check "${_CFG_KEY}" "${_CFG_VAL}"); then
                KIMO_CONFIG_IGNORED+=("${_CFG_KEY}: ${why}")
                continue
            fi
            KIMO_CONFIG_VALUES["${_CFG_KEY}"]="${_CFG_VAL}"
            KIMO_CONFIG_SOURCES["${_CFG_KEY}"]="file:${cfg}"
        done < "${cfg}"
    fi

    if [[ -n "${KIMO_CONFIG_VALUES[remote_url]:-}" && -z "${OLLAMA_REMOTE_URL:-}" ]]; then
        REMOTE_HOST_URL="${KIMO_CONFIG_VALUES[remote_url]}"
        OLLAMA_REMOTE_URL="${REMOTE_HOST_URL}"
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[local_url]:-}" && -z "${OLLAMA_LOCAL_URL:-}" ]]; then
        LOCAL_HOST_URL="${KIMO_CONFIG_VALUES[local_url]}"
        OLLAMA_LOCAL_URL="${LOCAL_HOST_URL}"
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[default_model]:-}" && -z "${KIMO_DEFAULT_MODEL:-}" ]]; then
        KIMO_DEFAULT_MODEL="${KIMO_CONFIG_VALUES[default_model]}"
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[kimi_effort]:-}" && -z "${KIMO_KIMI_EFFORT:-}" && -z "${OM_KIMI_EFFORT:-}" ]]; then
        KIMO_KIMI_EFFORT="${KIMO_CONFIG_VALUES[kimi_effort]}"
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[kimi_context]:-}" && -z "${KIMO_KIMI_CONTEXT:-}" ]]; then
        KIMO_KIMI_CONTEXT="${KIMO_CONFIG_VALUES[kimi_context]}"
    fi
    case "${KIMO_CONFIG_VALUES[no_color]:-}" in
        [Tt][Rr][Uu][Ee]|1|[Yy][Ee][Ss]) FORCE_NO_COLOR=true ;;
    esac
    if [[ -n "${KIMO_CONFIG_VALUES[webbridge_url]:-}" && -z "${KIMO_WEBBRIDGE_URL:-}" ]]; then
        WEBBRIDGE_URL="${KIMO_CONFIG_VALUES[webbridge_url]}"
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[webbridge_port]:-}" && -z "${KIMO_WEBBRIDGE_PORT:-}" ]]; then
        WEBBRIDGE_PORT="${KIMO_CONFIG_VALUES[webbridge_port]}"
        # Rebuild the URL only if no full custom URL is set
        if [[ "${WEBBRIDGE_URL}" == "http://127.0.0.1:10086/command" ]]; then
            WEBBRIDGE_URL="http://127.0.0.1:${WEBBRIDGE_PORT}/command"
        fi
    fi
    # environment > config file > built-in default, like every other key.
    if [[ -n "${KIMO_CONFIG_VALUES[web_engine]:-}" && -z "${KIMO_WEB_ENGINE:-}" ]]; then
        WEB_ENGINE="${KIMO_CONFIG_VALUES[web_engine]}"
    fi
    if [[ -n "${KIMO_CONFIG_VALUES[web_max_results]:-}" && -z "${KIMO_WEB_MAX_RESULTS:-}" ]]; then
        WEB_MAX_RESULTS="${KIMO_CONFIG_VALUES[web_max_results]}"
    fi
    # Both are interpolated into printed curl/JS snippets and URLs, so an env
    # value gets the same check as a file value.
    local why
    if ! why=$(_kimo_config_check web_max_results "${WEB_MAX_RESULTS}"); then
        KIMO_CONFIG_IGNORED+=("KIMO_WEB_MAX_RESULTS: ${why}")
        WEB_MAX_RESULTS=10
    fi
    if ! why=$(_kimo_config_check web_engine "${WEB_ENGINE}"); then
        KIMO_CONFIG_IGNORED+=("KIMO_WEB_ENGINE: ${why}")
        WEB_ENGINE=duckduckgo
    fi

    # Dynamically derive REMOTE_HOST_IP if not explicitly set
    if [[ -z "${REMOTE_HOST_IP}" ]]; then
        if [[ -n "${KIMO_CONFIG_VALUES[remote_host]:-}" ]]; then
            REMOTE_HOST_IP="${KIMO_CONFIG_VALUES[remote_host]}"
        elif [[ -n "${REMOTE_HOST_URL:-}" && "${REMOTE_HOST_URL}" != *127.0.0.1* && "${REMOTE_HOST_URL}" != *localhost* ]]; then
            REMOTE_HOST_IP=$(echo "${REMOTE_HOST_URL}" | sed -E 's|https?://([^:/]+).*|\1|')
        else
            local t_host
            t_host=$(_detect_tunnel_target 11438)
            [[ -n "${t_host}" ]] && REMOTE_HOST_IP="${t_host}"
        fi
    fi

    if [[ -n "${REMOTE_HOST_IP}" && "${REMOTE_HOST_IP}" != "127.0.0.1" && "${REMOTE_HOST_IP}" != "localhost" ]]; then
        REMOTE_DIRECT_URL="http://${REMOTE_HOST_IP}:${REMOTE_HOST_PORT}"
        REMOTE_DAEMON_URL="http://${REMOTE_HOST_IP}:11436"
    else
        REMOTE_DIRECT_URL=""
        REMOTE_DAEMON_URL=""
    fi
}
load_kimo_config

# Per-model tuned defaults baked into run/launch. Keyed by exact resolved model
# name; values mirror Ollama request option names (num_ctx/num_batch/...).
# Written by 'tune', consumed by 'run' and 'launch'. KIMO_TUNINGS_FILE relocates
# it (the test harness points it into its temp root).
TUNINGS_FILE="${KIMO_TUNINGS_FILE:-/var/lib/ollama/tunings.json}"

# Map of default models for external CLIs and native Ollama runs
declare -A DEFAULT_MODELS=(
    ["claude"]="kalidroid-27b:latest"
    ["qwen"]="qwen3.8:latest"
    ["llama3"]="llama3.2:3b-text-fp16"
    ["codex"]="kalidroid-27b:latest"
    ["opencode"]="kalidroid-27b:latest"
    ["hermes"]="kalidroid-27b:latest"
    ["openclaw"]="kalidroid-27b:latest"
    ["agy"]="kalidroid-27b:latest"
    ["grok"]="kalidroid-27b:latest"
    ["kimi"]="kalidroid-27b:latest"
    ["cyberstrike"]="kalidroid-27b:latest"
    ["cursor"]="kalidroid-27b:latest"
)

# Map of external CLI binary names
declare -A EXTERNAL_CLI_MAP=(
    ["claude"]="claude"
    ["codex"]="codex"
    ["qwen"]="qwen"
    ["opencode"]="opencode"
    ["hermes"]="hermes"
    ["openclaw"]="openclaw"
    ["agy"]="agy"
    ["grok"]="grok"
    ["kimi"]="kimi"
    ["cyberstrike"]="cyberstrike"
    ["cursor"]="cursor"
)

# abliteration.ai: a hosted Anthropic- and OpenAI-compatible API, not an Ollama
# daemon. Selected with 'launch --provider abliteration' or the cloud_provider
# config key. It bypasses host probing, /api/tags model resolution, /api/show
# capability detection and VRAM eviction - none of which exist upstream - and
# carries the model table below instead.
# Base URLs: the Anthropic surface is the bare origin (/v1/messages), the
# OpenAI surface adds /v1 (/v1/chat/completions).
ABLITERATION_BASE_URL="${KIMO_ABLITERATION_BASE_URL:-https://api.abliteration.ai}"
ABLITERATION_DEFAULT_MODEL="abliterated-model-large-v2"
# canonical id -> context window in tokens
declare -A ABLITERATION_MODELS=(
    ["abliterated-model"]="262144"
    ["abliterated-model-large"]="1000000"
    ["abliterated-model-large-v2"]="1000000"
)
# Only abliterated-model accepts image input; the two large models are text-only
# and reject image content with a 400.
ABLITERATION_VISION_MODEL="abliterated-model"
# CLIs whose launch branch knows how to reach abliteration.ai.
ABLITERATION_CLIS="claude kimi"

# OpenAI's two inference surfaces, both selected with 'launch --provider'.
# 'codex' is the ChatGPT plan endpoint and authenticates with an OAuth bearer
# token; 'openai' is the metered platform API and takes an sk- key. They are
# kept apart because the credentials are not interchangeable: the ChatGPT
# backend answers a platform key with 401 "API keys are not supported".
CODEX_BACKEND_URL="${KIMO_CODEX_BACKEND_URL:-https://chatgpt.com/backend-api/codex}"
OPENAI_BACKEND_URL="${KIMO_OPENAI_BACKEND_URL:-https://api.openai.com}"
# CLIs whose launch branch knows how to reach either OpenAI backend.
OPENAI_CLIS="codex kimi"

# Alibaba Model Studio's international OpenAI-compatible surface, selected
# with 'launch --provider dashscope' and billed pay-as-you-go. The credential
# is a DashScope sk- key from the environment, never written to disk.
DASHSCOPE_BACKEND_URL="${KIMO_DASHSCOPE_BASE_URL:-https://dashscope-intl.aliyuncs.com/compatible-mode/v1}"
DASHSCOPE_DEFAULT_MODEL="qwen3.8-max"
# qwen3.8-max's context window as the user's own model registrations declare
# it; --ctx and KIMO_DASHSCOPE_CTX override.
DASHSCOPE_DEFAULT_CTX="${KIMO_DASHSCOPE_CTX:-1000000}"
# CLIs whose launch branch knows how to reach DashScope.
DASHSCOPE_CLIS="kimi"

# Backend names 'launch --provider' accepts, in the order they are offered by
# completion and listed in errors. 'none' and '' are synonyms for ollama.
KIMO_LAUNCH_PROVIDERS="ollama abliteration codex openai dashscope"

# True when <name> is a hosted inference API rather than a self-hosted Ollama
# daemon: no host probing, no /api/tags resolution, no VRAM eviction, no tune
# registry, and the selected provider's own credential is forwarded instead of
# being scrubbed (scrubbing it would make every request 401).
hosted_provider() {
    case "${1:-}" in
        abliteration|codex|openai|dashscope) return 0 ;;
        *) return 1 ;;
    esac
}

# True when <name> is one of OpenAI's own backends (as opposed to abliteration).
openai_backend() {
    case "${1:-}" in
        codex|openai) return 0 ;;
        *) return 1 ;;
    esac
}

# grok, kimi, opencode, cyberstrike, cursor, etc. install into user directories that reach PATH only
# through ~/.bashrc, which a non-interactive caller (cron, systemd, Apache, sh -c)
# never sources. Ensure all CLI binary directories are present in PATH.
GROK_BIN_DIR="${GROK_BIN_DIR:-${HOME:-/root}/.grok/bin}"
KIMI_BIN_DIR="${KIMI_BIN_DIR:-${HOME:-/root}/.kimi-code/bin}"
CYBERSTRIKE_BIN_DIR="${CYBERSTRIKE_BIN_DIR:-${HOME:-/root}/.cyberstrike/bin}"
CURSOR_BIN_DIR="${CURSOR_BIN_DIR:-${HOME:-/root}/.local/bin}"
if [[ "${KIMO_ENFORCE_PATH:-1}" != "0" ]]; then
    for _dir in "${GROK_BIN_DIR}" "${KIMI_BIN_DIR}" "${CYBERSTRIKE_BIN_DIR}" "${CURSOR_BIN_DIR}" "${HOME:-/root}/.local/share/cyberstrike/bin" "${HOME:-/root}/.local/bin" "${HOME:-/root}/.opencode/bin" "${HOME:-/root}/.cargo/bin" "${HOME:-/root}/.npm-global/bin" "/usr/local/bin"; do
        if [[ -d "${_dir}" && ":${PATH}:" != *":${_dir}:"* ]]; then
            PATH="${PATH}:${_dir}"
        fi
    done
    export PATH
fi

# Terminal color initialization
setup_colors() {
    # no-color.org: any non-empty NO_COLOR disables color, not only "1".
    if [[ -t 1 && -z "${NO_COLOR:-}" && "${FORCE_NO_COLOR:-false}" != "true" ]]; then
        C_RESET=$'\033[0m'
        C_BOLD=$'\033[1m'
        C_DIM=$'\033[2m'
        C_RED=$'\033[0;31m'
        C_GREEN=$'\033[0;32m'
        C_YELLOW=$'\033[0;33m'
        C_BLUE=$'\033[0;34m'
        C_MAGENTA=$'\033[0;35m'
        C_CYAN=$'\033[0;36m'
        # shellcheck disable=SC2034
        C_WHITE=$'\033[1;37m'
    else
        C_RESET=""
        C_BOLD=""
        C_DIM=""
        C_RED=""
        C_GREEN=""
        C_YELLOW=""
        C_BLUE=""
        C_MAGENTA=""
        C_CYAN=""
        # shellcheck disable=SC2034
        C_WHITE=""
    fi
}

usage() {
    cat <<EOF
${C_BOLD}kimo (Ollama Manager)${C_RESET} – Unified Local & Remote Model Management & External CLI Hub

${C_YELLOW}Usage:${C_RESET}
  ${0##*/} [options] <command> [arguments...]

${C_YELLOW}Global Options:${C_RESET}
  ${C_CYAN}--remote${C_RESET}                     Route to remote server (${REMOTE_HOST_URL:-${REMOTE_TUNNEL_URL}}${REMOTE_HOST_IP:+ -> ${REMOTE_HOST_IP}})
  ${C_CYAN}--local${C_RESET}                      Route strictly to local daemon (${LOCAL_HOST_URL})
  ${C_CYAN}--host <address>${C_RESET}             Specify custom Ollama host (repeatable for multi-host routing)
  ${C_CYAN}--json${C_RESET}                       Output responses in structured JSON format
  ${C_CYAN}--no-color${C_RESET}                   Disable colored terminal output
  ${C_CYAN}-v, --version${C_RESET}                Show kimo version
  ${C_CYAN}-h, --help${C_RESET}                   Show this help message

${C_YELLOW}Model & VRAM Management:${C_RESET}
  ${C_CYAN}list, ls [filter]${C_RESET}            List installed models (local & remote) with VRAM indicators
  ${C_CYAN}search, find <keyword>${C_RESET}       Search model catalogs across hosts (name, params, capabilities)
  ${C_CYAN}ps [-w|--watch]${C_RESET}              Display models actively resident in GPU/CPU VRAM with memory stats
  ${C_CYAN}top [-n <sec>]${C_RESET}               Real-time live VRAM residency & model monitor (ps --watch)
  ${C_CYAN}pull, download <model>${C_RESET}       Pull model from registry with live streaming progress & speed
  ${C_CYAN}warm, preload <model> [dur]${C_RESET}  Pre-warm model into GPU VRAM (keep_alive: 24h) to avoid cold-starts
  ${C_CYAN}stop, unload [model|all]${C_RESET}     Evict models from GPU VRAM immediately (keep_alive: 0)
  ${C_CYAN}tune <model> [opts...]${C_RESET}       Bake runtime parameters (--ctx, --batch, --temp, --gpu) into registry
  ${C_CYAN}bench, eval [model]${C_RESET}          Benchmark TTFT, generation throughput (tok/s), and memory usage
  ${C_CYAN}info, show <model>${C_RESET}           Inspect model metadata, quantization, context size, and template
  ${C_CYAN}tag, alias <src> <dst>${C_RESET}       Create a model tag or alias on target host
  ${C_CYAN}rm, delete <model>${C_RESET}           Delete a model from local or remote Ollama server
